---
import { Image } from 'astro:assets';

import frame1 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_1.png';
import frame2 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_2.png';
import frame3 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_3.png';
import frame4 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_4.png';
import frame5 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_5.png';
import frame6 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_6.png';
import frame7 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_7.png';
import frame8 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_8.png';
import frame9 from '../../assets/art/secret-box-animation-frames/Doodles_secret_box_frame_9.png';
import { sitePath } from '../../config/site';

const frames = [frame1, frame2, frame3, frame4, frame5, frame6, frame7, frame8, frame9];
const homeHref = sitePath('/');
---

<secret-box-sequence class="secret-box-sequence">
  <span class="secret-box-sequence__composition">
    <a
      class="secret-box-sequence__trigger"
      href={homeHref}
      aria-label="Open the secret box"
      data-secret-box-trigger
    >
      <span class="secret-box-sequence__stage" aria-hidden="true">
        {
          frames.map((frame, index) => (
            <Image
              class="secret-box-sequence__frame"
              src={frame}
              alt=""
              width={512}
              height={512}
              loading="eager"
              data-secret-box-frame
              data-active={index === 0 ? '' : undefined}
            />
          ))
        }
      </span>
    </a>
    <span class="secret-box-sequence__warning">
      Do <span data-secret-box-negation>not</span> open
    </span>
  </span>

  <p class="secret-box-sequence__reflection" data-secret-box-reflection hidden>
    Curiosity killed the cat, but satisfaction brought it back.
  </p>
  <span class="secret-box-sequence__status" aria-live="polite" data-secret-box-status></span>
  <span class="secret-box-sequence__iris" aria-hidden="true" data-secret-box-iris></span>
</secret-box-sequence>

<script>
  class SecretBoxSequence extends HTMLElement {
    connectedCallback() {
      if (this.dataset.enhanced) return;

      const trigger = this.querySelector<HTMLAnchorElement>('[data-secret-box-trigger]');
      const frames = Array.from(this.querySelectorAll<HTMLElement>('[data-secret-box-frame]'));
      const negation = this.querySelector<HTMLElement>('[data-secret-box-negation]');
      const reflection = this.querySelector<HTMLElement>('[data-secret-box-reflection]');
      const status = this.querySelector<HTMLElement>('[data-secret-box-status]');
      const iris = this.querySelector<HTMLElement>('[data-secret-box-iris]');
      if (!trigger || frames.length < 2 || !negation || !reflection || !status || !iris) return;

      this.dataset.enhanced = 'true';
      let playing = false;
      let navigating = false;

      const showFrame = (activeIndex: number) => {
        frames.forEach((frame, index) => frame.toggleAttribute('data-active', index === activeIndex));
      };

      const wait = (duration: number) =>
        new Promise<void>((resolve) => window.setTimeout(resolve, duration));

      const goHome = () => {
        if (navigating) return;

        navigating = true;
        window.location.assign(trigger.href);
      };

      const play = async () => {
        if (playing) return;

        playing = true;
        this.setAttribute('aria-busy', 'true');
        trigger.setAttribute('aria-disabled', 'true');
        trigger.setAttribute('aria-label', 'Opening the secret box');
        negation.dataset.crossedOut = 'true';
        reflection.hidden = false;
        status.textContent = 'Opening the secret box.';

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (reduceMotion) {
          showFrame(frames.length - 1);
        } else {
          for (let index = 1; index < frames.length; index += 1) {
            showFrame(index);
            await wait(1000 / 3);
          }
        }

        this.dataset.transitioning = 'true';
        status.textContent = 'The secret box is open. Going home.';

        iris.addEventListener('animationend', goHome, { once: true });
        window.setTimeout(goHome, reduceMotion ? 100 : 1000);
      };

      trigger.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        void play();
      });
    }
  }

  if (!customElements.get('secret-box-sequence')) {
    customElements.define('secret-box-sequence', SecretBoxSequence);
  }
</script>

<style>
  .secret-box-sequence {
    position: relative;
    display: grid;
    min-height: calc(100vh - (2 * var(--field-gutter)));
    place-items: center;
    pointer-events: none;
  }

  .secret-box-sequence__composition {
    position: relative;
    display: block;
    width: clamp(10rem, 25vw, 13rem);
    aspect-ratio: 1;
  }

  .secret-box-sequence__trigger {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
  }

  .secret-box-sequence__warning {
    position: absolute;
    top: calc(100% + clamp(0.45rem, 1.5vw, 0.75rem));
    right: clamp(-0.9rem, -1.5vw, -0.35rem);
    width: max-content;
    color: rgba(243, 239, 228, 0.62);
    font-family: var(--font-reading);
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    line-height: 1;
    transform: rotate(-6deg);
  }

  .secret-box-sequence__warning span {
    text-decoration-line: underline;
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.14em;
  }

  .secret-box-sequence__warning span[data-crossed-out] {
    text-decoration-line: line-through;
  }

  .secret-box-sequence__trigger[aria-disabled='true'] {
    cursor: wait;
  }

  .secret-box-sequence__stage {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .secret-box-sequence__trigger:not([aria-disabled='true'])
      .secret-box-sequence__stage:hover {
      animation: secret-box-hover-shake 560ms steps(1, end) infinite;
    }
  }

  .secret-box-sequence__frame {
    position: absolute;
    top: -61.4%;
    left: -90%;
    display: block;
    width: 271%;
    max-width: none;
    height: auto;
    filter: grayscale(1) invert(1);
    opacity: 0;
  }

  .secret-box-sequence__frame[data-active] {
    opacity: 1;
  }

  .secret-box-sequence__reflection {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(25rem, 82vw);
    margin: 0;
    color: rgba(243, 239, 228, 0.68);
    font-size: clamp(0.82rem, 1.4vw, 1rem);
    line-height: 1.35;
    text-align: right;
    transform: rotate(-0.8deg);
  }

  .secret-box-sequence__reflection[hidden] {
    display: none;
  }

  .secret-box-sequence__reflection:not([hidden]) {
    animation: secret-box-reflection-appears 420ms steps(3, end) both;
  }

  .secret-box-sequence__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .secret-box-sequence__iris {
    position: fixed;
    z-index: 1000;
    top: 50%;
    left: 50%;
    display: block;
    width: 300vmax;
    height: 300vmax;
    visibility: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 200vmax #080807;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .secret-box-sequence[data-transitioning] .secret-box-sequence__iris {
    visibility: visible;
    animation: secret-box-iris-out 800ms cubic-bezier(0.6, 0, 0.85, 0.45) both;
  }

  @keyframes secret-box-iris-out {
    from {
      width: 300vmax;
      height: 300vmax;
    }

    to {
      width: 0;
      height: 0;
    }
  }

  @keyframes secret-box-reflection-appears {
    from {
      opacity: 0;
      transform: translateY(0.35rem) rotate(-0.8deg);
    }

    to {
      opacity: 1;
      transform: rotate(-0.8deg);
    }
  }

  @keyframes secret-box-hover-shake {
    0%,
    100% {
      transform: translate(0, 0) rotate(0);
    }

    25% {
      transform: translate(-0.08rem, 0.04rem) rotate(-0.45deg);
    }

    50% {
      transform: translate(0.07rem, -0.03rem) rotate(0.35deg);
    }

    75% {
      transform: translate(-0.04rem, -0.05rem) rotate(-0.25deg);
    }
  }
</style>
