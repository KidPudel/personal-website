---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  description: string;
  small: string;
  large: string;
  poster: ImageMetadata;
}

const { id, title, description, small, large, poster } = Astro.props;
const cover = await getImage({ src: poster, width: 1280, format: 'webp', quality: 82 });
---

<figure class="blog-film">
  <video
    controls
    playsinline
    preload="none"
    poster={cover.src}
    width={1920}
    height={1080}
    aria-label={title}
    aria-describedby={`${id}-caption`}
  >
    <source src={small} type="video/mp4" media="(max-width: 52rem), (max-resolution: 1.25dppx)" />
    <source src={large} type="video/mp4" />
    <a href={large}>Watch {title}</a>
  </video>
  <figcaption id={`${id}-caption`}>{description}</figcaption>
</figure>

<style>
  .blog-film {
    margin: 40px 0 44px;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    background: #000;
  }

  figcaption {
    margin-top: 14px;
    color: #656560;
    font-size: var(--study-small, 0.9375rem);
    line-height: 1.6;
  }

  a {
    color: inherit;
  }
</style>
