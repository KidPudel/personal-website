---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import { localePath, toLocale, translator } from '../../i18n/locales';
import BaseDocument from '../../layouts/BaseDocument.astro';
import { imageEdgeColor } from '../../lib/image-placeholder';
import type { LocalizedPost } from '../../lib/writing';
import '../../styles/case-study.css';

interface Props {
  post: LocalizedPost;
}

const { post } = Astro.props;
const { entry, contentLocale, cover } = post;
// The illustration is square on a flat ground; the band under the title
// continues that ground to its width, so nothing of the drawing is cropped.
const coverGround = cover && (await imageEdgeColor(cover));
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const { Content } = await render(entry);
const dateFormat = new Intl.DateTimeFormat(contentLocale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseDocument
  title={`${entry.data.title} | ${t('Igor Kupchinenko', 'Игорь Купчиненко')}`}
  description={entry.data.summary}
  pageClass="editorial-case-study blog-document"
>
  <main id="main-content">
    <article class="blog-post" lang={contentLocale === locale ? undefined : contentLocale}>
      <header class="blog-post__header">
        <h1>{entry.data.title}</h1>
        {entry.data.publishedAt && (
          <time datetime={entry.data.publishedAt.toISOString().slice(0, 10)}>
            {dateFormat.format(entry.data.publishedAt)}
          </time>
        )}
        {entry.data.mediumUrl && (
          <a class="blog-post__medium" href={entry.data.mediumUrl} hreflang="en">
            <span class="link-mark">{t('Also on Medium', 'Также на Medium, на английском')}</span> ↗
          </a>
        )}
      </header>
      {cover && (
        <div id="essay-cover" class="blog-post__cover" style={`--cover-ground: ${coverGround}`} aria-hidden="true">
          {/* The essay's card grows into this picture on the way in (BaseDocument). */}
          <Image
            class="blog-post__cover-picture"
            src={cover}
            alt=""
            widths={[208, 384, 576, 768]}
            sizes="(max-width: 44rem) 13rem, min(24rem, 30vw)"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            format="webp"
            quality={86}
            data-writing-transition={post.slug}
          />
        </div>
      )}
      <Content />
    </article>
  </main>
  <footer class="case-footer">
    <nav aria-label={t('Writing links', 'Ссылки на тексты')}>
      <a href={localePath('/writing/', locale)}><span class="link-mark">{t('All posts', 'Все тексты')}</span></a>
      <a href={localePath('/', locale)}><span class="link-mark">{t('Home', 'Главная')}</span></a>
    </nav>
  </footer>
</BaseDocument>
