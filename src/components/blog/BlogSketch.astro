---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** A photograph or screenshot rather than a drawing on white paper. */
  photo?: boolean;
}

const { src, alt, caption, photo = false } = Astro.props;
---

<figure class:list={['blog-sketch', { 'blog-sketch--photo': photo }]}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 720, 1040]}
    sizes="(max-width: 600px) calc(100vw - 40px), 520px"
    format="webp"
    quality={84}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .blog-sketch {
    margin: 48px auto 52px;
    max-width: 520px;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    /* The sketch is drawn on white; multiply lets the page paper show through it. */
    mix-blend-mode: multiply;
  }

  .blog-sketch--photo img {
    border-radius: 6px;
    mix-blend-mode: normal;
  }

  figcaption {
    margin-top: 12px;
    color: #656560;
    font-size: var(--study-small, 0.9375rem);
    line-height: 1.6;
    text-align: center;
  }
</style>
