---
import type { CollectionEntry } from 'astro:content';

import SectionMarker from './SectionMarker.astro';

interface Props {
  identityCage: CollectionEntry<'writing'>;
}

const { identityCage } = Astro.props;
---

<section id="writing" class="writing" aria-labelledby="writing-title">
  <SectionMarker icon="blog" label="Writing" />
  <h2 id="writing-title">{identityCage.data.title}</h2>
  <p>{identityCage.data.summary}</p>
  {identityCage.data.canonicalUrl && (
    <a href={identityCage.data.canonicalUrl}>Read on Medium <span aria-hidden="true">↗</span></a>
  )}
</section>

<style>
  .writing {
    position: relative;
    width: min(100%, 62rem);
    margin-inline: auto;
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1.25rem, 5vw, 4rem) clamp(5rem, 10vw, 8rem);
  }

  .writing h2 {
    max-width: 16ch;
    margin: 0.65rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 2.7vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .writing p {
    max-width: 38rem;
    margin: 1.15rem 0 0;
    color: var(--color-copy);
    font-size: clamp(0.98rem, 0.25vw + 0.94rem, 1.1rem);
  }

  .writing a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: 1.1rem;
    font-family: var(--font-reading);
    font-size: 0.84rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35rem;
  }
</style>
