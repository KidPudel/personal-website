---
import { Image } from 'astro:assets';
import '@fontsource/instrument-serif/400.css';

import { localePath, toLocale, translator } from '../../../i18n/locales';
import { getWriting, isFresh, newestFirst } from '../../../lib/writing';
import EssayCard from '../../blog/EssayCard.astro';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);

// The two newest essays, then a door to the writing page. The door holds the
// illustrations of the essays waiting there, stacked; opening it lays them out
// as the writing page's cards (BaseDocument).
const featured = 2;
const all = newestFirst(await getWriting(locale));
const newest = all[0];
const shown = all.slice(0, featured);
const waiting = all.slice(featured, featured + 3).filter((post) => post.cover);
---

<section id="writing" class="writing" aria-labelledby="writing-title">
  <h2 id="writing-title" class="writing__title" data-writing-transition="title">{t('writing', 'тексты')}</h2>

  <ul class="writing__grid">
    {shown.map((post) => (
      <li>
        <EssayCard post={post} heading="h3" fresh={isFresh(post, newest)} />
      </li>
    ))}

    <li>
      <article class="door">
        <div class="door__panel" style={`--count: ${waiting.length}`}>
          {waiting.map((post, index) => (
            <span
              class="door__leaf"
              style={`--step: ${index - (waiting.length - 1) / 2}`}
              data-writing-transition={post.slug}
            >
              <Image
                src={post.cover!}
                alt=""
                widths={[240, 360, 480]}
                sizes="(max-width: 44rem) 50vw, min(15vw, 12rem)"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={84}
              />
            </span>
          ))}
        </div>

        <div class="door__caption">
          <h3 class="door__title">
            <a class="door__link" href={localePath('/writing/', locale)}><span class="link-mark">{t('All writing', 'Все тексты')}</span> →</a>
          </h3>
        </div>
      </article>
    </li>
  </ul>
</section>

<style>
  .writing {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--page-frame));
    margin-inline: auto;
    padding: 0 0 var(--section-gap);
  }

  /* The homepage's section titles: "my work", "more things i've made". Only
     as wide as the word, so it travels as the word to the writing page's
     title. */
  .writing__title {
    width: fit-content;
    margin: 0 0 clamp(1.5rem, 2.5vw, 2.5rem);
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .writing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 3vw, 2.75rem) var(--work-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The door: the essays still to read, stacked on white paper. Pointing at
     it fans them out a little, as if it were opening. */
  .door {
    position: relative;
    display: grid;
    align-content: start;
    transition: transform 280ms var(--ease-out);
  }

  .door__panel {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: var(--radius-card);
    background: #fff;
    box-shadow:
      0 1px 0 rgb(17 17 15 / 0.06),
      0 1.25rem 3.5rem rgb(17 17 15 / 0.09);
    transition: box-shadow 280ms var(--ease-out);
  }

  .door__leaf {
    --spread: 1;

    grid-area: 1 / 1;
    width: 50%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(var(--radius-card) * 0.6);
    box-shadow: 0 0.6rem 1.4rem rgb(17 17 15 / 0.14);
    transform: translateX(calc(var(--step) * 34% * var(--spread))) rotate(calc(var(--step) * 7deg * var(--spread)));
    transition: transform 420ms var(--ease-out);
  }

  .door__leaf :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .door__caption {
    margin-top: 0.85rem;
    color: var(--color-muted);
    font-family: var(--font-reading);
    font-size: clamp(0.95rem, 0.15vw + 0.9rem, 1.02rem);
    letter-spacing: 0.015em;
    line-height: 1.4;
  }

  .door__title {
    margin: 0;
    font: inherit;
    font-weight: 500;
    letter-spacing: 0.005em;
  }

  .door__link {
    color: var(--color-ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .door__link::after {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
    content: '';
  }

  .door__link:focus-visible {
    outline: none;
  }

  .door__link:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .door:has(.door__link:focus-visible) {
    transform: translateY(-0.25rem);
  }

  .door:has(.door__link:focus-visible) .door__leaf {
    --spread: 1.45;
  }

  @media (hover: hover) and (pointer: fine) {
    .door:has(.door__link:hover) {
      transform: translateY(-0.25rem);
    }

    .door:has(.door__link:hover) .door__panel {
      box-shadow:
        0 1px 0 rgb(17 17 15 / 0.06),
        0 1.75rem 4.25rem rgb(17 17 15 / 0.14);
    }

    .door:has(.door__link:hover) .door__leaf {
      --spread: 1.45;
    }
  }

  @media (hover: none) {
    .door__link .link-mark {
      background-image: var(--link-mark-rest);
    }
  }

  /* On phones the essays stand one under another and the door is a shorter
     strip, so the stack still reads at a glance. */
  @media (max-width: 44rem) {
    .writing__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .door__panel {
      aspect-ratio: 3 / 2;
    }

    .door__leaf {
      width: 34%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .door,
    .door__leaf {
      transition: none;
    }

    .door:has(.door__link:is(:hover, :focus-visible)) {
      transform: none;
    }
  }
</style>
