---
import { Image } from 'astro:assets';
import '@fontsource/instrument-serif/400.css';

import discoursesPoster from '../../../assets/games/discourses/discourses-poster.webp';
import discoursesVideo from '../../../assets/games/discourses/discourses-teaser.mp4';
import snakePoster from '../../../assets/games/snake/poster.jpg';
import snakeVideo from '../../../assets/games/snake/snake-raylib-silent.mp4';
import bunPoster from '../../../assets/games/thelastofbuns/showcase-poster.webp';
import bunVideo from '../../../assets/games/thelastofbuns/showcase.mp4';
import ticTacToeImage from '../../../assets/games/tic-tac-toe/gameplay.png';
import FarmField from './FarmField.astro';
import SantaFlight from './SantaFlight.astro';
import WeightedSwitchExperiment from './WeightedSwitchExperiment.astro';
import { toLocale, translator } from '../../../i18n/locales';

const t = translator(toLocale(Astro.currentLocale));
const videoFallback = t('Your browser does not support embedded video.', 'Браузер не поддерживает встроенное видео.');

// Where a link leads, so a visitor knows before leaving the site.
const destinationOf = (href: string) => {
  const host = new URL(href).hostname;
  return host.endsWith('itch.io') ? 'itch.io' : host === 'github.com' ? 'GitHub' : host === 'x.com' ? 'X' : host;
};

const project = (name: string, href: string) => ({ name, href, destination: destinationOf(href) });

const cards = {
  discourses: project('Discourses by Campfire', 'https://kidpudel.itch.io/discourses-by-campfire'),
  santa: project('Secret Santa Foundation', 'https://itch.io/jam/secret-santa-2025/rate/4137573'),
  buns: project('The Last of Buns', 'https://github.com/KidPudel/The-Last-Of-Buns'),
  farm: project(t('Farming Game', 'Фермерская игра'), 'https://kidpudel.itch.io/farming-game'),
  snake: project(t('Snake with Go and raylib', 'Змейка на Go и raylib'), 'https://x.com/kidpudel/status/1781656147990020293?s=20'),
  switch: project(t('Switch experiment', 'Эксперимент с переключателем'), 'https://x.com/kidpudel/status/2089804412319358998'),
  ticTacToe: project(t('Tic-Tac-Toe with C++ and OpenGL', 'Крестики-нолики на C++ и OpenGL'), 'https://github.com/KidPudel/TicTacToe'),
};
---

<section id="side-projects" class="other-showcase" aria-labelledby="other-showcase-title">
  <h2 id="other-showcase-title" class="other-showcase__title">
    {t('more things i’ve made', 'что ещё я сделал').split(' ').map((word, index) => (
      <>{index > 0 && ' '}<span>{word}</span></>
    ))}
  </h2>

  {/* A reel: one card in front, larger, the rest waiting beside it; it turns on its own
      and round without end. Each card is one link. Without scripts it is a plain row
      that scrolls sideways. */}
  <div class="reel" data-reel>
    <ul class="reel__track" data-reel-track>
      <li class="reel__item" data-reel-item data-name={cards.discourses.name} data-destination={cards.discourses.destination}>
        <a class="reel__card" href={cards.discourses.href} aria-label={`${cards.discourses.name}, ${cards.discourses.destination}`} draggable="false">
          <span class="reel__frame">
            <span class="reel__media">
              <video src={discoursesVideo} poster={discoursesPoster.src} width="960" height="540" preload="none" playsinline muted loop>
                {videoFallback}
              </video>
            </span>
          </span>
          <span class="reel__caption" aria-hidden="true">
            <span class="reel__name"><span class="link-mark">{cards.discourses.name}</span></span>
            <span class="reel__destination">{cards.discourses.destination}</span>
          </span>
        </a>
      </li>

      <li class="reel__item" data-reel-item data-name={cards.santa.name} data-destination={cards.santa.destination}>
        <a class="reel__card" href={cards.santa.href} aria-label={`${cards.santa.name}, ${cards.santa.destination}`} draggable="false">
          <span class="reel__frame reel__frame--santa">
            <span class="reel__media"><SantaFlight ambient /></span>
          </span>
          <span class="reel__caption" aria-hidden="true">
            <span class="reel__name"><span class="link-mark">{cards.santa.name}</span></span>
            <span class="reel__destination">{cards.santa.destination}</span>
          </span>
        </a>
      </li>

      <li class="reel__item" data-reel-item data-name={cards.buns.name} data-destination={cards.buns.destination}>
        <a class="reel__card" href={cards.buns.href} aria-label={`${cards.buns.name}, ${cards.buns.destination}`} draggable="false">
          <span class="reel__frame">
            <span class="reel__media">
              <video src={bunVideo} poster={bunPoster.src} width="800" height="450" preload="none" playsinline muted loop>
                {videoFallback}
              </video>
            </span>
          </span>
          <span class="reel__caption" aria-hidden="true">
            <span class="reel__name"><span class="link-mark">{cards.buns.name}</span></span>
            <span class="reel__destination">{cards.buns.destination}</span>
          </span>
        </a>
      </li>

      <li class="reel__item" data-reel-item data-name={cards.farm.name} data-destination={cards.farm.destination}>
        <a class="reel__card" href={cards.farm.href} aria-label={`${cards.farm.name}, ${cards.farm.destination}`} draggable="false">
          <span class="reel__frame reel__frame--farm">
            <span class="reel__media"><FarmField ambient /></span>
          </span>
          <span class="reel__caption" aria-hidden="true">
            <span class="reel__name"><span class="link-mark">{cards.farm.name}</span></span>
            <span class="reel__destination">{cards.farm.destination}</span>
          </span>
        </a>
      </li>

      <li class="reel__item" data-reel-item data-name={cards.snake.name} data-destination={cards.snake.destination}>
        <a class="reel__card" href={cards.snake.href} aria-label={`${cards.snake.name}, ${cards.snake.destination}`} draggable="false">
          <span class="reel__frame">
            <span class="reel__media">
              <video src={snakeVideo} poster={snakePoster.src} width="1150" height="720" preload="none" playsinline muted loop>
                {videoFallback}
              </video>
            </span>
          </span>
          <span class="reel__caption" aria-hidden="true">
            <span class="reel__name"><span class="link-mark">{cards.snake.name}</span></span>
            <span class="reel__destination">{cards.snake.destination}</span>
          </span>
        </a>
      </li>

      <li class="reel__item" data-reel-item data-name={cards.switch.name} data-destination={cards.switch.destination}>
        <a class="reel__card" href={cards.switch.href} aria-label={`${cards.switch.name}, ${cards.switch.destination}`} draggable="false">
          <span class="reel__frame reel__frame--switch">
            <span class="reel__media"><WeightedSwitchExperiment ambient /></span>
          </span>
          <span class="reel__caption" aria-hidden="true">
            <span class="reel__name"><span class="link-mark">{cards.switch.name}</span></span>
            <span class="reel__destination">{cards.switch.destination}</span>
          </span>
        </a>
      </li>

      <li class="reel__item" data-reel-item data-name={cards.ticTacToe.name} data-destination={cards.ticTacToe.destination}>
        <a class="reel__card" href={cards.ticTacToe.href} aria-label={`${cards.ticTacToe.name}, ${cards.ticTacToe.destination}`} draggable="false">
          <span class="reel__frame reel__frame--tic-tac-toe">
            <span class="reel__media reel__board">
              <Image
                src={ticTacToeImage}
                alt=""
                widths={[360, 560]}
                sizes="(max-width: 60rem) 13rem, 20rem"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={82}
              />
            </span>
          </span>
          <span class="reel__caption" aria-hidden="true">
            <span class="reel__name"><span class="link-mark">{cards.ticTacToe.name}</span></span>
            <span class="reel__destination">{cards.ticTacToe.destination}</span>
          </span>
        </a>
      </li>
    </ul>
    <p class="reel__live" aria-hidden="true" data-reel-caption></p>
  </div>
</section>

<script>
  // The reel. One card is in front: larger, playing, and named underneath. The rest wait
  // beside it, smaller and still. The reel turns on its own, one card at a time and round
  // without end; under the pointer, the card you point at becomes the one in front, where
  // it stands. On touch screens a swipe turns it. At both ends of the text column the row
  // dissolves, so nothing is cut by a hard edge and nothing crosses into the margins.
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const track = reel?.querySelector<HTMLElement>('[data-reel-track]');
  const caption = reel?.querySelector<HTMLElement>('[data-reel-caption]');

  if (reel && track && caption) {
    const items = [...track.querySelectorAll<HTMLElement>('[data-reel-item]')];
    const count = items.length;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const connection = (
      navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
    ).connection;
    const conserveData = Boolean(connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? ''));

    const turnEvery = 3400; // ms between the reel's own turns
    const quietAfterHand = 4000; // ms the reel waits after being moved by hand
    const smallScale = 0.7; // a waiting card's size against the one in front
    const follow = 9; // how quickly the reel catches up with where it is going (per second)

    let big = 0; // width of the card in front
    let gap = 0;
    let view = 0;

    let position = 0; // which card is in front, as a continuous index
    let target = 0;
    let anchor = 0; // where the card in front stands, from the reel's left
    let anchorTarget = 0;
    let current = -1;
    let hovering = -1;
    let pointerInside = false;
    let focused = false;
    let visible = false;
    let revealed = false;
    let quietUntil = 0;
    let frame = 0;
    let last = 0;
    let turnTimer = 0;
    let hoverTimer = 0;
    let centres: number[] = [];

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const ease = (value: number) => value * value * (3 - 2 * value);
    // The nearest way round the loop from one card to another.
    const around = (from: number, to: number) => {
      const step = (((to - from) % count) + count) % count;
      return step > count / 2 ? step - count : step;
    };

    const measure = () => {
      const styles = getComputedStyle(reel);
      big = items[0]?.offsetWidth ?? 0;
      gap = parseFloat(styles.getPropertyValue('--reel-gap')) || 16;
      view = track.clientWidth;
      if (hovering < 0) anchor = anchorTarget = view / 2;
      render();
    };

    const showCaption = (item: HTMLElement) => {
      const name = item.dataset.name ?? '';
      const destination = item.dataset.destination ?? '';
      const words = name.split(' ');
      const build = () => {
        caption.replaceChildren();
        const nameLine = document.createElement('span');
        nameLine.className = 'reel__live-name';
        words.forEach((word, index) => {
          const span = document.createElement('span');
          span.className = 'reel__word';
          span.style.setProperty('--i', String(index));
          span.textContent = word;
          nameLine.append(span, index < words.length - 1 ? ' ' : '');
        });
        const destinationLine = document.createElement('span');
        destinationLine.className = 'reel__word reel__live-destination';
        destinationLine.style.setProperty('--i', String(words.length + 1));
        destinationLine.textContent = destination;
        caption.append(nameLine, destinationLine);
        caption.removeAttribute('data-leaving');
      };
      if (!caption.childElementCount || reducedMotion.matches) return build();
      caption.setAttribute('data-leaving', '');
      window.setTimeout(build, 130);
    };

    // Only the card in front plays; the rest hold still on their first frame.
    const syncMedia = () => {
      items.forEach((item, i) => {
        const video = item.querySelector('video');
        if (!video) return;
        if (i === current && visible && !reducedMotion.matches && !conserveData && !document.hidden) {
          void video.play().catch(() => undefined);
        } else {
          video.pause();
        }
      });
    };

    const setCurrent = (index: number) => {
      if (index === current) return;
      current = index;
      items.forEach((item, i) => {
        item.toggleAttribute('data-current', i === current);
        item.toggleAttribute('data-still', i !== current);
      });
      syncMedia();
      if (revealed) showCaption(items[current]!);
    };

    const render = () => {
      const pitch = big * smallScale + gap;
      // Keep as many cards on each side of the one in front as the space allows, so the
      // loop never runs out of cards at one end when the front card stands off centre.
      const bias = (anchor - view / 2) / pitch;
      const low = -count / 2 - bias;
      const offsets = items.map((_, i) => {
        const d = i - position;
        return ((((d - low) % count) + count) % count) + low;
      });
      const scales = offsets.map((d) => smallScale + (1 - smallScale) * ease(clamp(1 - Math.abs(d), 0, 1)));
      const widths = scales.map((scale) => big * scale);

      // Lay the row out from the card nearest the front, outward both ways.
      const order = offsets.map((d, i) => ({ d, i })).sort((a, b) => a.d - b.d);
      const nearest = order.reduce((best, entry) => (Math.abs(entry.d) < Math.abs(best.d) ? entry : best));
      const at = order.indexOf(nearest);
      const space = (a: number, b: number) => widths[a]! / 2 + gap + widths[b]! / 2;
      centres = new Array(count).fill(0);
      // Between two cards, the anchor sits the matching share of the way between them.
      const neighbour = nearest.d > 0 ? order[at - 1] : order[at + 1];
      centres[nearest.i] = anchor + nearest.d * (neighbour ? space(nearest.i, neighbour.i) : big);
      for (let k = at + 1; k < order.length; k += 1) {
        centres[order[k]!.i] = centres[order[k - 1]!.i]! + space(order[k - 1]!.i, order[k]!.i);
      }
      for (let k = at - 1; k >= 0; k -= 1) {
        centres[order[k]!.i] = centres[order[k + 1]!.i]! - space(order[k]!.i, order[k + 1]!.i);
      }

      items.forEach((item, i) => {
        const width = widths[i]!;
        const left = centres[i]! - width / 2;
        const right = centres[i]! + width / 2;
        item.style.transform = `translate3d(${(centres[i]! - big / 2).toFixed(2)}px, 0, 0) scale(${scales[i]!.toFixed(4)})`;
        item.style.zIndex = String(Math.round(scales[i]! * 100));
        item.style.visibility = right < 0 || left > view ? 'hidden' : '';
      });

      setCurrent(nearest.i);
      const front = items[nearest.i]!;
      const frontWidth = widths[nearest.i]!;
      caption.style.transform = `translate3d(${(centres[nearest.i]! - frontWidth / 2).toFixed(2)}px, 0, 0)`;
      caption.style.width = `${frontWidth.toFixed(2)}px`;
      caption.dataset.for = front.dataset.name ?? '';
    };

    const tick = (now: number) => {
      const elapsed = Math.min(now - last, 64) / 1000;
      last = now;
      const share = reducedMotion.matches ? 1 : 1 - Math.exp(-follow * elapsed);
      position += (target - position) * share;
      anchor += (anchorTarget - anchor) * share;
      render();
      if (Math.abs(target - position) < 0.0005 && Math.abs(anchorTarget - anchor) < 0.25 && !dragging) {
        position = target;
        anchor = anchorTarget;
        render();
        frame = 0;
        return;
      }
      frame = requestAnimationFrame(tick);
    };

    const wake = () => {
      if (frame) return;
      last = performance.now();
      frame = requestAnimationFrame(tick);
    };

    const goTo = (index: number, standAt = view / 2) => {
      target = Math.round(position + around(position, index));
      anchorTarget = standAt;
      wake();
    };

    // The reel's own turning, while nobody is pointing at it, holding focus in it, or
    // has just moved it by hand.
    const scheduleTurn = (delay = turnEvery) => {
      window.clearTimeout(turnTimer);
      turnTimer = window.setTimeout(turn, delay);
    };
    const turn = () => {
      const now = performance.now();
      if (!visible || pointerInside || focused || dragging || reducedMotion.matches || document.hidden) return;
      if (now < quietUntil) return scheduleTurn(quietUntil - now);
      target = Math.round(target) + 1;
      anchorTarget = view / 2;
      wake();
      scheduleTurn();
    };
    const handOver = () => {
      quietUntil = performance.now() + quietAfterHand;
      scheduleTurn(quietAfterHand);
    };

    // Pointing at a card brings it to the front where it stands, so it grows under the
    // pointer instead of running away from it. Only the pointer's own moves count: when
    // the row shifts under a still pointer, the card it lands on is not being chosen. A
    // short wait keeps a pointer crossing the row from waking every card on its way.
    let pointed = -1;
    track.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || dragging) return;
      const item = (event.target as Element).closest<HTMLElement>('[data-reel-item]');
      const i = item ? items.indexOf(item) : -1;
      if (i < 0 || i === pointed) return;
      pointed = i;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        hovering = i;
        if (i === current && Math.abs(anchorTarget - centres[i]!) < 1) return;
        target = Math.round(position + around(position, i));
        anchorTarget = clamp(centres[i]!, big / 2, view - big / 2);
        wake();
      }, 70);
    });

    reel.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') pointerInside = true;
    });
    reel.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return;
      window.clearTimeout(hoverTimer);
      pointerInside = false;
      hovering = -1;
      pointed = -1;
      anchorTarget = view / 2;
      wake();
      scheduleTurn();
    });

    // A card not in front comes to the front first; the one in front opens its project.
    items.forEach((item, i) => {
      item.querySelector('a')?.addEventListener('click', (event) => {
        if (swallowClick) return;
        if (i === current || i === hovering) return;
        event.preventDefault();
        handOver();
        goTo(i);
      });
      item.addEventListener('focusin', () => {
        if (i !== current) goTo(i);
      });
    });

    track.addEventListener('keydown', (event) => {
      const move = { ArrowLeft: -1, ArrowRight: 1 }[event.key];
      if (!move) return;
      event.preventDefault();
      handOver();
      const next = (((current + move) % count) + count) % count;
      goTo(next);
      items[next]?.querySelector('a')?.focus({ preventScroll: true });
    });

    reel.addEventListener('focusin', () => {
      focused = true;
    });
    reel.addEventListener('focusout', (event) => {
      if (reel.contains(event.relatedTarget as Node | null)) return;
      focused = false;
      scheduleTurn();
    });

    // A drag or a swipe turns the reel by hand and lets go on the nearest card.
    let dragging = false;
    let pressed = false;
    let pointerId = -1;
    let startX = 0;
    let startPosition = 0;
    let lastX = 0;
    let lastTime = 0;
    let velocity = 0;
    let swallowClick = false;

    track.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      pressed = true;
      pointerId = event.pointerId;
      startX = lastX = event.clientX;
      startPosition = position;
      lastTime = event.timeStamp;
      velocity = 0;
    });

    track.addEventListener('pointermove', (event) => {
      if (!pressed || event.pointerId !== pointerId) return;
      const moved = event.clientX - startX;
      if (!dragging && Math.abs(moved) > 6) {
        dragging = true;
        reel.dataset.dragging = '';
        window.clearTimeout(hoverTimer);
        hovering = -1;
        anchorTarget = view / 2;
        try {
          track.setPointerCapture(pointerId);
        } catch {
          // The pointer is already gone; the drag still follows its moves.
        }
        wake();
      }
      if (!dragging) return;
      const pitch = big * (1 + smallScale) / 2 + gap;
      target = position = startPosition - moved / pitch;
      const dt = Math.max(event.timeStamp - lastTime, 1);
      velocity = velocity * 0.6 + ((lastX - event.clientX) / pitch / dt) * 1000 * 0.4;
      lastX = event.clientX;
      lastTime = event.timeStamp;
    });

    const release = (event: PointerEvent) => {
      if (event.pointerId !== pointerId) return;
      pressed = false;
      if (!dragging) return;
      dragging = false;
      delete reel.dataset.dragging;
      swallowClick = true;
      window.setTimeout(() => (swallowClick = false), 0);
      target = Math.round(position + clamp(velocity * 0.18, -2, 2));
      handOver();
      wake();
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);
    track.addEventListener(
      'click',
      (event) => {
        if (!swallowClick) return;
        swallowClick = false;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    // A sideways wheel or trackpad swipe turns it too, settling on a card when it stops.
    let wheelTimer = 0;
    track.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
        event.preventDefault();
        const pitch = big * (1 + smallScale) / 2 + gap;
        target = position = position + event.deltaX / pitch;
        anchorTarget = view / 2;
        render();
        handOver();
        window.clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => {
          target = Math.round(position);
          wake();
        }, 140);
      },
      { passive: false },
    );

    new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? false;
        if (visible && !revealed && current >= 0) {
          revealed = true;
          showCaption(items[current]!);
        }
        syncMedia();
        if (visible) scheduleTurn();
        else window.clearTimeout(turnTimer);
      },
      { threshold: 0.6 },
    ).observe(track);

    const refresh = () => {
      syncMedia();
      if (!document.hidden) scheduleTurn();
    };
    document.addEventListener('visibilitychange', refresh);
    reducedMotion.addEventListener('change', refresh);
    new ResizeObserver(measure).observe(track);

    reel.dataset.reelReady = '';
    measure();
  }
</script>

<style>
  .other-showcase {
    --reel-frame: var(--page-frame);

    display: block;
    width: 100%;
    /* The room the caption keeps under the cards counts toward the pause. */
    padding: 0 0 calc(var(--section-gap) - 1.2rem);
  }

  .other-showcase__title {
    display: flex;
    width: min(calc(100% - 2 * var(--page-gutter)), var(--reel-frame));
    align-items: baseline;
    column-gap: 0.22em;
    margin: 0 auto clamp(1.25rem, 2vw, 2rem);
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  /* Square cards. The one in front is as wide as the oddities' card above, and the
     others wait at seven tenths of it, so they still read as things, not thumbnails. */
  .reel {
    --card-big: var(--side-card);
    --reel-gap: clamp(0.75rem, 1.6vw, 1.5rem);

    position: relative;
    width: min(calc(100% - 2 * var(--page-gutter)), var(--reel-frame));
    margin-inline: auto;
  }

  /* Without the script: a plain row of small cards that scrolls sideways in the frame. */
  .reel__track {
    display: flex;
    gap: var(--reel-gap);
    margin: 0;
    padding: 0.5rem 0 1rem;
    overflow-x: auto;
    list-style: none;
  }

  .reel__item {
    flex: none;
    width: calc(var(--card-big) * 0.6);
  }

  /* With it: the row keeps to the text column, like the title above it, and dissolves
     over its last stretch at each end instead of stopping at a hard edge. */
