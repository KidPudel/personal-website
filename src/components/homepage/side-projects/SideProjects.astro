---
import { Image } from 'astro:assets';
import '@fontsource/instrument-serif/400.css';

import discoursesPoster from '../../../assets/games/discourses/discourses-poster.webp';
import discoursesVideo from '../../../assets/games/discourses/discourses-teaser.mp4';
import snakePoster from '../../../assets/games/snake/poster.jpg';
import snakeVideo from '../../../assets/games/snake/snake-raylib-silent.mp4';
import bunPoster from '../../../assets/games/thelastofbuns/showcase-poster.webp';
import bunVideo from '../../../assets/games/thelastofbuns/showcase.mp4';
import ticTacToeImage from '../../../assets/games/tic-tac-toe/gameplay.png';
import FarmField from './FarmField.astro';
import SideProjectCaption from './SideProjectCaption.astro';
import SantaFlight from './SantaFlight.astro';
import WeightedSwitchExperiment from './WeightedSwitchExperiment.astro';
import { toLocale, translator } from '../../../i18n/locales';

const t = translator(toLocale(Astro.currentLocale));
const videoFallback = t('Your browser does not support embedded video.', 'Браузер не поддерживает встроенное видео.');
const cards = {
  santa: {
    name: 'Secret Santa Foundation',
    href: 'https://itch.io/jam/secret-santa-2025/rate/4137573',
  },
  discourses: {
    name: 'Discourses by Campfire',
    href: 'https://kidpudel.itch.io/discourses-by-campfire',
  },
  buns: {
    name: 'The Last of Buns',
    href: 'https://github.com/KidPudel/The-Last-Of-Buns',
  },
  snake: {
    name: t('Snake with Go and raylib', 'Змейка на Go и raylib'),
    href: 'https://x.com/kidpudel/status/1781656147990020293?s=20',
  },
  ticTacToe: {
    name: t('Tic-Tac-Toe with C++ and OpenGL', 'Крестики-нолики на C++ и OpenGL'),
    href: 'https://github.com/KidPudel/TicTacToe',
  },
  switch: {
    name: t('Switch experiment', 'Эксперимент с переключателем'),
    href: 'https://x.com/kidpudel/status/2089804412319358998',
  },
  farm: {
    name: t('Farming Game', 'Фермерская игра'),
    href: 'https://kidpudel.itch.io/farming-game',
  },
} as const;
---

<section id="side-projects" class="other-showcase" aria-labelledby="other-showcase-title">
  <h2 id="other-showcase-title" class="other-showcase__title">
    {t('more things i’ve made', 'что ещё я сделал').split(' ').map((word, index) => (
      <>{index > 0 && ' '}<span>{word}</span></>
    ))}
  </h2>

  <div class="other-showcase__grid">
    <article class="other-showcase__item other-showcase__item--santa">
      <div class="other-showcase__card other-showcase__card--santa">
        <SantaFlight />
      </div>
      <SideProjectCaption name={cards.santa.name} href={cards.santa.href} />
    </article>

    <article class="other-showcase__item other-showcase__item--discourses">
      <div class="other-showcase__card other-showcase__card--discourses">
        <div class="project-preview">
          <video
            src={discoursesVideo}
            poster={discoursesPoster.src}
            width="960"
            height="540"
            preload="none"
            playsinline
            muted
            loop
          >
            {videoFallback}
          </video>
        </div>
      </div>
      <SideProjectCaption name={cards.discourses.name} href={cards.discourses.href} />
    </article>

    <article class="other-showcase__item other-showcase__item--tic-tac-toe">
      <div class="other-showcase__card other-showcase__card--tic-tac-toe">
        <div class="other-showcase__tic-tac-toe">
          <Image
            src={ticTacToeImage}
            alt={t('Tic-Tac-Toe game board', 'Игровое поле крестиков-ноликов')}
            widths={[360, 560, 687]}
            sizes="(max-width: 44rem) 72vw, 23vw"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={82}
          />
        </div>
      </div>
      <SideProjectCaption name={cards.ticTacToe.name} href={cards.ticTacToe.href} />
    </article>

    <article class="other-showcase__item other-showcase__item--buns">
      <div class="other-showcase__card other-showcase__card--buns">
        <div class="project-preview">
          <video
            src={bunVideo}
            poster={bunPoster.src}
            width="800"
            height="450"
            preload="none"
            playsinline
            muted
            loop
          >
            {videoFallback}
          </video>
        </div>
      </div>
      <SideProjectCaption name={cards.buns.name} href={cards.buns.href} />
    </article>

    <article class="other-showcase__item other-showcase__item--snake">
      <div class="other-showcase__card other-showcase__card--snake">
        <div class="project-preview">
          <video
            src={snakeVideo}
            poster={snakePoster.src}
            width="1150"
            height="720"
            preload="none"
            playsinline
            muted
            loop
          >
            {videoFallback}
          </video>
        </div>
      </div>
      <SideProjectCaption name={cards.snake.name} href={cards.snake.href} />
    </article>

    <article class="other-showcase__item other-showcase__item--switch">
      <div class="other-showcase__card other-showcase__card--switch">
        <WeightedSwitchExperiment />
      </div>
      <SideProjectCaption name={cards.switch.name} href={cards.switch.href} />
    </article>

    <article class="other-showcase__item other-showcase__item--farm">
      <div class="other-showcase__card other-showcase__card--farm">
        <FarmField />
      </div>
      <SideProjectCaption name={cards.farm.name} href={cards.farm.href} />
    </article>
  </div>
</section>

<script>
  // These previews own playback and loading; a separate video.load() can cancel play().
  const previewVideos = document.querySelectorAll<HTMLVideoElement>('.project-preview video');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (
    navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
  ).connection;
  const conserveData = Boolean(
    connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? ''),
  );
  const visibleVideos = new Set<HTMLVideoElement>();

  const play = (video: HTMLVideoElement) => {
    if (reducedMotion.matches || conserveData || document.hidden) return;
    void video.play().catch(() => undefined);
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) {
        visibleVideos.add(video);
        play(video);
      } else {
        visibleVideos.delete(video);
        video.pause();
      }
    });
  });

  previewVideos.forEach((video) => observer.observe(video));

  const syncPlayback = () => {
    previewVideos.forEach((video) => video.pause());
    if (!reducedMotion.matches && !document.hidden) visibleVideos.forEach(play);
  };

  reducedMotion.addEventListener('change', syncPlayback);
  document.addEventListener('visibilitychange', syncPlayback);
</script>

<style>
  .other-showcase {
    display: block;
    width: 100%;
    padding: 0 0 clamp(8rem, 13vw, 12rem);
  }

  .other-showcase__title,
  .other-showcase__grid {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--page-frame));
    margin-inline: auto;
  }

  .other-showcase__title {
    display: flex;
    align-items: baseline;
    column-gap: 0.22em;
    margin-top: 0;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  .other-showcase__grid {
    display: grid;
    grid-template-areas:
      'santa snake'
      'discourses switch'
      'farm farm'
      'buns tic';
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1rem, 3vw, 3.75rem);
  }

  .other-showcase__item {
    min-width: 0;
  }

  .other-showcase__card {
    position: relative;
    min-width: 0;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: clamp(0.8rem, 1.4vw, 1.35rem);
    background: #111;
    box-shadow: 0 1px 0 rgb(17 17 15 / 0.06), 0 1.25rem 3.5rem rgb(17 17 15 / 0.09);
  }

  .other-showcase__card::after {
    position: absolute;
    z-index: 7;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .other-showcase__item--santa {
    grid-area: santa;
  }

  .other-showcase__item--discourses {
    grid-area: discourses;
  }

  .other-showcase__item--tic-tac-toe {
    grid-area: tic;
  }

  .other-showcase__card--tic-tac-toe {
    background: #dedbd4;
  }

  .other-showcase__item--buns {
    grid-area: buns;
  }

  .other-showcase__item--snake {
    grid-area: snake;
  }

  .other-showcase__item--switch {
    grid-area: switch;
  }

  .other-showcase__card--switch {
    background: #fff;
  }

  .other-showcase__item--farm {
    grid-area: farm;
  }

  .other-showcase__card--farm {
    aspect-ratio: 16 / 9;
    background: #425d5f;
  }

  .other-showcase__card--santa,
  .other-showcase__card--discourses,
  .other-showcase__card--buns {
    aspect-ratio: 2 / 1;
  }

  .project-preview,
  .other-showcase__tic-tac-toe {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .project-preview video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .other-showcase__tic-tac-toe :global(img) {
    display: block;
    width: 78%;
    height: auto;
    max-height: 84%;
    object-fit: contain;
    filter: drop-shadow(0 0.75rem 1.2rem rgb(17 17 15 / 0.14));
    transform: rotate(-1.4deg);
  }

  @media (max-width: 60rem) {
    .other-showcase {
      padding-bottom: clamp(7rem, 24vw, 9rem);
    }

    .other-showcase__title,
    .other-showcase__grid {
      width: min(calc(100% - 2 * var(--page-gutter)), 44rem);
    }

    .other-showcase__grid {
      grid-template-areas:
        'santa'
        'discourses'
        'snake'
        'switch'
        'farm'
        'buns'
        'tic';
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .other-showcase__card--santa,
    .other-showcase__card--discourses,
    .other-showcase__card--buns {
      aspect-ratio: 2 / 1;
    }

    /* One column: the square Snake and Tic-Tac-Toe panels would each take
       most of a phone screen. Snake's recording is 16:10, so nothing is lost. */
    .other-showcase__card--snake {
      aspect-ratio: 16 / 10;
    }

    .other-showcase__card--tic-tac-toe {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 44rem) {
    .other-showcase__title,
    .other-showcase__grid {
      width: min(calc(100% - 2 * var(--page-gutter)), 34rem);
    }
  }

</style>
