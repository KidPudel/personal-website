---
import { Image } from 'astro:assets';
import '@fontsource/instrument-serif/400.css';

import entranceIcon from '../../../assets/art/icons/Doodles_entrance.png';
import discoursesPoster from '../../../assets/games/discourses/discourses-poster.webp';
import discoursesVideo from '../../../assets/games/discourses/discourses-teaser.mp4';
import snakePoster from '../../../assets/games/snake/poster.jpg';
import snakeVideo from '../../../assets/games/snake/snake-raylib-silent.mp4';
import bunPoster from '../../../assets/games/thelastofbuns/showcase-poster.webp';
import bunVideo from '../../../assets/games/thelastofbuns/showcase.mp4';
import ticTacToeImage from '../../../assets/games/tic-tac-toe/gameplay.png';
import FarmField from './FarmField.astro';
import SantaFlight from './SantaFlight.astro';
import WeightedSwitchExperiment from './WeightedSwitchExperiment.astro';
import { toLocale, translator } from '../../../i18n/locales';

const t = translator(toLocale(Astro.currentLocale));
const videoFallback = t('Your browser does not support embedded video.', 'Браузер не поддерживает встроенное видео.');
const openLabel = (name: string) => t(`Open ${name}`, `Открыть «${name}»`);
const cards = {
  santa: {
    name: 'Secret Santa Foundation',
    href: 'https://itch.io/jam/secret-santa-2025/rate/4137573',
  },
  discourses: {
    name: 'Discourses by Campfire',
    href: 'https://kidpudel.itch.io/discourses-by-campfire',
  },
  buns: {
    name: 'The Last of Buns',
    href: 'https://github.com/KidPudel/The-Last-Of-Buns',
  },
  snake: {
    name: t('Snake with Go and raylib', 'Змейка на Go и raylib'),
    href: 'https://x.com/kidpudel/status/1781656147990020293?s=20',
  },
  ticTacToe: {
    name: t('Tic-Tac-Toe with C++ and OpenGL', 'Крестики-нолики на C++ и OpenGL'),
    href: 'https://github.com/KidPudel/TicTacToe',
  },
  switch: {
    name: t('X experiment', 'Эксперимент с переключателем'),
    href: 'https://x.com/kidpudel/status/2089804412319358998',
  },
  farm: {
    name: t('Farming Game', 'Фермерская игра'),
    href: 'https://kidpudel.itch.io/farming-game',
  },
} as const;
---

<section id="side-projects" class="other-showcase" aria-labelledby="other-showcase-title">
  <h2 id="other-showcase-title" class="other-showcase__title">
    {t('more things i’ve made', 'что ещё я сделал').split(' ').map((word, index) => (
      <>{index > 0 && ' '}<span>{word}</span></>
    ))}
  </h2>

  <div class="other-showcase__grid">
    <article class="other-showcase__card other-showcase__card--santa">
      <SantaFlight />
      <a
        class="other-showcase__project-link"
        href={cards.santa.href}
        aria-label={openLabel(cards.santa.name)}
        title={openLabel(cards.santa.name)}
      >
        <Image
          class="other-showcase__project-link-icon"
          src={entranceIcon}
          alt=""
          widths={[160, 240, 320]}
          sizes="(max-width: 44rem) 7.3rem, 7.5rem"
          loading="lazy"
          decoding="async"
          format="png"
        />
      </a>
    </article>

    <article class="other-showcase__card other-showcase__card--discourses">
      <div class="project-preview">
        <video
          src={discoursesVideo}
          poster={discoursesPoster.src}
          width="960"
          height="540"
          preload="none"
          playsinline
          muted
          loop
        >
          {videoFallback}
        </video>
      </div>
      <a
        class="other-showcase__project-link"
        href={cards.discourses.href}
        aria-label={openLabel(cards.discourses.name)}
        title={openLabel(cards.discourses.name)}
      >
        <Image
          class="other-showcase__project-link-icon"
          src={entranceIcon}
          alt=""
          widths={[160, 240, 320]}
          sizes="(max-width: 44rem) 7.3rem, 7.5rem"
          loading="lazy"
          decoding="async"
          format="png"
        />
      </a>
    </article>

    <article class="other-showcase__card other-showcase__card--tic-tac-toe">
      <div class="other-showcase__tic-tac-toe">
        <Image
          src={ticTacToeImage}
          alt={t('Tic-Tac-Toe game board', 'Игровое поле крестиков-ноликов')}
          widths={[360, 560, 687]}
          sizes="(max-width: 44rem) 72vw, 23vw"
          loading="lazy"
          decoding="async"
          format="webp"
          quality={82}
        />
      </div>
      <a
        class="other-showcase__project-link"
        href={cards.ticTacToe.href}
        aria-label={openLabel(cards.ticTacToe.name)}
        title={openLabel(cards.ticTacToe.name)}
      >
        <Image
          class="other-showcase__project-link-icon"
          src={entranceIcon}
          alt=""
          widths={[160, 240, 320]}
          sizes="(max-width: 44rem) 7.3rem, 7.5rem"
          loading="lazy"
          decoding="async"
          format="png"
        />
      </a>
    </article>

    <article class="other-showcase__card other-showcase__card--buns">
      <div class="project-preview">
        <video
          src={bunVideo}
          poster={bunPoster.src}
          width="800"
          height="450"
          preload="none"
          playsinline
          muted
          loop
        >
          {videoFallback}
        </video>
      </div>
      <a
        class="other-showcase__project-link"
        href={cards.buns.href}
        aria-label={openLabel(cards.buns.name)}
        title={openLabel(cards.buns.name)}
      >
        <Image
          class="other-showcase__project-link-icon"
          src={entranceIcon}
          alt=""
          widths={[160, 240, 320]}
          sizes="(max-width: 44rem) 7.3rem, 7.5rem"
          loading="lazy"
          decoding="async"
          format="png"
        />
      </a>
    </article>

    <article class="other-showcase__card other-showcase__card--snake">
      <div class="project-preview">
        <video
          src={snakeVideo}
          poster={snakePoster.src}
          width="1150"
          height="720"
          preload="none"
          playsinline
          muted
          loop
        >
          {videoFallback}
        </video>
      </div>
      <a
        class="other-showcase__project-link"
        href={cards.snake.href}
        aria-label={openLabel(cards.snake.name)}
        title={openLabel(cards.snake.name)}
      >
        <Image
          class="other-showcase__project-link-icon"
          src={entranceIcon}
          alt=""
          widths={[160, 240, 320]}
          sizes="(max-width: 44rem) 7.3rem, 7.5rem"
          loading="lazy"
          decoding="async"
          format="png"
        />
      </a>
    </article>

    <article class="other-showcase__card other-showcase__card--switch">
      <WeightedSwitchExperiment />
      <a
        class="other-showcase__project-link"
        href={cards.switch.href}
        aria-label={openLabel(cards.switch.name)}
        title={openLabel(cards.switch.name)}
      >
        <Image
          class="other-showcase__project-link-icon"
          src={entranceIcon}
          alt=""
          widths={[160, 240, 320]}
          sizes="(max-width: 44rem) 7.3rem, 7.5rem"
          loading="lazy"
          decoding="async"
          format="png"
        />
      </a>
    </article>

    <article class="other-showcase__card other-showcase__card--farm">
      <FarmField />
      <a
        class="other-showcase__project-link"
        href={cards.farm.href}
        aria-label={openLabel(cards.farm.name)}
        title={openLabel(cards.farm.name)}
      >
        <Image
          class="other-showcase__project-link-icon"
          src={entranceIcon}
          alt=""
          widths={[160, 240, 320]}
          sizes="(max-width: 44rem) 7.3rem, 7.5rem"
          loading="lazy"
          decoding="async"
          format="png"
        />
      </a>
    </article>
  </div>
</section>

<script>
  // These previews own playback and loading; a separate video.load() can cancel play().
  const previewVideos = document.querySelectorAll<HTMLVideoElement>('.project-preview video');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (
    navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
  ).connection;
  const conserveData = Boolean(
    connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? ''),
  );
  const visibleVideos = new Set<HTMLVideoElement>();

  const play = (video: HTMLVideoElement) => {
    if (reducedMotion.matches || conserveData || document.hidden) return;
    void video.play().catch(() => undefined);
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) {
        visibleVideos.add(video);
        play(video);
      } else {
        visibleVideos.delete(video);
        video.pause();
      }
    });
  });

  previewVideos.forEach((video) => observer.observe(video));

  const syncPlayback = () => {
    previewVideos.forEach((video) => video.pause());
    if (!reducedMotion.matches && !document.hidden) visibleVideos.forEach(play);
  };

  reducedMotion.addEventListener('change', syncPlayback);
  document.addEventListener('visibilitychange', syncPlayback);
</script>

<style>
  .other-showcase {
    display: block;
    width: 100%;
    padding: 0 0 clamp(8rem, 13vw, 12rem);
  }

  .other-showcase__title,
  .other-showcase__grid {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--page-frame));
    margin-inline: auto;
  }

  .other-showcase__title {
    display: flex;
    align-items: baseline;
    column-gap: 0.22em;
    margin-top: 0;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  .other-showcase__grid {
    display: grid;
    grid-template-areas:
      'santa snake'
      'discourses switch'
      'farm farm'
      'buns tic';
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1rem, 3vw, 3.75rem);
  }

  .other-showcase__card {
    position: relative;
    min-width: 0;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: clamp(0.8rem, 1.4vw, 1.35rem);
    background: #111;
    box-shadow: 0 1px 0 rgb(17 17 15 / 0.06), 0 1.25rem 3.5rem rgb(17 17 15 / 0.09);
  }

  .other-showcase__card::after {
    position: absolute;
    z-index: 7;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .other-showcase__card--santa {
    grid-area: santa;
  }

  .other-showcase__card--discourses {
    grid-area: discourses;
  }

  .other-showcase__card--tic-tac-toe {
    grid-area: tic;
    background: #dedbd4;
  }

  .other-showcase__card--buns {
    grid-area: buns;
  }

  .other-showcase__card--snake {
    grid-area: snake;
  }

  .other-showcase__card--switch {
    grid-area: switch;
    background: #fff;
  }

  .other-showcase__card--farm {
    grid-area: farm;
    aspect-ratio: 16 / 9;
    background: #425d5f;
  }

  .other-showcase__card--santa,
  .other-showcase__card--discourses,
  .other-showcase__card--buns {
    aspect-ratio: 2 / 1;
  }

  .project-preview,
  .other-showcase__tic-tac-toe {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .project-preview video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .other-showcase__tic-tac-toe :global(img) {
    display: block;
    width: 78%;
    height: auto;
    max-height: 84%;
    object-fit: contain;
    filter: drop-shadow(0 0.75rem 1.2rem rgb(17 17 15 / 0.14));
    transform: rotate(-1.4deg);
  }

  /* Open button: a glass disc set clear of the card's corner curve, with the
     hand-drawn arrow at full strength and optically centered. */
  .other-showcase__project-link {
    position: absolute;
    z-index: 6;
    top: clamp(0.9rem, 1.7vw, 1.4rem);
    right: clamp(0.9rem, 1.7vw, 1.4rem);
    display: grid;
    width: clamp(2.5rem, 3.1vw, 2.9rem);
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 999px;
    /* More opaque than the work cards: most previews here are dark. */
    background: rgb(255 255 255 / 0.86);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 0 0 0.5px rgb(17 17 15 / 0.08),
      0 0.35rem 1rem rgb(17 17 15 / 0.12),
      0 1px 2px rgb(17 17 15 / 0.06);
    color: inherit;
    text-decoration: none;
    transition:
      transform 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
    -webkit-backdrop-filter: blur(12px) saturate(1.6);
    backdrop-filter: blur(12px) saturate(1.6);
    -webkit-tap-highlight-color: transparent;
  }

  .other-showcase__project-link:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: 0.2rem;
  }

  .other-showcase__project-link :global(.other-showcase__project-link-icon) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0.3px 0 0 #11110f);
    transform: translate(0.8%, -4.9%) scale(2.05);
    transition: transform 220ms var(--ease-out);
  }

  .other-showcase__project-link:active {
    transform: scale(0.94);
  }

  @media (hover: hover) and (pointer: fine) {
    .other-showcase__project-link:hover {
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.9),
        0 0 0 0.5px rgb(17 17 15 / 0.1),
        0 0.55rem 1.4rem rgb(17 17 15 / 0.16),
        0 1px 2px rgb(17 17 15 / 0.06);
      transform: scale(1.05);
    }

    .other-showcase__project-link:hover :global(.other-showcase__project-link-icon) {
      transform: translate(5%, -9%) scale(2.05);
    }
  }

  @media (max-width: 60rem) {
    .other-showcase {
      padding-bottom: clamp(7rem, 24vw, 9rem);
    }

    .other-showcase__title,
    .other-showcase__grid {
      width: min(calc(100% - 2 * var(--page-gutter)), 44rem);
    }

    .other-showcase__grid {
      grid-template-areas:
        'santa'
        'discourses'
        'snake'
        'switch'
        'farm'
        'buns'
        'tic';
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .other-showcase__card--santa,
    .other-showcase__card--discourses,
    .other-showcase__card--buns {
      aspect-ratio: 2 / 1;
    }
  }

  @media (max-width: 44rem) {
    .other-showcase__title,
    .other-showcase__grid {
      width: min(calc(100% - 2 * var(--page-gutter)), 34rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .other-showcase__project-link,
    .other-showcase__project-link :global(.other-showcase__project-link-icon) {
      transition-duration: 0ms;
    }
  }
</style>
