---
import { Image } from 'astro:assets';

import city from '../../../assets/games/santa/city.png';
import mountains from '../../../assets/games/santa/mountains.png';
import sky from '../../../assets/games/santa/sky-texture.png';
import sleigh from '../../../assets/games/santa/sleigh-with-elf.png';
import snowflake from '../../../assets/games/santa/snowflake.png';
---

<santa-flight class="santa-flight" data-visible="true">
  <button
    class="santa-flight__scene"
    type="button"
    aria-label="Fly Santa's sleigh. Hold to rise and release to fall."
  >
    <Image
      class="santa-flight__layer santa-flight__sky"
      src={sky}
      alt=""
      widths={[320, 640, 960]}
      sizes="(max-width: 44rem) calc(100vw - 2.3rem), 57vw"
      loading="lazy"
      decoding="async"
      format="png"
    />
    <Image
      class="santa-flight__layer santa-flight__mountains"
      src={mountains}
      alt=""
      widths={[320, 640, 960]}
      sizes="(max-width: 44rem) calc(100vw - 2.3rem), 57vw"
      loading="lazy"
      decoding="async"
      format="png"
    />
    <Image
      class="santa-flight__layer santa-flight__city"
      src={city}
      alt=""
      widths={[320, 640, 960]}
      sizes="(max-width: 44rem) calc(100vw - 2.3rem), 57vw"
      loading="lazy"
      decoding="async"
      format="png"
    />

    <span class="santa-flight__snow" aria-hidden="true">
      {[0, 1, 2, 3, 4, 5, 6].map((index) => (
        <Image
          class={`santa-flight__flake santa-flight__flake--${index + 1}`}
          src={snowflake}
          alt=""
          width={15}
          height={15}
          loading="lazy"
          decoding="async"
          format="png"
        />
      ))}
    </span>

    <span class="santa-flight__sleigh-path" data-sleigh-path aria-hidden="true">
      <Image
        class="santa-flight__sleigh"
        src={sleigh}
        alt=""
        widths={[128, 256, 384]}
        sizes="(max-width: 44rem) 9rem, 13vw"
        loading="lazy"
        decoding="async"
        format="png"
      />
    </span>

  </button>
</santa-flight>

<script>
  import './santa-flight';
</script>

<style>
  .santa-flight {
    display: block;
  }

  .santa-flight__scene {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: inherit;
    background: #14152f;
    color: #fff;
    cursor: grab;
    isolation: isolate;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .santa-flight__scene:active {
    cursor: grabbing;
  }

  .santa-flight__scene:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: -0.35rem;
  }

  :global(.santa-flight__layer) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    object-fit: cover;
    pointer-events: none;
  }

  :global(.santa-flight__sky) {
    z-index: 0;
  }

  :global(.santa-flight__mountains) {
    z-index: 1;
  }

  :global(.santa-flight__city) {
    z-index: 3;
  }

  .santa-flight__snow {
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
  }

  :global(.santa-flight__flake) {
    position: absolute;
    top: -8%;
    display: block;
    width: clamp(0.28rem, 0.65vw, 0.5rem);
    height: auto;
    opacity: 0.72;
    image-rendering: pixelated;
    animation: snow-fall 5.8s linear infinite;
  }

  :global(.santa-flight__flake--1) { left: 8%; animation-delay: -2.1s; animation-duration: 5.2s; }
  :global(.santa-flight__flake--2) { left: 22%; animation-delay: -4.4s; animation-duration: 6.4s; }
  :global(.santa-flight__flake--3) { left: 39%; animation-delay: -1.3s; animation-duration: 5.6s; }
  :global(.santa-flight__flake--4) { left: 54%; animation-delay: -3.7s; animation-duration: 6.9s; }
  :global(.santa-flight__flake--5) { left: 68%; animation-delay: -0.8s; animation-duration: 5.9s; }
  :global(.santa-flight__flake--6) { left: 81%; animation-delay: -4.9s; animation-duration: 6.2s; }
  :global(.santa-flight__flake--7) { left: 93%; animation-delay: -2.8s; animation-duration: 5.4s; }

  .santa-flight__sleigh-path {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: 34%;
    width: clamp(4rem, 9vw, 6.5rem);
    overflow: hidden;
    transform: translate3d(-50%, -50%, 0);
    animation: sleigh-idle 2.6s var(--ease-in-out) infinite alternate;
    will-change: transform;
  }

  :global(.santa-flight__sleigh) {
    display: block;
    width: 200%;
    max-width: none;
    height: auto;
    image-rendering: pixelated;
    pointer-events: none;
    animation: sleigh-sprite 400ms steps(2, end) infinite;
    will-change: transform;
  }

  .santa-flight[data-engaged] .santa-flight__sleigh-path {
    animation: none;
  }

  .santa-flight[data-visible='false'] :global(.santa-flight__flake),
  .santa-flight[data-visible='false'] :global(.santa-flight__sleigh),
  .santa-flight[data-visible='false'] .santa-flight__sleigh-path {
    animation-play-state: paused;
  }

  @keyframes snow-fall {
    from { transform: translate3d(0, -10%, 0); }
    to { transform: translate3d(150%, 1200%, 0); }
  }

  @keyframes sleigh-idle {
    from { transform: translate3d(-50%, calc(-50% - 42%), 0); }
    to { transform: translate3d(-50%, calc(-50% + 42%), 0); }
  }

  @keyframes sleigh-sprite {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-100%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.santa-flight__flake),
    :global(.santa-flight__sleigh),
    .santa-flight__sleigh-path {
      animation: none;
    }

    :global(.santa-flight__flake) {
      top: var(--flake-rest, 25%);
    }

    :global(.santa-flight__flake--2),
    :global(.santa-flight__flake--5) { --flake-rest: 52%; }

    :global(.santa-flight__flake--3),
    :global(.santa-flight__flake--7) { --flake-rest: 72%; }

  }
</style>
