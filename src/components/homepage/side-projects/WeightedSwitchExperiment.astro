---
import { toLocale, translator } from '../../../i18n/locales';

interface Props {
  /** Flips itself every few seconds and takes no input, for a preview inside a link. */
  ambient?: boolean;
}

const { ambient = false } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
const Control = ambient ? 'span' : 'button';
const controlAttributes = ambient
  ? {}
  : {
      type: 'button' as const,
      role: 'switch' as const,
      'aria-label': t('Weighted switch experiment', 'Эксперимент с «тяжёлым» переключателем'),
    };
---

<weighted-switch
  class="weighted-switch"
  data-ambient={ambient ? '' : undefined}
  aria-hidden={ambient ? 'true' : undefined}
>
  <Control class="weighted-switch__control" aria-checked="true" {...controlAttributes}>
    <span class="weighted-switch__fill" aria-hidden="true"></span>
    <span class="weighted-switch__thumb" aria-hidden="true"></span>
  </Control>
</weighted-switch>

<script>
  import './weighted-switch';
</script>

<style>
  .weighted-switch[data-ambient] .weighted-switch__control {
    cursor: inherit;
    pointer-events: none;
  }

  .weighted-switch {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: clamp(1rem, 2.5vw, 2rem);
    background: #fff;
  }

  .weighted-switch__control {
    --switch-height: clamp(3.25rem, 5vw, 5rem);
    --switch-width: calc(var(--switch-height) * 2.2);
    --switch-pad: calc(var(--switch-height) * 0.075);
    --thumb-ratio: 0.63;

    position: relative;
    width: var(--switch-width);
    height: var(--switch-height);
    flex: 0 0 auto;
    padding: var(--switch-pad);
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: #e8e8ed;
    box-shadow: 0 0.65rem 1.75rem rgb(0 0 0 / 0.08), 0 0.12rem 0.4rem rgb(0 0 0 / 0.05);
    cursor: pointer;
    isolation: isolate;
    touch-action: manipulation;
  }

  .weighted-switch__control:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: 0.35rem;
  }

  .weighted-switch__fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #007aff;
    filter: blur(0);
    pointer-events: none;
    transform: translate3d(-100%, 0, 0);
  }

  .weighted-switch__thumb {
    position: relative;
    z-index: 1;
    display: block;
    width: calc(var(--thumb-ratio) * 100%);
    height: 100%;
    border-radius: 999px;
    background: #fff;
    backface-visibility: hidden;
    box-shadow: 0 0.1rem 0.32rem rgb(0 0 0 / 0.16);
    pointer-events: none;
    transform: translateX(0);
    transform-origin: left center;
  }

</style>
