---
interface Props {
  name: string;
  href: string;
}

const { name, href } = Astro.props;
// Where the link leads, so a visitor knows before leaving the site.
const host = new URL(href).hostname;
const destination = host.endsWith('itch.io') ? 'itch.io' : host === 'github.com' ? 'GitHub' : host === 'x.com' ? 'X' : host;
---

<a class="side-project-caption" href={href}>
  <span class="side-project-caption__name"><span class="link-mark">{name}</span></span>
  <span class="side-project-caption__destination">{destination}</span>
</a>

<style>
  /* Same caption as the work above: one face and size, set apart by color. */
  .side-project-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    /* Tall enough for a fingertip without moving the words. */
    min-height: 2.75rem;
    padding-top: clamp(0.8rem, 1.1vw, 1rem);
    color: var(--color-muted);
    font-family: var(--font-reading);
    font-size: clamp(0.95rem, 0.15vw + 0.9rem, 1.02rem);
    letter-spacing: 0.015em;
    line-height: 1.4;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .side-project-caption__name {
    min-width: 0;
    color: var(--color-ink);
  }

  .side-project-caption__destination {
    flex: none;
  }

  .side-project-caption:focus-visible {
    border-radius: 0.2rem;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /* Touch screens can't hover, so the name keeps a faint mark there. */
  @media (hover: none) {
    .side-project-caption .link-mark {
      background-image: var(--link-mark-rest);
    }
  }
</style>
