---
import { getImage } from 'astro:assets';
import frame1 from '../../assets/art/Doodles-baloon-fly/baloon_frame1.png';
import frame2 from '../../assets/art/Doodles-baloon-fly/baloon_frame2.png';
import frame3 from '../../assets/art/Doodles-baloon-fly/baloon_frame3.png';
import frame4 from '../../assets/art/Doodles-baloon-fly/baloon_frame4.png';
import frame5 from '../../assets/art/Doodles-baloon-fly/baloon_frame5.png';
import frame6 from '../../assets/art/Doodles-baloon-fly/baloon_frame6.png';
import frame7 from '../../assets/art/Doodles-baloon-fly/baloon_frame7.png';
import { toLocale, translator } from '../../i18n/locales';

const t = translator(toLocale(Astro.currentLocale));
const returnLabel = t('Return to the introduction', 'Вернуться к началу');
const returningLabel = t('Returning to the introduction', 'Возвращаемся к началу');

const frames = [frame1, frame2, frame3, frame4, frame5, frame6, frame7];
const optimizedFrames = await Promise.all(
  frames.map((frame) => getImage({ src: frame, width: 512, format: 'webp', quality: 'max' })),
);
---

<balloon-return class="balloon-return">
  <a
    class="balloon-return__trigger"
    href="#intro"
    aria-label={returnLabel}
    data-return-label={returnLabel}
    data-returning-label={returningLabel}
  >
    <span class="balloon-return__art" aria-hidden="true">
      {optimizedFrames.map((frame, index) => (
        <img
          class="balloon-return__frame"
          src={index === 0 ? frame.src : undefined}
          data-src={frame.src}
          alt=""
          width="512"
          height="512"
          loading="lazy"
          decoding="async"
          hidden={index !== 0}
          data-balloon-frame
          data-active={index === 0 ? '' : undefined}
        />
      ))}
    </span>
  </a>
</balloon-return>

<script>
  import { panFor, play } from '@foleyjs/core';
  import { balloonReturnMotion } from './balloon-return-motion';

  class BalloonReturn extends HTMLElement {
    private abort?: AbortController;
    private sequenceAbort?: AbortController;
    private lastFrameIndex = -1;

    connectedCallback() {
      if (this.dataset.enhanced) return;

      const trigger = this.querySelector<HTMLAnchorElement>('.balloon-return__trigger');
      const opening = document.querySelector<HTMLElement>('opening-sequence');
      const intro = document.getElementById('intro');
      const frames = Array.from(this.querySelectorAll<HTMLImageElement>('[data-balloon-frame]'));
      if (!trigger || !opening || !intro || frames.length !== 7) return;

      this.dataset.enhanced = '';
      this.abort = new AbortController();
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const primedFrames = new Set<number>([0]);

      const frameSource = (frame: HTMLImageElement) =>
        frame.dataset.src || frame.getAttribute('src') || '';

      const primeFrame = (index: number) => {
        const frame = frames[index];
        if (!frame || primedFrames.has(index)) return;

        const source = frameSource(frame);
        if (!source) return;
        frame.loading = 'eager';
        frame.src = source;
        primedFrames.add(index);
        void frame.decode().catch(() => undefined);
      };

      let framesReady: Promise<void[]> | undefined;
      const prepareSequenceFrames = () => {
        if (framesReady) return framesReady;

        frames.forEach((_, index) => primeFrame(index));
        framesReady = Promise.all(
          frames.map((frame) => frame.decode().catch(() => undefined)),
        );
        return framesReady;
      };

      const syncFrame = (index: number) => {
        primeFrame(index);
        primeFrame(index - 1);
        primeFrame(index + 1);
        if (index === this.lastFrameIndex) return;

        this.lastFrameIndex = index;
        frames.forEach((frame, frameIndex) => {
          const active = frameIndex === index;
          frame.toggleAttribute('data-active', active);
          frame.hidden = !active;
        });
      };

      const introScrollY = () => {
        return Math.max(0, window.scrollY + intro.getBoundingClientRect().top);
      };

      const wait = (duration: number, signal: AbortSignal) =>
        new Promise<void>((resolve, reject) => {
          const timer = window.setTimeout(resolve, duration);
          signal.addEventListener('abort', () => {
            window.clearTimeout(timer);
            reject(signal.reason);
          }, { once: true });
        });

      const playArrival = async (signal: AbortSignal) => {
        for (const index of [2, 3, 4]) {
          syncFrame(index);
          if (index === 3) play('drop', { pan: panFor(trigger) });
          await wait(balloonReturnMotion.frameDurationMs, signal);
        }
      };

      const riseWithScroll = (
        startScrollY: number,
        targetScrollY: number,
        signal: AbortSignal,
      ) => new Promise<number>((resolve, reject) => {
        const startedAt = performance.now();
        const scrollDistance = Math.max(1, startScrollY - targetScrollY);
        // Rise from wherever it rested to the same place near the top of the
        // screen, so the pop always happens in view, around the introduction.
        const popTop = window.innerHeight * balloonReturnMotion.popTopVh / 100;
        const riseDistance = Math.max(0, this.getBoundingClientRect().top - popTop);
        let lastProgressAt = startedAt;
        let previousProgress = -1;

        const cancel = () => reject(signal.reason);
        signal.addEventListener('abort', cancel, { once: true });

        const render = (now: number) => {
          if (signal.aborted) return;

          const progress = Math.min(
            1,
            Math.max(0, (startScrollY - window.scrollY) / scrollDistance),
          );
          if (progress > previousProgress + 0.001) {
            previousProgress = progress;
            lastProgressAt = now;
          }

          const y = -riseDistance * progress;
          trigger.style.transform = `translate3d(0, ${y.toFixed(2)}px, 0)`;
          syncFrame(Math.floor((now - startedAt) / balloonReturnMotion.frameDurationMs) % 2);

          const arrived = Math.abs(window.scrollY - targetScrollY) <= 2;
          if (arrived) {
            signal.removeEventListener('abort', cancel);
            resolve(y);
            return;
          }

          if (now - lastProgressAt > 800) {
            signal.removeEventListener('abort', cancel);
            reject(new DOMException('The return scroll was interrupted.', 'AbortError'));
            return;
          }

          window.requestAnimationFrame(render);
        };

        window.requestAnimationFrame(render);
        window.scrollTo({ top: targetScrollY, behavior: 'smooth' });
      });

      const fall = async (startY: number, signal: AbortSignal) => {
        const bounds = trigger.getBoundingClientRect();
        const finalY = startY + window.innerHeight - bounds.top + balloonReturnMotion.fallPastViewportPx;
        const animation = trigger.animate(
          [
            { transform: `translate3d(0, ${startY.toFixed(2)}px, 0)` },
            { transform: `translate3d(0, ${finalY.toFixed(2)}px, 0)` },
          ],
          {
            duration: balloonReturnMotion.fallDurationMs,
            easing: 'cubic-bezier(0.77, 0, 0.175, 1)',
            fill: 'forwards',
          },
        );
        const startedAt = performance.now();
        let loopFrame = 0;

        const renderLoop = (now: number) => {
          if (signal.aborted || animation.playState === 'finished') return;
          syncFrame(5 + Math.floor((now - startedAt) / balloonReturnMotion.frameDurationMs) % 2);
          loopFrame = window.requestAnimationFrame(renderLoop);
        };
        loopFrame = window.requestAnimationFrame(renderLoop);

        const cancel = () => animation.cancel();
        signal.addEventListener('abort', cancel, { once: true });
        try {
          await animation.finished;
        } finally {
          signal.removeEventListener('abort', cancel);
          window.cancelAnimationFrame(loopFrame);
          animation.cancel();
        }
      };

      const reset = async () => {
        this.setAttribute('data-resetting', '');
        trigger.style.removeProperty('transform');
        syncFrame(0);
        await new Promise<void>((resolve) => window.requestAnimationFrame(() => resolve()));
      };

      // The balloon rests in the page. For the flight it lets go of the page
      // and holds its place on screen while the page scrolls away under it.
      const takeOff = () => {
        const rect = this.getBoundingClientRect();
        this.style.top = `${rect.top}px`;
        this.style.left = `${rect.left}px`;
        this.setAttribute('data-flying', '');
      };

      const land = () => {
        this.removeAttribute('data-flying');
        this.style.removeProperty('top');
        this.style.removeProperty('left');
      };

      const stopSequence = () => {
        if (!this.hasAttribute('data-running')) return;
        window.scrollTo({ top: window.scrollY, behavior: 'auto' });
        this.sequenceAbort?.abort(new DOMException('The return was interrupted.', 'AbortError'));
      };

      const runSequence = async () => {
        this.sequenceAbort?.abort();
        this.sequenceAbort = new AbortController();
        const { signal } = this.sequenceAbort;
        takeOff();
        this.setAttribute('data-running', '');
        trigger.setAttribute('aria-disabled', 'true');
        trigger.setAttribute('aria-label', trigger.dataset.returningLabel ?? '');

        const interrupt = () => stopSequence();
        window.addEventListener('wheel', interrupt, { passive: true, signal });
        window.addEventListener('touchstart', interrupt, { passive: true, signal });
        window.addEventListener('pointerdown', interrupt, { signal });
        window.addEventListener('keydown', interrupt, { signal });

        try {
          await prepareSequenceFrames();
          if (signal.aborted) throw signal.reason;

          const startScrollY = window.scrollY;
          const targetScrollY = introScrollY();
          const startY = startScrollY <= targetScrollY + 2
            ? 0
            : await riseWithScroll(startScrollY, targetScrollY, signal);
          await playArrival(signal);
          await fall(startY, signal);
          await reset();
        } catch {
          trigger.getAnimations().forEach((animation) => animation.cancel());
          trigger.style.removeProperty('transform');
          syncFrame(0);
        } finally {
          this.removeAttribute('data-running');
          trigger.removeAttribute('aria-disabled');
          trigger.setAttribute('aria-label', trigger.dataset.returnLabel ?? '');
          if (!signal.aborted) this.sequenceAbort?.abort();
          land();
          // Back at rest, out of view at the end of the page: let it show
          // again on the next frame without fading across the screen.
          window.requestAnimationFrame(() => this.removeAttribute('data-resetting'));
        }
      };

      // While he waits on screen, the balloon's thread wobbles: the two
      // hanging frames trade places at a slightly uneven, hand-drawn pace.
      let onScreen = false;
      let wobbleTimer = 0;
      let wobbleFrame = 0;
      const scheduleWobble = () => {
        window.clearTimeout(wobbleTimer);
        if (!onScreen || reducedMotion.matches) return;
        wobbleTimer = window.setTimeout(wobble, 180 + Math.random() * 80);
      };
      const wobble = () => {
        if (!document.hidden && !this.hasAttribute('data-running')) {
          wobbleFrame = wobbleFrame ? 0 : 1;
          syncFrame(wobbleFrame);
        }
        scheduleWobble();
      };
      const watcher = new IntersectionObserver(([entry]) => {
        onScreen = entry.isIntersecting;
        if (onScreen) primeFrame(1);
        scheduleWobble();
      });
      watcher.observe(this);
      this.abort.signal.addEventListener('abort', () => {
        watcher.disconnect();
        window.clearTimeout(wobbleTimer);
      });

      trigger.addEventListener('click', (event) => {
        if (this.hasAttribute('data-running')) {
          event.preventDefault();
          return;
        }

        event.preventDefault();
        const target = introScrollY();
        if (reducedMotion.matches || event.detail === 0) {
          window.scrollTo({ top: target, behavior: 'auto' });
          if (event.detail === 0) intro.focus({ preventScroll: true });
          syncFrame(2);
          window.setTimeout(() => syncFrame(0), balloonReturnMotion.frameDurationMs);
          return;
        }

        play('rise', { pan: panFor(trigger) });
        void runSequence();
      }, { signal: this.abort.signal });

      syncFrame(0);
    }

    disconnectedCallback() {
      this.sequenceAbort?.abort();
      this.abort?.abort();
      delete this.dataset.enhanced;
    }
  }

  if (!customElements.get('balloon-return')) {
    customElements.define('balloon-return', BalloonReturn);
  }
</script>

<style>
  /* The balloon rests at the end of the page (it lives in the footer,
     ClosingContact.astro): on the page's right edge, level with the email
     and links, hovering just over the garden, whose flowers grow up to his
     feet and no further. Where the links fill the row, he waits above the
     email instead. */
  .balloon-return {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: calc(100% + clamp(0.4rem, 1.2vw, 1rem));
    display: block;
    width: clamp(5.4rem, 7.8vw, 7rem);
    aspect-ratio: 1;
  }

  @media (min-width: 60rem) {
    .balloon-return {
      bottom: 0.4rem;
    }
  }

  /* In flight it holds its place on screen (the script sets top and left
     where it rested) while the page scrolls back to the introduction. */
  .balloon-return[data-flying] {
    position: fixed;
    z-index: 70;
    right: auto;
    bottom: auto;
  }

  .balloon-return__trigger {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .balloon-return__art,
  .balloon-return__frame {
    display: block;
    width: 100%;
    height: 100%;
  }

  .balloon-return__art {
    position: relative;
  }

  .balloon-return__frame {
    position: absolute;
    inset: 0;
    max-width: none;
    object-fit: contain;
  }

  .balloon-return__frame:not([data-active]),
  .balloon-return__frame[hidden] {
    display: none;
  }

  /* While it waits, the balloon drifts: a slow bob, and a sway that swings
     the man under it from the balloon like a pendulum. The two run at
     different lengths, so together they never visibly repeat. They animate
     the art (`translate` and `rotate` compose), not the trigger, so the
     return flight keeps the trigger's transform to itself. */
  :global(.js) .balloon-return__art {
    transform-origin: 50% 14%;
  }

  :global(.js) .balloon-return:not([data-running]) .balloon-return__art {
    animation:
      balloon-bob 3.7s ease-in-out infinite alternate,
      balloon-sway 5.3s ease-in-out -1.9s infinite alternate;
  }

  @keyframes balloon-bob {
    from {
      translate: 0 0.15rem;
    }

    to {
      translate: 0 -0.35rem;
    }
  }

  @keyframes balloon-sway {
    from {
      rotate: -2.4deg;
    }

    to {
      rotate: 2.8deg;
    }
  }

  /* It answers the cursor: a little lift on hover, a squeeze on press. */
  .balloon-return__trigger {
    transition: transform 260ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .balloon-return:not([data-running]) .balloon-return__trigger:hover {
      transform: translate3d(0, -0.3rem, 0);
    }
  }

  .balloon-return:not([data-running]) .balloon-return__trigger:active {
    transform: translate3d(0, -0.2rem, 0) scale(0.96);
    transition-duration: 120ms;
  }

  /* In flight the script moves the trigger every frame; nothing eases it. */
  .balloon-return[data-running] .balloon-return__trigger {
    transition: none;
  }

  :global(.js) .balloon-return[data-running] {
    pointer-events: none;
  }

  :global(.js) .balloon-return[data-resetting] {
    opacity: 0;
  }

  .balloon-return__trigger:focus-visible {
    border-radius: 0.4rem;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  @media (max-width: 44rem) {
    .balloon-return {
      width: 5.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .balloon-return:not([data-running]) .balloon-return__art {
      animation: none;
    }

    .balloon-return__trigger,
    .balloon-return:not([data-running]) .balloon-return__trigger:hover,
    .balloon-return:not([data-running]) .balloon-return__trigger:active {
      transform: none;
      transition: none;
    }
  }
</style>
