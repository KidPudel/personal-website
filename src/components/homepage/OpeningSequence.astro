---
import frame1 from "../../assets/art/Doodles-box-opening/box_frame1.png";
import frame2 from "../../assets/art/Doodles-box-opening/box_frame2.png";
import frame3 from "../../assets/art/Doodles-box-opening/box_frame3.png";
import frame4 from "../../assets/art/Doodles-box-opening/box_frame4.png";
import frame5 from "../../assets/art/Doodles-box-opening/box_frame5.png";
import frame6 from "../../assets/art/Doodles-box-opening/box_frame6.png";
import frame7 from "../../assets/art/Doodles-box-opening/box_frame7.png";
import frame8 from "../../assets/art/Doodles-box-opening/box_frame8.png";

const frames = [frame1, frame2, frame3, frame4, frame5, frame6, frame7, frame8];
---

<opening-sequence class="opening-sequence" data-frame-count={frames.length}>
    <div class="opening-sequence__sticky">
        <div class="opening-sequence__reveal" data-opening-reveal>
            <slot />
        </div>

        <div class="opening-sequence__art" aria-hidden="true" data-opening-art>
            {
                frames.map((frame, index) => (
                    <img
                        class="opening-sequence__frame"
                        src={frame.src}
                        alt=""
                        width="2048"
                        height="2048"
                        loading="eager"
                        decoding="async"
                        data-opening-frame
                        data-active={index === 0 ? "" : undefined}
                    />
                ))
            }
        </div>

        <canvas
            class="opening-sequence__essence"
            aria-hidden="true"
            data-opening-essence
        ></canvas>

        <p class="opening-sequence__instruction" data-opening-instruction>
            Scroll to open <span aria-hidden="true">↓</span>
        </p>
        <a class="opening-sequence__skip" href="#values">Skip opening</a>
    </div>
</opening-sequence>

<script>
    class OpeningSequence extends HTMLElement {
        private frame = 0;
        private abort?: AbortController;

        connectedCallback() {
            if (this.dataset.enhanced) return;
            this.dataset.enhanced = "true";
            this.abort = new AbortController();

            const sticky = this.querySelector<HTMLElement>(
                ".opening-sequence__sticky",
            );
            const reveal = this.querySelector<HTMLElement>(
                "[data-opening-reveal]",
            );
            const art = this.querySelector<HTMLElement>("[data-opening-art]");
            const instruction = this.querySelector<HTMLElement>(
                "[data-opening-instruction]",
            );
            const essence = this.querySelector<HTMLCanvasElement>(
                "[data-opening-essence]",
            );
            const frames = Array.from(
                this.querySelectorAll<HTMLElement>("[data-opening-frame]"),
            );
            const page = this.closest<HTMLElement>(".portfolio-page");
            const header = page?.querySelector<HTMLElement>(".site-header");
            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            );

            if (
                !sticky ||
                !reveal ||
                !art ||
                !instruction ||
                !essence ||
                !frames.length ||
                !page ||
                !header
            )
                return;

            const essenceContext = essence.getContext("2d");
            if (!essenceContext) return;

            const clamp = (value: number) => Math.min(1, Math.max(0, value));
            const smooth = (value: number) => value * value * (3 - 2 * value);
            const openingColors = [
                "#4265ff",
                "#4265ff",
                "#ff49c2",
                "#ff49c2",
                "#ffd83d",
                "#ffd83d",
                "#39b9a7",
                "#39b9a7",
            ];
            const essencePalette = [
                { stop: 0, color: [26, 42, 122] },
                { stop: 0.08, color: [35, 77, 196] },
                { stop: 0.18, color: [43, 96, 235] },
                { stop: 0.28, color: [109, 157, 222] },
                { stop: 0.38, color: [235, 239, 247] },
                { stop: 0.49, color: [255, 230, 78] },
                { stop: 0.61, color: [255, 164, 38] },
                { stop: 0.72, color: [251, 92, 48] },
                { stop: 0.82, color: [244, 47, 104] },
                { stop: 0.91, color: [238, 28, 198] },
                { stop: 1, color: [207, 34, 237] },
            ];

            const paletteColor = (value: number) => {
                const position = clamp(value);
                const upperIndex = essencePalette.findIndex(
                    ({ stop }) => stop >= position,
                );

                if (upperIndex <= 0) return essencePalette[0].color;
                if (upperIndex < 0)
                    return essencePalette[essencePalette.length - 1].color;

                const lower = essencePalette[upperIndex - 1];
                const upper = essencePalette[upperIndex];
                const mix =
                    (position - lower.stop) / (upper.stop - lower.stop);

                return lower.color.map((channel, index) =>
                    Math.round(channel + (upper.color[index] - channel) * mix),
                );
            };

            const angularDistance = (first: number, second: number) =>
                Math.abs(
                    Math.atan2(
                        Math.sin(first - second),
                        Math.cos(first - second),
                    ),
                );

            const energyDirections = [
                { angle: -3.02, reach: 0.34, width: 0.1 },
                { angle: -2.72, reach: 0.66, width: 0.14 },
                { angle: -2.29, reach: 0.42, width: 0.12 },
                { angle: -1.91, reach: 0.76, width: 0.11 },
                { angle: -1.49, reach: 1, width: 0.1 },
                { angle: -1.08, reach: 0.48, width: 0.13 },
                { angle: -0.72, reach: 0.82, width: 0.11 },
                { angle: -0.3, reach: 0.5, width: 0.14 },
                { angle: 0.05, reach: 0.9, width: 0.1 },
                { angle: 0.45, reach: 0.42, width: 0.12 },
                { angle: 0.83, reach: 0.72, width: 0.11 },
                { angle: 1.29, reach: 0.56, width: 0.13 },
                { angle: 1.58, reach: 0.92, width: 0.1 },
                { angle: 2.02, reach: 0.5, width: 0.12 },
                { angle: 2.43, reach: 0.8, width: 0.11 },
                { angle: 2.88, reach: 0.58, width: 0.13 },
            ];

            const fieldSample = (x: number, y: number, growth: number) => {
                const dx = x - 0.5;
                const dy = y - (0.53 - growth * 0.015);
                const skewedX = dx + dy * 0.16;
                const viewportAspect = window.innerWidth / window.innerHeight;
                const seedVerticalRadius = Math.min(
                    0.48,
                    Math.max(0.12, (0.6 * viewportAspect) / 2.2),
                );
                const verticalRadius =
                    seedVerticalRadius +
                    (0.48 - seedVerticalRadius) *
                        smooth(clamp((growth - 0.18) / 0.82));
                const normalizedX = skewedX / 0.6;
                const normalizedY = dy / verticalRadius;
                const radial = Math.hypot(normalizedX, normalizedY);
                const angle = Math.atan2(normalizedY, normalizedX);
                const energy = smooth(clamp((growth - 0.12) / 0.74));
                const flowAngle =
                    angle +
                    energy *
                        (Math.sin(radial * 3.8 + 0.8) * 0.12 +
                            Math.sin(radial * 7.2 - 0.55) * 0.045);
                const flare = smooth(clamp((radial - 0.018) / 0.52));
                const contour =
                    1 +
                    Math.sin(flowAngle * 3 + 0.7) *
                        (0.022 + growth * 0.032) +
                    Math.cos(flowAngle * 5 - 0.45) *
                        (0.014 + growth * 0.022) +
                    Math.sin(flowAngle * 11 + radial * 3.1) * energy * 0.022;
                let directionalReach = 0;

                for (const direction of energyDirections) {
                    const distance = angularDistance(
                        flowAngle,
                        direction.angle,
                    );
                    const profile = 1 - smooth(clamp(distance / direction.width));

                    directionalReach += direction.reach * profile;
                }

                const reach =
                    1 +
                    energy * flare * directionalReach +
                    energy *
                        flare *
                        Math.sin(flowAngle * 8.5 + radial * 4.4) *
                        0.07;

                return {
                    distance: radial / Math.max(0.58, contour * reach),
                    flowAngle,
                    radial,
                };
            };

            const spectrumPosition = (
                band: number,
                flowAngle: number,
                radial: number,
                growth: number,
            ) => {
                const angularWave =
                    0.5 +
                    Math.sin(
                        flowAngle * 5.25 +
                            radial * 1.45 +
                            Math.sin(flowAngle * 9 - 0.4) * 0.24,
                    ) *
                        0.5;
                const angularSpectrum =
                    0.06 + Math.pow(angularWave, 0.62) * 0.94;
                const spectrumMix =
                    smooth(clamp((growth - 0.2) / 0.6)) *
                    smooth(clamp((radial - 0.01) / 0.24)) *
                    0.93;

                return clamp(
                    band + (angularSpectrum - band) * spectrumMix,
                );
            };

            const drawEssence = (progress: number) => {
                const targetWidth = Math.max(
                    64,
                    Math.min(144, Math.round(window.innerWidth / 12)),
                );
                const targetHeight = Math.max(
                    64,
                    Math.min(144, Math.round(window.innerHeight / 12)),
                );

                if (
                    essence.width !== targetWidth ||
                    essence.height !== targetHeight
                ) {
                    essence.width = targetWidth;
                    essence.height = targetHeight;
                }

                const growth = clamp((progress - 0.335) / 0.405);
                const reveal = smooth(clamp((progress - 0.7) / 0.19));
                const echoLife = clamp((progress - 0.77) / 0.2);
                const echoEnvelope = Math.sin(echoLife * Math.PI) * 0.2;
                const worldReaction =
                    Math.sin(
                        Math.PI * clamp((progress - 0.31) / 0.38),
                    ) *
                    (1 - smooth(clamp((progress - 0.62) / 0.13)));

                this.style.setProperty(
                    "--world-reaction",
                    String(Math.max(0, worldReaction)),
                );

                essence.toggleAttribute(
                    "data-visible",
                    growth > 0 && (reveal < 1 || echoEnvelope > 0.001),
                );
                essence.toggleAttribute("data-front", progress >= 0.61);

                if (growth <= 0 || (reveal >= 1 && echoEnvelope <= 0.001)) {
                    essenceContext.clearRect(
                        0,
                        0,
                        essence.width,
                        essence.height,
                    );
                    return;
                }

                const image = essenceContext.createImageData(
                    essence.width,
                    essence.height,
                );
                const overshoot =
                    Math.sin(
                        Math.PI * clamp((growth - 0.58) / 0.42),
                    ) * 0.065;
                const radius = 0.035 + (smooth(growth) + overshoot) * 1.48;
                const baseOpacity = 1 - reveal;

                for (let y = 0; y < essence.height; y += 1) {
                    for (let x = 0; x < essence.width; x += 1) {
                        const normalizedX = x / Math.max(1, essence.width - 1);
                        const normalizedY = y / Math.max(1, essence.height - 1);
                        const sample = fieldSample(
                            normalizedX,
                            normalizedY,
                            growth,
                        );
                        const band = sample.distance / radius;
                        const edge = 1 - smooth(clamp((band - 0.965) / 0.1));
                        const baseAlpha = edge * baseOpacity;
                        const echoWarp = echoLife * 0.065;
                        const echoSample = fieldSample(
                            normalizedX +
                                Math.sin(
                                    normalizedY * 11 + echoLife * 4.2,
                                ) *
                                    echoWarp,
                            normalizedY +
                                Math.sin(
                                    normalizedX * 9 - echoLife * 3.4,
                                ) *
                                    echoWarp *
                                    0.72,
                            1,
                        );
                        const echoBand =
                            echoSample.distance /
                            (radius * (0.9 + echoLife * 0.16));
                        const echoPhase =
                            echoSample.flowAngle * 5.25 +
                            echoSample.radial * 1.45 +
                            Math.sin(echoSample.flowAngle * 9 - 0.4) * 0.24;
                        const echoSpokes =
                            1 -
                            smooth(
                                clamp(
                                    Math.abs(Math.sin(echoPhase)) / 0.22,
                                ),
                            );
                        const echoSpan =
                            smooth(clamp((echoBand - 0.16) / 0.16)) *
                            (1 - smooth(clamp((echoBand - 0.82) / 0.14)));
                        const echoBreakup = smooth(
                            clamp(
                                (Math.sin(
                                    echoBand * 29 +
                                        Math.sin(echoSample.flowAngle * 4.5) *
                                            1.35 -
                                        echoLife * 8,
                                ) -
                                    0.04) /
                                    0.76,
                            ),
                        );
                        const echoAlpha =
                            echoSpokes *
                            echoSpan *
                            (0.3 + echoBreakup * 0.7) *
                            echoEnvelope;
                        const alpha = clamp(
                            baseAlpha + echoAlpha * (1 - baseAlpha),
                        );

                        if (alpha <= 0.002) continue;

                        const baseColor = paletteColor(
                            spectrumPosition(
                                band,
                                sample.flowAngle,
                                sample.radial,
                                growth,
                            ),
                        );
                        const echoColor = paletteColor(
                            spectrumPosition(
                                echoBand,
                                echoSample.flowAngle + echoLife * 0.38,
                                echoSample.radial,
                                1,
                            ),
                        );
                        const echoMix =
                            alpha > 0 ? echoAlpha / (baseAlpha + echoAlpha) : 0;
                        const pixelIndex = (y * essence.width + x) * 4;

                        image.data[pixelIndex] = Math.round(
                            baseColor[0] +
                                (echoColor[0] - baseColor[0]) * echoMix,
                        );
                        image.data[pixelIndex + 1] = Math.round(
                            baseColor[1] +
                                (echoColor[1] - baseColor[1]) * echoMix,
                        );
                        image.data[pixelIndex + 2] = Math.round(
                            baseColor[2] +
                                (echoColor[2] - baseColor[2]) * echoMix,
                        );
                        image.data[pixelIndex + 3] = Math.round(alpha * 255);
                    }
                }

                essenceContext.putImageData(image, 0, 0);
            };

            const render = () => {
                this.frame = 0;

                if (
                    reducedMotion.matches ||
                    window.location.hash === "#contact"
                ) {
                    this.style.setProperty("--reveal-opacity", "1");
                    this.style.setProperty("--art-opacity", "0");
                    this.style.setProperty("--instruction-opacity", "0");
                    this.style.setProperty("--hero-content-opacity", "1");
                    drawEssence(1);
                    page.style.setProperty("--header-visibility", "1");
                    header.inert = false;
                    header.removeAttribute("aria-hidden");
                    reveal.inert = false;
                    this.toggleAttribute("data-complete", true);
                    return;
                }

                const rect = this.getBoundingClientRect();
                const distance = Math.max(
                    1,
                    this.offsetHeight - window.innerHeight,
                );
                const progress = clamp(-rect.top / distance);
                const frameProgress = clamp(progress / 0.54);
                const frameIndex = Math.min(
                    frames.length - 1,
                    Math.floor(frameProgress * frames.length),
                );
                const revealProgress = smooth(clamp((progress - 0.68) / 0.17));
                const artOpacity = 1 - smooth(clamp((progress - 0.51) / 0.16));
                const instructionOpacity = 1 - smooth(clamp(progress / 0.16));
                const headerVisibility = smooth(
                    clamp((progress - 0.78) / 0.13),
                );
                const heroContentOpacity = 1;

                frames.forEach((frame, index) =>
                    frame.toggleAttribute("data-active", index === frameIndex),
                );
                this.style.setProperty(
                    "--opening-color",
                    openingColors[frameIndex] ?? openingColors[0],
                );
                this.style.setProperty(
                    "--reveal-opacity",
                    String(revealProgress),
                );
                this.style.setProperty("--art-opacity", String(artOpacity));
                this.style.setProperty(
                    "--instruction-opacity",
                    String(instructionOpacity),
                );
                this.style.setProperty(
                    "--hero-content-opacity",
                    String(heroContentOpacity),
                );
                drawEssence(progress);
                page.style.setProperty(
                    "--header-visibility",
                    String(headerVisibility),
                );
                header.inert = headerVisibility < 0.86;
                header.toggleAttribute("aria-hidden", headerVisibility < 0.86);
                reveal.inert = revealProgress < 0.9;
                this.toggleAttribute(
                    "data-complete",
                    progress >= 0.995,
                );
            };

            const requestRender = () => {
                if (this.frame) return;
                this.frame = window.requestAnimationFrame(render);
            };

            window.addEventListener("scroll", requestRender, {
                passive: true,
                signal: this.abort.signal,
            });
            window.addEventListener("resize", requestRender, {
                passive: true,
                signal: this.abort.signal,
            });
            window.addEventListener("hashchange", requestRender, {
                signal: this.abort.signal,
            });
            reducedMotion.addEventListener("change", requestRender, {
                signal: this.abort.signal,
            });
            render();
        }

        disconnectedCallback() {
            this.abort?.abort();
            if (this.frame) window.cancelAnimationFrame(this.frame);
            delete this.dataset.enhanced;
        }
    }

    if (!customElements.get("opening-sequence")) {
        customElements.define("opening-sequence", OpeningSequence);
    }
</script>

<style>
    .opening-sequence {
        --reveal-opacity: 1;
        --art-opacity: 0;
        --instruction-opacity: 0;
        --hero-content-opacity: 1;
        --opening-color: #4265ff;
        --world-reaction: 0;
        position: relative;
        z-index: 2;
        display: block;
        height: 100svh;
        background: #F8F8F8;
    }

    .opening-sequence__sticky {
        position: sticky;
        top: 0;
        height: 100svh;
        overflow: clip;
        background:
            radial-gradient(
                ellipse 62% 55% at 50% 53%,
                rgb(255 240 73 / calc(var(--world-reaction) * 0.5)) 0%,
                rgb(255 50 185 / calc(var(--world-reaction) * 0.32)) 34%,
                rgb(43 96 235 / calc(var(--world-reaction) * 0.18)) 58%,
                transparent 78%
            ),
            var(--opening-color);
    }

    .opening-sequence__reveal {
        position: absolute;
        z-index: 10;
        inset: 0;
        overflow: hidden;
        background: #F8F8F8;
        opacity: var(--reveal-opacity);
    }

    .opening-sequence__art {
        display: none;
    }

    .opening-sequence__essence {
        display: none;
    }

    .opening-sequence__instruction,
    .opening-sequence__skip {
        display: none;
    }

    :global(.js) .opening-sequence {
        height: 195svh;
    }

    :global(.js) .opening-sequence__reveal {
        will-change: opacity;
    }

    :global(.js) .opening-sequence__art {
        position: absolute;
        z-index: 5;
        inset: 0;
        display: block;
        opacity: var(--art-opacity);
        filter:
            drop-shadow(
                0 0 calc(0.25rem + var(--world-reaction) * 0.7rem)
                    rgb(238 28 198 / calc(var(--world-reaction) * 0.62))
            )
            drop-shadow(
                0 0 calc(0.15rem + var(--world-reaction) * 0.38rem)
                    rgb(255 230 78 / calc(var(--world-reaction) * 0.55))
            );
        pointer-events: none;
        will-change: filter, opacity;
    }

    :global(.js) .opening-sequence__essence {
        position: absolute;
        z-index: 4;
        inset: -4vmax;
        display: block;
        width: calc(100% + 8vmax);
        height: calc(100% + 8vmax);
        filter:
            blur(clamp(0.45rem, 1.05vw, 0.95rem))
            saturate(1.42)
            contrast(1.045);
        image-rendering: pixelated;
        opacity: 0;
        pointer-events: none;
        will-change: opacity;
    }

    :global(.js) .opening-sequence__essence[data-visible] {
        opacity: 1;
    }

    :global(.js) .opening-sequence__essence[data-front] {
        z-index: 15;
    }

    .opening-sequence__frame {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
    }

    .opening-sequence__frame[data-active] {
        opacity: 1;
    }

    :global(.js) .opening-sequence__instruction {
        position: absolute;
        z-index: 10;
        right: clamp(1.25rem, 4vw, 3.5rem);
        bottom: clamp(1.25rem, 3vw, 2.5rem);
        display: flex;
        gap: 0.75rem;
        margin: 0;
        opacity: var(--instruction-opacity);
        color: #0a0a0a;
        font-family: var(--font-reading);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    :global(.js) .opening-sequence__skip {
        position: absolute;
        z-index: 11;
        right: 1rem;
        top: 1rem;
        display: block;
        padding: 0.65rem 0.8rem;
        background: #11110f;
        color: #ffd84f;
        font-family: var(--font-reading);
        font-size: 0.68rem;
        opacity: 0;
        pointer-events: none;
        text-underline-offset: 0.2rem;
    }

    :global(.js) .opening-sequence__skip:focus-visible {
        opacity: 1;
        pointer-events: auto;
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.js) .opening-sequence {
            height: 100svh;
        }

        :global(.js) .opening-sequence__art,
        :global(.js) .opening-sequence__essence,
        :global(.js) .opening-sequence__instruction {
            display: none;
        }

    }
</style>
