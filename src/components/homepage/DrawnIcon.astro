---
import { Image } from 'astro:assets';

import blogIcon from '../../assets/art/icons/Doodles_blog.png';
import connectIcon from '../../assets/art/icons/Doodles_connect.png';
import gamesIcon from '../../assets/art/icons/Doodles_games.png';
import softwareIcon from '../../assets/art/icons/Doodles_software.png';
import whoIcon from '../../assets/art/icons/Doodles_whoiam.png';
import workIcon from '../../assets/art/icons/Doodles_work.png';

type IconName = 'who' | 'blog' | 'connect' | 'work' | 'software' | 'games';

interface Props {
  icon: IconName;
  loading?: 'eager' | 'lazy';
}

const { icon, loading = 'lazy' } = Astro.props;
const icons = {
  who: whoIcon,
  blog: blogIcon,
  connect: connectIcon,
  work: workIcon,
  software: softwareIcon,
  games: gamesIcon,
};
---

<span class={`drawn-icon drawn-icon--${icon}`} aria-hidden="true">
  <Image src={icons[icon]} alt="" width={512} {loading} decoding="async" />
</span>

<style>
  .drawn-icon {
    display: block;
    width: var(--drawn-icon-size, 4.5rem);
    aspect-ratio: 1;
    overflow: hidden;
    transform-origin: center;
  }

  .drawn-icon :global(img) {
    display: block;
    max-width: none;
    height: auto;
    filter: grayscale(1);
    opacity: var(--drawn-icon-opacity, 0.72);
  }

  .drawn-icon--who :global(img) {
    width: 270%;
    transform: translate(-30%, -26%);
  }

  .drawn-icon--blog :global(img) {
    width: 320%;
    transform: translate(-36%, -37%);
  }

  .drawn-icon--connect :global(img) {
    width: 340%;
    transform: translate(-31%, -31%);
  }

  .drawn-icon--work :global(img) {
    width: 320%;
    transform: translate(-31%, -33%);
  }

  .drawn-icon--software :global(img) {
    width: 300%;
    transform: translate(-29%, -36%);
  }

  .drawn-icon--games :global(img) {
    width: 270%;
    transform: translate(-29.5%, -33%);
  }

  :global(.drawn-icon-trigger[data-preview-active]) .drawn-icon {
    animation: drawn-icon-wobble var(--drawn-icon-wobble-duration) steps(1, end) infinite;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.drawn-icon-trigger:hover) .drawn-icon {
      animation: drawn-icon-wobble var(--drawn-icon-wobble-duration) steps(1, end) infinite;
    }
  }

  @keyframes drawn-icon-wobble {
    0%, 100% { transform: translate(-0.1rem, -0.12rem) rotate(-3deg); }
    25% { transform: translate(0.1rem, -0.08rem) rotate(2deg); }
    50% { transform: translate(-0.08rem, -0.04rem) rotate(-1.5deg); }
    75% { transform: translate(0.03rem, -0.18rem) rotate(1deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.drawn-icon-trigger[data-preview-active]) .drawn-icon,
    :global(.drawn-icon-trigger:hover) .drawn-icon {
      animation: none;
    }
  }
</style>
