---
import DrawnIcon from './DrawnIcon.astro';

interface Props {
  icon: 'blog' | 'connect' | 'software' | 'games';
  label: string;
  compact?: boolean;
}

const { icon, label, compact = false } = Astro.props;
---

<div class:list={['section-marker', 'drawn-icon-trigger', `section-marker--${icon}`, compact && 'section-marker--compact']} aria-hidden="true">
  <DrawnIcon {icon} />
  <span>{label}</span>
</div>

<style>
  .section-marker {
    --marker-tilt: -2deg;
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-muted);
    font-family: var(--font-reading);
    font-size: 0.76rem;
    line-height: 1.1;
    transform: rotate(var(--marker-tilt));
  }

  .section-marker--blog { --marker-tilt: 2deg; }
  .section-marker--connect { --marker-tilt: -1deg; }
  .section-marker--software { --marker-tilt: -3deg; }
  .section-marker--games { --marker-tilt: 2deg; }

  .section-marker--compact {
    --drawn-icon-size: 3.7rem;
  }

  @media (max-width: 40rem) {
    .section-marker {
      --drawn-icon-size: 3.8rem;
    }
  }
</style>
