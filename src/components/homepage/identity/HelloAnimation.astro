---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import clickCue from '../../../assets/art/icons/Doodles_point_click.png';

interface Props {
  text: string;
  interactive?: boolean;
  opening?: boolean;
}

const { text, interactive = true, opening = false } = Astro.props;
const frameModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/art/Hello-animation/hello_frame*.png',
  { eager: true },
);
const frames = Object.entries(frameModules)
  .sort(([firstPath], [secondPath]) => {
    const firstFrame = Number(firstPath.match(/frame(\d+)\.png$/)?.[1] ?? 0);
    const secondFrame = Number(secondPath.match(/frame(\d+)\.png$/)?.[1] ?? 0);
    return firstFrame - secondFrame;
  })
  .map(([, module]) => module.default);
---

<span class="hello-animation-with-text">
  <span class="sr-only">{text}</span>
  <hello-animation
    class="hello-animation"
    aria-hidden="true"
    data-opening={opening ? '' : undefined}
  >
    {frames.map((frame, index) => {
      const completed = !opening && index === frames.length - 1;
      const initial = opening && index === 0;
      const visible = completed || initial;

      return (
        <img
          src={visible ? frame.src : undefined}
          data-src={frame.src}
          alt=""
          width={frame.width}
          height={frame.height}
          loading={visible ? 'eager' : 'lazy'}
          decoding="async"
          hidden={!visible}
          data-hello-frame
          data-active={visible ? '' : undefined}
        />
      );
    })}
  </hello-animation>
  {interactive && (
    <>
      <button
        class="hello-animation__name-trigger"
        type="button"
        aria-label="Show a photo of Igor"
        aria-controls="identity-portrait"
        aria-expanded="false"
        data-identity-portrait-trigger
        hidden
      ></button>
      <span class="hello-animation__click-cue" aria-hidden="true">
        <Image src={clickCue} alt="" width={512} loading="lazy" decoding="async" />
      </span>
    </>
  )}
</span>

<script>
  import { openingMotion } from '../opening/opening-motion';

  class HelloAnimation extends HTMLElement {
    private animationFrame = 0;
    private cueTimer = 0;
    private played = false;
    private preparePromise?: Promise<void>;
    private dismissed = false;
    private host?: HTMLElement;
    private reducedMotion?: MediaQueryList;

    connectedCallback() {
      if (this.dataset.enhanced) return;
      this.dataset.enhanced = 'true';
      this.host = this.parentElement ?? undefined;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.addEventListener('hello-animation-prepare', this.prepare);
      this.addEventListener('hello-animation-play', this.play);
      this.host?.addEventListener('click', this.dismissClickCue);
      this.reducedMotion.addEventListener('change', this.handleMotionChange);

      if (this.reducedMotion.matches) {
        this.showCompletedFrame();
      } else if (this.hasAttribute('data-opening')) {
        this.showFrame(0);
      } else {
        this.showCompletedFrame();
      }
    }

    disconnectedCallback() {
      window.cancelAnimationFrame(this.animationFrame);
      window.clearTimeout(this.cueTimer);
      this.removeEventListener('hello-animation-prepare', this.prepare);
      this.removeEventListener('hello-animation-play', this.play);
      this.host?.removeEventListener('click', this.dismissClickCue);
      this.reducedMotion?.removeEventListener('change', this.handleMotionChange);
      delete this.dataset.enhanced;
    }

    private showFrame(index: number) {
      const frames = Array.from(this.querySelectorAll<HTMLImageElement>('[data-hello-frame]'));
      frames.forEach((frame, frameIndex) => {
        const active = frameIndex === index;
        frame.toggleAttribute('data-active', active);
        frame.hidden = !active;
      });
    }

    private showCompletedFrame() {
      const frameCount = this.querySelectorAll('[data-hello-frame]').length;
      if (frameCount) this.showFrame(frameCount - 1);
      this.removeAttribute('data-playing');
    }

    private completePlayback() {
      this.removeAttribute('data-playing');
      this.revealClickCue();
      this.dispatchEvent(new CustomEvent('hello-animation-complete', { bubbles: true }));
    }

    private revealClickCue() {
      if (this.dismissed || this.hasAttribute('data-click-cue')) return;
      this.setAttribute('data-click-cue', '');
      const appearMs = this.reducedMotion?.matches ? 0 : 980;
      this.cueTimer = window.setTimeout(() => this.hideClickCue('auto'), appearMs + 2_400);
    }

    private hideClickCue = (mode: 'auto' | 'click' = 'auto') => {
      if (mode === 'auto' && this.dismissed) return;
      if (mode === 'click' && this.hasAttribute('data-click-cue-dismissed')) return;

      this.dismissed = true;
      window.clearTimeout(this.cueTimer);
      this.cueTimer = 0;

      if (mode === 'click') {
        this.setAttribute('data-click-cue-dismissed', '');
        this.removeAttribute('data-click-cue-fading');
      } else {
        this.setAttribute('data-click-cue-fading', '');
      }

      this.removeAttribute('data-click-cue');
    };

    private dismissClickCue = (event: Event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('[data-identity-portrait-trigger]')) return;
      this.hideClickCue('click');
    };

    private handleMotionChange = () => {
      if (!this.reducedMotion?.matches) return;
      window.cancelAnimationFrame(this.animationFrame);
      this.showCompletedFrame();
      if (this.played) this.revealClickCue();
    };

    private prepare = () => {
      if (this.preparePromise) return this.preparePromise;

      const frames = Array.from(this.querySelectorAll<HTMLImageElement>('[data-hello-frame]'));
      frames.forEach((frame) => {
        const source = frame.dataset.src;
        frame.loading = 'eager';
        if (source && frame.getAttribute('src') !== source) frame.src = source;
      });

      this.preparePromise = Promise.allSettled(frames.map((frame) => frame.decode())).then(
        () => undefined,
      );
      return this.preparePromise;
    };

    private play = async () => {
      if (this.played) return;
      this.played = true;

      if (this.reducedMotion?.matches) {
        this.completePlayback();
        return;
      }

      await this.prepare();
      if (!this.isConnected) return;
      if (this.reducedMotion?.matches) {
        this.completePlayback();
        return;
      }

      const frames = Array.from(this.querySelectorAll<HTMLImageElement>('[data-hello-frame]'));
      if (!frames.length) {
        this.completePlayback();
        return;
      }

      const frameDuration = openingMotion.greetingFrameDurationMs;
      let activeFrame = -1;
      let startedAt = 0;
      this.setAttribute('data-playing', '');

      const animate = (time: number) => {
        if (!startedAt) startedAt = time;
        const nextFrame = Math.min(frames.length - 1, Math.floor((time - startedAt) / frameDuration));

        if (nextFrame !== activeFrame) {
          activeFrame = nextFrame;
          this.showFrame(activeFrame);
        }

        if (activeFrame < frames.length - 1) {
          this.animationFrame = window.requestAnimationFrame(animate);
        } else {
          this.completePlayback();
        }
      };

      this.animationFrame = window.requestAnimationFrame(animate);
    };
  }

  if (!customElements.get('hello-animation')) {
    customElements.define('hello-animation', HelloAnimation);
  }
</script>

<style>
  .hello-animation-with-text {
    position: relative;
    display: inline-block;
    flex: none;
    width: min(100%, 12.5rem);
    overflow: visible;
  }

  .hello-animation {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 680 / 220;
    overflow: hidden;
  }

  .hello-animation img {
    position: absolute;
    top: -79.55%;
    left: -23.53%;
    display: none;
    width: 150.59%;
    max-width: none;
    height: auto;
  }

  .hello-animation img[data-active] {
    display: block;
  }

  .hello-animation img[hidden] {
    display: none;
  }

  .hello-animation__name-trigger {
    position: absolute;
    z-index: 1;
    top: 0;
    right: -0.15rem;
    width: 42%;
    min-width: 2.75rem;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 0.3rem;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .hello-animation__name-trigger[hidden] {
    display: none;
  }

  .hello-animation__name-trigger:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .hello-animation__click-cue {
    position: absolute;
    z-index: 2;
    top: 2.35rem;
    left: 96%;
    width: 2.2rem;
    aspect-ratio: 1;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: rotate(-8deg);
  }

  .hello-animation__click-cue :global(img) {
    display: block;
    width: 250%;
    max-width: none;
    height: auto;
    transform: translate(-13.6%, -19.8%);
  }

  .hello-animation[data-click-cue] ~ .hello-animation__click-cue {
    animation: hello-click-cue-in 360ms ease 620ms both;
  }

  .hello-animation[data-click-cue-fading] ~ .hello-animation__click-cue {
    animation: hello-click-cue-out 2s ease-out both;
  }

  .hello-animation[data-click-cue-dismissed] ~ .hello-animation__click-cue {
    animation: hello-click-cue-out 280ms ease both;
  }

  @keyframes hello-click-cue-in {
    from {
      opacity: 0;
      transform: translate(0.22rem, 0.16rem) rotate(-12deg) scale(0.84);
    }

    to {
      opacity: 1;
      transform: translate(0, 0) rotate(-8deg) scale(1);
    }
  }

  @keyframes hello-click-cue-out {
    from {
      opacity: 1;
      transform: rotate(-8deg);
    }

    to {
      opacity: 0;
      transform: rotate(-8deg);
    }
  }

  @media (max-width: 52rem) {
    .hello-animation-with-text {
      width: min(100%, 11.75rem);
    }

    .hello-animation__click-cue {
      top: 2.2rem;
      left: 93%;
      width: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hello-animation img {
      transition: none;
    }

    .hello-animation[data-click-cue] ~ .hello-animation__click-cue {
      animation: none;
      opacity: 1;
      transform: rotate(-8deg);
    }

    .hello-animation[data-click-cue-fading] ~ .hello-animation__click-cue,
    .hello-animation[data-click-cue-dismissed] ~ .hello-animation__click-cue {
      animation: none;
      opacity: 0;
    }
  }
</style>
