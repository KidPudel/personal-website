---
import type { ImageMetadata } from 'astro';

import completedFrameInline from '../../../assets/art/Hello-animation/hello_frame18.png?inline';
import firstFrameInline from '../../../assets/art/Hello-animation/hello_frame1.png?inline';

interface Props {
  text: string;
  opening?: boolean;
}

const { text, opening = false } = Astro.props;
const frameModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/art/Hello-animation/hello_frame*.png',
  { eager: true },
);
const frames = Object.entries(frameModules)
  .sort(([firstPath], [secondPath]) => {
    const firstFrame = Number(firstPath.match(/frame(\d+)\.png$/)?.[1] ?? 0);
    const secondFrame = Number(secondPath.match(/frame(\d+)\.png$/)?.[1] ?? 0);
    return firstFrame - secondFrame;
  })
  .map(([, module]) => module.default);
---

<span class="hello-animation-with-text">
  <span class="sr-only">{text}</span>
  <hello-animation
    class="hello-animation"
    aria-hidden="true"
    data-opening={opening ? '' : undefined}
  >
    {frames.map((frame, index) => {
      const completed = !opening && index === frames.length - 1;
      const initial = opening && index === 0;
      const visible = completed || initial;
      const inlineSource = initial
        ? firstFrameInline
        : completed
          ? completedFrameInline
          : undefined;

      return (
        <img
          src={visible ? inlineSource : undefined}
          data-src={visible ? undefined : frame.src}
          alt=""
          width={frame.width}
          height={frame.height}
          loading={visible ? 'eager' : 'lazy'}
          decoding={visible ? 'sync' : 'async'}
          hidden={!visible}
          data-hello-frame
          data-active={visible ? '' : undefined}
        />
      );
    })}
  </hello-animation>
</span>

<script>
  import { openingMotion } from '../opening/opening-motion';

  class HelloAnimation extends HTMLElement {
    private animationFrame = 0;
    private played = false;
    private preparePromise?: Promise<void>;
    private reducedMotion?: MediaQueryList;

    connectedCallback() {
      if (this.dataset.enhanced) return;
      this.dataset.enhanced = 'true';
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.addEventListener('hello-animation-prepare', this.prepare);
      this.addEventListener('hello-animation-play', this.play);
      this.reducedMotion.addEventListener('change', this.handleMotionChange);

      if (this.reducedMotion.matches) {
        this.showCompletedFrame();
      } else if (this.hasAttribute('data-opening')) {
        this.showFrame(0);
      } else {
        this.showCompletedFrame();
      }
    }

    disconnectedCallback() {
      window.cancelAnimationFrame(this.animationFrame);
      this.removeEventListener('hello-animation-prepare', this.prepare);
      this.removeEventListener('hello-animation-play', this.play);
      this.reducedMotion?.removeEventListener('change', this.handleMotionChange);
      delete this.dataset.enhanced;
    }

    private showFrame(index: number) {
      const frames = Array.from(this.querySelectorAll<HTMLImageElement>('[data-hello-frame]'));
      frames.forEach((frame, frameIndex) => {
        const active = frameIndex === index;
        frame.toggleAttribute('data-active', active);
        frame.hidden = !active;
      });
    }

    private showCompletedFrame() {
      const frameCount = this.querySelectorAll('[data-hello-frame]').length;
      if (frameCount) this.showFrame(frameCount - 1);
      this.removeAttribute('data-playing');
    }

    private completePlayback() {
      this.removeAttribute('data-playing');
      this.dispatchEvent(new CustomEvent('hello-animation-complete', { bubbles: true }));
    }

    private handleMotionChange = () => {
      if (!this.reducedMotion?.matches) return;
      window.cancelAnimationFrame(this.animationFrame);
      this.showCompletedFrame();
    };

    private prepare = () => {
      if (this.preparePromise) return this.preparePromise;

      const frames = Array.from(this.querySelectorAll<HTMLImageElement>('[data-hello-frame]'));
      frames.forEach((frame) => {
        const source = frame.dataset.src;
        frame.loading = 'eager';
        if (source && frame.getAttribute('src') !== source) frame.src = source;
      });

      this.preparePromise = Promise.allSettled(frames.map((frame) => frame.decode())).then(
        () => undefined,
      );
      return this.preparePromise;
    };

    private play = async () => {
      if (this.played) return;
      this.played = true;

      if (this.reducedMotion?.matches) {
        this.completePlayback();
        return;
      }

      await this.prepare();
      if (!this.isConnected) return;
      if (this.reducedMotion?.matches) {
        this.completePlayback();
        return;
      }

      const frames = Array.from(this.querySelectorAll<HTMLImageElement>('[data-hello-frame]'));
      if (!frames.length) {
        this.completePlayback();
        return;
      }

      const frameDuration = openingMotion.greetingFrameDurationMs;
      let activeFrame = -1;
      let startedAt = 0;
      this.setAttribute('data-playing', '');

      const animate = (time: number) => {
        if (!startedAt) startedAt = time;
        const nextFrame = Math.min(frames.length - 1, Math.floor((time - startedAt) / frameDuration));

        if (nextFrame !== activeFrame) {
          activeFrame = nextFrame;
          this.showFrame(activeFrame);
        }

        if (activeFrame < frames.length - 1) {
          this.animationFrame = window.requestAnimationFrame(animate);
        } else {
          this.completePlayback();
        }
      };

      this.animationFrame = window.requestAnimationFrame(animate);
    };
  }

  if (!customElements.get('hello-animation')) {
    customElements.define('hello-animation', HelloAnimation);
  }
</script>

<style>
  .hello-animation-with-text {
    position: relative;
    display: inline-block;
    flex: none;
    width: min(100%, 12.5rem);
    overflow: visible;
  }

  .hello-animation {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 680 / 220;
    overflow: hidden;
  }

  .hello-animation img {
    position: absolute;
    top: -79.55%;
    left: -23.53%;
    display: none;
    width: 150.59%;
    max-width: none;
    height: auto;
  }

  .hello-animation img[data-active] {
    display: block;
  }

  .hello-animation img[hidden] {
    display: none;
  }

  @media (max-width: 52rem) {
    .hello-animation-with-text {
      width: min(100%, 11.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hello-animation img {
      transition: none;
    }
  }
</style>
