---
import { essenceChannel } from '../opening/pigment-field';

interface Props {
  word: string;
}

const { word } = Astro.props;
const essenceStyle = [
  `--essence-imperial: ${essenceChannel(0)}`,
  `--essence-sky: ${essenceChannel(1)}`,
  `--essence-alice: ${essenceChannel(2)}`,
  `--essence-mustard: ${essenceChannel(3)}`,
  `--essence-flame: ${essenceChannel(4)}`,
  `--essence-cinnabar: ${essenceChannel(5)}`,
  `--essence-magenta: ${essenceChannel(6)}`,
].join('; ');
---

<playful-word class="thermal-word" style={essenceStyle}>
  <span class="thermal-word__base">{word}</span>
  <canvas class="thermal-word__canvas" aria-hidden="true"></canvas>
</playful-word>

<script>
  interface ThermalStop {
    at: number;
    color: [number, number, number];
  }

  interface ThermalGeometry {
    ascent: number;
    baseline: number;
    centers: number[];
    cssHeight: number;
    cssWidth: number;
    drawX: number;
    fontSize: number;
    radii: number[];
  }

  class PlayfulWord extends HTMLElement {
    private canvas?: HTMLCanvasElement;
    private context?: CanvasRenderingContext2D;
    private fieldCanvas = document.createElement('canvas');
    private fieldContext = this.fieldCanvas.getContext('2d');
    private textCanvas = document.createElement('canvas');
    private textContext = this.textCanvas.getContext('2d');
    private geometry?: ThermalGeometry;
    private palette: ThermalStop[] = [];
    private animationFrame = 0;
    private animationStart = 0;
    private resizeObserver?: ResizeObserver;
    private reducedMotion?: MediaQueryList;
    private word = '';
    private inkColor = 'rgb(17 17 15)';

    private readonly letterDelay = 70;
    private readonly pulseDuration = 1_470;

    connectedCallback() {
      if (this.dataset.enhanced) return;

      this.canvas = this.querySelector<HTMLCanvasElement>('.thermal-word__canvas') ?? undefined;
      this.context = this.canvas?.getContext('2d') ?? undefined;
      this.word = this.querySelector<HTMLElement>('.thermal-word__base')?.textContent ?? '';
      if (!this.canvas || !this.context || !this.fieldContext || !this.textContext || !this.word) return;

      this.dataset.enhanced = 'true';
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.readPalette();
      this.configureCanvas();

      this.addEventListener('pointerenter', this.restartWave);
      this.addEventListener('pointerdown', this.restartWave);

      if ('ResizeObserver' in window) {
        this.resizeObserver = new ResizeObserver(() => this.configureCanvas());
        this.resizeObserver.observe(this);
      }

      document.fonts?.ready.then(() => this.configureCanvas());
    }

    disconnectedCallback() {
      window.cancelAnimationFrame(this.animationFrame);
      this.resizeObserver?.disconnect();
      this.removeEventListener('pointerenter', this.restartWave);
      this.removeEventListener('pointerdown', this.restartWave);
      delete this.dataset.enhanced;
    }

    private readPalette() {
      const style = getComputedStyle(this);
      const read = (name: string): [number, number, number] => {
        const channels = style
          .getPropertyValue(name)
          .trim()
          .split(/\s+/)
          .map(Number);
        return [channels[0] || 0, channels[1] || 0, channels[2] || 0];
      };

      this.palette = [
        { at: 0, color: read('--essence-magenta') },
        { at: 0.18, color: read('--essence-cinnabar') },
        { at: 0.31, color: read('--essence-flame') },
        { at: 0.45, color: read('--essence-mustard') },
        { at: 0.61, color: read('--essence-alice') },
        { at: 0.78, color: read('--essence-sky') },
        { at: 1, color: read('--essence-imperial') },
      ];
    }

    private setTextStyle(context: CanvasRenderingContext2D, style: CSSStyleDeclaration) {
      context.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      context.textBaseline = 'alphabetic';
      context.textAlign = 'left';
      context.fontKerning = 'normal';

      const letteredContext = context as CanvasRenderingContext2D & { letterSpacing?: string };
      if ('letterSpacing' in letteredContext) letteredContext.letterSpacing = style.letterSpacing;
    }

    private configureCanvas() {
      const base = this.querySelector<HTMLElement>('.thermal-word__base');
      if (!base || !this.canvas || !this.context || !this.textContext) return;

      const bounds = base.getBoundingClientRect();
      const style = getComputedStyle(base);
      if (style.color !== 'transparent' && style.color !== 'rgba(0, 0, 0, 0)') {
        this.inkColor = style.color;
      }
      const fontSize = Number.parseFloat(style.fontSize) || 48;
      const paddingX = fontSize * 0.22;
      const paddingTop = fontSize * 0.28;
      const paddingBottom = fontSize * 0.42;
      const cssWidth = Math.ceil(bounds.width + paddingX * 2);
      const cssHeight = Math.ceil(bounds.height + paddingTop + paddingBottom);
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      this.canvas.style.width = `${cssWidth}px`;
      this.canvas.style.height = `${cssHeight}px`;
      this.canvas.style.left = `${-paddingX}px`;
      this.canvas.style.top = `${-paddingTop}px`;
      this.canvas.width = Math.ceil(cssWidth * pixelRatio);
      this.canvas.height = Math.ceil(cssHeight * pixelRatio);
      this.textCanvas.width = this.canvas.width;
      this.textCanvas.height = this.canvas.height;

      this.context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      this.textContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      this.setTextStyle(this.context, style);
      this.setTextStyle(this.textContext, style);

      const metrics = this.context.measureText(this.word);
      const ascent = metrics.actualBoundingBoxAscent || fontSize * 0.76;
      const descent = metrics.actualBoundingBoxDescent || fontSize * 0.2;
      const drawX = paddingX + (bounds.width - metrics.width) * 0.5;
      const baseline = paddingTop + (bounds.height - ascent - descent) * 0.5 + ascent;
      const centers: number[] = [];
      const radii: number[] = [];

      for (let index = 0; index < this.word.length; index += 1) {
        const before = this.context.measureText(this.word.slice(0, index)).width;
        const through = this.context.measureText(this.word.slice(0, index + 1)).width;
        const advance = Math.max(through - before, fontSize * 0.24);
        centers.push(drawX + (before + through) * 0.5);
        // Keep each bloom legible as its own letter event. The smooth-union
        // pass below supplies the liquid bridge between neighbouring glyphs.
        radii.push(Math.max(advance * 0.94, fontSize * 0.36));
      }

      const fieldScale = 0.72;
      this.fieldCanvas.width = Math.max(1, Math.ceil(cssWidth * fieldScale));
      this.fieldCanvas.height = Math.max(1, Math.ceil(cssHeight * fieldScale));
      this.geometry = { ascent, baseline, centers, cssHeight, cssWidth, drawX, fontSize, radii };
      this.drawFrame(0);
    }

    private restartWave = () => {
      if (this.reducedMotion?.matches || !this.geometry) return;
      window.cancelAnimationFrame(this.animationFrame);
      this.animationStart = performance.now();
      this.setAttribute('data-thermal-wave', '');
      this.animationFrame = window.requestAnimationFrame(this.animate);
    };

    private animate = (time: number) => {
      const elapsed = time - this.animationStart;
      const totalDuration = this.pulseDuration + Math.max(0, this.word.length - 1) * this.letterDelay;
      this.drawFrame(elapsed);

      if (elapsed < totalDuration) {
        this.animationFrame = window.requestAnimationFrame(this.animate);
        return;
      }

      this.drawFrame(totalDuration);
      this.removeAttribute('data-thermal-wave');
      this.animationFrame = 0;
    };

    private smoothMax(first: number, second: number, softness: number) {
      const blend = Math.max(0, Math.min(1, 0.5 + (second - first) / (softness * 2)));
      return second * blend + first * (1 - blend) + softness * blend * (1 - blend);
    }

    private samplePalette(value: number): [number, number, number] {
      const position = Math.max(0, Math.min(1, value));
      const upperIndex = this.palette.findIndex((stop) => stop.at >= position);
      if (upperIndex <= 0) return this.palette[0]?.color ?? [253, 54, 237];
      if (upperIndex < 0) return this.palette[this.palette.length - 1]?.color ?? [14, 40, 137];

      const lower = this.palette[upperIndex - 1];
      const upper = this.palette[upperIndex];
      const mix = (position - lower.at) / Math.max(0.001, upper.at - lower.at);
      return lower.color.map((channel, index) =>
        Math.round(channel + (upper.color[index] - channel) * mix),
      ) as [number, number, number];
    }

    private drawFrame(elapsed: number) {
      if (!this.geometry || !this.context || !this.fieldContext || !this.textContext || !this.canvas) return;

      const { ascent, baseline, centers, cssHeight, cssWidth, drawX, fontSize, radii } = this.geometry;
      const fieldWidth = this.fieldCanvas.width;
      const fieldHeight = this.fieldCanvas.height;
      const scaleX = cssWidth / fieldWidth;
      const scaleY = cssHeight / fieldHeight;
      const centerY = baseline - ascent * 0.48;
      const verticalRadius = fontSize * 0.62;
      const image = this.fieldContext.createImageData(fieldWidth, fieldHeight);
      const pixels = image.data;
      const time = elapsed * 0.001;
      const pulseStrengths = centers.map((_, letterIndex) => {
        const localTime = (elapsed - letterIndex * this.letterDelay) / this.pulseDuration;
        return localTime > 0 && localTime < 1 ? Math.pow(Math.sin(localTime * Math.PI), 0.72) : 0;
      });
      const centerYs = centers.map(
        (_, letterIndex) => centerY + Math.sin(letterIndex * 1.73 + 0.4) * fontSize * 0.075,
      );

      for (let pixelY = 0; pixelY < fieldHeight; pixelY += 1) {
        const y = (pixelY + 0.5) * scaleY;

        for (let pixelX = 0; pixelX < fieldWidth; pixelX += 1) {
          const x = (pixelX + 0.5) * scaleX;
          const warpedX =
            x +
            Math.sin(y * 0.105 + time * 3.9) * fontSize * 0.055 +
            Math.sin((x + y) * 0.043 - time * 2.1) * fontSize * 0.03;
          const warpedY =
            y +
            Math.sin(x * 0.074 - time * 2.8) * fontSize * 0.045 +
            Math.cos((x - y) * 0.052 + time * 2.4) * fontSize * 0.025;
          let field = -0.18;

          for (let letterIndex = 0; letterIndex < centers.length; letterIndex += 1) {
            const strength = pulseStrengths[letterIndex];
            if (strength <= 0) continue;

            const horizontal = (warpedX - centers[letterIndex]) / radii[letterIndex];
            const vertical = (warpedY - centerYs[letterIndex]) / verticalRadius;
            const distance = Math.hypot(horizontal, vertical);
            const innerCurrent =
              Math.sin(warpedX * 0.16 + warpedY * 0.11 + time * 3.6) * 0.02 +
              Math.sin(warpedY * 0.24 - time * 2.5) * 0.014;
            const current = strength * 1.16 - distance * 0.54 + innerCurrent;
            field = this.smoothMax(field, current, 0.085);
          }

          // A narrow metaball bridge prevents the wave from becoming a row of
          // circular spotlights while preserving the pulse inside each glyph.
          for (let letterIndex = 0; letterIndex < centers.length - 1; letterIndex += 1) {
            const bridgeStrength = Math.min(pulseStrengths[letterIndex], pulseStrengths[letterIndex + 1]);
            if (bridgeStrength <= 0.04) continue;

            const startX = centers[letterIndex];
            const endX = centers[letterIndex + 1];
            const along = Math.max(0, Math.min(1, (warpedX - startX) / Math.max(1, endX - startX)));
            const nearestX = startX + (endX - startX) * along;
            const nearestY = centerYs[letterIndex] + (centerYs[letterIndex + 1] - centerYs[letterIndex]) * along;
            const bridgeDistance = Math.hypot(
              (warpedX - nearestX) / (fontSize * 0.34),
              (warpedY - nearestY) / (verticalRadius * 0.72),
            );
            const bridge = bridgeStrength * 1.02 - bridgeDistance * 0.5;
            field = this.smoothMax(field, bridge, 0.07);
          }

          const alpha = Math.max(0, Math.min(1, field / 0.12));
          const color = this.samplePalette(field);
          const index = (pixelY * fieldWidth + pixelX) * 4;
          pixels[index] = color[0];
          pixels[index + 1] = color[1];
          pixels[index + 2] = color[2];
          pixels[index + 3] = Math.round(alpha * 255);
        }
      }

      this.fieldContext.putImageData(image, 0, 0);

      const pixelRatio = this.canvas.width / cssWidth;
      this.textContext.setTransform(1, 0, 0, 1, 0, 0);
      this.textContext.clearRect(0, 0, this.textCanvas.width, this.textCanvas.height);
      this.textContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      this.textContext.globalCompositeOperation = 'source-over';
      this.textContext.imageSmoothingEnabled = true;
      this.textContext.imageSmoothingQuality = 'high';
      this.textContext.drawImage(this.fieldCanvas, 0, 0, fieldWidth, fieldHeight, 0, 0, cssWidth, cssHeight);
      this.textContext.globalCompositeOperation = 'destination-in';
      this.textContext.fillStyle = '#fff';
      this.textContext.fillText(this.word, drawX, baseline);
      this.textContext.globalCompositeOperation = 'source-over';

      this.context.setTransform(1, 0, 0, 1, 0, 0);
      this.context.clearRect(0, 0, this.canvas.width, this.canvas.height);
      this.context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      const style = getComputedStyle(this.querySelector<HTMLElement>('.thermal-word__base') ?? this);
      this.setTextStyle(this.context, style);
      this.context.fillStyle = this.inkColor;
      this.context.fillText(this.word, drawX, baseline);

      this.context.save();
      this.context.globalAlpha = 0.24;
      this.context.filter = `blur(${Math.max(1, fontSize * 0.055)}px)`;
      this.context.drawImage(this.textCanvas, 0, 0, cssWidth, cssHeight);
      this.context.restore();
      this.context.drawImage(this.textCanvas, 0, 0, cssWidth, cssHeight);
    }
  }

  if (!customElements.get('playful-word')) {
    customElements.define('playful-word', PlayfulWord);
  }
</script>

<style>
  .thermal-word {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
  }

  .thermal-word__base {
    position: relative;
  }

  .thermal-word__canvas {
    position: absolute;
    z-index: 1;
    display: block;
    max-width: none;
    pointer-events: none;
    opacity: 0;
  }

  .thermal-word[data-thermal-wave] .thermal-word__base {
    color: transparent;
  }

  .thermal-word[data-thermal-wave] .thermal-word__canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .thermal-word__canvas {
      display: none;
    }
  }
</style>
