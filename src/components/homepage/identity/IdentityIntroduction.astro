---
import { Image } from 'astro:assets';

import joyfulCircle from '../../../assets/art/elements/circled.png';
import { sitePath } from '../../../config/site';
import { identity } from '../../../content/homepage/identity';
import HelloAnimation from './HelloAnimation.astro';
import PlayfulWord from './PlayfulWord.astro';
---

<identity-introduction class="identity-shell">
  <section id="intro" class="identity" aria-labelledby="intro-title" tabindex="-1">
    <div class="identity__copy" data-identity-copy>
      <div class="identity__intro">
        <p class="identity__hello">
          <HelloAnimation text={identity.hello} />
          <span class="identity__role">{identity.role}</span>
        </p>
        <h1 id="intro-title" class="identity__summary">
          <span class="identity__passage">{identity.research}</span>
          <span class="identity__passage">
            {identity.experience.before}<a
              class="identity__deep-link identity__deep-link--experience"
              href="#value-experience"
              aria-label="Experience. Continue to why experience matters to me."
            ><PlayfulWord word={identity.experience.word} /></a>{identity.experience.after}<br
              class="identity__figma-break"
            />{identity.experience.continuation}
          </span>
          <span class="identity__passage identity__passage--purpose">
            {identity.purpose.before}<br class="identity__figma-break" />{identity.purpose.continuation}<a
              class="identity__joyful-link"
              href={identity.purpose.href}
            ><span class="identity__joyful-word">{identity.purpose.word}</span><Image
                class="identity__joyful-circle"
                src={joyfulCircle}
                alt=""
                width={180}
                aria-hidden="true"
              /></a>{identity.purpose.after}
          </span>
          <span class="identity__passage">
            {identity.engineering.before}<a
              class="identity__deep-link identity__deep-link--engineering"
              href={sitePath('/work/#product-design')}
            >{identity.engineering.word}</a>{identity.engineering.after}<br
              class="identity__figma-break"
            />{identity.engineering.continuation}<br
              class="identity__figma-break"
            />{identity.engineering.conclusion}
          </span>
        </h1>
      </div>
    </div>
  </section>
</identity-introduction>


<style>
  .identity-shell {
    display: block;
    width: 100%;
  }

  .identity {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 0;
    grid-template-columns: min(36rem, 100%);
    justify-content: start;
    align-content: start;
    align-items: start;
    padding: clamp(7rem, 18vh, 11rem) var(--page-gutter) 0.75rem;
    overflow: visible;
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  .identity__copy {
    position: relative;
    width: min(100%, 49rem);
  }

  .identity__intro {
    overflow: visible;
  }


  .identity__hello {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 0.5vw + 0.9rem, 1.25rem);
    letter-spacing: 0.025em;
  }

  .identity__role {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 2.9vw, 3.15rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .identity__summary {
    max-width: 35rem;
    margin: clamp(2.375rem, 4.5vw, 3.25rem) 0 0;
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.98rem, 0.35vw + 0.92rem, 1.16rem);
    font-weight: 400;
    letter-spacing: 0.025em;
    line-height: 1.3;
  }

  .identity__passage {
    display: block;
  }

  .identity__passage + .identity__passage {
    margin-top: 1em;
  }

  .identity__figma-break {
    display: block;
  }

  .identity__joyful-link {
    position: relative;
    display: inline-block;
    isolation: isolate;
    color: inherit;
    border-bottom: 0.08em dotted currentColor;
    font-family: var(--font-special);
    font-style: normal;
    line-height: 1.05;
    text-decoration: none;
  }

  .identity__joyful-word {
    position: relative;
    z-index: 1;
  }

  .identity__joyful-circle {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: -34%;
    display: block;
    width: 185%;
    height: auto;
    max-width: none;
    opacity: 1;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .identity__joyful-link:focus-visible {
    border-radius: 0.08em;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .identity__deep-link {
    color: inherit;
    text-decoration: none;
  }

  .identity__deep-link--experience {
    display: inline-block;
    border-bottom: 0.11rem dotted currentColor;
    line-height: 1.15;
  }

  .identity__deep-link--engineering {
    border-bottom: 0.1rem dotted currentColor;
    font-family: 'Roboto Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
    font-size: 0.91em;
    letter-spacing: -0.035em;
  }

  .identity__deep-link:focus-visible {
    border-radius: 0.08em;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  @media (max-width: 52rem) {
    .identity__figma-break {
      display: none;
    }

    .identity {
      padding:
        clamp(2.8rem, 6.5svh, 3.8rem)
        clamp(1.15rem, 5.2vw, 1.4rem)
        0.75rem;
    }

    .identity__copy {
      width: 100%;
    }

    .identity__hello {
      font-size: 1.05rem;
    }

    .identity__role {
      font-size: clamp(1.7rem, 7.8vw, 2.05rem);
      line-height: 1.14;
    }

    .identity__summary {
      max-width: 36em;
      margin-top: 1.875rem;
      font-size: 1.0625rem;
      line-height: 1.3;
    }
  }

  @media (max-width: 52rem) and (max-height: 43rem) {
    .identity {
      padding-top: clamp(2.4rem, 5.5svh, 3.2rem);
      padding-bottom: 0.6rem;
    }

    .identity__role {
      font-size: clamp(1.58rem, 7vw, 1.85rem);
    }

    .identity__summary {
      margin-top: 1.25rem;
    }
  }

  @media (max-height: 48rem) and (min-width: 52.01rem) {
    .identity {
      gap: 2.5rem;
      padding-top: clamp(7rem, 18vh, 11rem);
    }

    .identity__role {
      font-size: clamp(2.2rem, 3.2vw, 3.15rem);
    }

    .identity__summary {
      margin-top: 1.875rem;
      font-size: 0.95rem;
    }
  }

</style>
