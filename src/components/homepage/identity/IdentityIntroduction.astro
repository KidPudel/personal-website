---
import { Image } from 'astro:assets';

import realPortrait from '../../../assets/art/avatar_irl.png';
import { identity } from '../../../content/homepage/identity';
import PortfolioHeader from '../PortfolioHeader.astro';
import HelloAnimation from './HelloAnimation.astro';
import PlayfulWord from './PlayfulWord.astro';
---

<identity-introduction class="identity-shell">
  <section id="intro" class="identity" aria-labelledby="intro-title">
    <div class="identity__copy">
      <p class="identity__hello">
        <HelloAnimation text={identity.hello} />
        <span>{identity.role}</span>
      </p>
      <h1 id="intro-title">
        {identity.title.before}<span class="identity__title-mark"><PlayfulWord word={identity.title.word} />,</span>{identity.title.after.replace(/^,/, '')}
      </h1>
      <p class="identity__summary">
        {identity.summary.before}<span class="identity__word">{identity.summary.word}</span>{identity.summary.after}
      </p>
      <PortfolioHeader current="home" placement="intro" contactId="intro-contact" />
    </div>
    <figure id="identity-portrait" class="identity__portrait" aria-hidden="true">
      <Image
        src={realPortrait}
        alt="Igor smiling in a cap and orange life jacket while sitting in a boat"
        width={480}
        loading="lazy"
        format="webp"
      />
    </figure>
  </section>
</identity-introduction>

<script>
  class IdentityIntroduction extends HTMLElement {
    private trigger?: HTMLButtonElement;
    private portrait?: HTMLElement;

    connectedCallback() {
      if (this.dataset.enhanced) return;

      this.trigger =
        this.querySelector<HTMLButtonElement>('[data-identity-portrait-trigger]') ?? undefined;
      this.portrait = this.querySelector<HTMLElement>('#identity-portrait') ?? undefined;
      if (!this.trigger || !this.portrait) return;

      this.dataset.enhanced = 'true';
      this.trigger.hidden = false;
      this.trigger.addEventListener('click', this.togglePortrait);
    }

    disconnectedCallback() {
      this.trigger?.removeEventListener('click', this.togglePortrait);
      delete this.dataset.enhanced;
    }

    private togglePortrait = () => {
      if (!this.trigger || !this.portrait) return;

      const willShow = !this.hasAttribute('data-portrait-visible');
      this.toggleAttribute('data-portrait-visible', willShow);
      this.portrait.setAttribute('aria-hidden', String(!willShow));
      this.trigger.setAttribute('aria-expanded', String(willShow));
      this.trigger.setAttribute(
        'aria-label',
        willShow ? 'Hide the photo of Igor' : 'Show a photo of Igor',
      );
    };
  }

  if (!customElements.get('identity-introduction')) {
    customElements.define('identity-introduction', IdentityIntroduction);
  }
</script>

<style>
  .identity-shell {
    display: block;
  }

  .identity {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 0;
    grid-template-columns: minmax(0, 36rem);
    justify-content: center;
    align-content: start;
    align-items: start;
    padding: clamp(2.75rem, 4.6vh, 3.6rem) clamp(1.25rem, 6vw, 6rem) 0.75rem;
    overflow: visible;
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  .identity__portrait {
    position: absolute;
    z-index: 1;
    bottom: calc(50% + clamp(8rem, 11vw, 10rem));
    left: calc(50% + clamp(1.25rem, 5vw, 5.25rem));
    width: clamp(10rem, 17vw, 15rem);
    margin: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    border-radius: 0.45rem;
    transform: scale(0.88) rotate(-2deg);
    transform-origin: center;
    transition: opacity 220ms ease 80ms, transform 280ms ease 40ms, visibility 0s 320ms;
  }

  .identity__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 44%;
    border-radius: 0.45rem;
  }

  .identity-shell[data-portrait-visible] .identity__portrait {
    opacity: var(--identity-opacity, 1);
    visibility: visible;
    transform: scale(1) rotate(-2deg);
    transition-delay: 80ms, 40ms, 0s;
  }

  .identity__copy {
    position: relative;
    width: min(100%, 49rem);
  }

  .identity__hello {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(1rem, 0.5vw + 0.9rem, 1.25rem);
    letter-spacing: 0.025em;
    opacity: var(--hello-opacity, 1);
    transform: translate3d(0, calc((1 - var(--hello-opacity, 1)) * 0.85rem), 0);
    transition:
      opacity 480ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .identity__hello span {
    color: var(--color-muted);
    font-size: 0.82em;
    line-height: 1.2;
  }

  .identity h1 {
    max-width: 24ch;
    margin: calc(var(--title-opacity, 1) * 1.2rem) 0 0;
    max-height: calc(var(--title-opacity, 1) * 8em);
    overflow: hidden;
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 2.9vw, 3.15rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.04;
    opacity: var(--title-opacity, 1);
    transform: translate3d(0, calc((1 - var(--title-opacity, 1)) * 1.1rem), 0);
    transition:
      opacity 480ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 480ms cubic-bezier(0.16, 1, 0.3, 1),
      max-height 480ms cubic-bezier(0.16, 1, 0.3, 1),
      margin 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .identity__title-mark {
    white-space: nowrap;
  }

  .identity__summary {
    max-width: 35rem;
    margin: calc(var(--summary-opacity, 1) * 1.5rem) 0 0;
    max-height: calc(var(--summary-opacity, 1) * 8em);
    overflow: hidden;
    color: var(--color-copy);
    font-size: clamp(0.98rem, 0.35vw + 0.92rem, 1.16rem);
    line-height: 1.68;
    opacity: var(--summary-opacity, 1);
    transform: translate3d(0, calc((1 - var(--summary-opacity, 1)) * 0.95rem), 0);
    transition:
      opacity 480ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 480ms cubic-bezier(0.16, 1, 0.3, 1),
      max-height 480ms cubic-bezier(0.16, 1, 0.3, 1),
      margin 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .identity__word {
    font-family: var(--font-special);
    font-style: normal;
  }

  @media (max-width: 52rem) {
    .identity {
      padding:
        clamp(2.8rem, 6.5svh, 3.8rem)
        clamp(1.15rem, 5.2vw, 1.4rem)
        0.75rem;
    }

    .identity__portrait {
      top: calc(clamp(5.5rem, 21svh, 11rem) - 1.65rem);
      bottom: auto;
      right: auto;
      left: calc(clamp(1.15rem, 5.2vw, 1.4rem) + 12rem);
      width: clamp(5.5rem, 24vw, 6.6rem);
    }

    .identity__copy {
      width: 100%;
    }

    .identity__hello {
      font-size: 1.05rem;
    }

    .identity__hello span {
      font-size: 0.94em;
      line-height: 1.3;
    }

    .identity h1 {
      max-width: 13.5em;
      margin-top: calc(var(--title-opacity, 1) * 1.05rem);
      font-size: clamp(1.7rem, 7.8vw, 2.05rem);
      line-height: 1.14;
    }

    .identity__summary {
      max-width: 36em;
      margin-top: calc(var(--summary-opacity, 1) * 1.15rem);
      font-size: 1.0625rem;
      line-height: 1.55;
    }
  }

  @media (max-width: 52rem) and (max-height: 43rem) {
    .identity {
      padding-top: clamp(2.4rem, 5.5svh, 3.2rem);
      padding-bottom: 0.6rem;
    }

    .identity__portrait {
      top: calc(clamp(3.4rem, 12svh, 4.6rem) - 1.35rem);
      width: clamp(5.1rem, 22vw, 6rem);
    }

    .identity h1 {
      margin-top: calc(var(--title-opacity, 1) * 0.9rem);
      font-size: clamp(1.58rem, 7vw, 1.85rem);
    }

    .identity__summary {
      margin-top: calc(var(--summary-opacity, 1) * 0.95rem);
    }
  }

  @media (max-height: 48rem) and (min-width: 52.01rem) {
    .identity {
      gap: 2.5rem;
      padding-top: 3.25rem;
    }

    .identity__portrait {
      bottom: calc(50% + 7rem);
      width: min(13rem, 17vw);
    }

    .identity h1 {
      font-size: clamp(2.2rem, 3.2vw, 3.15rem);
    }

    .identity__summary {
      margin-top: calc(var(--summary-opacity, 1) * 1.15rem);
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .identity,
    .identity__hello,
    .identity h1,
    .identity__summary {
      transform: none;
      max-height: none;
      overflow: visible;
      transition: none;
    }

    .identity__portrait {
      transition: none;
    }
  }
</style>
