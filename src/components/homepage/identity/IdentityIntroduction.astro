---
import { identity as identityCopy } from '../../../content/homepage/identity';
import { toLocale } from '../../../i18n/locales';
import AnnotatedText from '../AnnotatedText.astro';
import HelloAnimation from './HelloAnimation.astro';

const identity = identityCopy[toLocale(Astro.currentLocale)];
---

<identity-introduction class="identity-shell">
  <section id="intro" class="identity" aria-labelledby="intro-title" tabindex="-1">
    <div class="identity__copy" data-identity-copy>
      <div class="identity__intro">
        <h1 id="intro-title" class="identity__hello">
          <HelloAnimation text={identity.hello} opening />{' '}
          <span class="identity__role">{identity.role}</span>
        </h1>
        <div class="identity__summary">
          <AnnotatedText parts={identity.claim} id="intro" />
        </div>
      </div>
    </div>
  </section>
</identity-introduction>


<style>
  .identity-shell {
    display: block;
    width: 100%;
  }

  .identity {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 0;
    grid-template-columns: min(42rem, 100%);
    justify-content: start;
    align-content: start;
    align-items: start;
    /* A fixed step below the header's row (its offset and 2.75rem controls),
       so the gap under the header is the same at every screen height. */
    padding: calc(var(--navigation-top) + 2.75rem + 2rem) var(--page-inset) 0.75rem;
    overflow: visible;
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  .identity__copy {
    position: relative;
    width: min(100%, 49rem);
  }

  .identity__intro {
    overflow: visible;
  }


  .identity__hello {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 0.5vw + 0.9rem, 1.25rem);
    font-weight: 400;
    letter-spacing: 0.025em;
  }

  .identity__role {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 2.9vw, 3.15rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .identity__summary {
    /* The doors' grey, a step darker than About's so it reads on the sky
       (4.6:1). */
    --door-grey: #5c5952;
    /* About 72 characters a line: wide enough for the claim to sit on one
       line, and in ems so the measure holds at every type size. */
    max-width: 35.5em;
    margin: clamp(1.125rem, 1.6vw, 1.5rem) 0 0;
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.98rem, 0.35vw + 0.92rem, 1.16rem);
    font-weight: 400;
    letter-spacing: 0.025em;
    line-height: 1.4;
  }

  @media (max-width: 52rem) {
    .identity {
      padding:
        clamp(2.8rem, 6.5svh, 3.8rem)
        var(--page-gutter)
        0.75rem;
    }

    .identity__copy {
      width: 100%;
    }

    .identity__hello {
      font-size: 1.05rem;
    }

    .identity__role {
      font-size: clamp(1.7rem, 7.8vw, 2.05rem);
      line-height: 1.14;
    }

    .identity__summary {
      max-width: 36em;
      margin-top: 1.125rem;
      font-size: 1.0625rem;
      line-height: 1.4;
    }
  }

  @media (max-width: 52rem) and (max-height: 43rem) {
    .identity {
      padding-top: clamp(2.4rem, 5.5svh, 3.2rem);
      padding-bottom: 0.6rem;
    }

    .identity__role {
      font-size: clamp(1.58rem, 7vw, 1.85rem);
    }

    .identity__summary {
      margin-top: 0.875rem;
    }
  }

  @media (max-height: 48rem) and (min-width: 52.01rem) {
    .identity__role {
      font-size: clamp(2.2rem, 3.2vw, 3.15rem);
    }

    .identity__summary {
      margin-top: 1.125rem;
      font-size: 0.95rem;
    }
  }

</style>
