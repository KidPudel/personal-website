---
import { identity as identityCopy } from '../../../content/homepage/identity';
import { toLocale } from '../../../i18n/locales';
import AnnotatedText from '../AnnotatedText.astro';
import HelloAnimation from './HelloAnimation.astro';

const identity = identityCopy[toLocale(Astro.currentLocale)];
---

<identity-introduction class="identity-shell">
  <section id="intro" class="identity" aria-labelledby="intro-title" tabindex="-1">
    <div class="identity__copy" data-identity-copy>
      <div class="identity__intro">
        <h1 id="intro-title" class="identity__hello">
          <HelloAnimation text={identity.hello} opening />
        </h1>
        <div class="identity__summary">
          <AnnotatedText parts={identity.claim} id="intro" />
        </div>
      </div>
    </div>
  </section>
</identity-introduction>


<style>
  .identity-shell {
    display: block;
    width: 100%;
  }

  .identity {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 0;
    grid-template-columns: min(62rem, 100%);
    justify-content: start;
    align-content: start;
    align-items: start;
    /* A fixed step below the header's row (its offset and 2.75rem controls),
       so the gap under the header is the same at every screen height. */
    padding: calc(var(--navigation-top) + 2.75rem + 2rem) var(--page-inset) 0.75rem;
    overflow: visible;
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  .identity__copy {
    position: relative;
    width: 100%;
  }

  .identity__intro {
    overflow: visible;
  }

  .identity__hello {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 0.5vw + 0.9rem, 1.25rem);
    font-weight: 400;
    letter-spacing: 0.025em;
  }

  /* The claim is the headline: what I care about and what kind of designer
     I am, with the detail behind its doors. Set in Splav (Averia, a serif
     averaged from hundreds of others, with Cyrillic averaged the same way),
     soft at the edges like the sky and the
     handwriting, and in ink, because a headline is read whole. The doors
     are italic, marked by their asterisks. */
  .identity__summary {
    /* The whole sentence in ink, not the doors' grey. */
    --door-grey: var(--color-ink);
    /* About 60 characters a line, so the headline reads in three lines. */
    max-width: 29em;
    margin: clamp(0.75rem, 1.2vw, 1.125rem) 0 0;
    color: var(--color-ink);
    font-family: var(--font-intro);
    font-size: clamp(1.3rem, 0.8vw + 0.9rem, 1.65rem);
    /* Light, so the bold italic doors stand clear of it. */
    font-weight: 300;
    letter-spacing: 0.005em;
    line-height: 1.26;
  }

  .identity__summary :global(.annotated__phrase) {
    font-family: inherit;
    font-style: italic;
    font-weight: 700;
  }

  .identity__summary :global(.annotated__anchor) {
    font-weight: inherit;
  }

  /* The notes open inside the headline, so they speak in its voice: Splav
     Italic at reading size, a quieter aside between the light sentence and
     its bold italic doors. */
  .identity__summary :global(.annotated__note-text) {
    /* The italic runs narrow, so a shorter measure keeps lines near 70
       characters. */
    max-width: 31em;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.1rem, 0.4vw + 0.98rem, 1.3rem);
    letter-spacing: 0.01em;
    line-height: 1.42;
  }

  @media (max-width: 52rem) {
    .identity {
      padding:
        clamp(2.8rem, 6.5svh, 3.8rem)
        var(--page-gutter)
        0.75rem;
    }

    .identity__hello {
      font-size: 1.05rem;
    }

    .identity__summary {
      margin-top: 0.75rem;
      font-size: clamp(1.15rem, 3.6vw + 0.3rem, 1.3rem);
      line-height: 1.26;
    }

    .identity__summary :global(.annotated__note-text) {
      font-size: 1.0625rem;
    }
  }

  @media (max-width: 52rem) and (max-height: 43rem) {
    .identity {
      padding-top: clamp(2.4rem, 5.5svh, 3.2rem);
      padding-bottom: 0.6rem;
    }
  }
</style>
