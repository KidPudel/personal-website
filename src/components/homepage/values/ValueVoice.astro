---
import { valuesPremise } from '../../../content/homepage/values';
---

<div class="value-voice">
  <h2>{valuesPremise}</h2>
</div>

<style>
  .value-voice {
    width: 100%;
    margin: 0.7rem 0 0;
    text-align: center;
  }

  .value-voice h2 {
    max-width: 35rem;
    margin: 0 auto;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  @media (max-width: 50rem) {
    .value-voice {
      margin-top: 0.55rem;
    }

    .value-voice h2 {
      font-size: clamp(1.08rem, 4.8vw, 1.3rem);
    }
  }
</style>
