---
import type { CollectionEntry } from 'astro:content';

import { sitePath } from '../../../config/site';
import {
  values,
  valuesPremise,
  workPath,
  type ValueProject,
} from '../../../content/homepage/values';
import EvidenceObject from './EvidenceObject.astro';
import { valueVoiceMotion } from './value-voice-motion';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
}

const { observatory, foodProduct, chineseBee } = Astro.props;
const projectTitles: Record<ValueProject, string> = {
  Observatory: observatory.data.title,
  PizzaSushiWok: foodProduct.data.title,
  'Chinese Bee': chineseBee.data.title,
  'Discourses by Campfire': 'Discourses by Campfire',
  'Santa Foundation': 'Santa Foundation',
};
---

<value-story style={`--values-stick-top: ${valueVoiceMotion.valuesStickTopVh}svh`}>
  <section id="values" class="values-story" aria-labelledby="values-title">
    <div class="value-composition">
      <div class="value-voice" data-value-voice>
        <div class="value-voice__stack">
          <div class="value-voice__layer value-voice__layer--intro" data-voice-layer>
            <h2 id="values-title">{valuesPremise}</h2>
          </div>

          {values.map((value) => (
            <div class="value-voice__layer" data-voice-layer>
              <h3 id={`value-${value.id}`}>
                {value.before}<button
                  type="button"
                  class="word-cycle"
                  data-word-cycle
                  aria-label={`${value.words[0]}. Change this word.`}
                  disabled
                >
                  {value.words.map((word, wordIndex) => (
                    <span data-word-option hidden={wordIndex !== 0}>{word}</span>
                  ))}
                </button><span class="value-voice__after">{value.after}</span>
              </h3>
            </div>
          ))}
        </div>
      </div>

      <div class="value-chapters">
        {values.map((value) => (
          <section
            class="value-chapter"
            aria-labelledby={`value-${value.id}`}
            data-value-passage
          >
            <ol class="aspects" aria-label={`Evidence for ${value.words[0]}`}>
              {value.aspects.map((aspect) => (
                <EvidenceObject aspect={aspect} projectTitle={projectTitles[aspect.project]} />
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>

    <p class="work-path">
      <a href={sitePath('/work/')}>{workPath.label}</a>
    </p>
  </section>
</value-story>

<script>
  import './value-voice';
</script>

<style>
  value-story {
    position: relative;
    z-index: 3;
    display: block;
  }

  .values-story {
    --passage-hold: 62svh;
    --voice-width: clamp(16.5rem, 25vw, 22rem);
    --values-intro-lift: 10svh;
    position: relative;
    isolation: isolate;
    width: min(calc(100% - clamp(4rem, 7vw, 6rem)), 88rem);
    margin-inline: auto;
    margin-top: calc(-1 * var(--values-intro-lift));
    padding: 0 clamp(0.75rem, 2vw, 1.75rem) clamp(3.5rem, 6vw, 5rem);
  }

  .value-composition {
    position: relative;
    display: grid;
  }

  .value-voice,
  .value-chapters {
    grid-area: 1 / 1;
  }

  .value-voice {
    position: sticky;
    z-index: 4;
    top: max(var(--values-stick-top), 6rem);
    align-self: start;
    width: var(--voice-width);
    min-height: 9rem;
    margin-inline: auto;
    text-align: center;
    pointer-events: none;
  }

  :global(.js) .value-voice[data-identity-pin] {
    position: fixed;
    top: var(--voice-pin-top, 87svh);
    left: 0;
    right: 0;
    opacity: var(--voice-pin-opacity, 0);
  }

  .value-voice__stack {
    display: grid;
    align-items: center;
  }

  .value-voice__layer {
    min-width: 0;
    padding: 1rem 0.55rem 1.1rem;
    pointer-events: auto;
  }

  .value-voice__layer h2,
  .value-voice__layer h3 {
    margin: 0;
  }

  .value-voice__layer--intro h2 {
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .value-voice__layer h3 {
    font-family: var(--font-editorial);
    font-size: clamp(1.55rem, 2.3vw, 2.25rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.12;
  }

  .word-cycle {
    padding: 0 0 0.04em;
    border: 0;
    border-bottom: 0.1rem dotted var(--color-muted);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: var(--font-special);
    font-size: inherit;
    font-style: normal;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: inherit;
    cursor: pointer;
  }

  .word-cycle:disabled {
    color: inherit;
    cursor: default;
  }

  .word-cycle:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 0.2rem;
  }

  .word-cycle [data-word-option][hidden] {
    display: none;
  }

  .value-voice__after {
    white-space: nowrap;
  }

  :global(.js) .value-voice[data-enhanced] .value-voice__stack {
    display: grid;
  }

  :global(.js) .value-voice[data-enhanced] .value-voice__layer {
    grid-area: 1 / 1;
    color: var(--color-ink);
    filter: blur(var(--voice-blur, 0));
    opacity: var(--voice-opacity, 0);
    will-change: filter, opacity;
  }

  .value-chapters {
    position: relative;
    z-index: 1;
  }

  .value-chapter,
  .value-chapter:first-child {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--voice-width) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(24rem, auto));
    gap: clamp(1.75rem, 3.4vw, 3.25rem);
    align-items: start;
    padding: var(--passage-hold) 0 clamp(3rem, 6vw, 5.5rem);
  }

  .value-chapter:first-child {
    grid-template-rows: repeat(3, minmax(24rem, auto));
  }

  .aspects {
    display: contents;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .value-chapter :global(.aspect:nth-child(1)) {
    grid-column: 1;
    grid-row: 1;
  }

  .value-chapter :global(.aspect:nth-child(2)) {
    grid-column: 3;
    grid-row: 1;
    margin-top: clamp(12rem, 18vw, 17rem);
  }

  .value-chapter :global(.aspect:nth-child(3)) {
    grid-column: 1;
    grid-row: 2;
    margin-top: 2rem;
  }

  .value-chapter:nth-child(even) :global(.aspect:nth-child(1)),
  .value-chapter:nth-child(even) :global(.aspect:nth-child(3)) {
    grid-column: 3;
  }

  .value-chapter:nth-child(even) :global(.aspect:nth-child(2)) {
    grid-column: 1;
  }

  .value-chapter:first-child :global(.aspect:nth-child(4)) {
    grid-column: 3;
    grid-row: 2;
    margin-top: clamp(12rem, 18vw, 17rem);
  }

  .value-chapter:first-child :global(.aspect:nth-child(5)) {
    grid-column: 1;
    grid-row: 3;
    margin-top: 2rem;
  }

  :global(.js) value-story[data-enhanced] :global(.aspect) {
    opacity: 0.18;
    transform: translateY(2.25rem) rotate(0.35deg);
    transition:
      opacity 480ms ease,
      transform 620ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(.js) value-story[data-enhanced] :global(.aspect[data-revealed]) {
    opacity: 1;
    transform: none;
  }

  .work-path {
    width: min(100%, 62rem);
    margin: clamp(1.5rem, 4vw, 3rem) auto 0;
    text-align: center;
  }

  .work-path a {
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-weight: 700;
    text-decoration: none;
    padding-bottom: 0.04em;
    border-bottom: 0.1rem dotted var(--color-muted);
  }

  @media (max-width: 50rem) {
    .values-story {
      --passage-hold: 58svh;
      --voice-width: clamp(7.5rem, 36vw, 9rem);
      width: 100%;
      padding-inline: clamp(0.45rem, 2.2vw, 0.9rem);
    }

    .value-voice {
      top: max(var(--values-stick-top), 4.5rem);
      min-height: 6rem;
    }

    :global(.js) .value-voice[data-identity-pin] {
      width: min(20.5rem, calc(100% - 2.3rem));
      min-height: 0;
    }

    :global(.js) .value-voice[data-identity-pin] .value-voice__layer {
      padding: 0.2rem 0.4rem 0.35rem;
    }

    :global(.js) .value-voice[data-identity-pin] .value-voice__layer--intro h2 {
      font-size: clamp(1.2rem, 4.8vw, 1.4rem);
      line-height: 1.28;
    }

    :global(.homepage:has(#intro-contact[open])) .value-voice[data-identity-pin] {
      opacity: 0;
      pointer-events: none;
    }

    .value-voice__layer {
      padding: 0.65rem 0.35rem 0.75rem;
    }

    .value-voice__layer--intro h2 {
      font-size: clamp(0.9rem, 4vw, 1.08rem);
    }

    .value-voice__layer h3 {
      font-size: clamp(0.82rem, 3.8vw, 1.05rem);
      line-height: 1.09;
    }

    .value-chapter,
    .value-chapter:first-child {
      grid-template-columns: minmax(0, 1fr) var(--voice-width) minmax(0, 1fr);
      grid-template-rows: repeat(2, minmax(19rem, auto));
      gap: clamp(0.55rem, 2.6vw, 1rem);
      padding: var(--passage-hold) 0 clamp(3rem, 14vw, 4.5rem);
    }

    .value-chapter:first-child {
      grid-template-rows: repeat(3, minmax(19rem, auto));
    }

    .value-chapter :global(.aspect:nth-child(n)),
    .value-chapter:nth-child(even) :global(.aspect:nth-child(n)),
    .value-chapter:first-child :global(.aspect:nth-child(n)) {
      width: 100%;
      margin-top: 0;
      justify-self: stretch;
    }

    .value-chapter :global(.aspect:nth-child(2)),
    .value-chapter:first-child :global(.aspect:nth-child(2)) {
      margin-top: 7rem;
    }

    .value-chapter:first-child :global(.aspect:nth-child(4)) {
      margin-top: 7rem;
    }

    .values-story :global(.aspect__visual),
    .values-story :global(.aspect--compact .aspect__visual),
    .values-story :global(.aspect--portrait .aspect__visual) {
      width: 94%;
    }

    .values-story :global(.aspect__copy) {
      padding-top: 0.4rem;
    }

    .values-story :global(.aspect__copy p) {
      font-size: clamp(0.52rem, 2.05vw, 0.64rem);
      line-height: 1.35;
    }

    .values-story :global(.aspect__copy a) {
      margin-top: 0.28rem;
      font-size: clamp(0.48rem, 1.9vw, 0.58rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .value-voice[data-enhanced] .value-voice__layer {
      filter: none;
      will-change: auto;
    }

    :global(.js) value-story[data-enhanced] :global(.aspect) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
