---
import type { CollectionEntry } from 'astro:content';

import {
  values,
  valuesPremise,
  type ValueProject,
} from '../../../content/homepage/values';
import EvidenceObject from './EvidenceObject.astro';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
}

const { observatory, foodProduct, chineseBee } = Astro.props;
const projectTitles: Record<ValueProject, string> = {
  Observatory: observatory.data.title,
  PizzaSushiWok: foodProduct.data.title,
  'Two Sticks': chineseBee.data.title,
  'Discourses by Campfire': 'Discourses by Campfire',
  'Santa Foundation': 'Santa Foundation',
};
---

<section id="values" class="values-story" aria-labelledby="values-story-title">
  <h2 id="values-story-title" class="visually-hidden">{valuesPremise}</h2>

  <div class="value-chapters">
    {values.map((value) => (
      <section class="value-chapter" aria-labelledby={`value-${value.id}`}>
        <header class="value-chapter__heading">
          <h3 id={`value-${value.id}`}>
            {value.before}<value-word-cycle><button
                type="button"
                class="word-cycle"
                data-word-cycle
                aria-label={`${value.words[0]}. Change this word.`}
                disabled
              ><span class="word-cycle__options">
                  {value.words.map((word, index) => (
                    <span data-word-option hidden={index !== 0}>{word}</span>
                  ))}
                </span></button></value-word-cycle>{value.after}
          </h3>
        </header>

        <ol class="aspects" aria-label={`Evidence for ${value.words[0]}`}>
          {value.aspects.map((aspect) => (
            <EvidenceObject aspect={aspect} projectTitle={projectTitles[aspect.project]} />
          ))}
        </ol>
      </section>
    ))}
  </div>
</section>

<script>
  import './value-word-cycle';
</script>

<style>
  .values-story {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(2.5rem, 6svh, 5rem) 0 clamp(6rem, 14svh, 11rem);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    margin: -1px;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  .value-chapters {
    display: grid;
    gap: clamp(5rem, 13svh, 10rem);
  }

  .value-chapter {
    width: min(calc(100% - 2 * var(--page-gutter)), 76rem);
    margin-inline: auto;
  }

  .value-chapter__heading {
    width: min(100%, 52rem);
    margin: 0 auto clamp(2rem, 5svh, 3.75rem);
    text-align: center;
  }

  .value-chapter__heading h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1.75rem, 3.8vw, 3.25rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  value-word-cycle {
    display: inline-grid;
    vertical-align: baseline;
  }

  .word-cycle {
    display: inline-grid;
    padding: 0 0 0.04em;
    border: 0;
    border-bottom: 0.1rem dotted var(--color-muted);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: inherit;
    cursor: pointer;
  }

  .word-cycle:disabled {
    color: inherit;
    cursor: default;
  }

  .word-cycle:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .word-cycle__options {
    display: grid;
  }

  .word-cycle [data-word-option] {
    grid-area: 1 / 1;
  }

  :global(.js) value-word-cycle[data-ready] [data-word-option] {
    display: inline-block;
    opacity: 0;
    visibility: hidden;
    transition: opacity 220ms var(--ease-out);
  }

  :global(.js) value-word-cycle[data-ready] [data-word-option][data-word-visible] {
    visibility: visible;
  }

  :global(.js) value-word-cycle[data-ready] [data-word-option][data-word-active] {
    opacity: 1;
  }

  .aspects {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1rem, 2.25vw, 2.25rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (max-width: 68rem) {
    .value-chapter {
      width: min(calc(100% - 2 * var(--page-gutter)), 58rem);
    }

    .aspects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 50rem) {
    .values-story {
      padding-top: 3.5rem;
    }

    .value-chapters {
      gap: 5.5rem;
    }

    .value-chapter {
      width: min(calc(100% - 2rem), 30rem);
    }

    .value-chapter__heading {
      width: min(100%, 24rem);
      margin-bottom: 2rem;
    }

    .value-chapter__heading h3 {
      font-size: clamp(1.55rem, 8vw, 2.3rem);
    }

    .aspects {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) value-word-cycle[data-ready] [data-word-option] {
      transition-duration: 120ms;
    }
  }
</style>
