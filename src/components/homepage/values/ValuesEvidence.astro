---
import type { CollectionEntry } from 'astro:content';

import { sitePath } from '../../../config/site';
import {
  values,
  workPath,
  type ValueProject,
} from '../../../content/homepage/values';
import EvidenceObject from './EvidenceObject.astro';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
}

const { observatory, foodProduct, chineseBee } = Astro.props;
const projectTitles: Record<ValueProject, string> = {
  Observatory: observatory.data.title,
  PizzaSushiWok: foodProduct.data.title,
  'Chinese Bee': chineseBee.data.title,
  'Discourses by Campfire': 'Discourses by Campfire',
  'Santa Foundation': 'Santa Foundation',
};
---

<section id="values" class="values-story" aria-labelledby="values-title">
  <div class="value-composition">
    <div class="value-chapters">
      {values.map((value) => (
        <section
          class="value-chapter"
          aria-labelledby={`value-${value.id}`}
          data-value-passage
        >
          <ol class="aspects" aria-label={`Evidence for ${value.words[0]}`}>
            {value.aspects.map((aspect) => (
              <EvidenceObject aspect={aspect} projectTitle={projectTitles[aspect.project]} />
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>

  <p class="work-path">
    <a href={sitePath('/work/')}>{workPath.label}</a>
  </p>
</section>

<style>
  .values-story {
    --passage-hold: 28svh;
    --voice-width: clamp(16.5rem, 25vw, 22rem);
    --fly-duration: 520ms;
    position: relative;
    isolation: isolate;
    width: min(calc(100% - clamp(4rem, 7vw, 6rem)), 88rem);
    margin-inline: auto;
    padding: 0 clamp(0.75rem, 2vw, 1.75rem) clamp(3.5rem, 6vw, 5rem);
  }

  .value-composition {
    position: relative;
    display: grid;
  }

  .value-chapters {
    position: relative;
    z-index: 1;
  }

  .value-chapter,
  .value-chapter:first-child {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--voice-width) minmax(0, 1fr);
    grid-template-rows: minmax(18rem, auto) minmax(16rem, auto) minmax(14rem, auto);
    gap: clamp(1rem, 2.4vw, 2.25rem);
    align-items: start;
    padding: var(--passage-hold) 0 36svh;
  }

  .value-chapter:first-child {
    grid-template-rows: minmax(17rem, auto) minmax(15rem, auto) minmax(14rem, auto);
  }

  .aspects {
    display: contents;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .value-chapter :global(.aspect) {
    --from-x: 0px;
    --from-y: 36vh;
  }

  .value-chapter :global(.aspect:nth-child(1)) {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    width: min(100%, 31rem);
    --from-x: 22vw;
    --from-y: 42vh;
  }

  .value-chapter :global(.aspect:nth-child(2)) {
    grid-column: 3;
    grid-row: 1;
    justify-self: start;
    width: min(100%, 27rem);
    margin-top: clamp(6rem, 10vw, 11rem);
    --from-x: -24vw;
    --from-y: 38vh;
  }

  .value-chapter :global(.aspect:nth-child(3)) {
    grid-column: 1;
    grid-row: 2;
    justify-self: end;
    width: min(88%, 22rem);
    margin-top: clamp(0.5rem, 2vw, 2rem);
    --from-x: 12vw;
    --from-y: 22vh;
  }

  .value-chapter:nth-child(even) :global(.aspect:nth-child(1)) {
    grid-column: 3;
    justify-self: start;
    --from-x: -22vw;
  }

  .value-chapter:nth-child(even) :global(.aspect:nth-child(2)) {
    grid-column: 1;
    justify-self: end;
    --from-x: 24vw;
  }

  .value-chapter:nth-child(even) :global(.aspect:nth-child(3)) {
    grid-column: 3;
    justify-self: start;
    --from-x: -12vw;
  }

  .value-chapter:first-child :global(.aspect:nth-child(4)) {
    grid-column: 3;
    grid-row: 2;
    justify-self: start;
    width: min(88%, 23rem);
    margin-top: clamp(5rem, 8vw, 9rem);
    --from-x: -16vw;
    --from-y: 24vh;
  }

  .value-chapter:first-child :global(.aspect:nth-child(5)) {
    grid-column: 1;
    grid-row: 3;
    justify-self: end;
    width: min(82%, 20rem);
    --from-x: 10vw;
    --from-y: 16vh;
  }

  :global(.js) :global(value-story[data-enhanced]) .value-chapter :global(.aspect) {
    opacity: 0;
    transform: translate3d(var(--from-x), var(--from-y), 0) scale(0.92);
    transition:
      opacity 300ms cubic-bezier(0.23, 1, 0.32, 1) var(--fly-delay, 0ms),
      transform var(--fly-duration) cubic-bezier(0.23, 1, 0.32, 1) var(--fly-delay, 0ms);
  }

  :global(.js) :global(value-story[data-enhanced]) .value-chapter :global(.aspect:nth-child(1)) { --fly-delay: 0ms; }
  :global(.js) :global(value-story[data-enhanced]) .value-chapter :global(.aspect:nth-child(2)) { --fly-delay: 60ms; }
  :global(.js) :global(value-story[data-enhanced]) .value-chapter :global(.aspect:nth-child(3)) { --fly-delay: 120ms; }
  :global(.js) :global(value-story[data-enhanced]) .value-chapter :global(.aspect:nth-child(4)) { --fly-delay: 180ms; }
  :global(.js) :global(value-story[data-enhanced]) .value-chapter :global(.aspect:nth-child(5)) { --fly-delay: 240ms; }

  :global(.js) :global(value-story[data-enhanced]) .value-chapter :global(.aspect[data-revealed]) {
    opacity: 1;
    transform: none;
  }

  .work-path {
    width: min(100%, 62rem);
    margin: clamp(1.5rem, 4vw, 3rem) auto 0;
    text-align: center;
  }

  .work-path a {
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-weight: 700;
    text-decoration: none;
    padding-bottom: 0.04em;
    border-bottom: 0.1rem dotted var(--color-muted);
  }

  @media (max-width: 50rem) {
    .values-story {
      --passage-hold: 72svh;
      width: 100%;
      padding-inline: clamp(0.75rem, 4vw, 1.25rem);
    }

    .value-chapter,
    .value-chapter:first-child {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-rows: minmax(14rem, auto);
      gap: clamp(3.5rem, 12svh, 6rem);
      padding: var(--passage-hold) 0 34svh;
    }

    .value-chapter:first-child {
      grid-template-rows: none;
    }

    .value-chapter :global(.aspect:nth-child(n)),
    .value-chapter:nth-child(even) :global(.aspect:nth-child(n)),
    .value-chapter:first-child :global(.aspect:nth-child(n)) {
      width: 100%;
      margin-top: 0;
      grid-column: 1;
      grid-row: auto;
      --from-x: 0px;
      --from-y: 22vh;
    }

    .value-chapter :global(.aspect:nth-child(odd)),
    .value-chapter:first-child :global(.aspect:nth-child(odd)) {
      justify-self: start;
      width: min(76vw, 19rem);
    }

    .value-chapter :global(.aspect:nth-child(even)),
    .value-chapter:first-child :global(.aspect:nth-child(even)) {
      justify-self: end;
      width: min(76vw, 19rem);
    }

    .values-story :global(.aspect__visual),
    .values-story :global(.aspect--compact .aspect__visual),
    .values-story :global(.aspect--portrait .aspect__visual) {
      width: 94%;
    }

    .values-story :global(.aspect__copy) {
      padding-top: 0.4rem;
    }

    .values-story :global(.aspect__copy p) {
      font-size: clamp(0.78rem, 3.4vw, 0.9rem);
      line-height: 1.45;
    }

    .values-story :global(.aspect__copy a) {
      margin-top: 0.4rem;
      font-size: clamp(0.72rem, 3vw, 0.82rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) :global(value-story[data-enhanced]) .value-chapter :global(.aspect) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
