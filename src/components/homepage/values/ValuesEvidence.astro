---
import type { CollectionEntry } from 'astro:content';

import {
  values,
  type ValueProject,
} from '../../../content/homepage/values';
import EvidenceObject from './EvidenceObject.astro';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
}

const { observatory, foodProduct, chineseBee } = Astro.props;
const projectTitles: Record<ValueProject, string> = {
  Observatory: observatory.data.title,
  PizzaSushiWok: foodProduct.data.title,
  'Chinese Bee': chineseBee.data.title,
  'Discourses by Campfire': 'Discourses by Campfire',
  'Santa Foundation': 'Santa Foundation',
};
---

<section id="values" class="values-story" aria-labelledby="values-title">
  <div class="value-composition">
    <div class="value-chapters">
      {values.map((value) => (
        <section
          class="value-chapter"
          aria-labelledby={`value-${value.id}`}
          data-value-passage
        >
          <ol class="aspects" aria-label={`Evidence for ${value.words[0]}`} data-evidence-deck>
            {value.aspects.map((aspect) => (
              <EvidenceObject aspect={aspect} projectTitle={projectTitles[aspect.project]} />
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>

</section>

<style>
  .values-story {
    position: relative;
    isolation: isolate;
    width: 100%;
    margin-inline: auto;
    padding: 0 0 clamp(3.5rem, 7vw, 6rem);
  }

  .value-composition {
    position: relative;
  }

  .value-chapters {
    position: relative;
    z-index: 2;
  }

  .value-chapter {
    position: relative;
    min-height: 120svh;
  }

  .value-chapter:first-child {
    min-height: 140svh;
  }

  .aspects {
    display: grid;
    width: min(calc(100% - 2rem), 68rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    padding: 0;
    margin: 0 auto;
    list-style: none;
  }

  :global(.js) :global(value-story[data-enhanced]) .aspects {
    position: fixed;
    z-index: 2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100svh;
    pointer-events: none;
  }

  /* Chapters fill the viewport as scroll-timing surfaces. They should not
     block the value-word control beneath them; active cards opt back in. */
  :global(.js) :global(value-story[data-enhanced]) .values-story,
  :global(.js) :global(value-story[data-enhanced]) .value-composition,
  :global(.js) :global(value-story[data-enhanced]) .value-chapters,
  :global(.js) :global(value-story[data-enhanced]) .value-chapter {
    pointer-events: none;
  }

  :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect) {
    position: absolute;
    opacity: 0;
    translate: -50% 0;
    pointer-events: none;
    transform-origin: 50% 24%;
    will-change: transform, opacity;
  }

  :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(1)) {
    z-index: 5;
    top: 38svh;
    left: 50%;
    width: min(27vw, 24rem);
  }

  :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(2)) {
    z-index: 4;
    top: 44svh;
    left: 24%;
    width: min(21vw, 18rem);
  }

  :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(3)) {
    z-index: 4;
    top: 44svh;
    left: 76%;
    width: min(21vw, 18rem);
  }

  :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(4)) {
    z-index: 3;
    top: 50svh;
    left: 9%;
    width: min(17vw, 14.5rem);
  }

  :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(5)) {
    z-index: 3;
    top: 50svh;
    left: 91%;
    width: min(17vw, 14.5rem);
  }

  @media (max-width: 50rem) {
    .values-story {
      width: 100%;
    }

    .value-chapter {
      min-height: 128svh;
    }

    .value-chapter:first-child {
      min-height: 150svh;
    }

    .aspects {
      grid-template-columns: 1fr;
    }

    :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(1)) {
      top: 28svh;
      left: 50%;
      width: min(64vw, 18rem);
    }

    :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(2)) {
      top: 48svh;
      left: 24%;
      width: min(44vw, 12.5rem);
    }

    :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(3)) {
      top: 48svh;
      left: 76%;
      width: min(44vw, 12.5rem);
    }

    :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(4)) {
      top: 64svh;
      left: 20%;
      width: min(35vw, 10.5rem);
    }

    :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(5)) {
      top: 64svh;
      left: 80%;
      width: min(35vw, 10.5rem);
    }

    .values-story :global(.aspect__visual img) {
      height: min(15svh, 7.5rem);
    }

    .values-story :global(.aspect:nth-child(1) .aspect__visual img) {
      height: min(17svh, 8.5rem);
    }

    .values-story :global(.aspect__copy) {
      padding-top: 0.48rem;
    }

    .values-story :global(.aspect__copy p) {
      font-size: clamp(0.78rem, 3.4vw, 0.9rem);
      line-height: 1.45;
    }

    .values-story :global(.aspect__copy a) {
      margin-top: 0.4rem;
      font-size: clamp(0.72rem, 3vw, 0.82rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-chapter {
      min-height: auto;
      padding: 3rem 0;
    }

    :global(.js) :global(value-story[data-enhanced]) .aspects {
      position: static;
      display: grid;
      width: min(calc(100% - 2rem), 68rem);
      height: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-inline: auto;
    }

    :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(n)) {
      position: relative;
      inset: auto;
      width: auto;
      opacity: 1;
      translate: none;
      transform: none;
      will-change: auto;
    }
  }

  @media (max-width: 50rem) and (prefers-reduced-motion: reduce) {
    :global(.js) :global(value-story[data-enhanced]) .aspects {
      grid-template-columns: 1fr;
      width: min(calc(100% - 2rem), 22rem);
    }

    :global(.js) :global(value-story[data-enhanced]) .aspects :global(.aspect:nth-child(n)) {
      width: 100%;
    }
  }
</style>
