---
import { Image } from 'astro:assets';
import type { ValueAspect } from '../../../content/homepage/values';
import { sitePath } from '../../../config/site';

interface Props {
  aspect: ValueAspect;
  projectTitle: string;
  position: number;
}

const { aspect, projectTitle, position } = Astro.props;
const portrait = aspect.image.height > aspect.image.width;
const compact = !portrait && aspect.image.width / aspect.image.height < 1.35;
const imageSizes = position === 0
  ? '(max-width: 50rem) 64vw, 27vw'
  : position < 3
    ? '(max-width: 50rem) 44vw, 21vw'
    : '(max-width: 50rem) 35vw, 17vw';

function evidenceTilt(seed: string): string {
  let hash = 2166136261;
  for (let i = 0; i < seed.length; i += 1) {
    hash ^= seed.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  const unsigned = hash >>> 0;
  const magnitude = 1.5 + (unsigned % 24) / 10;
  const sign = unsigned % 2 === 0 ? -1 : 1;
  return `${sign * magnitude}deg`;
}

const tilt = evidenceTilt(`${aspect.project}:${aspect.shot}`);
const caseStudyHrefByProject: Record<string, string> = {
  Observatory: sitePath('/case-studies/observatory/'),
  PizzaSushiWok: sitePath('/case-studies/supergood/'),
  'Two Sticks': sitePath('/case-studies/two-sticks/'),
};
const caseStudyHref = aspect.caseStudy ? caseStudyHrefByProject[aspect.project] : undefined;
---

<li
  class:list={[
    'aspect',
    portrait && 'aspect--portrait',
    compact && 'aspect--compact',
  ]}
  data-aspect
  data-target-tilt={tilt}
>
  <div class="aspect__visual">
    <Image
      src={aspect.image}
      alt={`${aspect.shot} from ${projectTitle}`}
      widths={[240, 360, 480, 640, 768]}
      sizes={imageSizes}
      format="webp"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="aspect__copy">
    <p>{aspect.caption}</p>
    {caseStudyHref && (
      <a href={caseStudyHref}>
        See this in the case study <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</li>

<style>
  .aspect {
    position: relative;
    min-width: 0;
    align-self: start;
    padding: 0.48rem 0.48rem 0.62rem;
    border-radius: 0.95rem;
    background: #fff;
    box-shadow: 0 0.3rem 1.15rem rgb(17 17 15 / 0.09);
  }

  .aspect__visual {
    width: 100%;
  }

  .aspect--compact .aspect__visual {
    width: 100%;
  }

  .aspect--portrait .aspect__visual {
    width: 100%;
  }

  .aspect__visual img {
    display: block;
    width: 100%;
    height: min(22svh, 12rem);
    object-fit: contain;
    border-radius: 0.58rem;
  }

  .aspect__copy {
    padding: 0.62rem 0.18rem 0;
  }

  .aspect__copy p {
    margin: 0;
    color: var(--color-copy);
    font-family: var(--font-reading);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .aspect__copy a {
    display: inline-block;
    margin-top: 0.45rem;
    font-family: var(--font-reading);
    font-size: 0.82rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35rem;
  }
</style>
