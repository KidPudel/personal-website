---
import type { ValueAspect } from '../../../content/homepage/values';
import { sitePath } from '../../../config/site';

interface Props {
  aspect: ValueAspect;
  projectTitle: string;
}

const { aspect, projectTitle } = Astro.props;
const portrait = aspect.image.height > aspect.image.width;
const compact = !portrait && aspect.image.width / aspect.image.height < 1.35;

function evidenceTilt(seed: string): string {
  let hash = 2166136261;
  for (let i = 0; i < seed.length; i += 1) {
    hash ^= seed.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  const unsigned = hash >>> 0;
  const magnitude = 1.5 + (unsigned % 24) / 10;
  const sign = unsigned % 2 === 0 ? -1 : 1;
  return `${sign * magnitude}deg`;
}

const tilt = evidenceTilt(`${aspect.project}:${aspect.shot}`);
---

<li
  class:list={[
    'aspect',
    portrait && 'aspect--portrait',
    compact && 'aspect--compact',
  ]}
  data-aspect
>
  <div class="aspect__visual" style={`--tilt: ${tilt}`}>
    <img
      src={aspect.image.src}
      width={aspect.image.width}
      height={aspect.image.height}
      alt={`${aspect.shot} from ${projectTitle}`}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="aspect__copy">
    <p>{aspect.caption}</p>
    {aspect.caseStudy && (
      <a href={sitePath('/case-studies/observatory/')}>
        See this in the case study <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</li>

<style>
  .aspect {
    position: relative;
    min-width: 0;
    align-self: start;
  }

  .aspect__visual {
    width: min(100%, 31rem);
    padding: 0.42rem;
    border-radius: 0.95rem;
    background: #fff;
    box-shadow: 0 0.22rem 0.85rem rgb(17 17 15 / 0.07);
    rotate: var(--tilt, -2deg);
  }

  .aspect--compact .aspect__visual {
    width: min(88%, 25rem);
  }

  .aspect--portrait .aspect__visual {
    width: min(68%, 18rem);
  }

  .aspect__visual img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.58rem;
  }

  .aspect__copy {
    padding-top: 0.7rem;
  }

  .aspect__copy p {
    margin: 0;
    color: var(--color-copy);
    font-family: var(--font-reading);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .aspect__copy a {
    display: inline-block;
    margin-top: 0.45rem;
    font-family: var(--font-reading);
    font-size: 0.82rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35rem;
  }
</style>
