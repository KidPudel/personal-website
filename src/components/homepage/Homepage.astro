---
import type { CollectionEntry } from 'astro:content';

import ElasticOverscrollBackdrop from './ElasticOverscrollBackdrop.astro';
import IdentityIntroduction from './identity/IdentityIntroduction.astro';
import OpeningSequence from './opening/OpeningSequence.astro';
import PersonalNote from './personal/PersonalNote.astro';
import PortfolioHeader from './PortfolioHeader.astro';
import ValuesEvidence from './values/ValuesEvidence.astro';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
}

const { observatory, foodProduct, chineseBee } = Astro.props;
---

<ElasticOverscrollBackdrop placement="top" />
<ElasticOverscrollBackdrop placement="bottom" />

<div class="homepage" data-homepage>
  <main id="main-content">
    <OpeningSequence>
      <IdentityIntroduction />
    </OpeningSequence>

    <ValuesEvidence {observatory} {foodProduct} {chineseBee} />
    <PersonalNote />
    <PortfolioHeader current="home" placement="footer" contactId="contact" />
  </main>

</div>

<style>
  .homepage {
    position: relative;
    z-index: 1;
    min-width: 20rem;
    overflow-x: clip;
    background: var(--color-field);
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.95rem, 0.12vw + 0.93rem, 1.02rem);
    line-height: 1.62;
  }

  :global(.homepage-document[data-elastic-edge]) .homepage {
    transform: translate3d(
      0,
      calc(var(--elastic-top-pull, 0px) - var(--elastic-bottom-pull, 0px)),
      0
    );
    will-change: transform;
  }

  :global(.homepage-document[data-elastic-top-edge]) .homepage {
    background: #6f8aff;
  }

  :global(html.homepage-document[data-elastic-top-edge]),
  :global(html.homepage-document[data-elastic-top-edge] body) {
    background: #6f8aff;
  }
</style>
