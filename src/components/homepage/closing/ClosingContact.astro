---
import { connectLinks, publicEmail, resumeLink } from '../../../config/site';
import { toLocale, translator } from '../../../i18n/locales';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
// The header already says "Get in touch", so the heading here is for assistive tech only.
// Email leads as the address itself; the rest follow as a quiet line.
const [email, ...others] = connectLinks(locale);
const resume = resumeLink(locale);
const elsewhere = [...others, { label: resume.file, href: resume.href }];
---

<footer id="contact" class="closing-contact" aria-labelledby="closing-contact-title">
  <h2 id="closing-contact-title" class="sr-only">{t('Get in touch', 'Связаться')}</h2>

  <a class="closing-contact__email" href={email.href}><span class="link-mark">{publicEmail}</span></a>

  <ul class="closing-contact__links" role="list">
    {elsewhere.map((link) => (
      <li><a href={link.href}><span class="link-mark">{link.label}</span></a></li>
    ))}
  </ul>
</footer>

<style>
  .closing-contact {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--page-frame));
    margin-inline: auto;
    /* The last thing on the page: the pause above it comes from the personal
       note, and it ends close to the bottom edge. */
    padding: 0 0 clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-ink);
  }

  .closing-contact__email {
    display: inline-block;
    max-width: 100%;
    color: inherit;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .closing-contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1.1rem, 2.2vw, 2rem);
    margin: 0.6rem 0 0;
    padding: 0;
    font-family: var(--font-reading);
    font-size: clamp(0.9rem, 0.2vw + 0.86rem, 1rem);
    letter-spacing: 0.025em;
    list-style: none;
  }

  /* Every link is at least a fingertip wide, even a one-letter name like X. */
  .closing-contact__links a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .closing-contact a:focus-visible {
    border-radius: 0.08em;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  @media (max-width: 52rem) {
    /* On narrow screens the fixed balloon is inside the frame, so the
       footer ends just above it. */
    .closing-contact {
      width: min(calc(100% - 2 * var(--page-gutter)), 36rem);
      padding-bottom: calc(clamp(5.4rem, 7.8vw, 7rem) + max(0.35rem, env(safe-area-inset-bottom)) + 0.5rem);
    }

    .closing-contact__links {
      font-size: 0.95rem;
    }
  }

  /* On phones the row can't fit on one line, so the links sit in two even
     rows of columns rather than leaving one word alone on the second. */
  @media (max-width: 30rem) {
    .closing-contact__links {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      column-gap: clamp(1.6rem, 8vw, 2.25rem);
    }
  }
</style>
