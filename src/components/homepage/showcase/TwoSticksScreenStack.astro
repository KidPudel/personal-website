    <div class="two-sticks-demo__header" aria-hidden="true">
      <span class="two-sticks-demo__back">‹</span>
      <span class="two-sticks-demo__avatar">🐝</span>
      <span class="two-sticks-demo__identity">
        <strong>Две палочки</strong>
        <small>бот</small>
      </span>
      <span class="two-sticks-demo__more">•••</span>
    </div>

    <div class="two-sticks-demo__conversation">
      <section class="two-sticks-demo__step" data-demo-step="0" data-state-active>
        <span class="two-sticks-demo__day">Сегодня</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--bot">
          <strong>Что умеет этот бот?</strong><br />
          Привет! Я китайская пчелка бот 🐝 Моя главная задача, помочь тебе легко и интуитивно изучать китайские иероглифы! 🇨🇳
        </span>
        <span class="two-sticks-demo__message two-sticks-demo__message--bot">
          Привет, Анастасия! Как насчет улучшить свой китайский?<br /><br />
          Прежде чем начать, хочешь узнать о том как устроены иероглифы?
        </span>
        <span class="two-sticks-demo__actions">
          <span>Да, хочу!</span><span>Уже знаю</span>
        </span>
      </section>

      <section class="two-sticks-demo__step" data-demo-step="1" aria-hidden="true">
        <span class="two-sticks-demo__day">Сегодня</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--user">Да, хочу!</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--bot">
          <strong>Письменность</strong><br /><br />
          Иероглифы: Китайская письменность состоит из иероглифов, каждый из которых представляет собой слово или морфему. Иероглифы могут состоять из одного или более ключей и фонетических компонентов.
        </span>
        <span class="two-sticks-demo__actions">
          <span>Далее</span><span>Назад</span>
        </span>
      </section>

      <section class="two-sticks-demo__step" data-demo-step="2" aria-hidden="true">
        <span class="two-sticks-demo__day">Сегодня</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--user">/chinese_match</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--bot">Введи слово, которое ты ищешь 🔎</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--user">Идти</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--bot two-sticks-demo__message--results">
          Вот что удалось найти ✨<br /><br />
          去 · идти<br />
          上学 · идти в школу<br />
          上班 · идти на работу<br />
          步行 · идти пешком<br />
          深入 · идти вглубь
        </span>
        <span class="two-sticks-demo__actions"><span>去 · идти</span></span>
      </section>

      <section class="two-sticks-demo__step" data-demo-step="3" aria-hidden="true">
        <span class="two-sticks-demo__day">Сегодня</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--user">去</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--bot two-sticks-demo__message--details">
          <span><small>chinese</small><strong>去</strong></span>
          <span><small>pinyin</small><strong>qù</strong></span>
          <span><small>english</small><strong>go</strong></span>
          <span><small>russian</small><strong>идти</strong></span>
          <span><small>hsk level</small><strong>1</strong></span>
        </span>
        <span class="two-sticks-demo__actions">
          <span>Сохранить</span><span>Назад</span>
        </span>
      </section>

      <section class="two-sticks-demo__step" data-demo-step="4" aria-hidden="true">
        <span class="two-sticks-demo__day">Сегодня</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--user">/saved_words</span>
        <span class="two-sticks-demo__message two-sticks-demo__message--bot two-sticks-demo__message--word-list">
          <span>去 <small>идти</small></span>
          <span>工作 <small>работа</small></span>
          <span>旁边 <small>рядом с собой</small></span>
          <span>家 <small>дом; здание</small></span>
          <span>快 <small>быстрый; срочный</small></span>
        </span>
        <span class="two-sticks-demo__message two-sticks-demo__message--bot">Начать практиковаться в правописании?</span>
        <span class="two-sticks-demo__actions">
          <span>Да</span><span>Открыть прописи</span>
        </span>
      </section>

      <section class="two-sticks-demo__step two-sticks-demo__step--writing" data-demo-step="5" aria-hidden="true">
        <span class="two-sticks-demo__webapp-bar">Отмена <strong>Две палочки</strong> •••</span>
        <span class="two-sticks-demo__word">идти</span>
        <span class="two-sticks-demo__canvas" aria-label="Handwritten Chinese character qu">去</span>
        <span class="two-sticks-demo__webapp-actions">
          <span>Очистить</span><span>Проверить</span>
        </span>
        <span class="two-sticks-demo__next">Следующее слово</span>
        <strong class="two-sticks-demo__score">90.77666401863098%</strong>
      </section>
    </div>

    <span class="two-sticks-demo__hint" aria-hidden="true">
      <span data-demo-progress>Click to continue · 1/{steps.length}</span>
      <i></i>
    </span>
  </div>

  <button
    class="two-sticks-demo__trigger"
    type="button"
    data-foley-hover="on"
    data-foley-click="switch"
    aria-label={`Advance Two Sticks bot demo. Step 1 of ${steps.length}: ${steps[0]}`}
  >
    <span class="visually-hidden">Advance the Two Sticks bot demo</span>
  </button>
</two-sticks-demo>

<script>
  import { panFor, play } from '@foleyjs/core';

  class TwoSticksDemo extends HTMLElement {
    private abort?: AbortController;
    private index = 0;
    private steps: string[] = [];

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      this.steps = JSON.parse(this.dataset.steps ?? '[]');
      const trigger = this.querySelector<HTMLButtonElement>('.two-sticks-demo__trigger');
      trigger?.addEventListener('click', this.advance, { signal: this.abort.signal });
      trigger?.addEventListener('pointerleave', this.playHoverOff, {
        signal: this.abort.signal,
      });
      this.render();
    }

    disconnectedCallback() {
      this.abort?.abort();
    }

    private advance = () => {
      this.index = (this.index + 1) % this.steps.length;
      this.render();
    };

    private playHoverOff = (event: PointerEvent) => {
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      play('off', { pan: panFor(event.currentTarget as HTMLElement) });
    };

    private render() {
      this.dataset.step = String(this.index);

      this.querySelectorAll<HTMLElement>('[data-demo-step]').forEach((step, index) => {
        const state = index === this.index ? 'active' : index < this.index ? 'past' : 'next';
        step.toggleAttribute('data-state-active', state === 'active');
        step.toggleAttribute('data-state-past', state === 'past');
        step.setAttribute('aria-hidden', String(state !== 'active'));
      });

      const trigger = this.querySelector<HTMLButtonElement>('.two-sticks-demo__trigger');
      trigger?.setAttribute(
        'aria-label',
        `${this.index === this.steps.length - 1 ? 'Restart' : 'Advance'} Two Sticks bot demo. Step ${this.index + 1} of ${this.steps.length}: ${this.steps[this.index]}`,
      );

      const progress = this.querySelector<HTMLElement>('[data-demo-progress]');
      if (progress) {
        progress.textContent = `${this.index === this.steps.length - 1 ? 'Click to restart' : 'Click to continue'} · ${this.index + 1}/${this.steps.length}`;
      }
    }
  }

  if (!customElements.get('two-sticks-demo')) {
    customElements.define('two-sticks-demo', TwoSticksDemo);
  }
</script>

<style>
  .two-sticks-demo {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: inherit;
    container-type: inline-size;
  }

  .two-sticks-demo__phone {
    position: absolute;
    top: 17%;
    left: 50%;
    height: 80%;
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border: clamp(0.25rem, 1.7cqi, 0.46rem) solid #09090b;
    border-radius: clamp(1.3rem, 7.5cqi, 2.15rem);
    background: #111114;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.2),
      0 0 0 2px rgb(17 17 15 / 0.42),
      0 1rem 2.2rem rgb(17 17 15 / 0.34);
    color: #f5f5f6;
