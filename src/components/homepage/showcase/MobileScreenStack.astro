---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Screen {
  src: ImageMetadata;
  label: string;
  /** The phone's opaque bounds inside the mockup: x, y, width, height. */
  device: [number, number, number, number];
}

interface Props {
  screens: Screen[];
  ariaLabel: string;
}

const { screens, ariaLabel } = Astro.props;

// Circular distance from the active screen (index 0), so the fan is symmetric:
// with six screens the offsets are 0, 1, 2, 3, -2, -1 and 3 waits out of view.
// The fan sits in the first viewport, so its visible phones load with the page.
const offsetOf = (index: number) => (index > screens.length / 2 ? index - screens.length : index);

// The box is the device itself; the image is scaled and shifted inside it so
// transparent padding in the mockup never moves a phone off the axis.
const getScreenStyle = ({ src, device: [x, y, width, height] }: Screen) =>
  [
    `--device-ratio: ${width} / ${height}`,
    `--image-width: ${(src.width / width) * 100}%`,
    `--image-height: ${(src.height / height) * 100}%`,
    `--image-left: ${(-x / width) * 100}%`,
    `--image-top: ${(-y / height) * 100}%`,
  ].join('; ');
---

<mobile-screen-stack class="mobile-stack">
  <button type="button" class="mobile-stack__trigger" aria-label={ariaLabel}>
    {screens.map((screen, index) => (
      <span
        class="mobile-stack__screen"
        data-foley-hover="tick"
        data-offset={offsetOf(index)}
        style={getScreenStyle(screen)}
      >
        <Image
          src={screen.src}
          alt=""
          widths={[240, 360, 480, 600]}
          sizes="(max-width: 44rem) 36vw, (max-width: 75rem) 26vw, 20vw"
          loading={Math.abs(offsetOf(index)) <= 2 ? 'eager' : 'lazy'}
          decoding="async"
          format="webp"
          quality={85}
        />
      </span>
    ))}
  </button>
</mobile-screen-stack>

<script>
  import { panFor, play } from '@foleyjs/core';

  class MobileScreenStack extends HTMLElement {
    private abort?: AbortController;
    private active = 0;

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const trigger = this.querySelector<HTMLButtonElement>('.mobile-stack__trigger');
      trigger?.addEventListener('click', this.select, { signal: this.abort.signal });
    }

    disconnectedCallback() {
      this.abort?.abort();
    }

    // The front phone advances the journey; a side phone swings to the front.
    private select = (event: MouseEvent) => {
      const screens = Array.from(this.querySelectorAll<HTMLElement>('.mobile-stack__screen'));
      const clicked = event.target instanceof Element
        ? event.target.closest<HTMLElement>('.mobile-stack__screen')
        : null;
      const clickedOffset = Number(clicked?.dataset.offset ?? 0);
      const step = clicked && clickedOffset !== 0 ? clickedOffset : 1;
      const count = screens.length;

      this.active = (this.active + step + count) % count;
      play('swoosh', { pan: panFor(screens[this.active]) });

      screens.forEach((screen, index) => {
        const current = Number(screen.dataset.offset);
        let next = (index - this.active + count) % count;
        if (next > count / 2) next -= count;

        const hidden = Math.abs(next) > 2;
        if (hidden) {
          // Leave toward the side the phone was already travelling to.
          const travelled = current - step;
          next = Math.sign(travelled || current || 1) * 3;
        } else if (Math.abs(current) > 2 && Math.sign(current) !== Math.sign(next)) {
          // Re-enter from the near edge instead of sweeping across the front.
          this.snap(screen, String(-current));
        }

        screen.dataset.offset = String(next);
      });
    };

    private snap(screen: HTMLElement, offset: string) {
      screen.style.transition = 'none';
      screen.dataset.offset = offset;
      void screen.offsetWidth;
      screen.style.transition = '';
    }
  }

  if (!customElements.get('mobile-screen-stack')) {
    customElements.define('mobile-screen-stack', MobileScreenStack);
  }
</script>

<style>
  .mobile-stack {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: inherit;
  }

  .mobile-stack__trigger {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-stack__trigger:focus-visible {
    border-radius: inherit;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(-1 * var(--focus-width));
  }

  /* Phones fan around a shared pivot below the card, like cards held in a
     hand: each sits on the same arc and shrinks around its own base. */
  .mobile-stack__screen {
    --turn: 0deg;
    --size: 1;

    position: absolute;
    bottom: 7%;
    left: 50%;
    display: block;
    height: 82%;
    aspect-ratio: var(--device-ratio);
    filter: drop-shadow(0 0.75rem 1rem rgb(17 17 15 / 0.24));
    transform:
      translateX(-50%)
      translateY(140%) rotate(var(--turn)) translateY(-140%)
      scale(var(--size));
    transform-origin: 50% 100%;
    transition:
      transform 620ms var(--ease-out),
      translate 240ms var(--ease-out),
      opacity 320ms var(--ease-out);
  }

  .mobile-stack__screen :global(img) {
    position: absolute;
    top: var(--image-top);
    left: var(--image-left);
    display: block;
    width: var(--image-width);
    max-width: none;
    height: var(--image-height);
  }

  .mobile-stack__screen[data-offset='0'] {
    z-index: 4;
  }

  .mobile-stack__screen[data-offset='1'],
  .mobile-stack__screen[data-offset='-1'] {
    z-index: 3;
  }

  .mobile-stack__screen[data-offset='2'],
  .mobile-stack__screen[data-offset='-2'] {
    z-index: 2;
  }

  .mobile-stack__screen[data-offset='3'],
  .mobile-stack__screen[data-offset='-3'] {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .mobile-stack__screen[data-offset='1'] { --turn: 11deg; --size: 0.88; }
  .mobile-stack__screen[data-offset='-1'] { --turn: -11deg; --size: 0.88; }
  .mobile-stack__screen[data-offset='2'] { --turn: 21deg; --size: 0.76; }
  .mobile-stack__screen[data-offset='-2'] { --turn: -21deg; --size: 0.76; }
  .mobile-stack__screen[data-offset='3'] { --turn: 31deg; --size: 0.66; }
  .mobile-stack__screen[data-offset='-3'] { --turn: -31deg; --size: 0.66; }

  @media (max-width: 44rem) {
    .mobile-stack__screen {
      bottom: 8%;
      height: 78%;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .mobile-stack__screen:hover {
      translate: 0 -3%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-stack__screen {
      translate: none !important;
      transition: none;
    }
  }
</style>
