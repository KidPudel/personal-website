---
import { Image } from 'astro:assets';

import entranceIcon from '../../../assets/art/icons/Doodles_entrance.png';
import card1 from '../../../assets/showcase-cards/card1.png';
import card2 from '../../../assets/showcase-cards/card2.png';
import card3 from '../../../assets/showcase-cards/card3.png';
import { sitePath } from '../../../config/site';
import ObservatoryScreenStack from './ObservatoryScreenStack.astro';
import ShowcaseInfo from './ShowcaseInfo.astro';
import SupergoodScreenStack from './SupergoodScreenStack.astro';
import TwoSticksScreenStack from './TwoSticksScreenStack.astro';

const cards = [
  {
    background: card1,
    name: 'Observatory',
    pitch: 'Activity Monitor, but more.',
    responsibility: 'Concept to launch: product design, identity, and storytelling.',
    href: sitePath('/case-studies/observatory/'),
  },
  {
    background: card2,
    name: 'SuperGood',
    pitch: 'Homemade food, without making the order feel like a gamble.',
    responsibility: 'Research, product direction, UX/UI, and Flutter implementation.',
    href: sitePath('/case-studies/supergood/'),
  },
  {
    background: card3,
    name: 'Two Sticks',
    pitch: 'Write the character, without leaving the chat.',
    responsibility: 'Product direction, UX/UI, bot, API, and handwriting app.',
    href: sitePath('/case-studies/two-sticks/'),
  },
];
---

<div class="showcase">
  <div class="showcase__grid">
    {cards.map((card, index) => (
      <article
        class:list={[
          'showcase__card',
          `showcase__card--${index + 1}`,
          index > 0 && 'showcase__card--portrait',
        ]}
      >
        <Image
          class="showcase__background"
          src={card.background}
          alt=""
          widths={[480, 720, 960, 1280, 1600]}
          sizes="(max-width: 44rem) calc(100vw - 2rem), 64vw"
          loading="lazy"
          decoding="async"
          format="webp"
          quality={82}
        />
        {index === 0 && <ObservatoryScreenStack />}
        {index === 1 && <SupergoodScreenStack />}
        {index === 2 && <TwoSticksScreenStack />}
        <ShowcaseInfo pitch={card.pitch} responsibility={card.responsibility} />
        <a
          class="showcase__project-link"
          href={card.href}
          aria-label={`Open the ${card.name} case study`}
          title={`Open the ${card.name} case study`}
        >
          <Image
            class="showcase__project-link-icon"
            src={entranceIcon}
            alt=""
            widths={[160, 240, 320]}
            sizes="(max-width: 44rem) 6.6rem, 8.4rem"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={90}
          />
        </a>
      </article>
    ))}
  </div>
</div>

<style>
  .showcase {
    width: 100%;
    padding: clamp(6rem, 11vw, 10rem) 0 clamp(7rem, 12vw, 11rem);
  }

  .showcase__grid {
    width: min(calc(100% - 2 * clamp(1.5rem, 5vw, 5rem)), 90rem);
    margin-inline: auto;
  }

  .showcase__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(2, minmax(12.5rem, 1fr));
    align-items: stretch;
    gap: clamp(0.85rem, 1.4vw, 1.35rem);
  }

  .showcase__card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    aspect-ratio: 4 / 3;
    border-radius: clamp(0.8rem, 1.4vw, 1.35rem);
    box-shadow:
      0 1px 0 rgb(17 17 15 / 0.06),
      0 1.25rem 3.5rem rgb(17 17 15 / 0.09);
  }

  .showcase__card::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .showcase__card :global(.showcase__background) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase__card--portrait {
    aspect-ratio: 2 / 3;
  }

  :global(.showcase__project-link) {
    position: absolute;
    z-index: 4;
    top: clamp(0.65rem, 1.2vw, 1rem);
    right: clamp(0.65rem, 1.2vw, 1rem);
    display: grid;
    width: clamp(2.2rem, 3.2vw, 2.8rem);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(17 17 15 / 0.1);
    border-radius: 999px;
    background: rgb(248 248 248 / 0.92);
    box-shadow: 0 0.15rem 0.55rem rgb(17 17 15 / 0.1);
    color: inherit;
    overflow: hidden;
    text-decoration: none;
    transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }

  :global(.showcase__project-link:focus-visible) {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: 0.2rem;
  }

  :global(.showcase__project-link .showcase__project-link-icon) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(3);
  }

  :global(.showcase__project-link:active) {
    transform: scale(0.96);
  }

  .showcase__card--portrait :global(.mobile-stack__screen) {
    top: 24%;
    height: 70%;
  }

  .showcase__card--portrait :global(.mobile-stack__screen:nth-child(1)) {
    left: 3%;
  }

  .showcase__card--portrait :global(.mobile-stack__screen:nth-child(2)) {
    left: 14%;
  }

  .showcase__card--portrait :global(.mobile-stack__screen:nth-child(3)) {
    left: 25%;
  }

  .showcase__card--portrait :global(.mobile-stack__screen:nth-child(4)) {
    left: 36%;
  }

  .showcase__card--portrait :global(.mobile-stack__screen:nth-child(5)) {
    left: 47%;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.showcase__project-link:hover) {
      box-shadow: 0 0.25rem 0.8rem rgb(17 17 15 / 0.16);
      transform: scale(1.04);
    }
  }

  @media (max-width: 44rem) {
    .showcase {
      padding: clamp(5rem, 18vw, 7rem) 0 clamp(6rem, 22vw, 8rem);
    }

    .showcase__grid {
      width: min(calc(100% - 2rem), 34rem);
    }

    .showcase__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .showcase__card {
      border-radius: 0.8rem;
      box-shadow:
        0 1px 0 rgb(17 17 15 / 0.05),
        0 0.8rem 2.4rem rgb(17 17 15 / 0.08);
    }

    .showcase__card--1 {
      grid-column: auto;
    }

    .showcase__card--portrait {
      aspect-ratio: 3 / 4;
    }

    :global(.showcase__project-link) {
      width: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.showcase__project-link) {
      transition-duration: 0ms;
    }
  }
</style>
