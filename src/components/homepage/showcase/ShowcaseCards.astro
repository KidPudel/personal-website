---
import { Image } from 'astro:assets';
import '@fontsource/instrument-serif/400.css';

import clickCue from '../../../assets/art/icons/Doodles_point_click.png';
import { caseStudies, caseStudyPath } from '../../../content/case-studies';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import InstagramPrototype from './InstagramPrototype.astro';
import ObservatoryScreenStack from './ObservatoryScreenStack.astro';
import SupergoodScreenStack from './SupergoodScreenStack.astro';
import TwoSticksScreenStack from './TwoSticksScreenStack.astro';
import WorkCaption from './WorkCaption.astro';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
// Copy lives in src/content/case-studies.ts; this adds the homepage layout.
// The two wide cards sit on a diagonal: SuperGood opens the grid at top left,
// Observatory closes it at bottom right. `position` keeps the document and
// keyboard order the same as the visual reading order.
const layout = {
  supergood: { area: 'supergood', kind: 'supergood', portrait: false, position: 1 },
  'instagram-saves-redesign': { area: 'instagram', kind: 'instagram', portrait: true, position: 2 },
  'two-sticks': { area: 'chinese', kind: 'chinese', portrait: true, position: 3 },
  observatory: { area: 'observatory', kind: 'observatory', portrait: false, position: 4 },
} as const;
const cards = caseStudies
  .map((study) => ({
    background: study.background,
    name: study.name[locale],
    pitch: study.pitch[locale],
    tag: study.tag[locale],
    year: study.year,
    href: localePath(caseStudyPath(study.slug), locale),
    slug: study.slug,
    ...layout[study.slug as keyof typeof layout],
  }))
  .sort((a, b) => a.position - b.position);
---

<showcase-cards id="work" class="showcase" data-opening-sky-fade-target>
  <div class="showcase__heading">
    <h2 class="showcase__title">
      {t('my work', 'мои работы')}
    </h2>

    <p class="showcase__click-cue">
      <span>{t('try clicking around', 'попробуй покликать')}</span>
      <span class="showcase__click-cue-art" aria-hidden="true">
        <Image
          src={clickCue}
          alt=""
          width={512}
          loading="lazy"
          decoding="async"
          format="png"
        />
      </span>
    </p>
  </div>

  <div class="showcase__grid">
    {cards.map((card) => (
      <article
        class:list={[
          'showcase__card',
          `showcase__card--${card.area}`,
          card.portrait && 'showcase__card--portrait',
        ]}
      >
        <!-- The panel grows into its case study's opening when the study opens (BaseDocument). -->
        <div class="showcase__panel" data-study-transition={card.slug}>
          <Image
            class="showcase__background"
            src={card.background}
            alt=""
            widths={card.portrait ? [360, 480, 720] : [480, 720, 960, 1280, 1600]}
            sizes={card.portrait
              ? '(max-width: 44rem) calc(100vw - 2rem), (max-width: 75rem) 45vw, 28vw'
              : '(max-width: 44rem) calc(100vw - 2rem), (max-width: 75rem) 90vw, 62vw'}
            loading="lazy"
            decoding="async"
            format="webp"
            quality={82}
          />
          {card.kind === 'observatory' && <ObservatoryScreenStack />}
          {card.kind === 'instagram' && <InstagramPrototype />}
          {card.kind === 'chinese' && <TwoSticksScreenStack />}
          {card.kind === 'supergood' && <SupergoodScreenStack />}
        </div>

        {/* The panel is for trying the product; the caption opens its case study. */}
        <WorkCaption
          class="showcase__caption"
          href={card.href}
          name={card.name}
          pitch={card.pitch}
          tag={card.tag}
          year={card.year}
        />
      </article>
    ))}
  </div>
</showcase-cards>

<script>
  import { bind, set } from '@foleyjs/core';

  class ShowcaseCards extends HTMLElement {
    private abort?: AbortController;
    private finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    private reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      set({ theme: 'mechanical', volume: 0.32, localize: 0.45 });
      this.syncSoundPreferences();
      bind(this);
      this.finePointer.addEventListener('change', this.syncSoundPreferences, {
        signal: this.abort.signal,
      });
      this.reducedMotion.addEventListener('change', this.syncSoundPreferences, {
        signal: this.abort.signal,
      });
    }

    disconnectedCallback() {
      this.abort?.abort();
    }

    private syncSoundPreferences = () => {
      set({
        hover: this.finePointer.matches,
        muted: this.reducedMotion.matches,
      });
    };
  }

  if (!customElements.get('showcase-cards')) {
    customElements.define('showcase-cards', ShowcaseCards);
  }
</script>

<style>
  .showcase {
    display: block;
    width: 100%;
    /* Tighter than the gaps between the later sections: those sit between
       full-width cards, while this one sits under the introduction's narrow
       text and would join the sky beside it into one empty area. It stays
       over twice the introduction's own largest gap. */
    padding: clamp(6rem, 7vw, 7rem) 0 clamp(3.5rem, 7vw, 6.5rem);
  }

  .showcase__heading,
  .showcase__grid {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--page-frame));
    margin-inline: auto;
  }

  .showcase__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .showcase__title {
    display: flex;
    align-items: baseline;
    column-gap: 0.22em;
    margin: 0;
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  .showcase__click-cue {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(0.25rem, 0.5vw, 0.55rem);
    margin: 0 clamp(0.1rem, 0.5vw, 0.5rem) -0.4rem 0;
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.9rem, 1.05vw, 1.1rem);
    line-height: 1;
  }

  .showcase__click-cue-art {
    display: block;
    width: clamp(1.65rem, 2.2vw, 2.15rem);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .showcase__click-cue-art :global(img) {
    display: block;
    width: 250%;
    max-width: none;
    height: auto;
    transform: translate(-13.6%, -19.8%);
  }

  /* Each card spans a panel row and a caption row of the parent grid
     (subgrid), so captions in one row start on the same line and the panels
     above them end together. The wide panels set each row's height. */
  .showcase__grid {
    display: grid;
    grid-template-areas:
      'supergood supergood instagram'
      'supergood supergood instagram'
      'chinese observatory observatory'
      'chinese observatory observatory';
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    column-gap: clamp(1rem, 3vw, 3.75rem);
  }

  .showcase__card {
    display: grid;
    min-width: 0;
    grid-template-rows: subgrid;
  }

  .showcase__panel {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    border-radius: clamp(0.8rem, 1.4vw, 1.35rem);
    box-shadow:
      0 1px 0 rgb(17 17 15 / 0.06),
      0 1.25rem 3.5rem rgb(17 17 15 / 0.09);
  }

  /* Pointing at the pitch (the case-study link) lifts the panel above it a little, so the small
     line and the big picture read as one thing to open. */
  .showcase__panel {
    transition:
      transform 280ms var(--ease-out),
      box-shadow 280ms var(--ease-out);
  }

  .showcase__card:has(.work-caption__link:focus-visible) .showcase__panel {
    transform: translateY(-0.2rem) scale(1.012);
    box-shadow:
      0 1px 0 rgb(17 17 15 / 0.06),
      0 1.75rem 4.25rem rgb(17 17 15 / 0.14);
  }

  @media (hover: hover) and (pointer: fine) {
    .showcase__card:has(.work-caption__link:hover) .showcase__panel {
      transform: translateY(-0.2rem) scale(1.012);
      box-shadow:
        0 1px 0 rgb(17 17 15 / 0.06),
        0 1.75rem 4.25rem rgb(17 17 15 / 0.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__panel {
      transition: box-shadow 200ms linear;
    }

    .showcase__card:has(.work-caption__link:is(:hover, :focus-visible)) .showcase__panel {
      transform: none;
    }
  }

  .showcase__panel::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .showcase__panel :global(.showcase__background) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase__card--supergood .showcase__panel,
  .showcase__card--observatory .showcase__panel {
    aspect-ratio: 10 / 7;
  }

  .showcase__card--observatory {
    grid-area: observatory;
  }

  .showcase__card--instagram {
    grid-area: instagram;
  }

  .showcase__card--chinese {
    grid-area: chinese;
  }

  .showcase__card--supergood {
    grid-area: supergood;
  }

  /* The caption (WorkCaption) is the case-study link's hit area; the panel
     above stays free for trying the product. */
  .showcase__caption {
    position: relative;
    padding: clamp(0.8rem, 1.1vw, 1rem) 0 clamp(2.75rem, 5vw, 4.75rem);
  }

  /* Tablets: the portrait cards would be too thin in three columns, so the
     wide cards take a full row each and the portrait pair shares the middle. */
  @media (44rem < width <= 75rem) {
    .showcase__grid {
      grid-template-areas:
        'supergood supergood'
        'supergood supergood'
        'instagram chinese'
        'instagram chinese'
        'observatory observatory'
        'observatory observatory';
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(6, auto);
    }

    .showcase__card--supergood .showcase__panel,
    .showcase__card--observatory .showcase__panel {
      aspect-ratio: 16 / 10;
    }

    .showcase__card--portrait .showcase__panel {
      aspect-ratio: 3 / 4;
    }
  }

  @media (max-width: 44rem) {
    .showcase {
      padding: clamp(5rem, 18vw, 7rem) 0 clamp(3.5rem, 12vw, 5rem);
    }

    .showcase__heading,
    .showcase__grid {
      width: min(calc(100% - 2 * var(--page-gutter)), 34rem);
    }

    .showcase__heading {
      gap: 1rem;
    }

    .showcase__click-cue {
      margin-right: 0;
      font-size: clamp(0.78rem, 3.4vw, 0.92rem);
    }

    .showcase__click-cue-art {
      width: clamp(1.55rem, 7vw, 1.9rem);
    }

    .showcase__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: none;
    }

    .showcase__card {
      display: block;
      grid-area: auto;
    }

    .showcase__panel {
      border-radius: 0.8rem;
      box-shadow:
        0 1px 0 rgb(17 17 15 / 0.05),
        0 0.8rem 2.4rem rgb(17 17 15 / 0.08);
    }

    .showcase__card--supergood .showcase__panel {
      aspect-ratio: 4 / 3;
    }

    .showcase__card--observatory .showcase__panel,
    .showcase__card--portrait .showcase__panel {
      aspect-ratio: 3 / 4;
    }

    .showcase__caption {
      padding: 0.75rem 0 2.5rem;
    }
  }
</style>
