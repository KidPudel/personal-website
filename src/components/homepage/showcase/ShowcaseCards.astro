---
import { Image } from 'astro:assets';
import '@fontsource/instrument-serif/400.css';

import entranceIcon from '../../../assets/art/icons/Doodles_entrance.png';
import clickCue from '../../../assets/art/icons/Doodles_point_click.png';
import { caseStudies, caseStudyPath } from '../../../content/case-studies';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import InstagramPrototype from './InstagramPrototype.astro';
import ObservatoryScreenStack from './ObservatoryScreenStack.astro';
import ShowcaseInfo from './ShowcaseInfo.astro';
import SupergoodScreenStack from './SupergoodScreenStack.astro';
import TwoSticksScreenStack from './TwoSticksScreenStack.astro';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
// Copy lives in src/content/case-studies.ts; this adds the homepage layout.
// The two wide cards sit on a diagonal: SuperGood opens the grid at top left,
// Observatory closes it at bottom right. `position` keeps the document and
// keyboard order the same as the visual reading order.
const layout = {
  supergood: { area: 'supergood', kind: 'supergood', portrait: false, position: 1 },
  'instagram-saves-redesign': { area: 'instagram', kind: 'instagram', portrait: true, position: 2 },
  'two-sticks': { area: 'chinese', kind: 'chinese', portrait: true, position: 3 },
  observatory: { area: 'observatory', kind: 'observatory', portrait: false, position: 4 },
} as const;
const cards = caseStudies
  .map((study) => ({
    background: study.background,
    name: study.name[locale],
    pitch: study.pitch[locale],
    responsibility: study.responsibility[locale],
    href: localePath(caseStudyPath(study.slug), locale),
    ...layout[study.slug as keyof typeof layout],
  }))
  .sort((a, b) => a.position - b.position);
---

<showcase-cards id="work" class="showcase" data-opening-sky-fade-target>
  <div class="showcase__heading">
    <h2 class="showcase__title">
      {t('my work', 'мои работы')}
    </h2>

    <p class="showcase__click-cue">
      <span>{t('try clicking around', 'попробуй покликать')}</span>
      <span class="showcase__click-cue-art" aria-hidden="true">
        <Image
          src={clickCue}
          alt=""
          width={512}
          loading="lazy"
          decoding="async"
          format="png"
        />
      </span>
    </p>
  </div>

  <div class="showcase__grid">
    {cards.map((card) => (
      <article
        class:list={[
          'showcase__card',
          `showcase__card--${card.area}`,
          card.portrait && 'showcase__card--portrait',
        ]}
      >
        <Image
          class="showcase__background"
          src={card.background}
          alt=""
          widths={card.portrait ? [360, 480, 720] : [480, 720, 960, 1280, 1600]}
          sizes={card.portrait
            ? '(max-width: 44rem) calc(100vw - 2rem), 28vw'
            : '(max-width: 44rem) calc(100vw - 2rem), 62vw'}
          loading="lazy"
          decoding="async"
          format="webp"
          quality={82}
        />
        {card.kind === 'observatory' && <ObservatoryScreenStack />}
        {card.kind === 'instagram' && <InstagramPrototype />}
        {card.kind === 'chinese' && <TwoSticksScreenStack />}
        {card.kind === 'supergood' && <SupergoodScreenStack />}
        <ShowcaseInfo pitch={card.pitch} responsibility={card.responsibility} />
        <a
          class="showcase__project-link"
          href={card.href}
          aria-label={t(`Open the ${card.name} case study`, `Открыть кейс «${card.name}»`)}
          title={t(`Open the ${card.name} case study`, `Открыть кейс «${card.name}»`)}
        >
          <Image
            class="showcase__project-link-icon"
            src={entranceIcon}
            alt=""
            widths={[160, 240, 320]}
            sizes="(max-width: 44rem) 7.3rem, 7.5rem"
            loading="lazy"
            decoding="async"
            format="png"
          />
        </a>
      </article>
    ))}
  </div>
</showcase-cards>

<script>
  import { bind, set } from '@foleyjs/core';

  class ShowcaseCards extends HTMLElement {
    private abort?: AbortController;
    private finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    private reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      set({ theme: 'mechanical', volume: 0.32, localize: 0.45 });
      this.syncSoundPreferences();
      bind(this);
      this.finePointer.addEventListener('change', this.syncSoundPreferences, {
        signal: this.abort.signal,
      });
      this.reducedMotion.addEventListener('change', this.syncSoundPreferences, {
        signal: this.abort.signal,
      });
    }

    disconnectedCallback() {
      this.abort?.abort();
    }

    private syncSoundPreferences = () => {
      set({
        hover: this.finePointer.matches,
        muted: this.reducedMotion.matches,
      });
    };
  }

  if (!customElements.get('showcase-cards')) {
    customElements.define('showcase-cards', ShowcaseCards);
  }
</script>

<style>
  .showcase {
    display: block;
    width: 100%;
    padding: clamp(6rem, 11vw, 10rem) 0 clamp(7rem, 12vw, 11rem);
  }

  .showcase__heading,
  .showcase__grid {
    width: min(calc(100% - 2 * var(--page-gutter)), 130rem);
    margin-inline: auto;
  }

  .showcase__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .showcase__title {
    display: flex;
    align-items: baseline;
    column-gap: 0.22em;
    margin: 0;
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  .showcase__click-cue {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(0.25rem, 0.5vw, 0.55rem);
    margin: 0 clamp(0.1rem, 0.5vw, 0.5rem) -0.4rem 0;
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.9rem, 1.05vw, 1.1rem);
    line-height: 1;
  }

  .showcase__click-cue-art {
    display: block;
    width: clamp(1.65rem, 2.2vw, 2.15rem);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .showcase__click-cue-art :global(img) {
    display: block;
    width: 250%;
    max-width: none;
    height: auto;
    transform: translate(-13.6%, -19.8%);
  }

  .showcase__grid {
    display: grid;
    grid-template-areas:
      'supergood supergood instagram'
      'chinese observatory observatory';
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 3.75rem);
    aspect-ratio: 21 / 20;
  }

  .showcase__card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    height: 100%;
    border-radius: clamp(0.8rem, 1.4vw, 1.35rem);
    box-shadow:
      0 1px 0 rgb(17 17 15 / 0.06),
      0 1.25rem 3.5rem rgb(17 17 15 / 0.09);
  }

  .showcase__card::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .showcase__card :global(.showcase__background) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase__card--portrait {
    aspect-ratio: auto;
  }

  .showcase__card--observatory {
    grid-area: observatory;
  }

  .showcase__card--instagram {
    grid-area: instagram;
  }

  .showcase__card--chinese {
    grid-area: chinese;
  }

  .showcase__card--supergood {
    grid-area: supergood;
  }

  :global(.showcase__project-link) {
    position: absolute;
    z-index: 4;
    top: clamp(0.65rem, 1.2vw, 1rem);
    right: clamp(0.65rem, 1.2vw, 1rem);
    display: grid;
    width: clamp(2.2rem, 3.2vw, 2.8rem);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(17 17 15 / 0.1);
    border-radius: 999px;
    background: rgb(248 248 248 / 0.92);
    box-shadow: 0 0.15rem 0.55rem rgb(17 17 15 / 0.1);
    color: inherit;
    overflow: hidden;
    text-decoration: none;
    transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }

  :global(.showcase__project-link:focus-visible) {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: 0.2rem;
  }

  :global(.showcase__project-link .showcase__project-link-icon) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.62;
    transform: translateY(-0.14rem) scale(2.65);
  }

  :global(.showcase__project-link:active) {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.showcase__project-link:hover) {
      box-shadow: 0 0.25rem 0.8rem rgb(17 17 15 / 0.16);
      transform: scale(1.04);
    }
  }

  @media (max-width: 44rem) {
    .showcase {
      padding: clamp(5rem, 18vw, 7rem) 0 clamp(6rem, 22vw, 8rem);
    }

    .showcase__heading,
    .showcase__grid {
      width: min(calc(100% - 2 * var(--page-gutter)), 34rem);
    }

    .showcase__heading {
      gap: 1rem;
    }

    .showcase__click-cue {
      margin-right: 0;
      font-size: clamp(0.78rem, 3.4vw, 0.92rem);
    }

    .showcase__click-cue-art {
      width: clamp(1.55rem, 7vw, 1.9rem);
    }

    .showcase__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: none;
      gap: 1rem;
      aspect-ratio: auto;
    }

    .showcase__card {
      border-radius: 0.8rem;
      box-shadow:
        0 1px 0 rgb(17 17 15 / 0.05),
        0 0.8rem 2.4rem rgb(17 17 15 / 0.08);
    }

    .showcase__card--observatory,
    .showcase__card--instagram,
    .showcase__card--chinese {
      grid-column: auto;
      grid-area: auto;
      height: auto;
      aspect-ratio: 3 / 4;
    }

    .showcase__card--supergood {
      grid-column: auto;
      grid-area: auto;
      height: auto;
      aspect-ratio: 4 / 3;
    }

    :global(.showcase__project-link) {
      width: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.showcase__project-link) {
      transition-duration: 0ms;
    }
  }
</style>
