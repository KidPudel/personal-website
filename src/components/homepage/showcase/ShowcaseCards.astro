---
import { Image } from 'astro:assets';
import '@fontsource/instrument-serif/400.css';

import { caseStudies, caseStudyPath } from '../../../content/case-studies';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import { imagePlaceholder } from '../../../lib/image-placeholder';
import InstagramPrototype from './InstagramPrototype.astro';
import ObservatoryGroupDemo from './ObservatoryGroupDemo.astro';
import SupergoodLunch from './SupergoodLunch.astro';
import TwoSticksChat from './TwoSticksChat.astro';
import WorkCaption from './WorkCaption.astro';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
// Copy lives in src/content/case-studies.ts; this adds the homepage layout.
// Two by two, every card the same moderately wide shape (4:3), which suits
// what they all hold: two phones, a phone in a wall, a phone beside paper, a
// desktop window. The order carries the ranking, SuperGood first. `position`
// keeps the document and keyboard order the same as the visual reading order.
// `portrait` only shapes the phone layout (upright cards there).
const layout = {
  supergood: { area: 'supergood', kind: 'supergood', portrait: false, position: 1 },
  'instagram-saves-redesign': { area: 'instagram', kind: 'instagram', portrait: true, position: 2 },
  'two-sticks': { area: 'chinese', kind: 'chinese', portrait: true, position: 3 },
  observatory: { area: 'observatory', kind: 'observatory', portrait: false, position: 4 },
} as const;
const cards = (await Promise.all(caseStudies.map(async (study) => ({
    background: study.background,
    placeholder: await imagePlaceholder(study.background),
    name: study.name[locale],
    pitch: study.pitch[locale],
    tag: study.tag[locale],
    year: study.year,
    href: localePath(caseStudyPath(study.slug), locale),
    slug: study.slug,
    ...layout[study.slug as keyof typeof layout],
  }))))
  .sort((a, b) => a.position - b.position);
// The first row (SuperGood and Instagram) is in the first viewport on wide
// screens, so its media loads with the page instead of waiting for layout.
const firstRow = 2;
---

<showcase-cards id="work" class="showcase" data-opening-sky-fade-target>
  <div class="showcase__heading">
    <h2 class="showcase__title">
      {t('my work', 'мои работы')}
    </h2>
  </div>

  <div class="showcase__grid">
    {cards.map((card) => (
      <article
        class:list={[
          'showcase__card',
          `showcase__card--${card.area}`,
          card.portrait && 'showcase__card--portrait',
        ]}
      >
        <!-- The panel grows into its case study's opening when the study opens (BaseDocument). -->
        <div
          class="showcase__panel"
          data-study-transition={card.slug}
          style={`--panel-placeholder: url(${card.placeholder})`}
        >
          <Image
            class="showcase__background"
            src={card.background}
            alt=""
            widths={[480, 720, 960, 1280]}
            sizes="(max-width: 44rem) calc(100vw - 2rem), 45vw"
            loading={card.position <= firstRow ? 'eager' : 'lazy'}
            decoding="async"
            format="webp"
            quality={82}
          />
          {/* The product inside is a preview to watch, not a control: inert keeps
              it out of the pointer's way and the tab order, so the whole card
              is one link to its case study. */}
          <div class="showcase__device" inert>
            {card.kind === 'observatory' && <ObservatoryGroupDemo />}
            {card.kind === 'instagram' && <InstagramPrototype />}
            {card.kind === 'chinese' && <TwoSticksChat />}
            {card.kind === 'supergood' && <SupergoodLunch />}
          </div>
        </div>

        {/* The caption's link reaches over the whole card. */}
        <WorkCaption
          class="showcase__caption"
          href={card.href}
          name={card.name}
          pitch={card.pitch}
          tag={card.tag}
          year={card.year}
        />
      </article>
    ))}
  </div>
</showcase-cards>

<script>
  import { bind, set } from '@foleyjs/core';

  class ShowcaseCards extends HTMLElement {
    private abort?: AbortController;
    private finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    private reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      set({ theme: 'mechanical', volume: 0.32, localize: 0.45 });
      this.syncSoundPreferences();
      bind(this);
      this.finePointer.addEventListener('change', this.syncSoundPreferences, {
        signal: this.abort.signal,
      });
      this.reducedMotion.addEventListener('change', this.syncSoundPreferences, {
        signal: this.abort.signal,
      });
      this.querySelectorAll<HTMLElement>('.showcase__card').forEach((card) => this.watch(card));
      this.watchScroll();
    }

    disconnectedCallback() {
      this.abort?.abort();
    }

    // A card being looked at plays its preview to the end and holds it; when
    // the look moves on, the preview rewinds. The card says so with a
    // `showcase:preview` event ({ on, quiet }), which its product listens for.
    // With a mouse, looking means the pointer resting on the card a moment (a
    // sweep across the grid doesn't start anything); with a keyboard, focus on
    // its link; on a phone or any screen without hover, the card scrolling up
    // into the middle of the screen (watchScroll). Previews started by
    // scrolling stay silent: sound should answer an action, and a scroll isn't
    // one.
    private looks = new Map<HTMLElement, { on: boolean; timer: number }>();

    private look(card: HTMLElement, next: boolean, delay: number, quiet = false) {
      const state = this.looks.get(card) ?? { on: false, timer: 0 };
      this.looks.set(card, state);
      window.clearTimeout(state.timer);
      state.timer = window.setTimeout(() => {
        if (state.on === next) return;
        state.on = next;
        card.dispatchEvent(new CustomEvent('showcase:preview', { detail: { on: next, quiet } }));
      }, delay);
    }

    private watch(card: HTMLElement) {
      const link = card.querySelector<HTMLElement>('.work-caption__link');
      const signal = this.abort?.signal;
      if (!link || !signal) return;
      link.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse' && this.finePointer.matches) this.look(card, true, 140);
      }, { signal });
      link.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse' && this.finePointer.matches) this.look(card, false, 90);
      }, { signal });
      link.addEventListener('focus', () => {
        if (link.matches(':focus-visible')) this.look(card, true, 0);
      }, { signal });
      link.addEventListener('blur', () => {
        if (this.finePointer.matches) this.look(card, false, 0);
      }, { signal });
      signal.addEventListener('abort', () => window.clearTimeout(this.looks.get(card)?.timer));
    }

    // Without hover, scrolling does the looking. A card plays once its panel
    // has risen past the line 60% down the screen, and rewinds when it sinks
    // back below it, so scrolling up a little undoes it and scrolling down
    // plays it again. A card that has scrolled away above the screen is left
    // as it is, out of sight.
    private watchScroll() {
      const signal = this.abort?.signal;
      if (!signal) return;
      const cards = [...this.querySelectorAll<HTMLElement>('.showcase__card')];
      let frame = 0;
      const update = () => {
        frame = 0;
        if (this.finePointer.matches) return;
        const line = window.innerHeight * 0.6;
        cards.forEach((card) => {
          const panel = card.querySelector<HTMLElement>('.showcase__panel');
          if (!panel) return;
          const box = panel.getBoundingClientRect();
          if (box.bottom < 0) return;
          this.look(card, box.top + box.height * 0.4 < line, 0, true);
        });
      };
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      window.addEventListener('scroll', schedule, { passive: true, signal });
      window.addEventListener('resize', schedule, { passive: true, signal });
      // Moving to a screen with hover hands the cards back to the pointer.
      this.finePointer.addEventListener('change', () => {
        if (this.finePointer.matches) cards.forEach((card) => this.look(card, false, 0));
        else schedule();
      }, { signal });
      schedule();
    }

    private syncSoundPreferences = () => {
      set({
        hover: this.finePointer.matches,
        muted: this.reducedMotion.matches,
      });
    };
  }

  if (!customElements.get('showcase-cards')) {
    customElements.define('showcase-cards', ShowcaseCards);
  }
</script>

<style>
  .showcase {
    display: block;
    width: 100%;
    /* Tighter than the gaps between the later sections: those sit between
       full-width cards, while this one sits under the introduction's narrow
       text and would join the sky beside it into one empty area. It stays
       over twice the introduction's own largest gap. */
    padding: clamp(6rem, 7vw, 7rem) 0 clamp(3.5rem, 7vw, 6.5rem);
  }

  .showcase__heading,
  .showcase__grid {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--page-frame));
    margin-inline: auto;
  }

  .showcase__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .showcase__title {
    display: flex;
    align-items: baseline;
    column-gap: 0.22em;
    margin: 0;
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  /* Each card spans a panel row and a caption row of the parent grid
     (subgrid), so captions in one row start on the same line and the panels
     above them end together. The wide panels set each row's height. */
  .showcase__grid {
    display: grid;
    grid-template-areas:
      'supergood instagram'
      'supergood instagram'
      'chinese observatory'
      'chinese observatory';
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    column-gap: clamp(1rem, 3vw, 3.75rem);
  }

  /* One card, one action: open the case study. The caption's link reaches
     over the whole card (WorkCaption's hit area covers the nearest positioned
     ancestor); the product preview above it is inert, so it never catches the
     pointer. */
  .showcase__card {
    --card-trail: clamp(2.75rem, 5vw, 4.75rem);
    --work-caption-hit-radius: clamp(0.8rem, 1.4vw, 1.35rem);

    position: relative;
    display: grid;
    min-width: 0;
    grid-template-rows: subgrid;
    isolation: isolate;
    transition: transform 280ms var(--ease-out);
  }

  /* The link's reach stops at the pitch, not in the gap before the next row. */
  .showcase__card :global(.work-caption__link)::after {
    bottom: var(--card-trail);
  }

  .showcase__panel {
    position: relative;
    overflow: hidden;
    /* A few pixels of the card's own background, stretched, until it loads. */
    background: var(--panel-placeholder) center / cover no-repeat;
    min-width: 0;
    min-height: 0;
    border-radius: clamp(0.8rem, 1.4vw, 1.35rem);
    box-shadow:
      0 1px 0 rgb(17 17 15 / 0.06),
      0 1.25rem 3.5rem rgb(17 17 15 / 0.09);
  }

  /* The product sits in the panel as if the wrapper weren't there. */
  .showcase__device {
    display: contents;
  }

  /* The card being looked at (pointer or keyboard) lifts, its pitch draws its
     marker, and its caption comes in; the other cards blur and step back. Moving
     straight from one card to the next switches at once: the newly looked-at
     card brightens without delay, while the others only dim after a beat and
     only come back after one, so crossing the gap between cards never
     flickers. */
  .showcase__panel {
    transition: box-shadow 280ms var(--ease-out);
  }

  .showcase__card {
    transition:
      transform 280ms var(--ease-out),
      opacity 320ms ease 160ms,
      filter 320ms ease 160ms;
  }

  .showcase__card:has(.work-caption__link:focus-visible) {
    transform: translateY(-0.25rem);
    transition-delay: 0s;
  }

  .showcase__card:has(.work-caption__link:focus-visible) .showcase__panel {
    box-shadow:
      0 1px 0 rgb(17 17 15 / 0.06),
      0 1.75rem 4.25rem rgb(17 17 15 / 0.14);
  }

  .showcase__grid:has(.work-caption__link:focus-visible) .showcase__card:not(:has(.work-caption__link:focus-visible)) {
    opacity: 0.38;
    filter: saturate(0.6) blur(3px);
    transition-delay: 0s, 90ms, 90ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .showcase__card:has(.work-caption__link:hover) {
      transform: translateY(-0.25rem);
      transition-delay: 0s;
    }

    .showcase__card:has(.work-caption__link:hover) .showcase__panel {
      box-shadow:
        0 1px 0 rgb(17 17 15 / 0.06),
        0 1.75rem 4.25rem rgb(17 17 15 / 0.14);
    }

    .showcase__grid:has(.work-caption__link:hover) .showcase__card:not(:has(.work-caption__link:hover)) {
      opacity: 0.38;
      filter: saturate(0.6) blur(3px);
      transition-delay: 0s, 90ms, 90ms;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    /* The product in the panel says what each study is about, so the
       caption waits for the card being looked at (pointer or keyboard) and
       then comes in, in the gap under the panel. It takes no room of its
       own, so the rows sit about as close as the columns and nothing moves
       when it appears; where it runs over the next card, that card is
       blurred and stepped back. It stays in the page for screen readers. */
    .showcase__card {
      --card-trail: clamp(2.9rem, 3.4vw, 3.75rem);
    }

    .showcase__card .showcase__caption {
      height: 0;
      padding: 0;
    }

    .showcase__card .showcase__caption > :global(*) {
      margin-top: 0.7rem;
    }

    /* Only a fade: a transform here would make the caption the box its
       link's card-wide reach is measured from. */
    .showcase__card :global(.work-caption) {
      opacity: 0;
      transition: opacity 160ms ease;
    }

    .showcase__card:has(.work-caption__link:is(:hover, :focus-visible)) :global(.work-caption) {
      opacity: 1;
      transition: opacity 220ms ease 60ms;
    }

    /* The link reaches over the panel and the caption under it, so moving
       down onto the caption keeps the card looked at, and stops short of
       the next row. */
    .showcase__card :global(.work-caption__link)::after {
      bottom: calc(var(--card-trail) - 2.4rem);
    }

    .showcase__card {
      padding-bottom: var(--card-trail);
    }
  }

  /* Reduced motion: the card doesn't move, but the spotlight still fades. */
  @media (prefers-reduced-motion: reduce) {
    .showcase__card {
      transition:
        opacity 200ms ease 160ms,
        filter 200ms ease 160ms;
    }

    .showcase__card:has(.work-caption__link:is(:hover, :focus-visible)) {
      transform: none;
    }
  }

  .showcase__panel::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .showcase__panel :global(.showcase__background) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase__panel {
    aspect-ratio: 4 / 3;
  }

  .showcase__card--observatory {
    grid-area: observatory;
  }

  .showcase__card--instagram {
    grid-area: instagram;
  }

  .showcase__card--chinese {
    grid-area: chinese;
  }

  .showcase__card--supergood {
    grid-area: supergood;
  }

  /* The caption (WorkCaption) is the case-study link's hit area; the panel
     above stays free for trying the product. */
  .showcase__caption {
    padding: clamp(0.8rem, 1.1vw, 1rem) 0 var(--card-trail);
  }

  @media (max-width: 44rem) {
    .showcase {
      padding: clamp(5rem, 18vw, 7rem) 0 clamp(3.5rem, 12vw, 5rem);
    }

    .showcase__heading,
    .showcase__grid {
      width: min(calc(100% - 2 * var(--page-gutter)), 34rem);
    }

    .showcase__heading {
      gap: 1rem;
    }

    .showcase__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: none;
    }

    .showcase__card {
      display: block;
      grid-area: auto;
    }

    .showcase__panel {
      border-radius: 0.8rem;
      box-shadow:
        0 1px 0 rgb(17 17 15 / 0.05),
        0 0.8rem 2.4rem rgb(17 17 15 / 0.08);
    }

    .showcase__card--supergood .showcase__panel {
      aspect-ratio: 4 / 3;
    }

    .showcase__card--observatory .showcase__panel,
    .showcase__card--portrait .showcase__panel {
      aspect-ratio: 3 / 4;
    }

    .showcase__card {
      --card-trail: 2.5rem;
      --work-caption-hit-radius: 0.8rem;
    }

    .showcase__caption {
      padding: 0.75rem 0 var(--card-trail);
    }
  }
</style>
