---
import { Image } from 'astro:assets';

import mainScreen from '../../../assets/case_study_images/outcome_screenshots/main.png';
import comparisonScreen from '../../../assets/case_study_images/outcome_screenshots/results-comparison.png';
import setupScreen from '../../../assets/case_study_images/outcome_screenshots/test-setup.png';
import testingScreen from '../../../assets/case_study_images/outcome_screenshots/testing.png';
import resultsScreen from '../../../assets/case_study_images/outcome_screenshots/tests-results.png';

const screens = [
  { src: comparisonScreen, label: 'Comparison' },
  { src: resultsScreen, label: 'Saved results' },
  { src: testingScreen, label: 'Recording' },
  { src: setupScreen, label: 'Test setup' },
  { src: mainScreen, label: 'Live view' },
];
---

<observatory-screen-stack
  class="observatory-stack"
>
  <button
    type="button"
    class="observatory-stack__trigger"
    aria-label="Cycle Observatory outcome screens: Live view, Test setup, Recording, Saved results, and Comparison"
  >
    {screens.map((screen) => (
      <span class="observatory-stack__screen" data-foley-hover="tick">
        <Image
          src={screen.src}
          alt=""
          widths={[320, 480, 720, 960, 1280]}
          sizes="(max-width: 44rem) 80vw, 52vw"
          loading="lazy"
          decoding="async"
          format="webp"
          quality={85}
        />
        <span class="observatory-stack__label">{screen.label}</span>
      </span>
    ))}
  </button>
</observatory-screen-stack>

<script>
  import { panFor, play } from '@foleyjs/core';

  class ObservatoryScreenStack extends HTMLElement {
    private abort?: AbortController;
    private animations = new Set<Animation>();
    private cycling = false;
    private reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const trigger = this.querySelector<HTMLButtonElement>('.observatory-stack__trigger');
      trigger?.addEventListener('click', this.cycle, { signal: this.abort.signal });
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.animations.forEach((animation) => animation.cancel());
      this.animations.clear();
      this.cycling = false;
    }

    private play(
      element: HTMLElement,
      keyframes: Keyframe[],
      options: KeyframeAnimationOptions,
    ) {
      const animation = element.animate(keyframes, options);
      this.animations.add(animation);
      animation.finished.then(
        () => this.animations.delete(animation),
        () => this.animations.delete(animation),
      );
      return animation;
    }

    private cycle = async (event: MouseEvent) => {
      if (this.cycling) return;

      const trigger = this.querySelector<HTMLButtonElement>('.observatory-stack__trigger');
      const screens = Array.from(
        this.querySelectorAll<HTMLElement>('.observatory-stack__screen'),
      );
      const front = screens.at(-1);
      if (!trigger || !front) return;

      const clicked = event.target instanceof Element
        ? event.target.closest<HTMLElement>('.observatory-stack__screen')
        : null;
      const nextFront = clicked && clicked !== front ? clicked : screens.at(-2);
      if (!nextFront) return;

      this.cycling = true;
      this.setAttribute('data-cycling', '');
      play('swoosh', { pan: panFor(nextFront) });

      if (this.reducedMotion.matches) {
        this.rotateToFront(trigger, nextFront);
        this.cycling = false;
        this.removeAttribute('data-cycling');
        return;
      }

      const easing = 'cubic-bezier(0.23, 1, 0.32, 1)';
      const exit = this.play(
        front,
        [
          { opacity: 1, transform: getComputedStyle(front).transform },
          { opacity: 0, transform: 'translate3d(0, 0.75rem, 0)' },
        ],
        { duration: 180, easing, fill: 'forwards' },
      );

      try {
        await exit.finished;
        this.rotateToFront(trigger, nextFront);
        exit.cancel();

        const enter = this.play(
          nextFront,
          [
            { opacity: 0, transform: 'translate3d(0, 0.375rem, 0)' },
            { opacity: 1, transform: 'translate3d(0, 0, 0)' },
          ],
          { duration: 180, easing },
        );
        await enter.finished;
      } catch {
        // A disconnected component cancels its in-flight handoff.
      } finally {
        this.cycling = false;
        this.removeAttribute('data-cycling');
      }
    };

    private rotateToFront(trigger: HTMLButtonElement, target: HTMLElement) {
      while (trigger.lastElementChild !== target) {
        const front = trigger.lastElementChild;
        if (!front) return;
        trigger.prepend(front);
      }
    }

  }

  if (!customElements.get('observatory-screen-stack')) {
    customElements.define('observatory-screen-stack', ObservatoryScreenStack);
  }
</script>

<style>
  .observatory-stack {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: inherit;
  }

  .observatory-stack__trigger {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .observatory-stack__trigger:focus-visible {
    border-radius: inherit;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(-1 * var(--focus-width));
  }

  .observatory-stack__screen {
    position: absolute;
    display: block;
    width: var(--screen-width);
    margin: 0;
    filter: drop-shadow(0 0.6rem 0.75rem rgb(17 17 15 / 0.2));
    transform: translate3d(0, 0, 0);
    transition: transform 180ms var(--ease-out);
  }

  .observatory-stack__label {
    position: absolute;
    z-index: 1;
    top: clamp(0.3rem, 0.65vw, 0.6rem);
    right: clamp(0.45rem, 1vw, 0.85rem);
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.46rem;
    border: 1px solid rgb(17 17 15 / 0.1);
    border-radius: 999px;
    background: rgb(248 248 248 / 0.9);
    box-shadow: 0 0.15rem 0.55rem rgb(17 17 15 / 0.08);
    color: rgb(17 17 15 / 0.72);
    font-family: var(--font-reading);
    font-size: clamp(0.55rem, 0.65vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    pointer-events: none;
    white-space: nowrap;
  }

  .observatory-stack__screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .observatory-stack__screen:nth-child(1) {
    z-index: 1;
    top: 23%;
    left: 10%;
    --screen-width: 78%;
  }

  .observatory-stack__screen:nth-child(2) {
    z-index: 2;
    top: 29%;
    left: 8%;
    --screen-width: 82%;
  }

  .observatory-stack__screen:nth-child(3) {
    z-index: 3;
    top: 35%;
    left: 6%;
    --screen-width: 86%;
  }

  .observatory-stack__screen:nth-child(4) {
    z-index: 4;
    top: 41%;
    left: 4%;
    --screen-width: 90%;
  }

  .observatory-stack__screen:nth-child(5) {
    z-index: 5;
    top: 47%;
    left: 1%;
    --screen-width: 96%;
  }

  @media (hover: hover) and (pointer: fine) {
    .observatory-stack__trigger:has(.observatory-stack__screen:hover) .observatory-stack__screen {
      transform: translate3d(0, 0.375rem, 0);
    }

    .observatory-stack__trigger:has(.observatory-stack__screen:hover) .observatory-stack__screen:hover {
      transform: translate3d(0, -0.875rem, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .observatory-stack__screen {
      transform: none !important;
      transition: none;
    }
  }
</style>
