---
import type { ComponentProps } from 'astro/types';

import basketScreen from '../../../assets/case_study_images/supergood/basket.png';
import checkoutScreen from '../../../assets/case_study_images/supergood/checkout.png';
import historyScreen from '../../../assets/case_study_images/supergood/history.png';
import mapScreen from '../../../assets/case_study_images/supergood/map.png';
import menuScreen from '../../../assets/case_study_images/supergood/menu-light.png';
import trackingScreen from '../../../assets/case_study_images/supergood/order-tracking.png';
import { toLocale, translator } from '../../../i18n/locales';
import MobileScreenStack from './MobileScreenStack.astro';

const t = translator(toLocale(Astro.currentLocale));
// Order follows the ordering journey. `device` is the phone's opaque bounding
// box inside each mockup (x, y, width, height in source pixels), so every
// device renders at the same height and sits exactly on the fan's axis.
const screens = [
  { src: menuScreen, label: t('Menu', 'Меню'), device: [50, 12, 499, 1032] },
  { src: basketScreen, label: t('Basket', 'Корзина'), device: [47, 13, 506, 1038] },
  { src: checkoutScreen, label: t('Checkout', 'Оформление'), device: [25, 5, 549, 1055] },
  { src: trackingScreen, label: t('Tracking', 'Отслеживание'), device: [28, 11, 542, 1062] },
  { src: mapScreen, label: t('Map', 'Карта'), device: [25, 11, 546, 1070] },
  { src: historyScreen, label: t('History', 'История'), device: [47, 11, 502, 1022] },
] satisfies ComponentProps<typeof MobileScreenStack>['screens'];
---

<MobileScreenStack
  screens={screens}
  ariaLabel={t(
    'Cycle SuperGood screens: Menu, Basket, Checkout, Tracking, Map, and History',
    'Листать экраны SuperGood: меню, корзина, оформление, отслеживание, карта и история',
  )}
/>
