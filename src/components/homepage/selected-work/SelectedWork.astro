---
import type { CollectionEntry } from 'astro:content';

import { sitePath } from '../../../config/site';
import WorkMedia from '../WorkMedia.astro';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
}

const { observatory, foodProduct, chineseBee } = Astro.props;
const projects = [
  {
    id: 'observatory',
    name: 'Observatory',
    label: 'Independent macOS product · 2026',
    href: '/case-studies/observatory/',
  },
  {
    id: 'flutter-product',
    name: 'SuperGood',
    label: 'Production food-delivery product · 2024',
    href: '/case-studies/supergood/',
  },
  {
    id: 'chinese-bee',
    name: 'Two Sticks',
    label: 'Telegram learning prototype · 2024',
    href: '/case-studies/two-sticks/',
  },
] as const;
---

<selected-work>
  <section id="selected-work" class="selected-work" aria-labelledby="selected-work-title" tabindex="-1">
    <div class="selected-work__stage">
      <div class="selected-work__content">
        <header class="selected-work__heading" data-selected-work-heading>
          <p>Product design</p>
          <h2 id="selected-work-title">Selected work</h2>
        </header>

        <div class="selected-work__gallery" data-selected-work-gallery>
          {projects.map((project, index) => (
            <article class={`project-piece project-piece--${index + 1}`} data-selected-project>
              <a
                class="project-piece__media"
                href={sitePath(project.href)}
                aria-label={`Read the ${project.name} case study`}
              >
                <WorkMedia slug={project.id} />
              </a>
              <div class="project-piece__copy">
                <p class="project-piece__label">{project.label}</p>
                <h3><a href={sitePath(project.href)}>{project.name}</a></h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</selected-work>

<script>
  import './selected-work';
</script>

<style>
  selected-work {
    display: block;
  }

  .selected-work {
    position: relative;
    z-index: 2;
    min-height: 170svh;
    scroll-margin-top: 1rem;
  }

  .selected-work__stage {
    position: sticky;
    top: 0;
    display: grid;
    min-height: 100svh;
    align-content: center;
    overflow: clip;
  }

  .selected-work__content {
    position: relative;
    width: min(100%, 88rem);
    margin-inline: auto;
    padding: clamp(2.75rem, 6svh, 4.75rem) clamp(1.5rem, 4vw, 4.5rem);
  }

  .selected-work__heading {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    margin-bottom: clamp(1.6rem, 3.5svh, 2.6rem);
  }

  .selected-work__heading p {
    margin: 0;
    color: var(--color-muted);
  }

  .selected-work__heading p {
    font-family: var(--font-special);
    font-size: clamp(0.88rem, 1.1vw, 1.02rem);
    rotate: -2deg;
  }

  .selected-work__heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 4.4vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .selected-work__gallery {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.2rem, 2vw, 2rem);
  }

  .project-piece {
    min-width: 0;
    transform-origin: 50% 18%;
  }

  .project-piece--1 {
    rotate: -0.7deg;
  }

  .project-piece--2 {
    margin-top: clamp(1rem, 4svh, 2.5rem);
    rotate: 0.55deg;
  }

  .project-piece--3 {
    margin-top: clamp(0.2rem, 1.5svh, 1rem);
    rotate: -0.35deg;
  }

  .project-piece__media {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: transform 160ms var(--ease-out);
  }

  .project-piece__media:active {
    transform: scale(0.98);
  }

  .project-piece__copy {
    padding: 0.85rem 0.25rem 0;
    opacity: var(--project-copy-opacity, 1);
    transform: translate3d(0, var(--project-copy-y, 0px), 0);
  }

  .project-piece__label {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.74rem;
    letter-spacing: 0.025em;
    line-height: 1.35;
  }

  .project-piece h3 {
    margin: 0.16rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .project-piece h3 a {
    color: inherit;
    text-decoration: none;
  }

  .project-piece :is(a):focus-visible {
    border-radius: 0.2rem;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-piece__media:hover {
      transform: translateY(-0.16rem);
    }

    .project-piece h3 a:hover {
      color: var(--color-accent);
    }
  }

  @media (max-width: 68rem) and (min-width: 50.001rem) {
    .selected-work__gallery {
      gap: 1rem;
    }
  }

  @media (max-width: 50rem) {
    .selected-work {
      min-height: auto;
    }

    .selected-work__stage {
      position: relative;
      display: block;
      min-height: auto;
      overflow: visible;
    }

    .selected-work__content {
      padding: 5rem 1rem 5.5rem;
    }

    .selected-work__heading {
      grid-template-columns: 1fr;
      gap: 0.2rem;
      padding-inline: 0.35rem;
      margin-bottom: 2rem;
    }

    .selected-work__heading h2 {
      grid-column: 1;
    }

    .selected-work__heading h2 {
      font-size: clamp(2.2rem, 11vw, 3.25rem);
    }

    .selected-work__gallery {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .project-piece,
    .project-piece--1,
    .project-piece--2,
    .project-piece--3 {
      width: min(100%, 29rem);
      margin: 0 auto;
      rotate: 0deg;
    }

    .project-piece__copy {
      padding-inline: 0.35rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .selected-work {
      min-height: auto;
    }

    .selected-work__stage {
      position: relative;
      min-height: auto;
      overflow: visible;
    }

    .project-piece__media {
      transition: none;
    }
  }
</style>
