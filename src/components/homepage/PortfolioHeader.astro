---
import { connectLinks, resumeLink } from '../../config/site';
import { localeDetails, localePath, localeStorageKey, locales, toLocale, translator } from '../../i18n/locales';
import DrawnIcon from './DrawnIcon.astro';

interface Props {
  showHome?: boolean;
  /** Locale-neutral path of the current page, when it exists in the other language. */
  alternatePath?: string;
}
const { showHome = false, alternatePath } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
// Each language is named in its own script, so either reader can find theirs.
const switchLabels = { en: 'en', ru: 'ру' } as const;
const resume = resumeLink(locale);
---

<portfolio-navigation class:list={["portfolio-navigation", { "portfolio-navigation--with-home": showHome }]} data-site-header>
  <nav class="site-navigation" aria-label={t('Primary navigation', 'Основная навигация')}>
    {showHome && <a class="navigation-action drawn-icon-trigger" href={localePath('/', locale)}>
      <span class="navigation-action__label">{t('Home', 'Главная')}</span>
      <span class="navigation-action__art" aria-hidden="true"><DrawnIcon icon="home" loading="eager" /></span>
    </a>}
    {alternatePath && (
      <span class="language-switch" role="group" aria-label={t('Language', 'Язык')}>
        {locales.map((option, index) => (
          <>
            {index > 0 && <span class="language-switch__divider" aria-hidden="true"></span>}
            {option === locale ? (
              <span class="language-switch__option" lang={option} aria-current="true">
                <span aria-hidden="true">{switchLabels[option]}</span>
                <span class="sr-only">{localeDetails[option].name}</span>
              </span>
            ) : (
              <a
                class="language-switch__option"
                href={localePath(alternatePath, option)}
                hreflang={option}
                lang={option}
                data-locale-switch={option}
                data-locale-storage-key={localeStorageKey}
              >
                <span aria-hidden="true"><span class="link-mark">{switchLabels[option]}</span></span>
                <span class="sr-only">{localeDetails[option].name}</span>
              </a>
            )}
          </>
        ))}
      </span>
    )}
    <!-- The résumé in plain sight for anyone who wants the facts in its usual form. -->
    <a class="navigation-action drawn-icon-trigger" href={resume.href} data-resume-link>
      <span class="navigation-action__label">{resume.label}</span>
      <span class="navigation-action__art" aria-hidden="true"><DrawnIcon icon="resume" loading="eager" /></span>
    </a>
    <details id="site-contact" class="contact-disclosure">
      <summary class="navigation-action drawn-icon-trigger">
        <span class="navigation-action__label">{t('Get in touch', 'Связаться')}</span>
        <span class="navigation-action__art" aria-hidden="true">
          <DrawnIcon icon="connect" loading="eager" />
        </span>
      </summary>
      <div class="contact-disclosure__panel">
        {connectLinks(locale).map((link, index) => (
          <>
            {index === 3 && <span class="contact-disclosure__break" aria-hidden="true"></span>}
            <a href={link.href}><span class="link-mark">{link.label}</span></a>
          </>
        ))}
      </div>
    </details>
  </nav>
</portfolio-navigation>
{showHome && <div class="portfolio-navigation-spacer" aria-hidden="true" data-site-header-spacer></div>}

<script>
  class PortfolioNavigation extends HTMLElement {
    private abort?: AbortController;
    private compactObserver?: IntersectionObserver;

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const { signal } = this.abort;
      const details = this.querySelector<HTMLDetailsElement>('details');
      const summary = details?.querySelector<HTMLElement>('summary');
      const panel = details?.querySelector<HTMLElement>('.contact-disclosure__panel');
      this.observeIntroduction();
      this.querySelectorAll<HTMLAnchorElement>('[data-locale-switch]').forEach((link) => {
        link.addEventListener('click', () => {
          try {
            localStorage.setItem(link.dataset.localeStorageKey ?? 'site-locale', link.dataset.localeSwitch ?? '');
          } catch {
            // The link still switches the language when storage is unavailable.
          }
        }, { signal });
      });
      if (!details || !summary || !panel) return;

      const syncExpandedState = () => {
        summary.setAttribute('aria-expanded', String(details.open));
        this.syncContactSurface(details, panel);
      };

      const revealContact = () => {
        if (window.location.hash !== `#${details.id}`) return;
        details.open = true;
        syncExpandedState();
      };

      details.addEventListener('toggle', syncExpandedState, { signal });
      document.addEventListener('pointerdown', (event) => {
        if (details.open && event.target instanceof Node && !this.contains(event.target)) {
          details.open = false;
        }
      }, { signal });
      this.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !details.open) return;
        details.open = false;
        summary.focus();
      }, { signal });
      window.addEventListener('hashchange', revealContact, { signal });
      window.addEventListener('resize', syncExpandedState, { signal });

      syncExpandedState();
      revealContact();
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.compactObserver?.disconnect();
    }

    private observeIntroduction = () => {
      this.compactObserver?.disconnect();
      this.removeAttribute('data-compact');

      // The homepage compacts once the introduction leaves; other pages
      // compact once the header's own reserved space has scrolled away.
      const introduction = document.querySelector<HTMLElement>('#intro');
      const spacer = document.querySelector<HTMLElement>('[data-site-header-spacer]');
      const target = introduction ?? spacer;
      if (!target || !('IntersectionObserver' in window)) return;

      this.compactObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          this.toggleAttribute('data-compact', !entry.isIntersecting);
        },
        { rootMargin: introduction ? '-20% 0px 0px 0px' : '0px' },
      );
      this.compactObserver.observe(target);
    };

    private syncContactSurface = (details: HTMLDetailsElement, panel: HTMLElement) => {
      if (!details.open) {
        this.style.setProperty('--contact-surface-bottom', '2.5rem');
        return;
      }

      const headerBounds = this.getBoundingClientRect();
      const panelBounds = panel.getBoundingClientRect();
      const rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
      const bottomExtension = Math.max(0, panelBounds.bottom - headerBounds.bottom + rootFontSize * 3);

      this.style.setProperty('--contact-surface-bottom', `${bottomExtension}px`);
    };
  }

  if (!customElements.get('portfolio-navigation')) {
    customElements.define('portfolio-navigation', PortfolioNavigation);
  }
</script>

<style>
  /* Spans the full width so its blur is an even band, not a patch. The band
     itself lets clicks through; only the controls take them. */
  .portfolio-navigation {
    position: fixed;
    z-index: 200;
    top: 0;
    right: 0;
    left: 0;
    display: block;
    --navigation-bottom: 1.3rem;
    padding: var(--navigation-top) var(--page-inset) var(--navigation-bottom);
    pointer-events: none;
    color: var(--color-ink);
    font-family: var(--font-reading);
    isolation: isolate;
    --contact-surface-bottom: 2.5rem;
    transform: translateY(0);
    transition: transform 220ms var(--ease-in-out);
  }

  .portfolio-navigation[data-compact] {
    transform: translateY(clamp(-2.25rem, -3vw, -1rem));
  }

  .portfolio-navigation:has(.contact-disclosure[open]) {
    --contact-surface-bottom: 6rem;
  }

  /* A progressive blur: a lighter blur with a faint tint runs the full depth
     of the band and a heavier one covers its upper part, so content under
     the controls is calm enough to read them and fades back in below. The
     tint stays faint so the band reads as blur rather than a white wash. */
  .portfolio-navigation::before,
  .portfolio-navigation::after {
    position: absolute;
    z-index: -1;
    inset: 0 0 calc(-1 * var(--contact-surface-bottom));
    content: '';
    pointer-events: none;
    transition:
      bottom 180ms var(--ease-out),
      opacity 220ms var(--ease-out);
  }

  .portfolio-navigation::before {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-field) 28%, transparent) 0,
      color-mix(in srgb, var(--color-field) 12%, transparent) 55%,
      transparent 100%
    );
    backdrop-filter: blur(8px);
    mask-image: linear-gradient(to bottom, black 0, black 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0, black 50%, transparent 100%);
  }

  .portfolio-navigation::after {
    backdrop-filter: blur(24px) saturate(1.05);
    mask-image: linear-gradient(to bottom, black 0, black 45%, transparent 90%);
    -webkit-mask-image: linear-gradient(to bottom, black 0, black 45%, transparent 90%);
  }

  /* While the links are open the band stays solid to just below them and
     fades after, so the text underneath doesn't show through them. */
  .portfolio-navigation:has(.contact-disclosure[open])::before {
    background: color-mix(in srgb, var(--color-field) 76%, transparent);
    mask-image: linear-gradient(to bottom, black 0, black calc(100% - 3rem), transparent 100%);
  }

  .portfolio-navigation:has(.contact-disclosure[open])::after {
    mask-image: linear-gradient(to bottom, black 0, black calc(100% - 3.5rem), transparent calc(100% - 0.5rem));
  }

  /* Over the homepage sky the controls need no backing, so the band only
     appears once the page scrolls past the introduction or the contact
     links open. */
  .portfolio-navigation:not(.portfolio-navigation--with-home):not([data-compact]):not(:has(.contact-disclosure[open]))::before,
  .portfolio-navigation:not(.portfolio-navigation--with-home):not([data-compact]):not(:has(.contact-disclosure[open]))::after {
    opacity: 0;
  }

  .site-navigation > * {
    pointer-events: auto;
  }

  /* Inner pages: Home sits on the left. */

  .portfolio-navigation--with-home .language-switch {
    margin-left: auto;
  }

  /* Reserves the bar's height so page content starts below it. */
  .portfolio-navigation-spacer {
    --navigation-bottom: 1.3rem;
    height: calc(var(--navigation-top) + 2.75rem + var(--navigation-bottom));
  }

  :global(html:has(.portfolio-navigation--with-home)) {
    scroll-padding-top: 6rem;
  }

  .site-navigation {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.9rem, 2.4vw, 1.8rem);
    font-size: clamp(0.88rem, 0.25vw + 0.83rem, 1rem);
    letter-spacing: 0.005em;
    white-space: nowrap;
  }

  .navigation-action {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.05rem;
    border: 0;
    color: inherit;
    line-height: 1.15;
    text-decoration: none;
    transition: color 150ms ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* No line: on hover and focus the drawn icon takes the label's place. */
  .navigation-action__label {
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 150ms linear,
      transform 180ms var(--ease-out);
  }

  .navigation-action__art {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: var(--drawn-icon-size);
    aspect-ratio: 1;
    --drawn-icon-opacity: 1;
    --drawn-icon-size: 3.7rem;
    overflow: visible;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.94) rotate(-4deg);
    transition:
      opacity 150ms linear,
      transform 180ms var(--ease-out);
  }

  .navigation-action:focus-visible,
  .contact-disclosure[open] summary {
    color: var(--color-copy);
  }

  .navigation-action:focus-visible .navigation-action__label,
  .contact-disclosure[open] summary .navigation-action__label {
    opacity: 0;
    transform: scale(0.96);
  }

  .navigation-action:focus-visible .navigation-action__art,
  .contact-disclosure[open] summary .navigation-action__art {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
  }

  .navigation-action:focus-visible,
  .contact-disclosure__panel a:focus-visible {
    border-radius: 0.1rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .navigation-action:hover {
      color: var(--color-copy);
    }

    .navigation-action:hover .navigation-action__label {
      opacity: 0;
      transform: scale(0.96);
    }

    .navigation-action:hover .navigation-action__art {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1) rotate(0deg);
    }
  }

  .contact-disclosure {
    position: relative;
    scroll-margin-top: 5rem;
  }

  .navigation-action {
    cursor: pointer;
    list-style: none;
  }

  .navigation-action::-webkit-details-marker {
    display: none;
  }

  .contact-disclosure__panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: -0.2rem;
    display: flex;
    width: max-content;
    max-width: calc(100vw - 1rem);
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.2rem clamp(0.8rem, 2vw, 1.3rem);
    padding: 0.55rem 0.4rem 0.8rem 1.4rem;
    transform-origin: 100% 0;
    animation: contact-reveal 180ms var(--ease-out) both;
  }

  .contact-disclosure__break {
    display: none;
  }

  .contact-disclosure:not([open]) .contact-disclosure__panel {
    display: none;
  }

  .contact-disclosure__panel a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
    font-size: 0.9rem;
    text-decoration: none;
  }

  /* Quiet by design: a setting, not an action, so it sits a step below
     "Get in touch". The current language is in ink; the one to switch to is
     grey and, like every other link, gains its line on hover. The muted grey
     still clears 4.5:1 on the page field. */
  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    color: var(--color-ink);
    font-size: 0.86em;
    letter-spacing: 0.02em;
    line-height: 1.15;
  }

  .language-switch__divider {
    width: 1px;
    height: 0.8em;
    background: currentColor;
    opacity: 0.35;
  }

  .language-switch__option {
    display: inline-flex;
    min-width: 2.2rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: inherit;
    touch-action: manipulation;
  }

  a.language-switch__option {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  a.language-switch__option:hover,
  a.language-switch__option:focus-visible {
    color: var(--color-ink);
  }

  a.language-switch__option:focus-visible {
    border-radius: 0.1rem;
  }

  @keyframes contact-reveal {
    from { opacity: 0; transform: translateY(-0.3rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 38rem) {
    .portfolio-navigation {
      padding: 0.45rem 0.7rem 1rem;
    }

    .portfolio-navigation-spacer {
      height: calc(0.45rem + 2.75rem + 1rem);
    }

    .portfolio-navigation[data-compact] {
      transform: translateY(0);
    }

    .portfolio-navigation:has(.contact-disclosure[open]) {
      --contact-surface-bottom: 9rem;
    }

    .site-navigation {
      gap: clamp(0.65rem, 3.4vw, 1.05rem);
      font-size: clamp(0.78rem, 3.7vw, 0.9rem);
    }

    .navigation-action__art {
      --drawn-icon-size: 3.25rem;
      width: var(--drawn-icon-size);
    }

    .contact-disclosure__panel {
      gap: 0 clamp(0.75rem, 3.6vw, 1rem);
      padding-left: 0.5rem;
    }

    /* Six links don't fit one row on a phone; three and three keep one word
       from sitting alone on the second row. */
    .contact-disclosure__break {
      display: block;
      flex-basis: 100%;
      height: 0;
    }

    .contact-disclosure__panel a {
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-navigation {
      transition: none;
    }

    .portfolio-navigation::before,
    .portfolio-navigation::after {
      transition: none;
    }

    .navigation-action,
    a.language-switch__option,
    .contact-disclosure__panel {
      transition: none;
      animation: none;
    }

    .navigation-action__label,
    .navigation-action__art {
      transform: none;
      transition: opacity 120ms linear;
    }

    .navigation-action__art {
      transform: translate(-50%, -50%);
    }

    .navigation-action:focus-visible .navigation-action__label,
    .contact-disclosure[open] summary .navigation-action__label {
      transform: none;
    }

    .navigation-action:focus-visible .navigation-action__art,
    .contact-disclosure[open] summary .navigation-action__art {
      transform: translate(-50%, -50%);
    }

    @media (hover: hover) and (pointer: fine) {
      .navigation-action:hover .navigation-action__label {
        transform: none;
      }

      .navigation-action:hover .navigation-action__art {
        transform: translate(-50%, -50%);
      }
    }
  }
</style>
