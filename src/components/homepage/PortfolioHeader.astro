---
import { Image } from 'astro:assets';

import connectIcon from '../../assets/art/icons/Doodles_connect.png';
import { connectLinks, sitePath } from '../../config/site';

interface Props {
  current?: 'home' | 'work';
}

const { current = 'home' } = Astro.props;
const primaryHref = current === 'home' ? sitePath('/work/') : sitePath('/');
const primaryLabel = current === 'home' ? 'Work' : 'Back to Igor';
---

<portfolio-navigation>
  <header class="site-header" aria-label="Primary navigation">
    <a class="site-header__work" href={primaryHref} aria-current={current === 'work' ? 'page' : undefined}>
      {primaryLabel}
    </a>

    <details id="contact" class="contact-disclosure">
      <summary>
        <span class="contact-disclosure__art" aria-hidden="true">
          <Image src={connectIcon} alt="" width={512} loading="eager" />
        </span>
        <span>Let’s talk</span>
      </summary>
      <nav class="contact-disclosure__panel" aria-label="Contact and profile links">
        {connectLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </header>
</portfolio-navigation>

<script>
  class PortfolioNavigation extends HTMLElement {
    private abort?: AbortController;

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const details = this.querySelector<HTMLDetailsElement>('details');
      if (!details) return;

      const revealContact = () => {
        if (window.location.hash === '#contact') details.open = true;
      };

      document.addEventListener('pointerdown', (event) => {
        if (details.open && event.target instanceof Node && !this.contains(event.target)) {
          details.open = false;
        }
      }, { signal: this.abort.signal });

      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) {
          details.open = false;
          details.querySelector<HTMLElement>('summary')?.focus();
        }
      }, { signal: this.abort.signal });

      window.addEventListener('hashchange', revealContact, { signal: this.abort.signal });
      revealContact();
    }

    disconnectedCallback() {
      this.abort?.abort();
    }
  }

  if (!customElements.get('portfolio-navigation')) {
    customElements.define('portfolio-navigation', PortfolioNavigation);
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 50;
    top: 50%;
    right: clamp(0.55rem, 1.8vw, 1.5rem);
    display: grid;
    justify-items: end;
    gap: 0.55rem;
    color: var(--white, #11110f);
    font-family: var(--font-reading);
    font-size: 0.78rem;
    opacity: var(--header-visibility, 1);
    transform: translateY(-50%) translateX(calc((1 - var(--header-visibility, 1)) * 3rem));
    transition:
      opacity 160ms linear,
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .site-header a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .site-header__work {
    margin-right: 0.4rem;
    padding: 0.15rem 0.3rem;
    text-decoration: none;
    transform: rotate(-2deg);
  }

  .site-header__work::after {
    content: '↗';
    margin-left: 0.42rem;
    color: var(--muted, #716d65);
    font-size: 0.78em;
  }

  .site-header__work:hover,
  .site-header__work:focus-visible,
  .site-header__work[aria-current='page'] {
    text-decoration: underline;
  }

  .contact-disclosure {
    position: relative;
  }

  .contact-disclosure summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    min-height: 3.25rem;
    padding: 0.1rem 0;
    cursor: pointer;
    list-style: none;
    transform: rotate(1.5deg);
  }

  .contact-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .contact-disclosure summary > span:last-child {
    margin-right: 0;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .contact-disclosure__art {
    display: block;
    width: 3.8rem;
    aspect-ratio: 1;
    overflow: hidden;
    transform-origin: center;
  }

  .contact-disclosure__art :global(img) {
    display: block;
    width: 340%;
    max-width: none;
    height: auto;
    filter: grayscale(1);
    opacity: 0.78;
    transform: translate(-31%, -31%);
  }

  .contact-disclosure__panel {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.75rem);
    display: grid;
    width: 10.5rem;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px dashed rgba(17, 17, 15, 0.35);
    background: rgba(248, 248, 248, 0.97);
    box-shadow: 0.3rem 0.35rem 0 rgba(17, 17, 15, 0.14);
    transform: translateY(-50%) rotate(-1deg);
  }

  .contact-disclosure:not([open]) .contact-disclosure__panel {
    display: none;
  }

  .contact-disclosure__panel a {
    padding: 0.25rem 0;
  }

  .contact-disclosure__panel a:hover,
  .contact-disclosure__panel a:focus-visible {
    color: var(--accent, #e35673);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-disclosure summary:hover .contact-disclosure__art {
      animation: contact-wobble 1.6s steps(1, end) infinite;
    }
  }

  @keyframes contact-wobble {
    0%, 100% { transform: translate(-0.08rem, -0.1rem) rotate(-3deg); }
    25% { transform: translate(0.08rem, -0.05rem) rotate(2deg); }
    50% { transform: translate(-0.06rem, 0) rotate(-1deg); }
    75% { transform: translate(0.03rem, -0.12rem) rotate(2deg); }
  }

  @media (max-width: 44rem) {
    .site-header {
      top: 0.55rem;
      right: 0.7rem;
      grid-auto-flow: column;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.72rem;
      transform: translateX(calc((1 - var(--header-visibility, 1)) * 3rem));
    }

    .site-header__work {
      order: 1;
      margin: 0;
    }

    .contact-disclosure {
      order: 2;
    }

    .contact-disclosure summary {
      flex-direction: row;
      min-height: 2.9rem;
    }

    .contact-disclosure__art {
      width: 3rem;
    }

    .contact-disclosure__panel {
      top: calc(100% + 0.3rem);
      right: 0;
      transform: rotate(-1deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }

    .contact-disclosure summary:hover .contact-disclosure__art {
      animation: none;
    }
  }
</style>
