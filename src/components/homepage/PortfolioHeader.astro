---
import { Image } from 'astro:assets';

import connectIcon from '../../assets/art/icons/Doodles_connect.png';
import homeIcon from '../../assets/art/icons/Doodles_home.png';
import workIcon from '../../assets/art/icons/Doodles_work.png';
import { connectLinks, sitePath } from '../../config/site';

interface Props {
  current?: 'home' | 'work';
  placement?: 'fixed' | 'intro' | 'footer';
  contactId?: string;
}

const {
  current = 'home',
  placement = 'fixed',
  contactId = 'contact',
} = Astro.props;
const primaryHref = current === 'home' ? sitePath('/work/') : sitePath('/');
const primaryLabel = current === 'home' ? 'Work' : 'Back to Igor';
const primaryIcon = current === 'home' ? workIcon : homeIcon;
const primaryIconName = current === 'home' ? 'work' : 'home';
const openingControlled = placement === 'intro' || placement === 'fixed';
---

<portfolio-navigation class={`portfolio-navigation portfolio-navigation--${placement}`}>
  <nav
    class="site-navigation"
    aria-label={placement === 'footer' ? 'Closing navigation' : 'Primary navigation'}
    data-site-header={openingControlled ? '' : undefined}
  >
    <a class="site-navigation__work" href={primaryHref}>
      <span class="navigation-action__label">{primaryLabel}</span>
      <span class={`navigation-action__art navigation-action__art--${primaryIconName}`} aria-hidden="true">
        <Image src={primaryIcon} alt="" width={512} loading="eager" />
      </span>
    </a>

    <details id={contactId} class="contact-disclosure">
      <summary>
        <span class="navigation-action__label">Let’s talk</span>
        <span class="navigation-action__art navigation-action__art--contact" aria-hidden="true">
          <Image src={connectIcon} alt="" width={512} loading="eager" />
        </span>
      </summary>
      <div class="contact-disclosure__panel">
        {connectLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </details>
  </nav>
</portfolio-navigation>

<script>
  class PortfolioNavigation extends HTMLElement {
    private abort?: AbortController;

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const details = this.querySelector<HTMLDetailsElement>('details');
      if (!details) return;

      const revealContact = () => {
        if (window.location.hash === `#${details.id}`) details.open = true;
      };

      document.addEventListener('pointerdown', (event) => {
        if (details.open && event.target instanceof Node && !this.contains(event.target)) {
          details.open = false;
        }
      }, { signal: this.abort.signal });

      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) {
          details.open = false;
          details.querySelector<HTMLElement>('summary')?.focus();
        }
      }, { signal: this.abort.signal });

      window.addEventListener('hashchange', revealContact, { signal: this.abort.signal });
      revealContact();
    }

    disconnectedCallback() {
      this.abort?.abort();
    }
  }

  if (!customElements.get('portfolio-navigation')) {
    customElements.define('portfolio-navigation', PortfolioNavigation);
  }
</script>

<style>
  .portfolio-navigation {
    position: relative;
    z-index: 50;
    display: block;
    color: var(--color-ink);
    font-family: var(--font-reading);
  }

  .portfolio-navigation--intro {
    position: relative;
    width: 100%;
    margin-top: clamp(1.75rem, 4.5vh, 2.25rem);
    opacity: var(--header-visibility, 1);
    transform: translateY(calc((1 - var(--header-visibility, 1)) * 1.25rem));
    transition:
      opacity 180ms linear,
      transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .portfolio-navigation--fixed {
    position: fixed;
    top: clamp(0.85rem, 2vw, 1.5rem);
    right: clamp(0.85rem, 2vw, 1.5rem);
    opacity: var(--header-visibility, 1);
    transform: translateY(calc((1 - var(--header-visibility, 1)) * -1.5rem));
    transition:
      opacity 180ms linear,
      transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .portfolio-navigation--fixed .site-navigation {
    padding: 0.15rem 0.55rem;
    background: color-mix(in srgb, var(--color-field) 92%, transparent);
    box-shadow: 0 0 1rem 0.7rem color-mix(in srgb, var(--color-field) 88%, transparent);
  }

  .portfolio-navigation--footer {
    display: grid;
    min-height: clamp(18rem, 42svh, 29rem);
    place-items: center;
    padding: 6rem 1.25rem 9rem;
  }

  .site-navigation {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    font-size: clamp(0.88rem, 0.18vw + 0.84rem, 0.98rem);
    letter-spacing: 0.01em;
  }

  .site-navigation__work,
  .contact-disclosure summary {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.35rem;
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .site-navigation__work {
    min-width: 4.5rem;
  }

  .contact-disclosure summary {
    min-width: 5.25rem;
  }

  .contact-disclosure {
    position: relative;
    scroll-margin-top: 5rem;
  }

  .portfolio-navigation--intro .site-navigation {
    justify-content: center;
  }

  .portfolio-navigation--intro .contact-disclosure {
    position: relative;
  }

  .portfolio-navigation--intro .contact-disclosure__panel {
    position: relative;
    top: auto;
    right: auto;
    left: 0;
    transform: none;
  }

  .portfolio-navigation--intro:has(.contact-disclosure[open]) {
    margin-bottom: 2.5rem;
  }

  .contact-disclosure summary {
    cursor: pointer;
    list-style: none;
  }

  .contact-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .navigation-action__label {
    padding-bottom: 0.04em;
    border-bottom: 0.1rem dotted var(--color-muted);
    filter: blur(0);
    transition: opacity 150ms linear, filter 220ms ease;
  }

  .navigation-action__art {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: 3.8rem;
    aspect-ratio: 1;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    filter: blur(0.45rem);
    transform: translate(-50%, -50%) scale(0.92);
    transition:
      opacity 150ms linear,
      filter 220ms ease,
      transform 220ms ease;
  }

  .navigation-action__art :global(img) {
    display: block;
    max-width: none;
    height: auto;
    filter: grayscale(1);
    opacity: 0.74;
  }

  .navigation-action__art--work :global(img),
  .navigation-action__art--home :global(img) {
    width: 320%;
    transform: translate(-31%, -33%);
  }

  .navigation-action__art--contact :global(img) {
    width: 340%;
    transform: translate(-31%, -31%);
  }

  .site-navigation__work:focus-visible .navigation-action__label,
  .contact-disclosure summary:focus-visible .navigation-action__label {
    opacity: 0;
    filter: blur(0.4rem);
  }

  .site-navigation__work:focus-visible .navigation-action__art,
  .contact-disclosure summary:focus-visible .navigation-action__art {
    opacity: 1;
    filter: blur(0);
    transform: translate(-50%, -50%) scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-navigation__work:hover .navigation-action__label,
    .contact-disclosure summary:hover .navigation-action__label,
    .contact-disclosure:focus-within .navigation-action__label,
    .contact-disclosure[open] .navigation-action__label {
      opacity: 0;
      filter: blur(0.4rem);
    }

    .site-navigation__work:hover .navigation-action__art,
    .contact-disclosure summary:hover .navigation-action__art,
    .contact-disclosure:focus-within .navigation-action__art,
    .contact-disclosure[open] .navigation-action__art {
      opacity: 1;
      filter: blur(0);
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .contact-disclosure__panel {
    position: absolute;
    z-index: 2;
    top: calc(100% + 0.7rem);
    left: 50%;
    display: flex;
    align-items: center;
    width: max-content;
    gap: 1.15rem;
    padding: 0.8rem 1rem 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent);
    background: color-mix(in srgb, var(--color-field) 97%, transparent);
    box-shadow: 0 0.9rem 1.8rem color-mix(in srgb, var(--color-ink) 8%, transparent);
    transform: translateX(-50%);
    animation: contact-panel-in 160ms ease-out;
  }

  .portfolio-navigation--fixed .contact-disclosure__panel {
    right: 0;
    left: auto;
    transform: none;
  }

  .contact-disclosure:not([open]) .contact-disclosure__panel {
    display: none;
  }

  .contact-disclosure__panel a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.25rem 0;
    color: inherit;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .contact-disclosure__panel a:hover,
  .contact-disclosure__panel a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  @keyframes contact-panel-in {
    from { opacity: 0; translate: 0 -0.35rem; }
  }

  @media (max-width: 44rem) {

    .portfolio-navigation--fixed {
      top: 0.55rem;
      right: 0.65rem;
    }

    .portfolio-navigation--fixed .site-navigation {
      padding-inline: 0.25rem;
    }

    .portfolio-navigation--footer {
      min-height: 20rem;
      padding-bottom: 8rem;
    }

    .site-navigation {
      gap: 1.5rem;
      font-size: 0.82rem;
    }

    .navigation-action__art {
      width: 3.35rem;
    }

    .contact-disclosure__panel {
      display: grid;
      width: min(17rem, calc(100vw - 2rem));
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1rem;
      background: var(--color-field);
    }

    .portfolio-navigation--intro {
      margin-top: clamp(1.4rem, 3vh, 1.75rem);
    }

    .portfolio-navigation--intro .site-navigation {
      gap: 1.9rem;
      font-size: 1rem;
    }

    .portfolio-navigation--intro .site-navigation__work,
    .portfolio-navigation--intro .contact-disclosure summary {
      min-width: 5.25rem;
      padding-inline: 0.45rem;
    }

    .portfolio-navigation--intro .contact-disclosure__panel {
      width: min(20rem, 100%);
      margin-inline: auto;
      box-shadow: none;
      padding-inline: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-navigation,
    .navigation-action__label,
    .navigation-action__art {
      transition: none;
    }

    .contact-disclosure__panel {
      animation: none;
    }
  }
</style>
