---
import { connectLinks, sitePath } from '../../config/site';
import DrawnIcon from './DrawnIcon.astro';

const pathname = Astro.url.pathname;
const workIsCurrent = pathname.includes('/work/') || pathname.includes('/case-studies/');
const aboutIsCurrent = pathname.includes('/about/');
---

<portfolio-navigation class="portfolio-navigation" data-site-header>
  <nav class="site-navigation" aria-label="Primary navigation">
    <a
      class="site-navigation__link drawn-icon-trigger"
      href={sitePath('/work/')}
      data-work-navigation
      aria-current={workIsCurrent ? 'page' : undefined}
    >
      <span class="navigation-action__label">Work</span>
      <span class="navigation-action__art" aria-hidden="true">
        <DrawnIcon icon="work" loading="eager" />
      </span>
    </a>

    <a
      class="site-navigation__link drawn-icon-trigger"
      href={sitePath('/about/')}
      aria-current={aboutIsCurrent ? 'page' : undefined}
    >
      <span class="navigation-action__label">About me</span>
      <span class="navigation-action__art" aria-hidden="true">
        <DrawnIcon icon="who" loading="eager" />
      </span>
    </a>

    <details id="site-contact" class="contact-disclosure">
      <summary class="drawn-icon-trigger">
        <span class="navigation-action__label">Get in touch</span>
        <span class="navigation-action__art" aria-hidden="true">
          <DrawnIcon icon="connect" loading="eager" />
        </span>
      </summary>
      <div class="contact-disclosure__panel">
        {connectLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </details>
  </nav>
</portfolio-navigation>

<script>
  class PortfolioNavigation extends HTMLElement {
    private abort?: AbortController;
    private previewTimer?: number;

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const { signal } = this.abort;
      const details = this.querySelector<HTMLDetailsElement>('details');
      const summary = details?.querySelector<HTMLElement>('summary');
      window.addEventListener('portfolio:preview-work', this.previewWork, { signal });
      if (!details || !summary) return;

      const syncExpandedState = () => {
        summary.setAttribute('aria-expanded', String(details.open));
      };

      const revealContact = () => {
        if (window.location.hash !== `#${details.id}`) return;
        details.open = true;
        syncExpandedState();
      };

      details.addEventListener('toggle', syncExpandedState, { signal });
      document.addEventListener('pointerdown', (event) => {
        if (details.open && event.target instanceof Node && !this.contains(event.target)) {
          details.open = false;
        }
      }, { signal });
      this.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !details.open) return;
        details.open = false;
        summary.focus();
      }, { signal });
      window.addEventListener('hashchange', revealContact, { signal });

      syncExpandedState();
      revealContact();
    }

    disconnectedCallback() {
      this.abort?.abort();
      window.clearTimeout(this.previewTimer);
      this.querySelector('[data-work-navigation]')?.removeAttribute('data-preview-active');
    }

    private previewWork = () => {
      const workLink = this.querySelector<HTMLElement>('[data-work-navigation]');
      if (!workLink) return;

      window.clearTimeout(this.previewTimer);
      workLink.setAttribute('data-preview-active', '');
      this.previewTimer = window.setTimeout(() => {
        workLink.removeAttribute('data-preview-active');
      }, 2000);
    };
  }

  if (!customElements.get('portfolio-navigation')) {
    customElements.define('portfolio-navigation', PortfolioNavigation);
  }
</script>

<style>
  .portfolio-navigation {
    position: fixed;
    z-index: 200;
    top: 0;
    right: 0;
    display: block;
    padding: clamp(1.25rem, 6vw, 5rem) var(--page-gutter) 1.3rem 1.8rem;
    color: var(--color-ink);
    font-family: var(--font-reading);
    isolation: isolate;
  }

  .portfolio-navigation::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: color-mix(in srgb, var(--color-field) 18%, transparent);
    backdrop-filter: blur(14px) saturate(1.08);
    -webkit-backdrop-filter: blur(14px) saturate(1.08);
    content: '';
    mask-image:
      linear-gradient(to left, black 0, black 84%, transparent 100%),
      linear-gradient(to top, transparent 0, black 42%, black 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to left, black 0, black 84%, transparent 100%),
      linear-gradient(to top, transparent 0, black 42%, black 100%);
    -webkit-mask-composite: source-in;
    pointer-events: none;
  }

  .site-navigation {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.9rem, 2.4vw, 1.8rem);
    font-size: clamp(0.88rem, 0.25vw + 0.83rem, 1rem);
    letter-spacing: 0.005em;
    white-space: nowrap;
  }

  .site-navigation__link,
  .contact-disclosure summary {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.05rem;
    border: 0;
    color: inherit;
    line-height: 1.15;
    text-decoration: none;
    transition: color 150ms ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .navigation-action__label {
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-color: color-mix(in srgb, var(--color-muted) 72%, transparent);
    text-decoration-thickness: 0.09rem;
    text-underline-offset: 0.34rem;
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 150ms linear,
      transform 180ms var(--ease-out),
      text-decoration-color 150ms ease;
  }

  .site-navigation__link[aria-current='page'] .navigation-action__label {
    text-decoration-style: solid;
    text-decoration-color: var(--color-ink);
  }

  .navigation-action__art {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: var(--drawn-icon-size);
    aspect-ratio: 1;
    --drawn-icon-opacity: 1;
    --drawn-icon-size: 3.7rem;
    overflow: visible;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.94) rotate(-4deg);
    transition:
      opacity 150ms linear,
      transform 180ms var(--ease-out);
  }

  .site-navigation__link:focus-visible,
  .site-navigation__link[data-preview-active],
  .contact-disclosure summary:focus-visible,
  .contact-disclosure[open] summary {
    color: var(--color-copy);
  }

  .site-navigation__link:focus-visible .navigation-action__label,
  .site-navigation__link[data-preview-active] .navigation-action__label,
  .contact-disclosure summary:focus-visible .navigation-action__label,
  .contact-disclosure[open] summary .navigation-action__label {
    opacity: 0;
    transform: scale(0.96);
  }

  .site-navigation__link:focus-visible .navigation-action__art,
  .site-navigation__link[data-preview-active] .navigation-action__art,
  .contact-disclosure summary:focus-visible .navigation-action__art,
  .contact-disclosure[open] summary .navigation-action__art {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
  }

  .site-navigation__link:focus-visible,
  .contact-disclosure summary:focus-visible,
  .contact-disclosure__panel a:focus-visible {
    border-radius: 0.1rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-navigation__link:hover,
    .contact-disclosure summary:hover {
      color: var(--color-copy);
    }

    .site-navigation__link:hover .navigation-action__label,
    .contact-disclosure summary:hover .navigation-action__label {
      opacity: 0;
      transform: scale(0.96);
    }

    .site-navigation__link:hover .navigation-action__art,
    .contact-disclosure summary:hover .navigation-action__art {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1) rotate(0deg);
    }
  }

  .contact-disclosure {
    position: relative;
    scroll-margin-top: 5rem;
  }

  .contact-disclosure summary {
    cursor: pointer;
    list-style: none;
  }

  .contact-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .contact-disclosure__panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: -0.2rem;
    display: flex;
    width: max-content;
    max-width: calc(100vw - 1rem);
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.2rem clamp(0.8rem, 2vw, 1.3rem);
    padding: 0.55rem 0.4rem 0.8rem 1.4rem;
    background: color-mix(in srgb, var(--color-field) 24%, transparent);
    backdrop-filter: blur(15px) saturate(1.08);
    -webkit-backdrop-filter: blur(15px) saturate(1.08);
    mask-image: linear-gradient(to right, transparent 0, black 10%, black 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 10%, black 100%);
    transform-origin: 100% 0;
    animation: contact-reveal 180ms var(--ease-out) both;
  }

  .contact-disclosure:not([open]) .contact-disclosure__panel {
    display: none;
  }

  .contact-disclosure__panel a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: inherit;
    font-size: 0.9rem;
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-color: color-mix(in srgb, var(--color-muted) 64%, transparent);
    text-underline-offset: 0.28rem;
  }

  .contact-disclosure__panel a:hover,
  .contact-disclosure__panel a:focus-visible {
    text-decoration-color: var(--color-ink);
  }

  @keyframes contact-reveal {
    from { opacity: 0; transform: translateY(-0.3rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 38rem) {
    .portfolio-navigation {
      padding: 0.45rem 0.7rem 1rem 1.2rem;
    }

    .site-navigation {
      gap: clamp(0.65rem, 3.4vw, 1.05rem);
      font-size: clamp(0.78rem, 3.7vw, 0.9rem);
    }

    .navigation-action__art {
      --drawn-icon-size: 3.25rem;
      width: var(--drawn-icon-size);
    }

    .contact-disclosure__panel {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      gap: 0 clamp(0.55rem, 2.7vw, 0.85rem);
    }

    .contact-disclosure__panel a {
      justify-self: end;
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-navigation__link,
    .contact-disclosure summary,
    .contact-disclosure__panel {
      transition: none;
      animation: none;
    }

    .navigation-action__label,
    .navigation-action__art {
      transform: none;
      transition: opacity 120ms linear;
    }

    .navigation-action__art {
      transform: translate(-50%, -50%);
    }

    .site-navigation__link:focus-visible .navigation-action__label,
    .site-navigation__link[data-preview-active] .navigation-action__label,
    .contact-disclosure summary:focus-visible .navigation-action__label,
    .contact-disclosure[open] summary .navigation-action__label {
      transform: none;
    }

    .site-navigation__link:focus-visible .navigation-action__art,
    .site-navigation__link[data-preview-active] .navigation-action__art,
    .contact-disclosure summary:focus-visible .navigation-action__art,
    .contact-disclosure[open] summary .navigation-action__art {
      transform: translate(-50%, -50%);
    }

    @media (hover: hover) and (pointer: fine) {
      .site-navigation__link:hover .navigation-action__label,
      .contact-disclosure summary:hover .navigation-action__label {
        transform: none;
      }

      .site-navigation__link:hover .navigation-action__art,
      .contact-disclosure summary:hover .navigation-action__art {
        transform: translate(-50%, -50%);
      }
    }
  }
</style>
