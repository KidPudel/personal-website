---
interface Props {
  placement?: 'top' | 'bottom';
}

const { placement = 'bottom' } = Astro.props;
---

<elastic-overscroll-backdrop
  class="elastic-overscroll-backdrop"
  data-placement={placement}
  aria-hidden="true"
>
  <div class="elastic-overscroll-backdrop__backing"></div>
  <div class="elastic-overscroll-backdrop__glow">
    <canvas class="elastic-overscroll-backdrop__field"></canvas>
  </div>
</elastic-overscroll-backdrop>

<script>
  import './elastic-overscroll-backdrop';
</script>

<style>
  .elastic-overscroll-backdrop {
    position: fixed;
    z-index: 0;
    right: 0;
    left: 0;
    display: none;
    height: calc(var(--edge-span, min(22svh, 11.25rem)) + var(--ray-bleed, 3.5rem));
    overflow: hidden;
    contain: layout style;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .elastic-overscroll-backdrop[data-placement='top'] {
    top: 0;
  }

  .elastic-overscroll-backdrop[data-placement='bottom'] {
    bottom: 0;
  }

  :global(.js) .elastic-overscroll-backdrop {
    display: block;
  }

  .elastic-overscroll-backdrop[data-edge-active] {
    z-index: 2;
    opacity: 1;
    visibility: visible;
  }

  .elastic-overscroll-backdrop__backing {
    position: absolute;
    right: 0;
    left: 0;
  }

  [data-placement='top'] .elastic-overscroll-backdrop__backing {
    top: 0;
    height: calc(var(--elastic-top-pull, 0px) + 2px);
    background: #6f8aff;
  }

  [data-placement='bottom'] .elastic-overscroll-backdrop__backing {
    bottom: 0;
    height: calc(var(--elastic-bottom-pull, 0px) + 2px);
    background: var(--color-field);
  }

  .elastic-overscroll-backdrop__glow {
    position: absolute;
    inset: 0;
    filter: blur(clamp(0.7rem, 1.8vw, 1.2rem));
  }

  [data-placement='top'] .elastic-overscroll-backdrop__glow {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 calc(100% - var(--ray-bleed, 3.5rem)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 calc(100% - var(--ray-bleed, 3.5rem)),
      transparent 100%
    );
  }

  [data-placement='bottom'] .elastic-overscroll-backdrop__glow {
    -webkit-mask-image: linear-gradient(
      to top,
      #000 0%,
      #000 calc(100% - var(--ray-bleed, 3.5rem)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to top,
      #000 0%,
      #000 calc(100% - var(--ray-bleed, 3.5rem)),
      transparent 100%
    );
  }

  .elastic-overscroll-backdrop__field {
    position: absolute;
    right: -1.25rem;
    left: -1.25rem;
    display: block;
    width: calc(100% + 2.5rem);
    height: 100%;
  }

  [data-placement='top'] .elastic-overscroll-backdrop__field {
    top: 0;
  }

  [data-placement='bottom'] .elastic-overscroll-backdrop__field {
    bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .elastic-overscroll-backdrop {
      display: none;
    }
  }
</style>
