---
import skyPosterInline from '../../../assets/art/dithered-sky-poster.webp?inline';
import skyMobileVideoUrl from '../../../assets/art/dithered-sky-mobile.mp4?url';
import skyMobileAv1VideoUrl from '../../../assets/art/dithered-sky-mobile-av1.mp4?url';
import skyVideoUrl from '../../../assets/art/dithered-sky.mp4?url';
import skyAv1VideoUrl from '../../../assets/art/dithered-sky-av1.mp4?url';
---

<opening-sequence class="opening-sequence">
  <div class="opening-sequence__scene">
    <div class="opening-sequence__sky" aria-hidden="true">
      <img
        class="opening-sequence__sky-poster"
        src={skyPosterInline}
        alt=""
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <video
        data-opening-sky
        data-critical-media
        poster={skyPosterInline}
        width="1280"
        height="720"
        preload="auto"
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        tabindex="-1"
      >
        <!-- AV1 first, at about half the bytes, for browsers that decode it; H.264 for the rest
             (scripts/prepare-opening-sky.mjs). -->
        <source
          src={skyMobileAv1VideoUrl}
          type='video/mp4; codecs="av01.0.01M.08"'
          media="(max-width: 44.999rem) and (prefers-reduced-motion: no-preference)"
        />
        <source
          src={skyMobileVideoUrl}
          type="video/mp4"
          media="(max-width: 44.999rem) and (prefers-reduced-motion: no-preference)"
        />
        <source
          src={skyAv1VideoUrl}
          type='video/mp4; codecs="av01.0.05M.08"'
          media="(min-width: 45rem) and (prefers-reduced-motion: no-preference)"
        />
        <source
          src={skyVideoUrl}
          type="video/mp4"
          media="(min-width: 45rem) and (prefers-reduced-motion: no-preference)"
        />
      </video>
    </div>
  </div>
</opening-sequence>

<script>
  import './opening-controller';
</script>

<style>
  .opening-sequence {
    position: relative;
    display: block;
    background: var(--color-field);
  }

  .opening-sequence__scene {
    position: relative;
    display: block;
  }

  .opening-sequence__sky {
    display: none;
  }

  /* The sky sits just above the homepage's field and beneath its content,
     so it tints the page without tinting the cards and text. The controller
     fades it out as the work comes up. */
  :global(.js) .opening-sequence__sky {
    position: fixed;
    inset: 0 0 auto;
    z-index: -1;
    display: block;
    height: calc(100vh + var(--browser-bleed-bottom));
    height: calc(100lvh + var(--browser-bleed-bottom));
    overflow: hidden;
    overflow: clip;
    /* Hidden until the controller knows how far down the page is (a reload
       can land anywhere), then it fades to the right strength once; after
       that it follows the scroll directly. */
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms ease-out;
  }

  :global(.js) .opening-sequence__sky[data-following] {
    transition: none;
  }

  .opening-sequence__sky-poster,
  .opening-sequence__sky video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .opening-sequence__sky video {
    pointer-events: none;
  }

  .opening-sequence__sky video[data-autoplay-blocked] {
    display: none;
  }

  .opening-sequence__sky video::-webkit-media-controls,
  .opening-sequence__sky video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .opening-sequence__sky {
      display: none;
    }
  }
</style>
