---
import skyPoster from '../../../assets/art/dithered-sky-poster.webp';
import skyMobileVideoUrl from '../../../assets/art/dithered-sky-mobile.mp4?url';
import skyVideoUrl from '../../../assets/art/dithered-sky.mp4?url';
import { identity } from '../../../content/homepage/identity';
import HelloAnimation from '../identity/HelloAnimation.astro';
---

<link
  rel="preload"
  href={skyVideoUrl}
  as="video"
  type="video/mp4"
  media="(min-width: 45rem) and (prefers-reduced-motion: no-preference)"
/>
<link
  rel="preload"
  href={skyMobileVideoUrl}
  as="video"
  type="video/mp4"
  media="(max-width: 44.999rem) and (prefers-reduced-motion: no-preference)"
/>

<opening-sequence class="opening-sequence">
  <div class="opening-sequence__scene">
    <div class="opening-sequence__sky" aria-hidden="true">
      <img
        class="opening-sequence__sky-poster"
        src={skyPoster.src}
        alt=""
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <video
        data-opening-sky
        data-src={skyVideoUrl}
        data-mobile-src={skyMobileVideoUrl}
        poster={skyPoster.src}
        preload="auto"
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        tabindex="-1"
      ></video>
    </div>

    <div class="opening-sequence__greeting" aria-hidden="true" data-opening-greeting>
      <HelloAnimation text={identity.hello} interactive={false} opening />
    </div>
  </div>
</opening-sequence>

<script>
  import './opening-controller';
</script>

<style>
  .opening-sequence {
    position: relative;
    display: block;
    background: var(--color-field);
  }

  .opening-sequence__greeting,
  .opening-sequence__sky {
    display: none;
  }

  .opening-sequence__scene {
    position: relative;
    display: block;
  }

  :global(.js:not(.opening-bypassed)) .opening-sequence__sky,
  :global(.js:not(.opening-bypassed)) .opening-sequence__greeting {
    position: fixed;
    display: block;
    pointer-events: none;
  }

  :global(.js:not(.opening-bypassed) [data-site-header]) {
    opacity: 0;
    pointer-events: none;
  }

  :global(.js:not(.opening-bypassed)) .opening-sequence__sky {
    inset: 0;
    z-index: 100;
    overflow: hidden;
    overflow: clip;
    opacity: 0.5;
  }

  :global(.js:not(.opening-bypassed)) .opening-sequence__greeting {
    z-index: 101;
    top: 50%;
    left: 50%;
    width: clamp(20rem, 58vw, 48rem);
    opacity: 1;
    transform: translate3d(-50%, -50%, 0);
    transform-origin: top left;
  }

  :global(.js:not(.opening-bypassed)) .opening-sequence[data-opening-live] .opening-sequence__sky,
  :global(.js:not(.opening-bypassed)) .opening-sequence[data-opening-live] .opening-sequence__greeting {
    will-change: transform, opacity;
  }

  :global(.js.opening-bypassed) .opening-sequence__sky,
  :global(.js.opening-bypassed) .opening-sequence__greeting,
  .opening-sequence[data-complete] .opening-sequence__sky,
  .opening-sequence[data-complete] .opening-sequence__greeting {
    display: none;
  }

  .opening-sequence__greeting :global(.hello-animation-with-text) {
    width: 100%;
  }

  .opening-sequence__sky-poster,
  .opening-sequence__sky video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .opening-sequence__sky video {
    pointer-events: none;
  }

  .opening-sequence__sky video[data-autoplay-blocked] {
    display: none;
  }

  .opening-sequence__sky video::-webkit-media-controls,
  .opening-sequence__sky video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  @media (max-width: 44.999rem) {
    :global(.js:not(.opening-bypassed)) .opening-sequence__greeting {
      width: min(88vw, 34rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .opening-sequence__greeting,
    :global(.js) .opening-sequence__sky {
      display: none;
    }
  }
</style>
