---
import type { AnnotatedPart, Tone } from '../../content/homepage/annotated';
import foundations from '../../styles/foundations.css?raw';
import JoyfulWord from './JoyfulWord.astro';

interface Props {
  parts: AnnotatedPart[];
  /** Prefix for the notes' ids, unique on the page. */
  id: string;
}

const { parts, id } = Astro.props;
// Each door has a marker colour, the pigment its swipe is drawn in, and a
// text colour for its note, deep enough to read (4.5:1) on the sky and the
// field.
const tones: Record<Tone, { mark: string; text: string }> = {
  green: { mark: '#7aa83a', text: '#406417' },
  blue: { mark: '#3f99ed', text: '#265d90' },
  lavender: { mark: '#8f7cf6', text: '#5b45b8' },
  orange: { mark: '#fc5629', text: '#a1371a' },
  pink: { mark: '#fd36ed', text: '#9c2192' },
};

// The site's marker swipe is three hand-drawn frames in lavender
// (foundations.css). A door draws the same frames in its own colour.
const swipeFrames = [
  ...(foundations.match(/@keyframes link-mark-draw \{[\s\S]*?\n {2}\}/)?.[0] ?? '').matchAll(/url\("([^"]+)"\)/g),
].map((match) => match[1]);
if (swipeFrames.length !== 3) throw new Error('AnnotatedText: expected the three link-mark frames in foundations.css');
const tintFrames = (color: string) =>
  swipeFrames.map((frame) => frame.replaceAll('%238c93ee', `%23${color.slice(1)}`));
const usedTones = [...new Set(parts.flatMap((part) => (typeof part === 'object' && 'tone' in part ? [part.tone] : [])))];
const toneStyles = usedTones
  .map((tone) => {
    const [first, second, third] = tintFrames(tones[tone].mark);
    return `.door-tone--${tone}{--door:${tones[tone].text};--door-mark-0:url("${first}");--door-mark-1:url("${second}");--door-mark-2:url("${third}")}`;
  })
  .join('');

type Item =
  | { kind: 'text'; value: string }
  | { kind: 'anchor'; value: string }
  | { kind: 'phrase'; text: string; tone: string; noteId: string }
  | { kind: 'joyful'; lead: string; word: string; href: string; trail: string };

const items: Item[] = [];
const notes: { id: string; text: string; tone: string }[] = [];

parts.forEach((part, index) => {
  if (typeof part === 'string') {
    const last = items.at(-1);
    // Punctuation right after "joyful" stays on its line.
    if (last?.kind === 'joyful' && !last.trail) {
      const trail = part.match(/^[^\s]*/)?.[0] ?? '';
      last.trail = trail;
      part = part.slice(trail.length);
    }
    if (part) items.push({ kind: 'text', value: part });
  } else if ('anchor' in part) {
    items.push({ kind: 'anchor', value: part.anchor });
  } else if ('joyful' in part) {
    // The word before "joyful" stays with it, so the circled word never ends
    // the sentence alone on its line.
    const previous = items.at(-1);
    let lead = '';
    if (previous?.kind === 'text') {
      const cut = previous.value.trimEnd().lastIndexOf(' ') + 1;
      lead = previous.value.slice(cut);
      previous.value = previous.value.slice(0, cut);
    }
    items.push({ kind: 'joyful', lead, word: part.joyful, href: part.href, trail: '' });
  } else {
    const noteId = `${id}-note-${index}`;
    const tone = `door-tone--${part.tone}`;
    items.push({ kind: 'phrase', text: part.text, tone, noteId });
    notes.push({ id: noteId, text: part.note, tone });
  }
});
---

<style is:inline set:html={toneStyles}></style>
<annotated-text class="annotated">
  <p class="annotated__text">
    {items.map((item) =>
      item.kind === 'text' ? (
        item.value
      ) : item.kind === 'anchor' ? (
        <strong class="annotated__anchor">{item.value}</strong>
      ) : item.kind === 'phrase' ? (
        <span class:list={['annotated__phrase link-mark', item.tone]} aria-controls={item.noteId} data-phrase>{item.text}<span class="annotated__star" aria-hidden="true">*</span></span>
      ) : (
        <span class="annotated__keep">{item.lead}<JoyfulWord word={item.word} href={item.href} />{item.trail}</span>
      ),
    )}
  </p>

  <div class="annotated__notes">
    {notes.map((note) => (
      <div id={note.id} class:list={['annotated__note', note.tone]} data-note>
        <div class="annotated__note-inner">
          <p class="annotated__note-text">{note.text}</p>
        </div>
      </div>
    ))}
  </div>
</annotated-text>

<script>
  // The doors of a sentence, like the ones in "A few more things about me":
  // grey text, ink words that open something. Opening one fades the rest of
  // the page, colours the door, and parts the sentence under the door's
  // line: the lines below slide down and the note unfolds in the gap, so the
  // explanation stays right under its word. Without this script the notes
  // simply follow the sentence.
  const OPEN_EVENT = 'annotation-open';
  // How long the gap takes to close before the note goes back to its place.
  const CLOSE_MS = 320;

  class AnnotatedText extends HTMLElement {
    private abort?: AbortController;
    private active?: HTMLElement;
    private width = 0;
    private closing = new Map<HTMLElement, number>();

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const { signal } = this.abort;

      this.querySelectorAll<HTMLElement>('[data-phrase]').forEach((phrase) => {
        phrase.setAttribute('role', 'button');
        phrase.setAttribute('tabindex', '0');
        phrase.setAttribute('aria-expanded', 'false');
        phrase.addEventListener('click', () => this.toggle(phrase), { signal });
        phrase.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          this.toggle(phrase);
        }, { signal });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !this.active) return;
        const phrase = this.active;
        this.close();
        phrase.focus();
      }, { signal });
      document.addEventListener('pointerdown', (event) => {
        if (!this.active) return;
        const target = event.target as Node;
        if (this.active.contains(target) || this.noteFor(this.active)?.contains(target)) return;
        this.close();
      }, { signal });
      document.addEventListener(OPEN_EVENT, (event) => {
        if ((event as CustomEvent).detail !== this && this.active) this.close();
      }, { signal });

      // The sentence rewraps at a new width, so an open note moves to the
      // door's new line.
      const resize = new ResizeObserver(([entry]) => {
        const width = Math.round(entry.contentRect.width);
        if (width === this.width) return;
        this.width = width;
        if (this.active) this.place(this.active, false);
      });
      resize.observe(this);
      signal.addEventListener('abort', () => resize.disconnect());
    }

    disconnectedCallback() {
      this.abort?.abort();
      if (this.active) this.close();
    }

    private noteFor(phrase: HTMLElement) {
      return document.getElementById(phrase.getAttribute('aria-controls') ?? '');
    }

    private toggle(phrase: HTMLElement) {
      if (this.active === phrase) {
        this.close();
        return;
      }
      if (this.active) this.reset(this.active, false);
      this.active = phrase;
      phrase.setAttribute('aria-expanded', 'true');
      this.place(phrase, true);
      this.setAttribute('data-active', '');
      this.closest('#main-content > *')?.setAttribute('data-annotating-host', '');
      document.documentElement.setAttribute('data-annotating', '');
      document.dispatchEvent(new CustomEvent(OPEN_EVENT, { detail: this }));
    }

    private close() {
      if (this.active) this.reset(this.active, true);
      this.active = undefined;
      this.removeAttribute('data-active');
      this.closest('#main-content > *')?.removeAttribute('data-annotating-host');
      if (!document.querySelector('annotated-text[data-active], personal-note-reveals[data-active]')) {
        document.documentElement.removeAttribute('data-annotating');
      }
    }

    private reset(phrase: HTMLElement, animate: boolean) {
      phrase.setAttribute('aria-expanded', 'false');
      const note = this.noteFor(phrase);
      if (!note) return;
      note.removeAttribute('data-open');
      if (!animate || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.putBack(note);
        return;
      }
      window.clearTimeout(this.closing.get(note));
      this.closing.set(note, window.setTimeout(() => this.putBack(note), CLOSE_MS));
    }

    /** Returns a note to the list after the sentence and mends the text it
     *  split. */
    private putBack(note: HTMLElement) {
      window.clearTimeout(this.closing.get(note));
      this.closing.delete(note);
      const sentence = note.parentElement;
      note.style.removeProperty('margin-right');
      note.querySelector<HTMLElement>('.annotated__note-text')?.removeAttribute('style');
      this.querySelector('.annotated__notes')?.append(note);
      if (sentence?.matches('.annotated__text')) sentence.normalize();
    }

    /** Opens the sentence after the door's line and sets the note in the
     *  gap. */
    private place(phrase: HTMLElement, animate: boolean) {
      const note = this.noteFor(phrase);
      const sentence = phrase.closest<HTMLElement>('.annotated__text');
      if (!note || !sentence) return;
      this.putBack(note);
      note.removeAttribute('data-open');
      sentence.insertBefore(note, this.lineAfter(phrase, sentence));
      this.alignUnder(phrase, sentence, note);
      if (animate) note.getBoundingClientRect();
      note.toggleAttribute('data-instant', !animate);
      note.setAttribute('data-open', '');
    }

    /** Starts the note where the door starts, out into the space beside the
     *  sentence, narrowing to fit before the page's right inset. When that
     *  leaves less than 24em (about 55 characters), it starts at the
     *  sentence's edge instead, never somewhere in between, so it always lines
     *  up with something. On a phone it stays at the edge. */
    private alignUnder(phrase: HTMLElement, sentence: HTMLElement, note: HTMLElement) {
      const text = note.querySelector<HTMLElement>('.annotated__note-text');
      if (!text) return;
      const style = getComputedStyle(text);
      const rects = phrase.getClientRects();
      const box = sentence.getBoundingClientRect();
      const start = rects[rects.length - 1].left - box.left;
      // The page's inset mirrored on the right: as far as the note may run.
      const room = document.documentElement.clientWidth - 2 * box.left - start;
      if (start <= 0 || room < 24 * parseFloat(style.fontSize)) return;
      const width = Math.min(parseFloat(style.maxWidth), room);
      text.style.marginLeft = `${start}px`;
      text.style.maxWidth = `${width}px`;
      // The note may run past the sentence's right edge into the space beside it.
      note.style.marginRight = `${Math.min(0, box.width - start - width)}px`;
    }

    /** The first thing on the line after the door's last line: a split text
     *  node, or the part of the sentence that holds it. Null when the door is
     *  on the last line. */
    private lineAfter(phrase: HTMLElement, sentence: HTMLElement): Node | null {
      const rects = phrase.getClientRects();
      const line = rects[rects.length - 1];
      const middle = (line.top + line.bottom) / 2;
      const walker = document.createTreeWalker(sentence, NodeFilter.SHOW_TEXT);
      const range = document.createRange();
      for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
        if (phrase.contains(node) || !(phrase.compareDocumentPosition(node) & Node.DOCUMENT_POSITION_FOLLOWING)) continue;
        for (let index = 0; index < node.length; index += 1) {
          if (/\s/.test(node.data[index])) continue;
          range.setStart(node, index);
          range.setEnd(node, index + 1);
          const rect = range.getClientRects()[0];
          if (!rect || (rect.top + rect.bottom) / 2 < middle + line.height / 2) continue;
          if (node.parentNode === sentence) return node.splitText(index);
          let part: Node = node;
          while (part.parentNode !== sentence) part = part.parentNode!;
          return part;
        }
      }
      return null;
    }
  }

  if (!customElements.get('annotated-text')) {
    customElements.define('annotated-text', AnnotatedText);
  }
</script>

<style>
  .annotated {
    position: relative;
    display: block;
    --door-fade: rgb(17 17 15 / 0.2);
  }

  .annotated__text {
    margin: 0;
    /* The sentence's grey, About's; the introduction sets a darker one for
       the sky (--door-grey). */
    color: var(--door-grey, var(--color-muted));
    text-wrap: pretty;
    transition: color 220ms ease;
  }

  /* A door, as in "A few more things about me": ink in the grey sentence,
     with its asterisk. Hover draws the marker swipe, in the door's colour;
     while its note is open the swipe stays. */
  .annotated__phrase {
    color: var(--color-ink);
    font-family: var(--font-door);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color 220ms ease;
  }

  .annotated__phrase:focus-visible,
  .annotated__phrase[aria-expanded='true'] {
    animation: door-mark-draw var(--link-mark-draw) step-end forwards;
  }

  @media (hover: hover) and (pointer: fine) {
    .annotated__phrase:hover {
      animation: door-mark-draw var(--link-mark-draw) step-end forwards;
    }
  }

  @keyframes door-mark-draw {
    0% { background-image: var(--door-mark-0); }
    33.33% { background-image: var(--door-mark-1); }
    66.67%, 100% { background-image: var(--door-mark-2); }
  }

  .annotated__phrase:focus-visible {
    border-radius: 0.08em;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .annotated__keep {
    white-space: nowrap;
  }

  /* A door's mark: an asterisk in its own colour, the footnote sign for
     "there's more here". It is what tells a visitor a word opens, on touch
     screens too, so ink and weight are free to mean "read this". */
  .annotated__star {
    margin-left: 0.04em;
    color: var(--door);
    transition: color 220ms ease;
  }

  /* An anchor: a phrase to read first, in ink. Its weight comes from where
     the sentence is set, and it carries no door mark. */
  .annotated__anchor {
    color: var(--color-ink);
    font-weight: inherit;
    transition: color 220ms ease;
  }

  /* "joyful" is a door of its own kind, in ink like the others. */
  .annotated__keep :global(.joyful) {
    color: var(--color-ink);
    transition: opacity 220ms ease;
  }

  /* Open: everything but the door and its note fades. */
  .annotated[data-active] .annotated__text,
  .annotated[data-active] .annotated__anchor,
  .annotated[data-active] .annotated__phrase {
    color: var(--door-fade);
  }

  .annotated[data-active] .annotated__phrase[aria-expanded='true'] {
    color: var(--color-ink);
  }

  .annotated[data-active] .annotated__phrase:not([aria-expanded='true']) .annotated__star {
    color: var(--door-fade);
  }

  .annotated[data-active] .annotated__keep :global(.joyful) {
    opacity: 0.2;
  }

  /* The note, in the gap the sentence opens under the door's line: in the
     sentence's own face, in the door's colour, starting where the door
     starts. Its asterisk hangs in the margin, the footnote answering
     the one on the door. */
  .annotated__note-text {
    max-width: 36em;
    margin: 0;
    color: var(--door);
    font-style: normal;
    font-weight: inherit;
    text-wrap: pretty;
  }

  .annotated__note-text::before {
    content: '*' / '';
    display: inline-block;
    width: 0.6em;
    margin-left: -0.6em;
  }

  /* Without JavaScript the notes follow the sentence in the page. With it,
     a note waits out of sight until its door opens, then moves into the
     sentence. Keyed to the root's js class, set before the first paint, so
     the notes never show in the page and then fold away. */
  :global(.js) .annotated .annotated__notes {
    display: none;
  }

  .annotated__notes .annotated__note-text {
    padding-top: 0.9lh;
  }

  /* Opening: the gap grows from nothing to the note's height, pushing the
     rest of the sentence down, and the note's letters come in as it opens. */
  :global(.js) .annotated__text > .annotated__note {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms var(--ease-out);
  }

  :global(.js) .annotated__text > .annotated__note[data-open] {
    grid-template-rows: 1fr;
  }

  /* Room on the left for the hanging asterisk, which the unfold would
     otherwise clip. */
  :global(.js) .annotated__text > .annotated__note > .annotated__note-inner {
    min-height: 0;
    margin-left: -1em;
    padding-left: 1em;
    overflow: hidden;
  }

  :global(.js) .annotated__text > .annotated__note .annotated__note-text {
    padding: 0.55rem 0 1rem;
    opacity: 0;
    transition: opacity 140ms ease;
  }

  :global(.js) .annotated__text > .annotated__note[data-open] .annotated__note-text {
    opacity: 1;
    transition: opacity 240ms ease 80ms;
  }

  :global(.js) .annotated__text > .annotated__note[data-instant],
  :global(.js) .annotated__text > .annotated__note[data-instant] .annotated__note-text {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .annotated__text > .annotated__note,
    :global(.js) .annotated__text > .annotated__note .annotated__note-text {
      transition: none;
    }
  }
</style>
