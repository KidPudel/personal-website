---
import type { CollectionEntry } from 'astro:content';

import { publicLinks, sitePath } from '../../config/site';
import PortfolioHeader from './PortfolioHeader.astro';
import SectionMarker from './SectionMarker.astro';
import WorkMedia from './WorkMedia.astro';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
  receiptProcessing: CollectionEntry<'software'>;
  orderingPlatform: CollectionEntry<'software'>;
  discourses: CollectionEntry<'games'>;
  santa: CollectionEntry<'games'>;
  snake: CollectionEntry<'games'>;
  ticTacToe: CollectionEntry<'games'>;
  cardStudy: CollectionEntry<'games'>;
}

const {
  observatory,
  foodProduct,
  chineseBee,
  receiptProcessing,
  orderingPlatform,
  discourses,
  santa,
  snake,
  ticTacToe,
  cardStudy,
} = Astro.props;
---

<div class="work-page" data-work-page>
  <PortfolioHeader current="work" />

  <main id="main-content">
    <header class="work-intro">
      <div class="doodles doodles--intro" aria-hidden="true"></div>
      <SectionMarker icon="work" label="Work" />
      <h1>Products, systems, and playable things.</h1>
      <p>
        I work from the shape of an experience through its behavior and into a real build.
        These projects show that range without pretending every artifact is the same kind of evidence.
      </p>
      <a class="quiet-link" href={sitePath('/resume/igor-kupchinenko-product-designer-resume.pdf')}>Résumé PDF</a>
    </header>

    <section id="product-design" class="work-section product-work" aria-labelledby="product-title">
      <header class="section-intro">
        <SectionMarker icon="software" label="Product design" />
        <h2 id="product-title">From an idea to something people can actually use.</h2>
      </header>

      <article class="featured-project">
        <a class="featured-project__media" href={sitePath('/case-studies/observatory/')}>
          <WorkMedia slug="observatory" />
        </a>
        <div class="featured-project__copy">
          <p class="project-label">Native macOS product · published</p>
          <h3>{observatory.data.title}</h3>
          <p>{observatory.data.summary}</p>
          <ul class="meta-line" aria-label="Responsibilities">
            {observatory.data.capabilities.slice(0, 5).map((capability) => <li>{capability}</li>)}
          </ul>
          <div class="project-links">
            <a class="quiet-link" href={sitePath('/case-studies/observatory/')}>Read the case study</a>
            {observatory.data.externalUrl && (
              <a class="quiet-link" href={observatory.data.externalUrl}>GitHub <span aria-hidden="true">↗</span></a>
            )}
          </div>
        </div>
      </article>

      <div class="product-pair">
        <article class="project project--visual" style="--media-tilt: 2.1deg">
          <WorkMedia slug="flutter-product" />
          <div class="project__copy">
            <p class="project-label">End-to-end product delivery</p>
            <h3>{foodProduct.data.title}</h3>
            <p>{foodProduct.data.summary}</p>
            <ul class="meta-line" aria-label="Capabilities">
              {foodProduct.data.capabilities.map((capability) => <li>{capability}</li>)}
            </ul>
          </div>
        </article>

        <article class="project project--visual" style="--media-tilt: -1.9deg">
          <WorkMedia slug="chinese-bee" />
          <div class="project__copy">
            <p class="project-label">One learning need across several surfaces</p>
            <h3>{chineseBee.data.title}</h3>
            <p>{chineseBee.data.summary}</p>
            <ul class="meta-line" aria-label="Capabilities">
              {chineseBee.data.capabilities.map((capability) => <li>{capability}</li>)}
            </ul>
          </div>
        </article>
      </div>

      <div class="systems-pair">
        <article class="project project--system">
          <WorkMedia slug="receipt-processing" />
          <div class="project__copy">
            <p class="project-label">Investigation and simplification</p>
            <h3>{receiptProcessing.data.title}</h3>
            <p>{receiptProcessing.data.summary}</p>
          </div>
        </article>

        <article class="project project--system">
          <WorkMedia slug="ordering-platform" />
          <div class="project__copy">
            <p class="project-label">Product flows across service boundaries</p>
            <h3>{orderingPlatform.data.title}</h3>
            <p>{orderingPlatform.data.summary}</p>
          </div>
        </article>
      </div>
    </section>

    <section id="games" class="work-section games-work" aria-labelledby="games-title">
      <div class="doodles doodles--games" aria-hidden="true"></div>
      <header class="section-intro">
        <SectionMarker icon="games" label="Games" />
        <h2 id="games-title">Where behavior, feedback, atmosphere, and failure meet.</h2>
        <p>
          Games keep my design practice honest. They cannot be completed by styling the surface.
          The player has to feel the system working.
        </p>
      </header>

      <article class="game-feature">
        <div class="game-feature__media" style="--media-tilt: -1.6deg">
          <WorkMedia slug="discourses-by-campfire" />
        </div>
        <div class="game-feature__copy">
          <p class="project-label">Godot · complete game</p>
          <h3>{discourses.data.title}</h3>
          <p>{discourses.data.summary}</p>
          <ul class="meta-line" aria-label="Craft demonstrated">
            {discourses.data.learnings.map((learning) => <li>{learning}</li>)}
          </ul>
          {discourses.data.externalUrl && (
            <a class="quiet-link" href={discourses.data.externalUrl}>Play on itch.io <span aria-hidden="true">↗</span></a>
          )}
        </div>
      </article>

      <article class="game-feature game-feature--reverse">
        <div class="game-feature__media" style="--media-tilt: 1.8deg">
          <WorkMedia slug="santa-foundation" />
        </div>
        <div class="game-feature__copy">
          <p class="project-label">Game jam · built and improved from player feedback</p>
          <h3>{santa.data.title}</h3>
          <p>{santa.data.summary}</p>
          <ul class="meta-line" aria-label="Craft demonstrated">
            {santa.data.learnings.map((learning) => <li>{learning}</li>)}
          </ul>
          {santa.data.externalUrl && (
            <a class="quiet-link" href={santa.data.externalUrl}>View the game <span aria-hidden="true">↗</span></a>
          )}
        </div>
      </article>

      <section class="experiments" aria-labelledby="experiments-title">
        <header class="experiments__intro">
          <p class="section-label">Earlier experiments and unfinished systems</p>
          <h3 id="experiments-title">The trail matters too.</h3>
          <p>Smaller and unfinished work, presented honestly and with the artifact itself.</p>
        </header>
        <div class="experiments__grid">
          <article class="experiment" style="--media-tilt: -2deg">
            <WorkMedia slug="snake-raylib" />
            <p class="project-label">{snake.data.engine}</p>
            <h4>{snake.data.title}</h4>
            <p>{snake.data.summary}</p>
            {snake.data.externalUrl && (
              <a class="quiet-link" href={snake.data.externalUrl}>Original post <span aria-hidden="true">↗</span></a>
            )}
          </article>
          <article class="experiment" style="--media-tilt: 1.6deg">
            <WorkMedia slug="tic-tac-toe-opengl" />
            <p class="project-label">{ticTacToe.data.engine}</p>
            <h4>{ticTacToe.data.title}</h4>
            <p>{ticTacToe.data.summary}</p>
            {ticTacToe.data.externalUrl && (
              <a class="quiet-link" href={ticTacToe.data.externalUrl}>GitHub <span aria-hidden="true">↗</span></a>
            )}
          </article>
          <article class="experiment experiment--wide">
            <WorkMedia slug="card-system-study" />
            <div>
              <p class="project-label">{cardStudy.data.status} · {cardStudy.data.engine}</p>
              <h4>{cardStudy.data.title}</h4>
              <p>{cardStudy.data.summary}</p>
            </div>
          </article>
        </div>
      </section>
    </section>

    <footer class="work-footer">
      <p>That is the work. The next interesting problem can be yours.</p>
      <a class="quiet-link" href={publicLinks.email}>i.kupchinenko@gmail.com</a>
    </footer>
  </main>
</div>

<style>
  .work-page {
    min-width: 20rem;
    overflow-x: clip;
    background: var(--color-field);
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.95rem, 0.12vw + 0.93rem, 1.02rem);
    line-height: 1.62;
  }

  .work-intro,
  .work-section,
  .work-footer {
    position: relative;
    width: min(100%, 76rem);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 4.5rem);
  }

  .doodles {
    position: absolute;
    z-index: 0;
    inset: 0;
    background-repeat: no-repeat;
    filter: grayscale(1);
    opacity: 0.07;
    pointer-events: none;
  }

  .doodles--intro {
    background-image: url('../../assets/art/doodles/Doodles_camera.png'), url('../../assets/art/doodles/Doodles_scribble.png');
    background-position: 6% 33%, 90% 35%;
    background-size: 7rem, 11rem;
  }

  .doodles--games {
    background-image: url('../../assets/art/doodles/Doodles_campfire.png'), url('../../assets/art/doodles/Doodles_robot.png'), url('../../assets/art/doodles/Doodles_dead_fish.png');
    background-position: 94% 7%, 3% 60%, 88% 96%;
    background-size: 8rem, 7rem, 9rem;
  }

  .work-intro > *,
  .work-section > * {
    position: relative;
    z-index: 1;
  }

  .work-intro {
    padding-top: 6.75rem;
    padding-bottom: 1.35rem;
  }

  .section-label,
  .project-label {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-reading);
    font-size: 0.78rem;
    letter-spacing: 0.035em;
  }

  .work-intro h1,
  .featured-project h3,
  .project h3,
  .game-feature h3,
  .experiment h4 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .section-intro h2,
  .experiments h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .work-intro h1 {
    max-width: 16ch;
    margin-top: 0.45rem;
    font-size: clamp(2.25rem, 3.25vw, 3.5rem);
    line-height: 1.04;
  }

  .work-intro > p {
    max-width: 36rem;
    margin: 1.15rem 0 0;
    color: var(--color-copy);
    font-size: clamp(0.98rem, 0.35vw + 0.93rem, 1.14rem);
  }

  .quiet-link {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: 0.84rem;
    text-decoration: none;
    padding-bottom: 0.04em;
    border-bottom: 0.1rem dotted var(--color-muted);
  }

  .work-intro .quiet-link {
    margin-top: 1.15rem;
  }

  .work-section {
    scroll-margin-top: 1.5rem;
    padding-top: clamp(2.1rem, 3.8vw, 3.1rem);
    padding-bottom: clamp(3.25rem, 6vw, 5.25rem);
  }

  .section-intro {
    display: grid;
    gap: 0.35rem;
    max-width: 38rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .section-intro h2 {
    max-width: 22ch;
    font-size: clamp(1.45rem, 2.1vw, 2.05rem);
    line-height: 1.2;
  }

  .section-intro > p {
    max-width: 34rem;
    margin: 0.55rem 0 0;
    color: var(--color-copy);
  }

  .featured-project {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .featured-project__media {
    display: block;
    min-width: 0;
    rotate: -1.7deg;
    text-decoration: none;
  }

  .featured-project h3 {
    margin-top: 0.45rem;
    font-size: clamp(1.35rem, 1.8vw, 1.75rem);
    line-height: 1.12;
  }

  .featured-project__copy > p:not(.project-label),
  .project__copy > p:not(.project-label),
  .game-feature__copy > p:not(.project-label),
  .experiment > p:not(.project-label),
  .experiment--wide > div > p:not(.project-label) {
    margin: 0.65rem 0 0;
    color: var(--color-copy);
  }

  .meta-line {
    margin: 0.75rem 0 0;
    padding: 0;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.55;
    list-style: none;
  }

  .meta-line li {
    display: inline;
  }

  .meta-line li:not(:last-child)::after {
    content: ' · ';
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    align-items: center;
    margin-top: 0.85rem;
  }

  .game-feature__copy > .quiet-link,
  .experiment > .quiet-link {
    margin-top: 0.35rem;
  }

  .product-pair,
  .systems-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .product-pair {
    padding-top: clamp(3.25rem, 5.5vw, 4.5rem);
  }

  .systems-pair {
    padding-top: clamp(3rem, 5vw, 4.25rem);
  }

  .project {
    min-width: 0;
  }

  .project > :global(.work-media) {
    rotate: var(--media-tilt, 1.8deg);
  }

  .project--system > :global(.work-media) {
    rotate: none;
  }

  .project__copy {
    padding-top: 0.85rem;
  }

  .project h3 {
    margin-top: 0.35rem;
    font-size: clamp(1.18rem, 1.45vw, 1.42rem);
    line-height: 1.16;
  }

  .games-work {
    isolation: isolate;
  }

  .game-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: clamp(2.25rem, 4vw, 3.25rem) 0 0;
  }

  .game-feature--reverse {
    padding-top: clamp(2.75rem, 4.5vw, 3.75rem);
  }

  .game-feature--reverse .game-feature__media { order: 2; }
  .game-feature--reverse .game-feature__copy { order: 1; }

  .game-feature__media {
    min-width: 0;
    rotate: var(--media-tilt, -1.6deg);
  }

  .game-feature h3 {
    margin-top: 0.4rem;
    font-size: clamp(1.28rem, 1.7vw, 1.6rem);
    line-height: 1.12;
  }

  .experiments {
    padding-top: clamp(3.25rem, 5.5vw, 4.5rem);
  }

  .experiments__intro {
    display: grid;
    gap: 0.4rem;
    max-width: 36rem;
    margin-bottom: 1.75rem;
  }

  .experiments h3 {
    font-size: clamp(1.3rem, 1.8vw, 1.7rem);
    line-height: 1.2;
  }

  .experiments__intro > p:last-child {
    margin: 0.15rem 0 0;
    color: var(--color-copy);
  }

  .experiments__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .experiment {
    min-width: 0;
  }

  .experiment :global(.work-media) {
    rotate: var(--media-tilt, 1.6deg);
  }

  .experiment:not(.experiment--wide) :global(.work-media) {
    display: grid;
    aspect-ratio: 16 / 10;
  }

  .experiment:not(.experiment--wide) :global(.work-media) :global(img),
  .experiment:not(.experiment--wide) :global(.work-media) :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .experiment .project-label {
    margin-top: 0.85rem;
  }

  .experiment h4 {
    margin-top: 0.3rem;
    font-size: clamp(1.12rem, 1.3vw, 1.28rem);
    line-height: 1.14;
  }

  .experiment--wide {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-top: 0.5rem;
  }

  .experiment--wide :global(.work-media) {
    rotate: none;
  }

  .experiment--wide .project-label {
    margin-top: 0;
  }

  .work-footer {
    display: grid;
    place-items: center;
    gap: 0.15rem;
    padding-top: 2.5rem;
    padding-bottom: 4.5rem;
    text-align: center;
  }

  .work-footer p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 52rem) {
    .featured-project,
    .game-feature,
    .product-pair,
    .systems-pair {
      grid-template-columns: 1fr;
    }

    .game-feature--reverse .game-feature__media,
    .game-feature--reverse .game-feature__copy {
      order: initial;
    }

    .product-pair,
    .systems-pair {
      gap: 3.25rem;
    }

    .featured-project,
    .game-feature {
      gap: 1rem;
    }

    .experiment--wide {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .work-intro {
      padding-top: 5.75rem;
    }

    .work-intro h1 {
      font-size: clamp(1.7rem, 8vw, 2.35rem);
    }

    .section-intro h2 {
      font-size: clamp(1.3rem, 6vw, 1.7rem);
    }

    .experiments__grid {
      grid-template-columns: 1fr;
    }

    .experiment--wide {
      grid-column: auto;
    }
  }
</style>
