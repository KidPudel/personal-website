---
import type { CollectionEntry } from 'astro:content';

import { publicLinks, sitePath } from '../../config/site';
import PortfolioHeader from './PortfolioHeader.astro';
import SectionMarker from './SectionMarker.astro';
import WorkMedia from './WorkMedia.astro';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
  receiptProcessing: CollectionEntry<'software'>;
  orderingPlatform: CollectionEntry<'software'>;
  discourses: CollectionEntry<'games'>;
  santa: CollectionEntry<'games'>;
  snake: CollectionEntry<'games'>;
  ticTacToe: CollectionEntry<'games'>;
  cardStudy: CollectionEntry<'games'>;
}

const {
  observatory,
  foodProduct,
  chineseBee,
  receiptProcessing,
  orderingPlatform,
  discourses,
  santa,
  snake,
  ticTacToe,
  cardStudy,
} = Astro.props;
---

<div class="work-page" data-work-page>
  <PortfolioHeader current="work" />

  <main id="main-content">
    <header class="work-intro">
      <div class="doodles doodles--intro" aria-hidden="true"></div>
      <SectionMarker icon="work" label="Work" />
      <h1>Products, systems, and playable things.</h1>
      <p>
        I work from the shape of an experience through its behavior and into a real build.
        These projects show that range without pretending every artifact is the same kind of evidence.
      </p>
      <div class="work-intro__links">
        <a href="#product-design">Product design <span aria-hidden="true">↓</span></a>
        <a href="#games">Games <span aria-hidden="true">↓</span></a>
        <a href={sitePath('/resume/igor-kupchinenko-resume.pdf')}>Résumé PDF</a>
      </div>
    </header>

    <section id="product-design" class="work-section product-work" aria-labelledby="product-title">
      <header class="section-intro">
        <SectionMarker icon="software" label="Product design" />
        <h2 id="product-title">From an idea to something people can actually use.</h2>
      </header>

      <article class="featured-project">
        <a class="featured-project__media" href={sitePath('/case-studies/observatory/')}>
          <WorkMedia slug="observatory" />
        </a>
        <div class="featured-project__copy">
          <p class="project-label">Native macOS product · published</p>
          <h3>{observatory.data.title}</h3>
          <p>{observatory.data.summary}</p>
          <ul class="capabilities" aria-label="Responsibilities">
            {observatory.data.capabilities.slice(0, 5).map((capability) => <li>{capability}</li>)}
          </ul>
          <div class="project-links">
            <a href={sitePath('/case-studies/observatory/')}>Read the case study</a>
            {observatory.data.externalUrl && <a href={observatory.data.externalUrl}>GitHub <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
      </article>

      <div class="product-pair">
        <article class="project project--visual">
          <WorkMedia slug="flutter-product" />
          <div class="project__copy">
            <p class="project-label">End-to-end product delivery</p>
            <h3>{foodProduct.data.title}</h3>
            <p>{foodProduct.data.summary}</p>
            <ul class="capabilities" aria-label="Capabilities">
              {foodProduct.data.capabilities.map((capability) => <li>{capability}</li>)}
            </ul>
          </div>
        </article>

        <article class="project project--visual">
          <WorkMedia slug="chinese-bee" />
          <div class="project__copy">
            <p class="project-label">One learning need across several surfaces</p>
            <h3>{chineseBee.data.title}</h3>
            <p>{chineseBee.data.summary}</p>
            <ul class="capabilities" aria-label="Capabilities">
              {chineseBee.data.capabilities.map((capability) => <li>{capability}</li>)}
            </ul>
          </div>
        </article>
      </div>

      <div class="systems-pair">
        <article class="project project--system">
          <WorkMedia slug="receipt-processing" />
          <div class="project__copy">
            <p class="project-label">Investigation and simplification</p>
            <h3>{receiptProcessing.data.title}</h3>
            <p>{receiptProcessing.data.summary}</p>
          </div>
        </article>

        <article class="project project--system">
          <WorkMedia slug="ordering-platform" />
          <div class="project__copy">
            <p class="project-label">Product flows across service boundaries</p>
            <h3>{orderingPlatform.data.title}</h3>
            <p>{orderingPlatform.data.summary}</p>
          </div>
        </article>
      </div>
    </section>

    <section id="games" class="work-section games-work" aria-labelledby="games-title">
      <div class="doodles doodles--games" aria-hidden="true"></div>
      <header class="section-intro section-intro--games">
        <div>
          <SectionMarker icon="games" label="Games" />
          <h2 id="games-title">Where behavior, feedback, atmosphere, and failure meet.</h2>
        </div>
        <p>
          Games keep my design practice honest. They cannot be completed by styling the surface.
          The player has to feel the system working.
        </p>
      </header>

      <article class="game-feature">
        <div class="game-feature__media"><WorkMedia slug="discourses-by-campfire" /></div>
        <div class="game-feature__copy">
          <p class="project-label">Godot · complete game</p>
          <h3>{discourses.data.title}</h3>
          <p>{discourses.data.summary}</p>
          <ul class="learnings" aria-label="Craft demonstrated">
            {discourses.data.learnings.map((learning) => <li>{learning}</li>)}
          </ul>
          {discourses.data.externalUrl && <a href={discourses.data.externalUrl}>Play on itch.io <span aria-hidden="true">↗</span></a>}
        </div>
      </article>

      <article class="game-feature game-feature--reverse">
        <div class="game-feature__media"><WorkMedia slug="santa-foundation" /></div>
        <div class="game-feature__copy">
          <p class="project-label">Game jam · built and improved from player feedback</p>
          <h3>{santa.data.title}</h3>
          <p>{santa.data.summary}</p>
          <ul class="learnings" aria-label="Craft demonstrated">
            {santa.data.learnings.map((learning) => <li>{learning}</li>)}
          </ul>
          {santa.data.externalUrl && <a href={santa.data.externalUrl}>View the game <span aria-hidden="true">↗</span></a>}
        </div>
      </article>

      <section class="experiments" aria-labelledby="experiments-title">
        <header>
          <p class="section-label">Earlier experiments and unfinished systems</p>
          <h3 id="experiments-title">The trail matters too.</h3>
          <p>Smaller and unfinished work, presented honestly and with the artifact itself.</p>
        </header>
        <div class="experiments__grid">
          <article class="experiment">
            <WorkMedia slug="snake-raylib" />
            <p class="project-label">{snake.data.engine}</p>
            <h4>{snake.data.title}</h4>
            <p>{snake.data.summary}</p>
            {snake.data.externalUrl && <a href={snake.data.externalUrl}>Original post <span aria-hidden="true">↗</span></a>}
          </article>
          <article class="experiment">
            <WorkMedia slug="tic-tac-toe-opengl" />
            <p class="project-label">{ticTacToe.data.engine}</p>
            <h4>{ticTacToe.data.title}</h4>
            <p>{ticTacToe.data.summary}</p>
            {ticTacToe.data.externalUrl && <a href={ticTacToe.data.externalUrl}>GitHub <span aria-hidden="true">↗</span></a>}
          </article>
          <article class="experiment experiment--wide">
            <WorkMedia slug="card-system-study" />
            <div>
              <p class="project-label">{cardStudy.data.status} · {cardStudy.data.engine}</p>
              <h4>{cardStudy.data.title}</h4>
              <p>{cardStudy.data.summary}</p>
            </div>
          </article>
        </div>
      </section>
    </section>

    <footer class="work-footer">
      <p>That is the work. The next interesting problem can be yours.</p>
      <a href={publicLinks.email}>i.kupchinenko@gmail.com</a>
      <a href={sitePath('/')}>Back to me ↑</a>
    </footer>
  </main>
</div>

<style>
  .work-page {
    min-width: 20rem;
    overflow-x: clip;
    background: var(--color-field);
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.95rem, 0.12vw + 0.93rem, 1.02rem);
    line-height: 1.62;
  }

  .work-intro,
  .work-section,
  .work-footer {
    position: relative;
    width: min(100%, 88rem);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 4.5rem);
  }

  .doodles {
    position: absolute;
    z-index: 0;
    inset: 0;
    background-repeat: no-repeat;
    filter: grayscale(1);
    opacity: 0.07;
    pointer-events: none;
  }

  .doodles--intro {
    background-image: url('../../assets/art/doodles/Doodles_camera.png'), url('../../assets/art/doodles/Doodles_scribble.png');
    background-position: 6% 33%, 90% 35%;
    background-size: 7rem, 11rem;
  }

  .doodles--games {
    background-image: url('../../assets/art/doodles/Doodles_campfire.png'), url('../../assets/art/doodles/Doodles_robot.png'), url('../../assets/art/doodles/Doodles_dead_fish.png');
    background-position: 94% 7%, 3% 60%, 88% 96%;
    background-size: 8rem, 7rem, 9rem;
  }

  .work-intro > *,
  .work-section > * {
    position: relative;
    z-index: 1;
  }

  .work-intro {
    display: grid;
    min-height: 62svh;
    align-content: center;
    padding-top: 6.5rem;
    padding-bottom: 4rem;
  }

  .section-label,
  .project-label {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-reading);
    font-size: 0.78rem;
    letter-spacing: 0.035em;
  }

  .work-intro h1,
  .section-intro h2,
  .featured-project h3,
  .project h3,
  .game-feature h3,
  .experiments h3,
  .experiment h4 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .work-intro h1 {
    max-width: 14ch;
    margin-top: 0.55rem;
    font-size: clamp(2.75rem, 5vw, 5rem);
    line-height: 1;
  }

  .work-intro > p:not(.section-label) {
    max-width: 45rem;
    margin: 1.2rem 0 0;
    color: var(--color-copy);
    font-size: clamp(0.98rem, 0.35vw + 0.93rem, 1.14rem);
  }

  .work-intro__links,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.4rem;
    align-items: center;
    margin-top: 2rem;
    font-size: 0.82rem;
    font-family: var(--font-reading);
  }

  .work-intro__links a,
  .project-links a,
  .game-feature__copy > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-underline-offset: 0.35rem;
  }

  .game-feature__copy > a {
    margin-top: 1.1rem;
  }

  .work-section {
    padding-top: clamp(4rem, 6.5vw, 5.8rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) minmax(0, 1fr);
    gap: 2rem;
    margin-bottom: clamp(2.75rem, 5vw, 4.5rem);
  }

  .section-intro h2 {
    max-width: 15ch;
    font-size: clamp(2.3rem, 3.8vw, 3.9rem);
    line-height: 1.02;
  }

  .featured-project {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(3rem, 5.5vw, 4.75rem);
  }

  .featured-project__media {
    display: block;
    min-width: 0;
  }

  .featured-project h3 {
    max-width: 14ch;
    margin-top: 0.8rem;
    font-size: clamp(1.95rem, 2.8vw, 3rem);
    line-height: 1.05;
  }

  .featured-project__copy > p:not(.project-label),
  .project__copy > p:not(.project-label),
  .game-feature__copy > p:not(.project-label),
  .experiment > p:not(.project-label),
  .experiment--wide > div > p:not(.project-label) {
    margin: 1rem 0 0;
    color: var(--color-copy);
  }

  .capabilities,
  .learnings {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0;
    margin: 1.2rem 0 0;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-family: var(--font-reading);
    list-style: none;
  }

  .capabilities li::before,
  .learnings li::before {
    color: var(--color-accent);
    content: '·';
    margin-right: 0.35rem;
  }

  .product-pair,
  .systems-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .product-pair {
    padding: clamp(3rem, 5.5vw, 4.75rem) 0;
  }

  .systems-pair {
    padding-top: clamp(3rem, 5.5vw, 4.75rem);
  }

  .project {
    min-width: 0;
  }

  .project__copy {
    padding-top: 1.5rem;
  }

  .project h3 {
    max-width: 18ch;
    margin-top: 0.65rem;
    font-size: clamp(1.65rem, 2.1vw, 2.3rem);
    line-height: 1.08;
  }

  .games-work {
    isolation: isolate;
  }

  .section-intro--games {
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.65fr);
    align-items: end;
  }

  .section-intro--games > p {
    max-width: 34rem;
    margin: 0;
    color: var(--color-copy);
  }

  .game-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding: clamp(2.75rem, 4.5vw, 4rem) 0;
  }

  .game-feature--reverse .game-feature__media { order: 2; }
  .game-feature--reverse .game-feature__copy { order: 1; }

  .game-feature h3 {
    margin-top: 0.7rem;
    font-size: clamp(1.95rem, 2.8vw, 3rem);
    line-height: 1.05;
  }

  .experiments {
    padding-top: clamp(3rem, 5.5vw, 4.75rem);
  }

  .experiments > header {
    display: grid;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 0.7fr) minmax(15rem, 0.55fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 2.75rem;
  }

  .experiments h3 {
    font-size: clamp(1.9rem, 2.8vw, 2.9rem);
    line-height: 1.05;
  }

  .experiments > header > p:last-child {
    margin: 0;
    color: var(--color-copy);
  }

  .experiments__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .experiment {
    min-width: 0;
  }

  .experiment .project-label {
    margin-top: 1.3rem;
  }

  .experiment h4 {
    margin-top: 0.55rem;
    font-size: clamp(1.55rem, 2vw, 2.1rem);
    line-height: 1.05;
  }

  .experiment > a {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-family: var(--font-reading);
    text-underline-offset: 0.3rem;
  }

  .experiment--wide {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: 2rem;
  }

  .experiment--wide .project-label {
    margin-top: 0;
  }

  .work-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 1.5rem 2.5rem;
    align-items: baseline;
    padding-top: 3rem;
    padding-bottom: 4rem;
    font-size: 0.82rem;
    font-family: var(--font-reading);
  }

  .work-footer p { margin: 0; color: var(--color-muted); }
  .work-footer a { text-underline-offset: 0.3rem; }

  @media (max-width: 52rem) {
    .section-intro,
    .section-intro--games,
    .featured-project,
    .game-feature,
    .experiments > header {
      grid-template-columns: 1fr;
    }

    .featured-project,
    .game-feature {
      align-items: start;
    }

    .game-feature--reverse .game-feature__media,
    .game-feature--reverse .game-feature__copy {
      order: initial;
    }

    .product-pair,
    .systems-pair {
      grid-template-columns: 1fr;
    }

    .product-pair,
    .systems-pair {
      gap: 4.5rem;
    }

    .experiment--wide {
      grid-template-columns: 1fr;
    }

    .work-footer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .work-intro {
      min-height: 68svh;
      padding-top: 5.5rem;
    }

    .work-intro h1 {
      font-size: clamp(2.45rem, 12vw, 3.7rem);
    }

    .experiments__grid {
      grid-template-columns: 1fr;
    }

    .experiment--wide {
      grid-column: auto;
    }
  }
</style>
