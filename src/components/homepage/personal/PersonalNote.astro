---
import couplePortrait from '../../../assets/life/me_and_bebe.png';
import { personalNote as personalNoteCopy, type PersonalReveal } from '../../../content/homepage/values';
import { toLocale } from '../../../i18n/locales';
import WritingList from '../../blog/WritingList.astro';
import DoodleSketchbook from './DoodleSketchbook.astro';
import HoloPortrait from './HoloPortrait.astro';

const personalNote = personalNoteCopy[toLocale(Astro.currentLocale)];
const reveals: PersonalReveal[] = ['portrait', 'doodles', 'blog'];
const panelId = (reveal: PersonalReveal) => `personal-${reveal}`;
---

<section id="personal" class="personal-note" aria-labelledby="personal-title">
  <h2 id="personal-title" class="personal-note__title">{personalNote.heading}</h2>

  <personal-note-reveals class="personal-note__body">
    <div class="personal-note__columns">
      {personalNote.columns.map((column) => (
        <div class="personal-note__column">
          {column.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      ))}
    </div>

    <div class="personal-note__closing-block">
      <p class="personal-note__closing">
        {personalNote.closing.map((part) =>
          typeof part === 'string' ? (
            part
          ) : (
            <a
              class="personal-note__trigger link-mark"
              href={`#${panelId(part.reveal)}`}
              aria-controls={panelId(part.reveal)}
              data-reveal-trigger
            >
              {part.text}
            </a>
          ),
        )}
      </p>

      {reveals.map((reveal) => (
        <div id={panelId(reveal)} class={`personal-note__panel personal-note__panel--${reveal}`} data-reveal-panel>
          <div class="personal-note__panel-content">
            {reveal === 'portrait' ? (
              <figure class="personal-note__portrait">
                <HoloPortrait src={couplePortrait} alt={personalNote.portraitAlt} />
              </figure>
            ) : reveal === 'blog' ? (
              <WritingList class="personal-note__writing" />
            ) : (
              <DoodleSketchbook label={personalNote.doodlesLabel} />
            )}
          </div>
        </div>
      ))}
    </div>
  </personal-note-reveals>
</section>

<script>
  // The words of the closing sentence are doors, like the introduction's and
  // the beliefs' (AnnotatedText.astro): opening one fades the rest of the
  // page and lays its panel over what follows, so nothing moves. Without this
  // script every panel stays visible and each word is a plain link to it.
  const OPEN_EVENT = 'annotation-open';

  class PersonalNoteReveals extends HTMLElement {
    private abort?: AbortController;
    private active?: HTMLAnchorElement;

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const { signal } = this.abort;
      const triggers = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-reveal-trigger]'));

      triggers.forEach((trigger) => {
        trigger.setAttribute('role', 'button');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          this.toggle(trigger);
        }, { signal });
        trigger.addEventListener('keydown', (event) => {
          if (event.key !== ' ') return;
          event.preventDefault();
          this.toggle(trigger);
        }, { signal });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !this.active) return;
        const trigger = this.active;
        this.close();
        trigger.focus();
      }, { signal });
      document.addEventListener('pointerdown', (event) => {
        if (!this.active) return;
        const target = event.target as Node;
        if (this.active.contains(target) || this.panelFor(this.active)?.contains(target)) return;
        this.close();
      }, { signal });
      document.addEventListener(OPEN_EVENT, (event) => {
        if ((event as CustomEvent).detail !== this && this.active) this.close();
      }, { signal });

      this.setAttribute('data-enhanced', '');
    }

    disconnectedCallback() {
      this.abort?.abort();
      if (this.active) this.close();
    }

    private panelFor(trigger: HTMLAnchorElement) {
      return document.getElementById(trigger.getAttribute('aria-controls') ?? '');
    }

    private toggle(trigger: HTMLAnchorElement) {
      if (this.active === trigger) {
        this.close();
        return;
      }
      if (this.active) this.reset(this.active);
      this.active = trigger;
      trigger.setAttribute('aria-expanded', 'true');
      this.panelFor(trigger)?.setAttribute('data-open', '');
      this.setAttribute('data-active', '');
      this.closest('#main-content > *')?.setAttribute('data-annotating-host', '');
      document.documentElement.setAttribute('data-annotating', '');
      document.dispatchEvent(new CustomEvent(OPEN_EVENT, { detail: this }));
    }

    private close() {
      if (this.active) this.reset(this.active);
      this.active = undefined;
      this.removeAttribute('data-active');
      this.closest('#main-content > *')?.removeAttribute('data-annotating-host');
      if (!document.querySelector('annotated-text[data-active], personal-note-reveals[data-active]')) {
        document.documentElement.removeAttribute('data-annotating');
      }
    }

    private reset(trigger: HTMLAnchorElement) {
      trigger.setAttribute('aria-expanded', 'false');
      this.panelFor(trigger)?.removeAttribute('data-open');
    }
  }

  if (!customElements.get('personal-note-reveals')) {
    customElements.define('personal-note-reveals', PersonalNoteReveals);
  }
</script>

<style>
  .personal-note {
    display: block;
    width: 100%;
    /* Matches the pause between the other homepage sections. */
    padding: 0 0 clamp(7rem, 12.5vw, 12rem);
  }

  .personal-note__title,
  .personal-note__body {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--page-frame));
    margin-inline: auto;
  }

  .personal-note__title {
    margin-top: 0;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  .personal-note__body {
    display: block;
    --about-gap: clamp(2.5rem, 5vw, 7rem);
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.98rem, 0.35vw + 0.92rem, 1.16rem);
    letter-spacing: 0.025em;
    line-height: 1.3;
  }

  .personal-note__columns {
    display: grid;
    grid-template-columns: minmax(0, 35rem);
    gap: 1.25lh;
    transition: color 220ms ease;
  }

  .personal-note__column {
    min-width: 0;
  }

  .personal-note__column p {
    margin: 0;
  }

  .personal-note__column p + p {
    margin-top: 1.25lh;
  }

  /* An aside after the story: under it on narrow screens, beside it on wide
     ones. */
  .personal-note__closing-block {
    position: relative;
    margin-top: clamp(2.5rem, 4vw, 4rem);
  }

  /* Doors, as in the introduction and the beliefs: the words that open
     something are in ink and the rest of the sentence is grey (3.7:1 against
     the grey, which itself clears 4.5:1 on the field). */
  .personal-note__closing {
    max-width: 35rem;
    margin: 0;
    color: var(--color-muted);
    transition: color 220ms ease;
  }

  .personal-note__trigger {
    color: var(--color-ink);
    font-family: var(--font-door);
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color 220ms ease;
  }

  /* The open door keeps its mark. */
  .personal-note__trigger[aria-expanded='true'] {
    animation: link-mark-draw var(--link-mark-draw) step-end forwards;
  }

  .personal-note__trigger:focus-visible {
    border-radius: 0.08em;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /* Open: the story and the rest of the sentence fade with the page. */
  .personal-note__body[data-active] .personal-note__columns,
  .personal-note__body[data-active] .personal-note__closing,
  .personal-note__body[data-active] .personal-note__trigger:not([aria-expanded='true']) {
    color: rgb(17 17 15 / 0.2);
  }

  .personal-note__panel-content {
    padding-top: 1.4rem;
  }

  /* With the script, a panel lies over the faded page under the sentence
     instead of pushing what follows down. Closed panels leave the reading
     order and focus sequence entirely, and the layout too, so a closed
     panel never stretches the page past the garden at its end. */
  .personal-note__body[data-enhanced] .personal-note__panel {
    position: absolute;
    z-index: 1;
    top: 100%;
    left: 0;
    display: none;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition:
      opacity 180ms var(--ease-out),
      transform 240ms var(--ease-out),
      visibility 0s 240ms,
      display 0s 240ms allow-discrete;
  }

  .personal-note__body[data-enhanced] .personal-note__panel[data-open] {
    display: block;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 220ms var(--ease-out),
      transform 260ms var(--ease-out),
      visibility 0s,
      display 0s allow-discrete;

    @starting-style {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  /* The blog list is text: what it lies over melts into a soft blur behind
     it, as under the introduction's notes and the header. */
  .personal-note__body[data-enhanced] .personal-note__panel--blog {
    isolation: isolate;
  }

  .personal-note__body[data-enhanced] .personal-note__panel--blog::before {
    position: absolute;
    z-index: -1;
    inset: 0 -2rem -3rem;
    content: '';
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    --feather-y: linear-gradient(to bottom, transparent, black 1.4rem, black calc(100% - 2.25rem), transparent);
    --feather-x: linear-gradient(to right, transparent, black 1.5rem, black calc(100% - 1.5rem), transparent);
    mask-image: var(--feather-y), var(--feather-x);
    mask-composite: intersect;
    -webkit-mask-image: var(--feather-y), var(--feather-x);
    -webkit-mask-composite: source-in;
    pointer-events: none;
  }

  .personal-note__portrait {
    width: min(100%, 28rem);
    margin: 0 0 0.5rem;
    filter: drop-shadow(0 0.4rem 1rem rgb(17 17 15 / 0.12));
  }

  /* Wide screens: a spread, the story on the left and the aside on the right,
     both from the same top line. The doodles spread over both columns from
     that line, around the sentence and over the faded story, and let clicks
     through to it. */
  @media (width > 75rem) {
    .personal-note__body {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 35rem));
      column-gap: var(--about-gap);
      align-items: start;
    }

    .personal-note__closing-block {
      margin-top: 0;
    }

    .personal-note__body[data-enhanced] .personal-note__panel--doodles {
      top: 0;
      left: calc(-100% - var(--about-gap));
      width: calc(200% + var(--about-gap));
      pointer-events: none;
    }

    .personal-note__body[data-enhanced] .personal-note__panel--doodles .personal-note__panel-content {
      padding-top: 0;
    }
  }

  @media (max-width: 52rem) {
    .personal-note__title,
    .personal-note__body {
      width: min(calc(100% - 2 * var(--page-gutter)), 36rem);
    }

    .personal-note__body {
      font-size: 1.0625rem;
    }

    .personal-note__closing-block {
      margin-top: 1.25lh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .personal-note__body[data-enhanced] .personal-note__panel,
    .personal-note__body[data-enhanced] .personal-note__panel[data-open] {
      transform: none;
    }
  }
</style>
