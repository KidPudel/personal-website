---
import couplePortrait from '../../../assets/life/me_and_bebe.png';
import { personalNote as personalNoteCopy, type PersonalReveal } from '../../../content/homepage/values';
import { toLocale } from '../../../i18n/locales';
import WritingList from '../../blog/WritingList.astro';
import DoodleSketchbook from './DoodleSketchbook.astro';
import HoloPortrait from './HoloPortrait.astro';

const personalNote = personalNoteCopy[toLocale(Astro.currentLocale)];
const reveals: PersonalReveal[] = ['portrait', 'doodles', 'blog'];
const panelId = (reveal: PersonalReveal) => `personal-${reveal}`;
---

<section id="personal" class="personal-note" aria-labelledby="personal-title">
  <h2 id="personal-title" class="personal-note__title">{personalNote.heading}</h2>

  <div class="personal-note__columns">
    {personalNote.columns.map((column) => (
      <div class="personal-note__column">
        {column.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    ))}
  </div>

  <personal-note-reveals class="personal-note__closing-block">
    <p class="personal-note__closing">
      {personalNote.closing.map((part) =>
        typeof part === 'string' ? (
          part
        ) : (
          <a
            class="personal-note__trigger"
            href={`#${panelId(part.reveal)}`}
            aria-controls={panelId(part.reveal)}
            data-reveal-trigger
          >
            {part.text}
          </a>
        ),
      )}
    </p>

    {reveals.map((reveal) => (
      <div id={panelId(reveal)} class={`personal-note__panel personal-note__panel--${reveal}`} data-reveal-panel>
        <div class="personal-note__panel-inner">
          <div class="personal-note__panel-content">
            {reveal === 'portrait' ? (
            <figure class="personal-note__portrait">
              <HoloPortrait src={couplePortrait} alt={personalNote.portraitAlt} />
            </figure>
          ) : reveal === 'blog' ? (
            <WritingList class="personal-note__writing" />
          ) : (
            <DoodleSketchbook label={personalNote.doodlesLabel} />
          )}
          </div>
        </div>
      </div>
    ))}
  </personal-note-reveals>
</section>

<script>
  // Without this script every panel stays visible and each word is a plain
  // link to its panel. With it, the words open one panel at a time: below the
  // sentence on narrow screens, in a stage beside it on wide ones.
  class PersonalNoteReveals extends HTMLElement {
    private abort?: AbortController;

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const { signal } = this.abort;
      const triggers = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-reveal-trigger]'));

      triggers.forEach((trigger) => {
        trigger.setAttribute('role', 'button');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          this.toggle(trigger, triggers);
        }, { signal });
        trigger.addEventListener('keydown', (event) => {
          if (event.key !== ' ') return;
          event.preventDefault();
          this.toggle(trigger, triggers);
        }, { signal });
      });

      this.setAttribute('data-enhanced', '');
    }

    disconnectedCallback() {
      this.abort?.abort();
    }

    private toggle(active: HTMLAnchorElement, triggers: HTMLAnchorElement[]) {
      const opening = active.getAttribute('aria-expanded') !== 'true';

      triggers.forEach((trigger) => {
        const open = trigger === active && opening;
        trigger.setAttribute('aria-expanded', String(open));
        const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
        panel?.toggleAttribute('data-open', open);
      });
    }
  }

  if (!customElements.get('personal-note-reveals')) {
    customElements.define('personal-note-reveals', PersonalNoteReveals);
  }
</script>

<style>
  .personal-note {
    display: block;
    width: 100%;
    padding: 0 0 clamp(5.5rem, 9vw, 9rem);
  }

  .personal-note__title,
  .personal-note__columns,
  .personal-note__closing-block {
    width: min(calc(100% - 2 * var(--page-gutter)), var(--page-frame));
    margin-inline: auto;
  }

  .personal-note__title {
    margin-top: 0;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
    color: var(--color-ink);
    font-family: 'Instrument Serif', 'Oranienbaum', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  .personal-note__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 35rem));
    gap: clamp(2.5rem, 5vw, 7rem);
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.98rem, 0.35vw + 0.92rem, 1.16rem);
    letter-spacing: 0.025em;
    line-height: 1.3;
  }

  .personal-note__column {
    min-width: 0;
  }

  .personal-note__column p {
    margin: 0;
  }

  .personal-note__column p + p {
    margin-top: 1.25lh;
  }

  /* A separate aside after the story, starting under the left column. */
  .personal-note__closing-block {
    display: block;
    margin-top: clamp(2.5rem, 4vw, 4rem);
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.98rem, 0.35vw + 0.92rem, 1.16rem);
    letter-spacing: 0.025em;
    line-height: 1.3;
  }

  .personal-note__closing {
    max-width: 35rem;
    margin: 0;
  }

  .personal-note__trigger {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-style: var(--link-line-style);
    text-decoration-color: var(--link-line-color);
    text-decoration-thickness: var(--link-line-width);
    text-underline-offset: var(--link-line-offset);
    cursor: pointer;
    touch-action: manipulation;
    transition: text-decoration-color 150ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .personal-note__trigger:hover,
  .personal-note__trigger:focus-visible {
    text-decoration-color: var(--link-line-color-active);
  }

  .personal-note__trigger[aria-expanded='true'] {
    text-decoration-style: solid;
    text-decoration-color: var(--link-line-color-active);
  }

  .personal-note__trigger:focus-visible {
    border-radius: 0.08em;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .personal-note__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 240ms var(--ease-out),
      opacity 180ms var(--ease-out),
      transform 240ms var(--ease-out),
      visibility 240ms;
  }

  .personal-note__panel-inner {
    min-height: 0;
  }

  .personal-note__panel-content {
    padding-top: 1.4rem;
  }

  /* Closed panels leave the reading order and focus sequence entirely. */
  .personal-note__closing-block[data-enhanced] .personal-note__panel:not([data-open]) {
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
  }

  .personal-note__closing-block[data-enhanced] .personal-note__panel:not([data-open]) .personal-note__panel-inner {
    overflow: hidden;
  }

  .personal-note__portrait {
    width: min(100%, 28rem);
    margin: 0 0 0.5rem;
    filter: drop-shadow(0 0.4rem 1rem rgb(17 17 15 / 0.12));
  }

  /* Wide screens: the sentence keeps the left column and the panels share one
     stage cell in the right column. The stage always reserves the tallest
     panel, so switching or closing never moves the contact block below. */
  @media (width > 52rem) {
    .personal-note__closing-block[data-enhanced] {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 35rem));
      column-gap: clamp(2.5rem, 5vw, 7rem);
      align-items: start;
    }

    .personal-note__closing-block[data-enhanced] .personal-note__closing {
      grid-area: 1 / 1;
    }

    .personal-note__closing-block[data-enhanced] .personal-note__panel {
      grid-area: 1 / 2;
    }

    .personal-note__closing-block[data-enhanced] .personal-note__panel-content {
      padding-top: 0;
    }

    .personal-note__closing-block[data-enhanced] .personal-note__panel:not([data-open]) {
      grid-template-rows: 1fr;
      transform: translateY(0.5rem);
    }

    .personal-note__closing-block[data-enhanced] .personal-note__panel:not([data-open]) .personal-note__panel-inner {
      overflow: visible;
    }

    /* The doodles spread over both columns and the space below, around the
       sentence, and let clicks through to it. */
    .personal-note__closing-block[data-enhanced] .personal-note__panel--doodles {
      grid-column: 1 / -1;
      margin-bottom: calc(-1 * clamp(2rem, 4vw, 4rem));
      pointer-events: none;
    }
  }

  @media (max-width: 52rem) {
    .personal-note__title,
    .personal-note__columns,
    .personal-note__closing-block {
      width: min(calc(100% - 2 * var(--page-gutter)), 36rem);
    }

    .personal-note__closing-block {
      margin-top: 1.25lh;
      font-size: 1.0625rem;
    }

    .personal-note__columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25lh;
      font-size: 1.0625rem;
      line-height: 1.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .personal-note__panel {
      transition:
        opacity 160ms ease,
        visibility 160ms;
    }

    .personal-note__closing-block[data-enhanced] .personal-note__panel:not([data-open]) {
      transform: none;
    }
  }
</style>
