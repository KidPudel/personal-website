---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import couplePortrait from '../../../assets/life/me_and_bebe.png';
import { sitePath } from '../../../config/site';
import { personalNote } from '../../../content/homepage/values';

const doodleModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/art/doodles/Doodles_*.png',
  { eager: true },
);
const doodles = Object.entries(doodleModules)
  .sort(([firstPath], [secondPath]) => firstPath.localeCompare(secondPath))
  .map(([, module]) => module.default);
---

<section id="personal" class="personal-note" aria-labelledby="personal-title">
  <h2 id="personal-title" class="personal-note__title">{personalNote.heading}</h2>

  <div class="personal-note__columns">
    {personalNote.columns.map((column) => (
      <div class="personal-note__column">
        {column.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    ))}
  </div>

  <ul class="personal-note__facts">
    {personalNote.items.map((item) => (
      <li>
        {'href' in item ? (
          <a href={sitePath(item.href)}>{item.label}</a>
        ) : (
          <details class="personal-note__fact">
            <summary>
              <span>{item.label}</span>
              <span class="personal-note__indicator" aria-hidden="true"></span>
            </summary>

            <div class="personal-note__reveal">
              {item.action === 'portrait' ? (
                <figure class="personal-note__portrait">
                  <Image
                    src={couplePortrait}
                    alt="Igor and his girlfriend outdoors"
                    widths={[320, 480, 640]}
                    sizes="(max-width: 52rem) calc(100vw - 2.5rem), 28rem"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                  />
                </figure>
              ) : (
                <div class="personal-note__doodles" aria-label="A selection of Igor’s doodles">
                  {doodles.map((doodle) => (
                    <img
                      src={doodle.src}
                      width={doodle.width}
                      height={doodle.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </div>
              )}
            </div>
          </details>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .personal-note {
    display: block;
    width: 100%;
    padding: 0 0 clamp(8rem, 13vw, 12rem);
    interpolate-size: allow-keywords;
  }

  .personal-note__title,
  .personal-note__columns,
  .personal-note__facts {
    width: min(calc(100% - 2 * var(--page-gutter)), 130rem);
    margin-inline: auto;
  }

  .personal-note__title {
    margin-top: 0;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
    color: var(--color-ink);
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
  }

  .personal-note__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 35rem));
    gap: clamp(2.5rem, 5vw, 7rem);
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.98rem, 0.35vw + 0.92rem, 1.16rem);
    letter-spacing: 0.025em;
    line-height: 1.3;
  }

  .personal-note__column {
    min-width: 0;
  }

  .personal-note__column p {
    margin: 0;
  }

  .personal-note__column p + p {
    margin-top: 1.25lh;
  }

  .personal-note__facts {
    display: grid;
    gap: 0.7rem;
    padding-left: 1.15rem;
    margin-block: clamp(2.75rem, 4vw, 4rem) 0;
    color: var(--color-copy);
    font-size: clamp(1rem, 0.25vw + 0.95rem, 1.1rem);
  }

  .personal-note__facts li {
    padding-left: 0.2rem;
  }

  .personal-note__facts a,
  .personal-note__fact summary {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-color: color-mix(in srgb, var(--color-muted) 68%, transparent);
    text-decoration-thickness: 0.08rem;
    text-underline-offset: 0.24rem;
  }

  .personal-note__fact {
    max-width: min(100%, 40rem);
  }

  .personal-note__fact summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.55rem;
    margin-block: -0.55rem;
    cursor: pointer;
    list-style: none;
    touch-action: manipulation;
  }

  .personal-note__fact summary::-webkit-details-marker {
    display: none;
  }

  .personal-note__indicator {
    position: relative;
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    flex: none;
    transition: transform 200ms var(--ease-in-out);
  }

  .personal-note__indicator::before,
  .personal-note__indicator::after {
    position: absolute;
    top: calc(50% - 0.04rem);
    left: 0;
    width: 100%;
    height: 0.08rem;
    background: currentColor;
    content: '';
  }

  .personal-note__indicator::after {
    transform: rotate(90deg);
  }

  .personal-note__fact[open] .personal-note__indicator {
    transform: rotate(45deg);
  }

  .personal-note__fact::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size 200ms var(--ease-out),
      opacity 160ms var(--ease-out),
      content-visibility 200ms allow-discrete;
  }

  .personal-note__fact[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  .personal-note__reveal {
    transform: translateY(-0.35rem);
    transform-origin: top left;
    transition: transform 200ms var(--ease-out);
  }

  .personal-note__fact[open] .personal-note__reveal {
    transform: translateY(0);
  }

  .personal-note__portrait {
    width: min(100%, 28rem);
    margin: 1.15rem 0 0.5rem;
    filter: drop-shadow(0 0.4rem 1rem rgb(17 17 15 / 0.12));
  }

  .personal-note__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .personal-note__doodles {
    display: grid;
    max-width: 31rem;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.4rem, 1vw, 0.85rem);
    padding-top: 1rem;
  }

  .personal-note__doodles img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    filter: grayscale(1);
  }

  .personal-note__facts a:hover,
  .personal-note__facts a:focus-visible,
  .personal-note__fact summary:hover,
  .personal-note__fact summary:focus-visible {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  .personal-note__facts a:focus-visible,
  .personal-note__fact summary:focus-visible {
    border-radius: 0.08em;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  @media (max-width: 52rem) {
    .personal-note__title,
    .personal-note__columns,
    .personal-note__facts {
      width: min(calc(100% - 2 * var(--page-gutter)), 36rem);
    }

    .personal-note__columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25lh;
      font-size: 1.0625rem;
      line-height: 1.3;
    }

    .personal-note__doodles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .personal-note__indicator {
      transition: none;
    }

    .personal-note__fact::details-content {
      transition:
        block-size 0ms,
        opacity 160ms ease,
        content-visibility 0ms allow-discrete;
    }

    .personal-note__reveal {
      transform: none;
      transition: none;
    }
  }
</style>
