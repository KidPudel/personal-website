---
import { doodles } from '../../../content/doodles';
import { toLocale } from '../../../i18n/locales';
import DoodleArt from '../../doodles/DoodleArt.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
const locale = toLocale(Astro.currentLocale);

interface Place {
  /** Centre, in % of the page width and height. */
  x: number;
  y: number;
  /** Width in % of the page width. */
  size: number;
  tilt: number;
}

// Two hand-placed pages. `compact` is a small sketchbook page under the
// sentence on narrow screens. `wide` spreads across both columns on wide
// screens and keeps clear of the sentence in the top-left corner (roughly
// x < 48 and y < 34). Recompose freely; the order only affects overlap.
const composition: Record<string, { compact: Place; wide: Place }> = {
  bird: { compact: { x: 12, y: 24, size: 17, tilt: -6 }, wide: { x: 55, y: 38, size: 8, tilt: -6 } },
  reader: { compact: { x: 33, y: 16, size: 15, tilt: 8 }, wide: { x: 75, y: 8, size: 6.5, tilt: 8 } },
  burger: { compact: { x: 52, y: 26, size: 15, tilt: -4 }, wide: { x: 84, y: 36, size: 7, tilt: -4 } },
  camera: { compact: { x: 73, y: 16, size: 18, tilt: 5 }, wide: { x: 60, y: 10, size: 8.5, tilt: 5 } },
  campfire: { compact: { x: 90, y: 30, size: 16, tilt: -3 }, wide: { x: 94, y: 14, size: 7.5, tilt: -3 } },
  'fish-bones': { compact: { x: 11, y: 56, size: 18, tilt: 10 }, wide: { x: 23, y: 48, size: 8.5, tilt: 10 } },
  disk: { compact: { x: 32, y: 52, size: 20, tilt: -12 }, wide: { x: 6, y: 58, size: 9, tilt: -12 } },
  fish: { compact: { x: 55, y: 58, size: 20, tilt: 4 }, wide: { x: 40, y: 62, size: 9, tilt: 4 } },
  controller: { compact: { x: 76, y: 50, size: 13, tilt: -9 }, wide: { x: 69, y: 57, size: 6.5, tilt: -9 } },
  house: { compact: { x: 92, y: 62, size: 13, tilt: 6 }, wide: { x: 96, y: 60, size: 5.5, tilt: 6 } },
  robot: { compact: { x: 14, y: 86, size: 15, tilt: 7 }, wide: { x: 15, y: 87, size: 7, tilt: 7 } },
  scribble: { compact: { x: 36, y: 84, size: 17, tilt: -5 }, wide: { x: 62, y: 83, size: 8, tilt: -5 } },
  computer: { compact: { x: 56, y: 87, size: 15, tilt: 10 }, wide: { x: 45, y: 90, size: 7, tilt: 10 } },
  figure: { compact: { x: 74, y: 84, size: 12, tilt: -8 }, wide: { x: 80, y: 80, size: 6, tilt: -8 } },
  tools: { compact: { x: 91, y: 88, size: 12, tilt: 14 }, wide: { x: 93, y: 92, size: 6, tilt: 14 } },
};

const placeStyle = (prefix: string, place: Place) =>
  `--${prefix}x: ${place.x}%; --${prefix}y: ${place.y}%; --${prefix}size: ${place.size}%; --${prefix}tilt: ${place.tilt}deg`;

// Three slightly different wobbles make the boil; the strong set is for the
// doodle under the pointer.
const boilFrames = [3, 11, 23];
---

<div class="doodle-sketchbook">
  <svg class="doodle-sketchbook__filters" width="0" height="0" aria-hidden="true" focusable="false">
    {boilFrames.map((seed, index) => (
      <>
        <filter id={`doodle-boil-${index}`}>
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed={seed} />
          <feDisplacementMap in="SourceGraphic" scale="2.2" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id={`doodle-boil-strong-${index}`}>
          <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed={seed + 40} />
          <feDisplacementMap in="SourceGraphic" scale="5" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </>
    ))}
  </svg>

  <ul class="doodle-sketchbook__page" aria-label={label}>
    {doodles.map((doodle, index) => {
      const place = composition[doodle.id];
      return (
        <li
          class="doodle-sketchbook__doodle"
          style={`${placeStyle('c-', place.compact)}; ${placeStyle('w-', place.wide)}; --order: ${index}`}
        >
          <DoodleArt doodle={doodle} />
          <span class="sr-only">{doodle.name[locale]}</span>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .doodle-sketchbook {
    /* Where the doodles fly from and back to: roughly the word "sketcher". */
    --origin-x: 30%;
    --origin-y: -12%;
  }

  .doodle-sketchbook__filters {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .doodle-sketchbook__page {
    position: relative;
    aspect-ratio: 5 / 3.6;
    padding: 0;
    margin: 0;
    list-style: none;
    animation: doodle-boil 375ms steps(1, end) infinite;
  }

  .doodle-sketchbook__doodle {
    --x: var(--c-x);
    --y: var(--c-y);
    --size: var(--c-size);
    --tilt: var(--c-tilt);

    position: absolute;
    top: var(--y);
    left: var(--x);
    width: var(--size);
    rotate: var(--tilt);
    translate: -50% -50%;
    transition:
      top 700ms var(--ease-out) calc(var(--order) * 28ms),
      left 700ms var(--ease-out) calc(var(--order) * 28ms),
      rotate 700ms var(--ease-out) calc(var(--order) * 28ms),
      scale 200ms var(--ease-out);
  }

  /* While its panel is closed, every doodle waits tucked into the word, so
     opening tosses them out to their places and closing gathers them back. */
  :global([data-enhanced] [data-reveal-panel]:not([data-open])) .doodle-sketchbook__doodle {
    top: var(--origin-y);
    left: var(--origin-x);
    rotate: calc(var(--tilt) - 40deg);
    scale: 0.3;
    transition-delay: 0ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .doodle-sketchbook__doodle:hover {
      z-index: 1;
      scale: 1.08;
      animation: doodle-boil-strong 250ms steps(1, end) infinite;
    }
  }

  /* Line boil: the whole page swaps between three wobbles, like redrawn frames. */
  @keyframes doodle-boil {
    0% { filter: url(#doodle-boil-0); }
    33.333% { filter: url(#doodle-boil-1); }
    66.666% { filter: url(#doodle-boil-2); }
    100% { filter: url(#doodle-boil-0); }
  }

  @keyframes doodle-boil-strong {
    0% { filter: url(#doodle-boil-strong-0); }
    33.333% { filter: url(#doodle-boil-strong-1); }
    66.666% { filter: url(#doodle-boil-strong-2); }
    100% { filter: url(#doodle-boil-strong-0); }
  }

  /* Wide screens: the page spans both columns and runs into the space below,
     around the sentence (see PersonalNote.astro). */
  @media (width > 52rem) {
    .doodle-sketchbook {
      --origin-x: 22%;
      --origin-y: 10%;
    }

    .doodle-sketchbook__page {
      height: 27rem;
      aspect-ratio: auto;
      pointer-events: none;
    }

    .doodle-sketchbook__doodle {
      --x: var(--w-x);
      --y: var(--w-y);
      --size: var(--w-size);
      --tilt: var(--w-tilt);

      width: max(var(--size), 3.5rem);
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .doodle-sketchbook__page,
    .doodle-sketchbook__doodle:hover {
      animation: none;
    }

    .doodle-sketchbook__doodle,
    :global([data-enhanced] [data-reveal-panel]:not([data-open])) .doodle-sketchbook__doodle {
      top: var(--y);
      left: var(--x);
      rotate: var(--tilt);
      scale: 1;
      transition: none;
    }
  }
</style>
