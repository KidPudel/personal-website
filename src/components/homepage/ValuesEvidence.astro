---
import type { CollectionEntry } from 'astro:content';

import { sitePath } from '../../config/site';
import chineseBee1 from '../../assets/evidence/cb1.png';
import chineseBee2 from '../../assets/evidence/cb2.png';
import chineseBee3 from '../../assets/evidence/cb3.png';
import campfire1 from '../../assets/evidence/campfire1.png';
import observatory1 from '../../assets/evidence/observatory1.png';
import observatory2 from '../../assets/evidence/observatory2.png';
import observatory3 from '../../assets/evidence/observatory3.png';
import pizzaSushiWok1 from '../../assets/evidence/pzw1.png';
import pizzaSushiWok2 from '../../assets/evidence/pzw2.png';
import pizzaSushiWok3 from '../../assets/evidence/pzw3.png';
import santaFoundation1 from '../../assets/evidence/secret_santa_foundation1.png';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
}

const { observatory, foodProduct, chineseBee } = Astro.props;
const projectTitles = {
  Observatory: observatory.data.title,
  PizzaSushiWok: foodProduct.data.title,
  'Chinese Bee': chineseBee.data.title,
  'Discourses by Campfire': 'Discourses by Campfire',
  'Santa Foundation': 'Santa Foundation',
};

const values = [
  {
    number: '01',
    before: 'Fulfil a real wish for ',
    words: ['experience', 'behaviour', 'capability'],
    after: '.',
    copy: 'Start with what someone is actually trying to accomplish, then carry that need through the product.',
    aspects: [
      {
        project: 'Observatory',
        title: 'Run controlled tests, not only watch live activity.',
        copy: 'A person can test one to four applications, add a warm-up, repeat rounds, and keep the results for later inspection and comparison.',
        shot: 'Observatory testing view screenshot',
        image: observatory1,
        caseStudy: true,
      },
      {
        project: 'PizzaSushiWok',
        title: 'Carry one order from browsing to delivery.',
        copy: 'Menu navigation, basket, checkout, payment, addresses, courier status, promotions, loyalty, and bonuses belong to one complete ordering journey.',
        shot: 'Ordering journey screenshot',
        image: pizzaSushiWok1,
      },
      {
        project: 'Chinese Bee',
        title: 'Turn a learning need into a repeatable practice loop.',
        copy: 'Multilingual search leads into saved vocabulary, quizzes, guidance, handwriting practice, and recognition feedback instead of ending at a definition.',
        shot: 'Search-to-practice flow screenshot',
        image: chineseBee1,
      },
      {
        project: 'Discourses by Campfire',
        title: 'Build one survival experience from connected systems.',
        copy: 'The winter forest, shifting day and night, survival pressure, dialogue, sound, music, effects, and interacting systems work together as one suspenseful experience.',
        shot: 'Discourses by Campfire gameplay screenshot',
        image: campfire1,
      },
      {
        project: 'Santa Foundation',
        title: 'Keep a small game focused on its playable idea.',
        copy: 'A compact browser game turns delivering presents, avoiding the Grinch’s attacks, original pixel art, and player-led balancing changes into one complete game-jam experience.',
        shot: 'Santa Foundation gameplay screenshot',
        image: santaFoundation1,
      },
    ],
  },
  {
    number: '02',
    before: 'Create an ',
    words: ['impactful', 'empowering'],
    after: ' interaction experience.',
    copy: 'Give people useful control, confidence, ease, or delight through the way the product behaves.',
    aspects: [
      {
        project: 'Observatory',
        title: 'Keep evidence local, reopenable, and comparable.',
        copy: 'Recorded tests stay on the Mac and remain available for later comparison, giving people useful evidence rather than a disappearing live snapshot.',
        shot: 'Saved test comparison screenshot',
        image: observatory2,
      },
      {
        project: 'PizzaSushiWok',
        title: 'Make complex order states manageable.',
        copy: 'Payments and 3DS, maps and addresses, courier progress, promotions, loyalty, bonuses, and themes work as understandable parts of one product.',
        shot: 'Checkout and delivery-state screenshot',
        image: pizzaSushiWok2,
      },
      {
        project: 'Chinese Bee',
        title: 'Respond to the learner’s own handwriting.',
        copy: 'Freehand character input receives an accuracy result, turning practice from passive review into feedback on something the learner actually made.',
        shot: 'Handwriting feedback screenshot',
        image: chineseBee2,
      },
    ],
  },
  {
    number: '03',
    before: 'Be ',
    words: ['clear', 'honest'],
    after: ' with users or players.',
    copy: 'Expose the right structure and state so the product can be understood without fighting it.',
    aspects: [
      {
        project: 'Observatory',
        title: 'Group processes into the applications people recognize.',
        copy: 'Related processes become whole-application totals, replacing Activity Monitor’s process-first view with a structure that reads clearly at a glance.',
        shot: 'Application totals screenshot',
        image: observatory3,
      },
      {
        project: 'PizzaSushiWok',
        title: 'Keep a large menu navigable across devices.',
        copy: 'Custom category and menu-scrolling behavior, adaptive layouts, and repeated usability fixes help people keep their place while ordering.',
        shot: 'Menu navigation screenshot',
        image: pizzaSushiWok3,
      },
      {
        project: 'Chinese Bee',
        title: 'Make several surfaces feel like one capability.',
        copy: 'Chat, saved learning state, practice eligibility, freehand input, and scoring are connected as one understandable workflow rather than separate tools.',
        shot: 'Connected chat and practice screenshot',
        image: chineseBee3,
      },
    ],
  },
] as const;
---

<value-story>
<section id="values" class="values-story" aria-labelledby="values-title" data-values-story>
  <div class="value-composition" data-value-composition>
    <div class="value-voice" data-value-voice>
      <div class="value-voice__stack">
        <div class="value-voice__layer value-voice__layer--intro" data-voice-layer>
          <h2 id="values-title">Three things important to me.</h2>
        </div>

        {values.map((value) => (
          <div class="value-voice__layer" data-voice-layer>
            <h3 id={`value-${value.number}`}>
              {value.before}<button
                type="button"
                class="word-cycle"
                data-word-cycle
                aria-label={`${value.words[0]}. Change this word.`}
                disabled
              >
                {value.words.map((word, wordIndex) => (
                  <span data-word-option hidden={wordIndex !== 0}>{word}</span>
                ))}
              </button>{value.after}
            </h3>
            <p>{value.copy}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="value-chapters" data-value-chapters>
      {values.map((value) => (
        <section
          class="value-chapter"
          aria-labelledby={`value-${value.number}`}
          data-value-passage
        >
          <ol class="aspects" aria-label={`Evidence for ${value.words[0]}`}>
            {value.aspects.map((aspect) => (
              <li class="aspect" data-aspect>
                <div
                  class:list={[
                    'aspect__visual',
                    aspect.image.height > aspect.image.width && 'aspect__visual--portrait',
                    aspect.image.height <= aspect.image.width && aspect.image.width / aspect.image.height < 1.35 && 'aspect__visual--compact',
                  ]}
                >
                  <img
                    src={aspect.image.src}
                    width={aspect.image.width}
                    height={aspect.image.height}
                    alt={`${aspect.shot} from ${projectTitles[aspect.project]}`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="aspect__copy">
                  <p class="aspect__project">{aspect.project}</p>
                  <h4>{aspect.title}</h4>
                  <p>{aspect.copy}</p>
                  {'caseStudy' in aspect && aspect.caseStudy && (
                    <a href={sitePath('/case-studies/observatory/')}>
                      See this in the case study <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>

  <div class="more-work">
    <p>That’s the short version.</p>
    <a href={sitePath('/work/')}>See more work <span aria-hidden="true">→</span></a>
  </div>

  <div class="personal-note">
    <div>
      <p class="eyebrow">A few things about me</p>
      <h2>More than one discipline, still one person.</h2>
    </div>
    <ul>
      <li>Product designer</li>
      <li>Experienced software engineer</li>
      <li>Hobby game designer</li>
      <li>Editorial and illustrative sketcher</li>
      <li>Proud boyfriend to a beautiful girlfriend</li>
    </ul>
  </div>

</section>
</value-story>

<script>
  class ValueStory extends HTMLElement {
    private abort?: AbortController;
    private frame = 0;
    private observer?: IntersectionObserver;

    connectedCallback() {
      if (this.dataset.enhanced) return;
      this.dataset.enhanced = 'true';
      this.abort = new AbortController();

      const voice = this.querySelector<HTMLElement>('[data-value-voice]');
      const layers = Array.from(this.querySelectorAll<HTMLElement>('[data-voice-layer]'));
      const passages = Array.from(this.querySelectorAll<HTMLElement>('[data-value-passage]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!voice || layers.length !== passages.length + 1 || !passages.length) return;
      voice.dataset.enhanced = 'true';

      this.querySelectorAll<HTMLButtonElement>('[data-word-cycle]').forEach((button) => {
        const options = Array.from(button.querySelectorAll<HTMLElement>('[data-word-option]'));
        let activeIndex = 0;

        const update = () => {
          options.forEach((option, index) => {
            const active = index === activeIndex;
            option.hidden = !active;
            option.setAttribute('aria-hidden', String(!active));
          });

          const word = options[activeIndex]?.textContent?.trim() ?? '';
          button.setAttribute('aria-label', `${word}. Change this word.`);
        };

        button.disabled = false;
        button.addEventListener('click', () => {
          activeIndex = (activeIndex + 1) % options.length;
          update();
        });
        update();
      });

      if ('IntersectionObserver' in window) {
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).dataset.revealed = 'true';
              this.observer?.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -14% 0px', threshold: 0.16 });

        this.querySelectorAll<HTMLElement>('[data-aspect]').forEach((aspect) => this.observer?.observe(aspect));
      }

      const clamp = (value: number) => Math.min(1, Math.max(0, value));
      const smooth = (value: number) => value * value * (3 - 2 * value);

      const setLayer = (
        layer: HTMLElement,
        opacity: number,
        clipTop: number,
        clipRight: number,
        shift: number,
        blur: number,
      ) => {
        layer.style.setProperty('--voice-opacity', opacity.toFixed(4));
        layer.style.setProperty('--voice-clip-top', `${clipTop.toFixed(2)}%`);
        layer.style.setProperty('--voice-clip-right', `${clipRight.toFixed(2)}%`);
        layer.style.setProperty('--voice-shift', `${shift.toFixed(3)}rem`);
        layer.style.setProperty('--voice-blur', `${blur.toFixed(3)}px`);
      };

      const showOnly = (activeIndex: number) => {
        layers.forEach((layer, index) => {
          const active = index === activeIndex;
          setLayer(layer, active ? 1 : 0, active ? 0 : 100, active ? 0 : 100, 0, 0);
          layer.querySelectorAll<HTMLButtonElement>('[data-word-cycle]').forEach((button) => {
            button.tabIndex = active ? 0 : -1;
          });
        });
      };

      const transitionProgress = (passage: HTMLElement, index: number) => {
        const top = passage.getBoundingClientRect().top;
        const start = window.innerHeight * (index === 0 ? 0.3 : 0.66);
        const distance = window.innerHeight * (index === 0 ? 0.42 : 0.46);
        return clamp((start - top) / Math.max(1, distance));
      };

      const render = () => {
        this.frame = 0;

        if (reducedMotion.matches) {
          let active = 0;
          passages.forEach((passage, index) => {
            if (passage.getBoundingClientRect().top < window.innerHeight * 0.52) active = index + 1;
          });
          showOnly(active);
          return;
        }

        const transitions = passages.map(transitionProgress);
        const activeTransition = transitions.findIndex((progress) => progress > 0 && progress < 1);

        if (activeTransition === -1) {
          let active = 0;
          transitions.forEach((progress, index) => {
            if (progress >= 1) active = index + 1;
          });
          showOnly(active);
          return;
        }

        const progress = smooth(transitions[activeTransition]);
        const outgoingIndex = activeTransition;
        const incomingIndex = activeTransition + 1;
        const erase = smooth(clamp(progress / 0.72));
        const reveal = smooth(clamp((progress - 0.18) / 0.82));

        layers.forEach((layer, index) => {
          if (index === outgoingIndex) {
            setLayer(layer, 1 - erase, erase * 100, 0, -0.4 * erase, 1.8 * erase);
          } else if (index === incomingIndex) {
            setLayer(layer, reveal, 0, (1 - reveal) * 100, 0.45 * (1 - reveal), 1.4 * (1 - reveal));
          } else {
            setLayer(layer, 0, 100, 100, 0, 0);
          }

          const interactive = index === (progress < 0.5 ? outgoingIndex : incomingIndex);
          layer.querySelectorAll<HTMLButtonElement>('[data-word-cycle]').forEach((button) => {
            button.tabIndex = interactive ? 0 : -1;
          });
        });
      };

      const requestRender = () => {
        if (this.frame) return;
        this.frame = window.requestAnimationFrame(render);
      };

      window.addEventListener('scroll', requestRender, { passive: true, signal: this.abort.signal });
      window.addEventListener('resize', requestRender, { passive: true, signal: this.abort.signal });
      reducedMotion.addEventListener('change', requestRender, { signal: this.abort.signal });
      render();
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.observer?.disconnect();
      if (this.frame) window.cancelAnimationFrame(this.frame);
      delete this.dataset.enhanced;
    }
  }

  if (!customElements.get('value-story')) {
    customElements.define('value-story', ValueStory);
  }
</script>

<style>
  value-story {
    display: block;
  }

  .values-story {
    position: relative;
    isolation: isolate;
    width: min(calc(100% - clamp(5.5rem, 8vw, 7rem)), 84rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 4vw, 3.5rem) clamp(3.5rem, 6vw, 5rem);
  }

  .values-story::before,
  .values-story::after {
    position: absolute;
    z-index: -1;
    background-repeat: no-repeat;
    background-size: contain;
    content: '';
    filter: grayscale(1);
    opacity: 0.06;
    pointer-events: none;
  }

  .values-story::before {
    top: 11rem;
    left: -1rem;
    width: 8rem;
    aspect-ratio: 1;
    background-image: url('../../assets/art/doodles/Doodles_camera.png');
    rotate: -7deg;
  }

  .values-story::after {
    right: 0;
    bottom: 22rem;
    width: 9rem;
    aspect-ratio: 1;
    background-image: url('../../assets/art/doodles/Doodles_fish_1.png');
    rotate: 4deg;
  }

  .eyebrow,
  .aspect__project {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-reading);
    font-size: 0.8rem;
    letter-spacing: 0.035em;
  }

  .personal-note h2,
  .aspect h4 {
    margin: 0;
    font-family: var(--font-portfolio-display);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .aspect__copy a {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-reading);
    font-size: 0.82rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35rem;
  }

  .word-cycle {
    position: relative;
    display: inline-grid;
    padding: 0;
    border: 0;
    border-bottom: 0.08em solid currentColor;
    border-radius: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-align: center;
    cursor: pointer;
  }

  .word-cycle:disabled {
    color: inherit;
    cursor: default;
  }

  .word-cycle:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 0.2rem;
  }

  .word-cycle [data-word-option][hidden] { display: none; }

  .aspects {
    display: contents;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .aspect {
    position: relative;
    min-width: 0;
    align-self: start;
  }

  .aspect__visual {
    width: min(100%, 31rem);
    overflow: hidden;
    border: clamp(0.22rem, 0.3vw, 0.32rem) solid #11110f;
    border-radius: clamp(1.05rem, 1.6vw, 1.5rem);
    background: #ecebe7;
    box-shadow: 0.22rem 0.26rem 0 rgba(17, 17, 15, 0.12);
  }

  .aspect__visual--compact {
    width: min(88%, 25rem);
  }

  .aspect__visual--portrait {
    width: min(68%, 18rem);
  }

  .aspect__visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  .aspect__copy {
    padding-top: 1rem;
  }

  .aspect h4 {
    max-width: 22ch;
    margin-top: 0.45rem;
    font-size: clamp(1.25rem, 1.5vw, 1.65rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .aspect__copy > p:not(.aspect__project) {
    max-width: 39rem;
    margin: 0.85rem 0 0;
    color: #4e4b45;
    font-size: 0.96rem;
    line-height: 1.58;
  }

  .personal-note {
    display: grid;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    width: min(100%, 62rem);
    margin: clamp(4.5rem, 7vw, 6.5rem) auto 0;
  }

  .personal-note h2 {
    max-width: 12ch;
    margin-top: 0.5rem;
    font-size: clamp(1.8rem, 2.35vw, 2.45rem);
    line-height: 1.08;
  }

  .personal-note ul {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    margin: 0;
    font-family: var(--font-reading);
    list-style: none;
  }

  .personal-note li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: baseline;
  }

  .personal-note li::before {
    color: var(--accent);
    content: '•';
  }

  .more-work {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.8rem 1.35rem;
    margin-top: clamp(3.5rem, 6vw, 5rem);
    text-align: center;
  }

  .more-work p {
    margin: 0;
    color: var(--muted);
  }

  .more-work a {
    font-family: var(--font-portfolio-display);
    font-size: clamp(1.4rem, 1.75vw, 1.8rem);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35rem;
  }

  @media (max-width: 50rem) {
    .personal-note {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .more-work {
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<style>
  value-story {
    position: relative;
    z-index: 3;
    display: block;
  }

  .values-story {
    position: relative;
    isolation: isolate;
    width: min(calc(100% - clamp(4rem, 7vw, 6rem)), 88rem);
    margin-inline: auto;
    padding: 0 clamp(0.75rem, 2vw, 1.75rem) clamp(3.5rem, 6vw, 5rem);
  }

  .value-composition {
    position: relative;
    display: grid;
  }

  .value-voice,
  .value-chapters {
    grid-area: 1 / 1;
  }

  .value-voice {
    position: sticky;
    z-index: 4;
    top: max(14svh, 6rem);
    align-self: start;
    width: clamp(16rem, 23vw, 19rem);
    min-height: 9rem;
    margin-inline: auto;
    text-align: center;
    pointer-events: none;
  }

  .value-voice__stack {
    display: grid;
    align-items: start;
  }

  .value-voice__layer {
    min-width: 0;
    padding: 1.1rem 0.9rem 1.25rem;
    background: rgb(248 248 248 / 0.94);
    pointer-events: auto;
  }

  .value-voice__layer h2,
  .value-voice__layer h3,
  .value-voice__layer p {
    margin: 0;
  }

  .value-voice__layer--intro h2 {
    font-family: var(--font-reading);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.18;
  }

  .value-voice__layer h3 {
    font-family: var(--font-portfolio-display);
    font-size: clamp(1.55rem, 2.3vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .value-voice__layer:nth-child(2) .word-cycle { min-width: 6.2em; }
  .value-voice__layer:nth-child(3) .word-cycle { min-width: 5.4em; }
  .value-voice__layer:nth-child(4) .word-cycle { min-width: 3.1em; }

  .value-voice__layer > p {
    max-width: 27rem;
    margin: 0.9rem auto 0;
    color: #5d5952;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  :global(.js) .value-voice[data-enhanced] .value-voice__stack {
    display: grid;
  }

  :global(.js) .value-voice[data-enhanced] .value-voice__layer {
    grid-area: 1 / 1;
    clip-path: inset(var(--voice-clip-top, 100%) var(--voice-clip-right, 100%) 0 0);
    filter: blur(var(--voice-blur, 0));
    opacity: var(--voice-opacity, 0);
    transform: translateY(var(--voice-shift, 0));
    will-change: clip-path, filter, opacity, transform;
  }

  .value-chapters {
    position: relative;
    z-index: 1;
  }

  .value-chapter,
  .value-chapter:first-child {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(16rem, 23vw, 19rem) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(30rem, auto));
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    padding: 78svh 0 clamp(4rem, 8vw, 7rem);
  }

  .value-chapter:first-child {
    grid-template-rows: repeat(3, minmax(30rem, auto));
  }

  .aspects {
    display: contents;
  }

  .aspect:nth-child(1) {
    grid-column: 1;
    grid-row: 1;
  }

  .aspect:nth-child(2) {
    grid-column: 3;
    grid-row: 1;
    margin-top: clamp(12rem, 18vw, 17rem);
  }

  .aspect:nth-child(3) {
    grid-column: 1;
    grid-row: 2;
    margin-top: 2rem;
  }

  .value-chapter:nth-child(even) .aspect:nth-child(1),
  .value-chapter:nth-child(even) .aspect:nth-child(3) {
    grid-column: 3;
  }

  .value-chapter:nth-child(even) .aspect:nth-child(2) {
    grid-column: 1;
  }

  .value-chapter:first-child .aspect:nth-child(4) {
    grid-column: 3;
    grid-row: 2;
    margin-top: clamp(12rem, 18vw, 17rem);
  }

  .value-chapter:first-child .aspect:nth-child(5) {
    grid-column: 1;
    grid-row: 3;
    margin-top: 2rem;
  }

  :global(.js) value-story[data-enhanced] .aspect {
    opacity: 0.18;
    transform: translateY(2.25rem) rotate(0.35deg);
    transition:
      opacity 480ms ease,
      transform 620ms cubic-bezier(0.2, 0.8, 0.2, 1);
