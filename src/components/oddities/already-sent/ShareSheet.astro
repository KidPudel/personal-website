---
import { Image } from 'astro:assets';

import bird from '../../../assets/oddities/already-sent/avatars/bird.png';
import burger from '../../../assets/oddities/already-sent/avatars/burger.png';
import camera from '../../../assets/oddities/already-sent/avatars/camera.png';
import campfire from '../../../assets/oddities/already-sent/avatars/campfire.png';
import fish from '../../../assets/oddities/already-sent/avatars/fish.png';
import robot from '../../../assets/oddities/already-sent/avatars/robot.png';
import { toLocale, translator } from '../../../i18n/locales';

// Instagram's share sheet, as it opens over a reel: search, then the people you talk to most.
// Measured from Igor's screenshots of the real sheet (a 390-point-wide phone) and drawn in points,
// so it keeps its proportions at any width. The people are stand-ins, Igor's own doodles with
// made-up names: the real sheet is full of his friends.
//
// `fix` shows the oddity's answer: a quiet "Sent" line under everyone this reel already went to.
// The line's room is kept in both versions, so nobody moves when it appears.

interface Props {
  /** Show who already got this reel. */
  fix?: boolean;
  /** People (by position) this reel already went to. */
  sent?: number[];
  /** When it went, after "Sent", such as "2h ago". */
  sentWhen?: string;
  /** People are buttons and the message bar can rise (SendPlayground). */
  interactive?: boolean;
  loading?: 'eager' | 'lazy';
  /** A picture next to words that already say what it shows: kept out of the accessibility tree. */
  decorative?: boolean;
  class?: string;
}

const { fix = false, sent = [], sentWhen, interactive = false, loading = 'lazy', decorative = false, class: className } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));

const people = [
  { name: t('Mira', 'Мира'), avatar: bird, tone: '#f2c7a2' },
  { name: t('Tolya', 'Толя'), avatar: robot, tone: '#bfd6ee', active: t('30m', '30 мин') },
  { name: t('Sasha Orlova', 'Саша Орлова'), avatar: fish, tone: '#cfe3bd' },
  { name: t('Nika', 'Ника'), avatar: camera, tone: '#e5cbe9' },
  { name: 'campfire.club', avatar: campfire, tone: '#f1e2a6' },
  { name: t('Lev', 'Лев'), avatar: burger, tone: '#efbdb6' },
];
const sentText = sentWhen ?? t('2h ago', '2 ч назад');
const Person = interactive ? 'button' : 'div';
---

<div class:list={['share-sheet-frame', className]} aria-hidden={decorative ? 'true' : undefined}>
  <div class="share-sheet" data-share-sheet data-fix={fix ? '' : undefined}>
    <span class="share-sheet__grabber" aria-hidden="true"></span>
    <div class="share-sheet__top" aria-hidden="true">
      <span class="share-sheet__search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7" /><path d="m16 16 5.5 5.5" /></svg>
        {t('Search', 'Поиск')}
      </span>
      <span class="share-sheet__group">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.4" /><path d="M2.8 19.5c.6-3.4 3.1-5.4 6.2-5.4s5.6 2 6.2 5.4z" /><circle cx="16.6" cy="10.4" r="2.6" /><path d="M15.4 15.3c2.6-.4 4.9 1 5.6 4.2h-3.2M19 2.6v5.2M16.4 5.2h5.2" /></svg>
      </span>
    </div>
    <ul class="share-sheet__people" role="list">
      {people.map((person, index) => (
        <li>
          <Person
            class="share-sheet__person"
            data-person={index}
            data-sent={sent.includes(index) ? '' : undefined}
            {...(interactive ? { type: 'button', 'aria-pressed': 'false' } : {})}
          >
            <span class="share-sheet__avatar" style={`--tone: ${person.tone}`}>
              <Image src={person.avatar} alt="" widths={[96, 192]} sizes="74px" format="png" loading={loading} decoding="async" />
              {person.active && <span class="share-sheet__active" aria-hidden="true">{person.active}</span>}
              <span class="share-sheet__check" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m6.5 12.5 3.6 3.6 7.4-8.2" /></svg>
              </span>
            </span>
            <span class="share-sheet__name">{person.name}</span>
            {/* "Sent" and when are kept apart, so a language where they don't fit one line (Russian)
                breaks between them instead of running into the next person. */}
            <span class="share-sheet__sent" data-sent-line>
              <span class="share-sheet__sent-word"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.5 3 10.2 13.8M21.5 3l-7.1 18-4.2-7.2L3 9.7z" /></svg>{t('Sent', 'Отправлено')}</span>
              {' '}<span class="share-sheet__sent-when">{sentText}</span>
            </span>
          </Person>
        </li>
      ))}
    </ul>
    {interactive && (
      <div class="share-sheet__compose" data-compose>
        <span class="share-sheet__message" aria-hidden="true">{t('Write a message…', 'Напишите сообщение…')}</span>
        <button class="share-sheet__send" type="button" data-send tabindex="-1">{t('Send', 'Отправить')}</button>
      </div>
    )}
  </div>
</div>

<style>
  /* Everything inside is measured in the real sheet's points (--pt), from its own width. */
  .share-sheet-frame {
    container-type: inline-size;
  }

  .share-sheet {
    --pt: calc(100cqi / 390);
    --sheet: #191c1f;
    --field: #2b3036;
    --text: #f5f6f7;
    --muted: #a2a8b0;
    --blue: #4a5df6;
    position: relative;
    height: 100%;
    padding: calc(14 * var(--pt)) calc(14 * var(--pt)) 0;
    overflow: hidden;
    border-radius: calc(26 * var(--pt)) calc(26 * var(--pt)) 0 0;
    background: var(--sheet);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: calc(15 * var(--pt));
    letter-spacing: -0.01em;
    line-height: 1.3;
    -webkit-font-smoothing: antialiased;
  }

  .share-sheet__grabber {
    display: block;
    width: calc(34 * var(--pt));
    height: calc(4 * var(--pt));
    margin: 0 auto calc(16 * var(--pt));
    border-radius: 99px;
    background: #4b5057;
  }

  .share-sheet__top {
    display: flex;
    gap: calc(8 * var(--pt));
    margin-bottom: calc(22 * var(--pt));
  }

  .share-sheet__search {
    display: flex;
    flex: 1;
    align-items: center;
    gap: calc(10 * var(--pt));
    height: calc(44 * var(--pt));
    padding-inline: calc(12 * var(--pt));
    border-radius: 99px;
    background: var(--field);
    color: var(--muted);
    font-size: calc(18 * var(--pt));
  }

  .share-sheet__group {
    display: grid;
    flex: none;
    place-items: center;
    width: calc(44 * var(--pt));
    height: calc(44 * var(--pt));
    border-radius: 50%;
    background: var(--field);
  }

  .share-sheet svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .share-sheet__search svg {
    width: calc(19 * var(--pt));
    height: calc(19 * var(--pt));
  }

  .share-sheet__group svg {
    width: calc(22 * var(--pt));
    height: calc(22 * var(--pt));
    color: var(--text);
    stroke-width: 1.8;
  }

  .share-sheet__people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: calc(8 * var(--pt));
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .share-sheet__person {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    /* Room in every cell for a name and a sent line of two lines each, so rows never shift. */
    min-height: calc(146 * var(--pt));
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: center;
    -webkit-tap-highlight-color: transparent;
  }

  button.share-sheet__person {
    cursor: pointer;
  }

  button.share-sheet__person:focus-visible {
    border-radius: calc(12 * var(--pt));
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .share-sheet__avatar {
    position: relative;
    display: block;
    width: calc(74 * var(--pt));
    height: calc(74 * var(--pt));
    margin-bottom: calc(9 * var(--pt));
    border-radius: 50%;
    background: var(--tone);
    transition: transform 160ms var(--ease-out);
  }

  button.share-sheet__person:active .share-sheet__avatar {
    transform: scale(0.95);
  }

  .share-sheet__avatar :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  /* Seen recently: the green time in the avatar's corner, as in the real sheet. */
  .share-sheet__active {
    position: absolute;
    right: calc(-12 * var(--pt));
    bottom: calc(2 * var(--pt));
    padding: calc(1 * var(--pt)) calc(6 * var(--pt));
    border: calc(3 * var(--pt)) solid var(--sheet);
    border-radius: 99px;
    background: #183f1d;
    color: #5fd068;
    font-size: calc(12 * var(--pt));
    font-weight: 600;
    line-height: 1.25;
  }

  /* Picked to send now: Instagram's blue check. */
  .share-sheet__check {
    position: absolute;
    right: calc(-5 * var(--pt));
    bottom: calc(-3 * var(--pt));
    display: grid;
    width: calc(27 * var(--pt));
    height: calc(27 * var(--pt));
    place-items: center;
    border: calc(3 * var(--pt)) solid var(--sheet);
    border-radius: 50%;
    background: var(--blue);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 140ms var(--ease-out), transform 220ms var(--ease-out);
  }

  .share-sheet__check svg {
    width: 70%;
    height: 70%;
    color: #fff;
    stroke-width: 3;
  }

  [aria-pressed='true'] .share-sheet__check {
    opacity: 1;
    transform: none;
  }

  .share-sheet__name {
    display: -webkit-box;
    max-width: 100%;
    overflow: hidden;
    padding-inline: calc(4 * var(--pt));
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    text-wrap: balance;
  }

  /* The fix: who already got this, in grey under the name, with Instagram's own send arrow. */
  .share-sheet__sent {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.3em;
    max-width: 100%;
    margin-top: calc(3 * var(--pt));
    color: var(--muted);
    font-size: calc(13 * var(--pt));
    letter-spacing: 0;
    line-height: 1.3;
    visibility: hidden;
    opacity: 0;
    filter: blur(3px);
    transform: translateY(calc(-4 * var(--pt)));
    transition:
      opacity 260ms var(--ease-out),
      filter 260ms var(--ease-out),
      transform 360ms var(--ease-out),
      visibility 0s linear 360ms;
  }

  .share-sheet__sent-word,
  .share-sheet__sent-when {
    white-space: nowrap;
  }

  .share-sheet__sent svg {
    display: inline-block;
    width: 0.92em;
    height: 0.92em;
    margin-right: 0.3em;
    vertical-align: -0.1em;
    stroke-width: 2.2;
  }

  [data-fix] [data-sent] .share-sheet__sent {
    visibility: visible;
    opacity: 1;
    filter: none;
    transform: none;
    transition-delay: var(--sent-delay, 0ms);
  }

  /* The message bar and Send rise once someone is picked (SendPlayground). */
  .share-sheet__compose {
    position: absolute;
    inset: auto 0 0;
    padding: 0 calc(14 * var(--pt)) calc(26 * var(--pt));
    border-top: 1px solid #2a2e33;
    background: var(--sheet);
    transform: translateY(100%);
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  [data-picking] .share-sheet__compose {
    transform: none;
  }

  .share-sheet__message {
    display: block;
    padding: calc(20 * var(--pt)) calc(4 * var(--pt));
    color: var(--muted);
    font-size: calc(16 * var(--pt));
  }

  .share-sheet__send {
    display: block;
    width: 100%;
    height: calc(46 * var(--pt));
    border: 0;
    border-radius: calc(12 * var(--pt));
    background: var(--blue);
    color: #fff;
    font: inherit;
    font-size: calc(16 * var(--pt));
    font-weight: 600;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }

  .share-sheet__send:active {
    transform: scale(0.97);
  }

  .share-sheet__send:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .share-sheet__sent {
      filter: none;
      transform: none;
    }
  }
</style>
