---
import { connectLinks } from '../../config/site';
import ColorWord from './ColorWord.astro';
import CraftValues from './CraftValues.astro';
import PlayfulWord from './PlayfulWord.astro';
import PortraitInteraction from './PortraitInteraction.astro';
---

<section
  id="who-i-am"
  class="who-disclosure"
  aria-labelledby="who-title"
  data-destination-disclosure
  hidden
>
  <article class="who-unfolding">
    <svg class="who-connections" viewBox="0 0 1200 760" preserveAspectRatio="none" aria-hidden="true" data-who-connections>
      <path class="who-connection who-connection--intro" data-connection-to="intro" data-curve="-0.08" pathLength="1" d="M600 190 C670 160 730 140 800 145" />
      <path class="who-connection who-connection--values" data-connection-to="values" data-curve="0.1" pathLength="1" d="M600 190 C620 290 630 380 650 470" />
      <path class="who-connection who-connection--portrait" data-connection-to="portrait" data-curve="-0.08" pathLength="1" d="M600 190 C535 175 485 168 430 175" />
      <path class="who-connection who-connection--secret" data-connection-to="secret" data-curve="0.12" pathLength="1" d="M600 190 C470 295 395 405 330 500" />
    </svg>

    <div class="who-piece who-introduction" style="--piece-delay: 90ms; --piece-x: -3.5rem; --piece-y: 2rem;">
      <p class="who-introduction__hello">hello, I am Igor</p>
      <h1 id="who-title" tabindex="-1" data-connection-target="intro">
        I build <PlayfulWord word="experiences" />, then the systems that make them real.
      </h1>
      <p>
        I design and build interactive products and gameplay systems. I take someone's desire, carry it
        across technical boundaries, and bring it to life as something <ColorWord word="joyful" /> to interact with.
      </p>
    </div>

    <section
      class="who-piece who-values"
      style="--piece-delay: 150ms; --piece-x: 3.75rem; --piece-y: 1.5rem;"
    >
      <div class="who-values__content" data-connection-target="values">
        <CraftValues completionId="who-contact-paper" />
      </div>
    </section>

    <div
      class="who-piece who-portrait"
      data-connection-target="portrait"
      style="--piece-delay: 210ms; --piece-x: 0rem; --piece-y: -4.5rem;"
    >
      <PortraitInteraction loading="lazy" />
    </div>

    <div
      class="who-piece who-secret-zone"
      data-connection-target="secret"
      style="--piece-delay: 260ms; --piece-x: 4rem; --piece-y: -3rem;"
    >
      <svg class="who-secret-zone__outline" viewBox="0 0 420 220" preserveAspectRatio="none" aria-hidden="true">
        <path d="M18 31 C86 13 146 26 209 18 C270 10 344 19 399 37 C409 84 392 134 405 184 C332 207 267 192 205 202 C140 211 71 199 21 180 C8 128 25 82 18 31" />
      </svg>
      <span class="who-secret-zone__question who-secret-zone__question--one" aria-hidden="true">?</span>
      <span class="who-secret-zone__question who-secret-zone__question--two" aria-hidden="true">?</span>
      <span class="who-secret-zone__question who-secret-zone__question--three" aria-hidden="true">?</span>

      <aside id="who-contact-paper" class="who-contact-paper" aria-live="polite" hidden>
        <p>I'd love to chat with you.</p>
        <div class="who-contact-paper__links" aria-label="Connect options">
          {connectLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </aside>
    </div>
  </article>
</section>

<style>
  .who-disclosure {
    position: relative;
    z-index: 2;
    display: none;
    width: 100%;
    min-width: 0;
    color: var(--color-field-ink);
    isolation: isolate;
    pointer-events: none;
    scroll-margin-block: 0;
  }

  .who-disclosure[hidden] {
    display: none;
  }

  .who-disclosure:target {
    display: block;
  }

  .who-disclosure:not([hidden]) {
    display: block;
  }

  .who-unfolding {
    position: relative;
    display: grid;
    min-height: max(48rem, calc(100vh - (2 * var(--field-gutter))));
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(8, minmax(0, 1fr));
    overflow: clip;
    isolation: isolate;
  }

  .who-connections {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .who-connection {
    fill: none;
    stroke: rgba(243, 239, 228, 0.44);
    stroke-dasharray: 0.015 0.025 0.08 0.025;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
    vector-effect: non-scaling-stroke;
  }

  .who-piece {
    position: relative;
    z-index: 2;
    min-width: 0;
    pointer-events: auto;
  }

  .who-introduction {
    display: grid;
    max-width: 34rem;
    grid-column: 8 / 13;
    grid-row: 1 / 5;
    align-self: start;
    gap: 0.8rem;
    padding-top: clamp(2.75rem, 6vh, 5rem);
    padding-right: clamp(1rem, 3vw, 3rem);
    padding-left: clamp(2.25rem, 3.5vw, 3.75rem);
  }

  .who-introduction__hello {
    width: fit-content;
    font-size: 1rem;
    transform: rotate(-1.5deg);
  }

  .who-introduction h1 {
    max-width: 14ch;
    font-family: var(--font-distinctive);
    font-size: clamp(2rem, 3vw, 3.2rem);
    font-weight: 400;
    line-height: 1.03;
  }

  .who-introduction h1:focus {
    outline: none;
  }

  .who-introduction > p:last-child {
    max-width: 48ch;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.55;
  }

  .who-values {
    grid-column: 5 / 11;
    grid-row: 5 / 9;
    align-self: start;
    padding-top: clamp(1.75rem, 4vh, 3.5rem);
    padding-left: clamp(0.5rem, 2vw, 2rem);
  }

  .who-values :global(.craft-values) {
    max-width: 31rem;
    margin: 0;
  }

  .who-values :global(.craft-values__heading) {
    margin-left: 1.4rem;
  }

  .who-values :global(.craft-values li p) {
    max-width: 29ch;
    font-size: clamp(0.98rem, 1.35vw, 1.18rem);
  }

  .who-portrait {
    width: min(100%, 21rem);
    grid-column: 2 / 6;
    grid-row: 1 / 5;
    align-self: start;
    justify-self: center;
    margin-top: clamp(1.25rem, 3vh, 2.5rem);
    rotate: -0.6deg;
  }

  .who-portrait :global(.portrait-interaction) {
    width: 100%;
    justify-self: center;
  }

  .who-secret-zone {
    display: grid;
    width: min(100%, 21rem);
    min-height: 12.5rem;
    grid-column: 1 / 5;
    grid-row: 6 / 9;
    align-self: end;
    justify-self: center;
    place-items: center;
    rotate: -0.8deg;
  }

  .who-secret-zone__outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .who-secret-zone__outline path {
    fill: rgba(243, 239, 228, 0.015);
    stroke: rgba(243, 239, 228, 0.55);
    stroke-dasharray: 7 10 3 8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
    vector-effect: non-scaling-stroke;
  }

  .who-secret-zone__question {
    position: absolute;
    z-index: 1;
    color: rgba(243, 239, 228, 0.66);
    font-family: var(--font-distinctive);
    font-size: clamp(1.55rem, 2.6vw, 2.25rem);
    line-height: 1;
  }

  .who-secret-zone__question--one {
    top: 22%;
    left: 28%;
    transform: rotate(-12deg);
  }

  .who-secret-zone__question--two {
    top: 45%;
    right: 27%;
    transform: rotate(9deg);
  }

  .who-secret-zone__question--three {
    right: 45%;
    bottom: 14%;
    transform: rotate(-4deg);
  }

  .who-secret-zone:has(.who-contact-paper:not([hidden])) .who-secret-zone__question {
    visibility: hidden;
  }

  .who-contact-paper {
    position: absolute;
    z-index: 2;
    inset: 1.8rem 1.2rem 1.2rem;
    display: grid;
    align-content: center;
    padding: 1rem 1rem 0.75rem;
    overflow: clip;
    background:
      linear-gradient(rgba(237, 225, 196, 0.72), rgba(242, 232, 207, 0.82)),
      url('../../assets/art/paper-crumpled.webp') center / cover,
      var(--color-paper);
    filter: drop-shadow(0.25rem 0.7rem 0.65rem rgba(7, 7, 6, 0.3));
    color: var(--color-ink);
    clip-path: polygon(
      1.4% 4%, 9% 1%, 20% 3.2%, 32% 0.4%, 44% 2.8%, 56% 0%, 69% 3.5%, 81% 0.8%,
      93% 3.1%, 99% 1.5%, 97.6% 16%, 100% 31%, 98% 47%, 99.6% 64%, 97.2% 82%,
      99% 97%, 90% 96.2%, 78% 99.3%, 64% 96.4%, 50% 99.5%, 36% 96%, 22% 99%,
      8% 96.5%, 1% 98%, 2.5% 82%, 0.4% 66%, 2% 49%, 0% 31%, 2.2% 15%
    );
    scroll-margin-block: 1rem;
    transform-origin: center;
  }

  .who-contact-paper::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: url('../../assets/art/paper-grain.svg') 0 0 / 180px 180px;
    content: '';
    mix-blend-mode: multiply;
    opacity: 0.18;
    pointer-events: none;
  }

  .who-contact-paper[hidden] {
    display: none;
  }

  .who-contact-paper:not([hidden]) {
    animation: contact-paper-appears 360ms steps(3, end) both;
  }

  .who-contact-paper > p {
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
  }

  .who-contact-paper__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.05rem 0.8rem;
    margin-top: 0.2rem;
  }

  @media (min-width: 64.001rem) and (max-width: 78rem) {
    .who-introduction {
      padding-left: clamp(5.5rem, 9vw, 7rem);
    }

    .who-introduction h1 {
      font-size: clamp(1.9rem, 3vw, 2.35rem);
    }

    .who-introduction > p:last-child {
      font-size: 1rem;
    }
  }

  .who-contact-paper__links a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: #864538;
    font-size: 0.9rem;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 0.24em;
  }

  :global(spatial-route-shell[data-entering]) .who-piece {
    animation: who-piece-unfolds 520ms cubic-bezier(0.18, 0.78, 0.25, 1)
      var(--piece-delay) both;
  }

  :global(spatial-route-shell[data-entering]) .who-connection {
    animation: who-line-draws 560ms steps(7, end) both;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(spatial-route-shell[data-entering]) .who-connection--values {
    animation-delay: 90ms;
  }

  :global(spatial-route-shell[data-entering]) .who-connection--portrait {
    animation-delay: 150ms;
  }

  :global(spatial-route-shell[data-entering]) .who-connection--secret {
    animation-delay: 210ms;
  }

  :global(spatial-route-shell[data-entering]) .who-values :global(.craft-values li) {
    animation: who-note-appears 260ms steps(3, end) both;
  }

  :global(spatial-route-shell[data-entering]) .who-values :global(.craft-values li:nth-child(1)) {
    animation-delay: 260ms;
  }

  :global(spatial-route-shell[data-entering]) .who-values :global(.craft-values li:nth-child(2)) {
    animation-delay: 330ms;
  }

  :global(spatial-route-shell[data-entering]) .who-values :global(.craft-values li:nth-child(3)) {
    animation-delay: 400ms;
  }

  @keyframes who-piece-unfolds {
    from {
      opacity: 0;
      transform: translate(var(--piece-x), var(--piece-y)) rotate(1.5deg) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(0) scale(1);
    }
  }

  @keyframes who-line-draws {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes who-note-appears {
    from {
      opacity: 0;
      transform: translate(0.45rem, 0.25rem) rotate(1deg);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(0);
    }
  }

  @keyframes contact-paper-appears {
    from {
      opacity: 0;
      transform: translateY(0.5rem) rotate(1.6deg) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(-0.8deg) scale(1);
    }
  }

  @media (max-width: 64rem) {
    .who-unfolding {
      display: flex;
      min-height: calc(100vh - 1.75rem);
      flex-direction: column;
      gap: 4rem;
      padding: 6.5rem 1.1rem 2.5rem;
      overflow: clip;
    }

    .who-connections {
      display: none;
    }

    .who-introduction,
    .who-values,
    .who-portrait,
    .who-secret-zone {
      width: min(100%, 42rem);
      max-width: 100%;
      align-self: center;
      padding: 0;
      margin: 0;
      rotate: 0deg;
      transform: none;
    }

    .who-introduction {
      order: 1;
    }

    .who-introduction h1 {
      font-size: clamp(2.35rem, 9vw, 3.8rem);
    }

    .who-portrait {
      width: min(100%, 21rem);
      order: 2;
    }

    .who-values {
      order: 3;
    }

    .who-values :global(.craft-values) {
      margin-inline: auto;
    }

    .who-secret-zone {
      width: min(100%, 25rem);
      min-height: 16rem;
      order: 4;
    }
  }

  @media (max-width: 36rem) {
    .who-unfolding {
      gap: 3.5rem;
      padding-inline: 0.35rem;
    }

    .who-introduction h1 {
      font-size: clamp(2.35rem, 12vw, 3.5rem);
    }

    .who-values :global(.craft-values__heading) {
      margin-left: 0.35rem;
    }

    .who-values :global(.craft-values li p) {
      max-width: 27ch;
      font-size: clamp(1rem, 5vw, 1.2rem);
    }

    .who-contact-paper {
      inset: 2.25rem 1.3rem 1.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(spatial-route-shell[data-entering]) .who-piece,
    :global(spatial-route-shell[data-entering]) .who-connection,
    :global(spatial-route-shell[data-entering]) .who-values :global(.craft-values li),
    .who-contact-paper:not([hidden]) {
      animation-duration: 0.01ms;
      animation-delay: 0ms;
    }
  }
</style>
