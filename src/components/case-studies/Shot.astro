---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Kind = 'device' | 'screen' | 'desktop' | 'wireframe' | 'sheet';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** device: a phone mockup with its own frame. screen: a bare phone screen. desktop: an app window. */
  kind?: Kind;
  sizes?: string;
  /** high: the route's single most important image. eager: visible on arrival. */
  priority?: 'high' | 'eager';
}

const { src, alt, caption, kind = 'device', sizes, priority } = Astro.props;
const phone = kind === 'device' || kind === 'screen';
const candidates = phone ? [240, 360, 480, 600] : [480, 720, 960, 1280, 1600];
const widths = [...new Set([...candidates.filter((width) => width < src.width), Math.min(src.width, candidates.at(-1)!)])];
const defaultSizes = phone
  ? '(max-width: 760px) min(calc(100vw - 80px), 248px), 248px'
  : '(max-width: 1008px) calc(100vw - 40px), 960px';
---

<figure class:list={['shot', `shot--${kind}`]}>
  <div class="shot__frame">
    <Image src={src} alt={alt} widths={widths} sizes={sizes ?? defaultSizes} format="webp" quality={85} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority === 'high' ? 'high' : undefined} />
  </div>
  {caption && (
    <figcaption class="shot__caption">{caption}</figcaption>
  )}
</figure>

<style>
  .shot { margin: 0; min-width: 0; }
  .shot__frame { position: relative; }
  .shot__frame :global(img) { display: block; width: 100%; height: auto; }
  .shot--device, .shot--screen { width: min(100%, 248px); margin-inline: auto; }
  .shot--screen .shot__frame :global(img) { border-radius: 24px; box-shadow: 0 0 0 1px rgb(25 20 28 / 8%); }
  .shot--desktop .shot__frame :global(img) { border-radius: 8px; box-shadow: 0 0 0 1px rgb(17 17 15 / 10%); }
  .shot--sheet .shot__frame :global(img) { border-radius: 4px; box-shadow: 0 0 0 1px rgb(17 17 15 / 10%); }

  .shot__caption { margin-top: 1rem; color: var(--color-muted); font-size: 0.8125rem; line-height: 1.5; text-wrap: balance; }
</style>
