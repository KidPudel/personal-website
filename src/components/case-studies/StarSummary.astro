---
import { toLocale, translator } from '../../i18n/locales';
import Rich from './Rich.astro';

interface Props {
  situation: string;
  task: string;
  action: string;
  /** Outcome numbers go in **bold**; they are highlighted as the summary scrolls in. */
  result: string;
  /** One honest note about the numbers, set as a note in the margin beside the result. */
  caption?: string;
}

const { situation, task, action, result, caption } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
const parts = [
  { label: t('Situation.', 'Ситуация.'), text: situation },
  { label: t('Task.', 'Задача.'), text: task },
  { label: t('Action.', 'Действия.'), text: action },
];
---

<section class="part part--summary" id="summary" data-index-section data-index-label={t('Summary', 'Коротко')} aria-labelledby="summary-title">
  <h2 id="summary-title">{t('The short version', 'Коротко')}</h2>
  {parts.map((part) => <p><span class="summary__label">{part.label}</span> <Rich text={part.text} /></p>)}
  <div class="outcome outcome--right">
    <p class="marked" id="summary-result" data-arrive><span class="summary__label">{t('Result.', 'Результат.')}</span> <Rich text={result} /></p>
    {caption && <p class="callout" data-note-for="summary-result">{caption}</p>}
  </div>
</section>
