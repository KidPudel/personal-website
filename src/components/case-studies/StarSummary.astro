---
import { toLocale, translator } from '../../i18n/locales';
import Rich from './Rich.astro';

interface Props {
  situation: string;
  task: string;
  action: string;
  /** Outcome numbers go in **bold**; they are highlighted as the summary scrolls in. */
  result: string;
  /** One honest note about the numbers, set as a note in the margin beside the result. */
  caption?: string;
  /** On wide pages, the result and its note sit in the side column beside the rest. */
  beside?: boolean;
}

const { situation, task, action, result, caption, beside = false } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
const parts = [
  { label: t('Situation.', 'Ситуация.'), text: situation },
  { label: t('Task.', 'Задача.'), text: task },
  { label: t('Action.', 'Действия.'), text: action },
];
---

<section class="part part--summary" id="summary" data-index-section data-index-label={t('Summary', 'Коротко')} aria-labelledby="summary-title">
  <!-- How much to read: everything, or the headings, problems, screens, and results. -->
  <div class="depth" role="group" aria-label={t('How much to read', 'Сколько читать')} hidden>
    <button class="depth__option" type="button" data-depth="full" aria-pressed="true">{t('Detailed', 'Подробно')}</button>
    <button class="depth__option" type="button" data-depth="tldr" aria-pressed="false">TL;DR</button>
  </div>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      let saved = null;
      try { saved = localStorage.getItem('study-depth'); } catch {}
      if (saved === 'tldr') root.dataset.depth = 'tldr';
      const group = document.currentScript.previousElementSibling;
      const options = group.querySelectorAll('[data-depth]');
      const show = (depth) => {
        if (depth === 'tldr') root.dataset.depth = 'tldr';
        else delete root.dataset.depth;
        options.forEach((option) => option.setAttribute('aria-pressed', String(option.dataset.depth === depth)));
      };
      show(saved === 'tldr' ? 'tldr' : 'full');
      options.forEach((option) => option.addEventListener('click', () => {
        show(option.dataset.depth);
        try { localStorage.setItem('study-depth', option.dataset.depth); } catch {}
      }));
      group.hidden = false;
    })();
  </script>
  <h2 id="summary-title">{t('The short version', 'Коротко')}</h2>
  {beside ? (
    <div class="beside">
      <div>{parts.map((part) => <p><span class="summary__label">{part.label}</span> <Rich text={part.text} /></p>)}</div>
      <div class="beside__side summary__result">
        <p class="marked" id="summary-result" data-arrive><span class="summary__label">{t('Result.', 'Результат.')}</span> <Rich text={result} /></p>
        {caption && <p class="callout">{caption}</p>}
      </div>
    </div>
  ) : (
    <>
      {parts.map((part) => <p><span class="summary__label">{part.label}</span> <Rich text={part.text} /></p>)}
      <div class="outcome outcome--right">
        <p class="marked" id="summary-result" data-arrive><span class="summary__label">{t('Result.', 'Результат.')}</span> <Rich text={result} /></p>
        {caption && <p class="callout" data-note-for="summary-result">{caption}</p>}
      </div>
    </>
  )}
</section>

<style>
  /* Two options in one pill, the chosen one raised. */
  .depth {
    display: inline-flex;
    justify-self: start;
    gap: 0.2rem;
    width: fit-content;
    margin: 0 0 var(--space-block);
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--panel, #f0f0ee);
  }

  .depth[hidden] {
    display: none;
  }

  .depth__option {
    min-height: 2.5rem;
    padding: 0 1.1rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
    font-family: var(--font-reading);
    font-size: 0.9375rem;
    transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
  }

  .depth__option:hover {
    color: var(--color-ink);
  }

  .depth__option[aria-pressed='true'] {
    background: #fff;
    box-shadow: 0 1px 3px rgb(17 17 15 / 0.12);
    color: var(--color-ink);
  }

  .depth__option:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>
