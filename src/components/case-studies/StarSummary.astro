---
import { toLocale, translator } from '../../i18n/locales';

interface Metric {
  value: string;
  label: string;
  /** Where the number comes from: measured, estimated, or counted from the design. */
  basis: string;
}

interface Props {
  situation: string;
  task: string;
  action: string;
  /** Said in words when the result is not a number. */
  result?: string;
  /** The headline numbers. They stand in for the result, so the page states them here once. */
  metrics?: Metric[];
  /** One honest note about the numbers, said once for the whole page. */
  caption?: string;
}

const { situation, task, action, result, metrics = [], caption } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
const parts = [
  { label: t('Situation', 'Ситуация'), text: situation },
  { label: t('Task', 'Задача'), text: task },
  { label: t('Action', 'Действия'), text: action },
];
const resultLabel = t('Result', 'Результат');
---

<section class="summary" id="summary" data-index-section data-index-label={t('Summary', 'Коротко')} aria-labelledby="summary-title">
  <h2 class="summary__title" id="summary-title">{t('The short version', 'Коротко')}</h2>
  <dl class="summary__list">
    {parts.map((part) => (
      <div class="summary__row">
        <dt class="summary__label">{part.label}</dt>
        <dd class="summary__text">{part.text}</dd>
      </div>
    ))}
    <div class="summary__row">
      <dt class="summary__label">{resultLabel}</dt>
      <dd class="summary__text">
        {result && <span class="summary__result">{result}</span>}
        {metrics.length > 0 && (
          <ul class="summary__metrics" role="list">
            {metrics.map((metric) => (
              <li class="summary__metric">
                <span class="summary__value">{metric.value}</span>
                <span class="summary__metric-label">{metric.label}</span>
                <span class="summary__basis">{metric.basis}</span>
              </li>
            ))}
          </ul>
        )}
      </dd>
    </div>
  </dl>
  {caption && <p class="summary__caption">{caption}</p>}
</section>

<style>
  .summary { padding-top: 32px; }
  .summary__title { margin: 0 0 12px; }
  .summary__list { margin: 0; }
  .summary__row { display: grid; grid-template-columns: 8rem minmax(0, var(--study-measure)); gap: 4px 24px; padding: 14px 0; border-top: 1px solid var(--study-rule); }
  .summary__row:last-child { border-bottom: 1px solid var(--study-rule); }
  .summary__label { padding-top: 3px; color: var(--study-caption); font-size: var(--study-small); line-height: 1.5; }
  .summary__text { margin: 0; font-size: var(--study-body); letter-spacing: .012em; line-height: 1.6; }
  .summary__result { display: block; }
  .summary__result + .summary__metrics { margin-top: 16px; }
  .summary__metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 20px 28px; margin: 4px 0 0; padding: 0; list-style: none; }
  .summary__metric { display: flex; flex-direction: column; gap: 4px; }
  .summary__value { font-size: clamp(1.5rem, 2.4vw, 1.875rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.15; text-wrap: balance; }
  .summary__metric-label { font-size: var(--study-small); line-height: 1.45; }
  .summary__basis { color: var(--study-caption); font-size: .875rem; line-height: 1.45; }
  .summary__caption { margin: 14px 0 0; color: var(--study-caption); font-size: var(--study-small); line-height: 1.6; }
  @media (max-width: 760px) {
    .summary__row { grid-template-columns: minmax(0, 1fr); }
    .summary__metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; }
  }
</style>
