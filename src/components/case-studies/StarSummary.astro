---
import { toLocale, translator } from '../../i18n/locales';

interface Props {
  situation: string;
  task: string;
  action: string;
  result: string;
}

const { situation, task, action, result } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
const parts = [
  { label: t('Situation', 'Ситуация'), text: situation },
  { label: t('Task', 'Задача'), text: task },
  { label: t('Action', 'Действия'), text: action },
  { label: t('Result', 'Результат'), text: result },
];
---

<section class="star breakout" aria-labelledby="star-title">
  <h2 class="star__title" id="star-title">{t('The short version', 'Коротко')}</h2>
  <dl class="star__grid">
    {parts.map((part) => (
      <div class="star__part">
        <dt class="star__label"><span class="star__letter" aria-hidden="true">{part.label.charAt(0)}</span>{part.label}</dt>
        <dd class="star__text">{part.text}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .star { padding-block: 8px 0; }
  .star__title { margin: 0 0 18px; color: #656560; font-size: var(--study-small); font-weight: 400; letter-spacing: 0; line-height: 1.4; }
  .star__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin: 0; }
  .star__part { padding: 20px 20px 22px; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px rgb(17 17 15 / 7%); }
  .star__label { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-size: var(--study-small); font-weight: 700; line-height: 1.3; }
  .star__letter { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 7px; background: var(--color-ink); color: var(--color-field); font-size: .875rem; line-height: 1; }
  .star__text { margin: 0; color: var(--color-copy); font-size: 1.0625rem; line-height: 1.55; }
  @media (max-width: 980px) { .star__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .star__grid { grid-template-columns: minmax(0, 1fr); gap: 12px; } .star__part { padding: 18px; } }
</style>
