---
interface Row {
  label: string;
  value: number;
  display: string;
  /** The row the chart is about. The rest are context in grey. */
  emphasis?: boolean;
}

interface Props {
  title: string;
  rows: Row[];
  note?: string;
  /** The top of the scale, such as 7 for a 1–7 rating. Defaults to the largest value. */
  max?: number;
}

const { title, rows, note, max = Math.max(...rows.map((row) => row.value)) } = Astro.props;
---

<!-- Drawn like the blog's chart: no card, thin bars, the value at the end of the bar. -->
<figure class="bars">
  <figcaption class="bars__title">{title}</figcaption>
  <dl class="bars__rows">
    {rows.map((row) => (
      <div class:list={['bars__row', row.emphasis && 'bars__row--emphasis']}>
        <dt class="bars__label">{row.label}</dt>
        <dd class="bars__plot">
          <span class="bars__bar" style={`--share: ${row.value / max}`} aria-hidden="true"></span>
          <span class="bars__value">{row.display}</span>
        </dd>
      </div>
    ))}
  </dl>
  {note && <p class="bars__note">{note}</p>}
</figure>

<style>
  .bars { margin: 0; }
  .bars__title { margin: 0 0 16px; color: var(--color-ink); font-size: var(--study-body); font-weight: 700; letter-spacing: -.015em; line-height: 1.35; text-wrap: balance; }
  .bars__rows { display: grid; gap: 12px; margin: 0; }
  .bars__row { display: grid; gap: 4px; color: var(--study-caption); font-size: var(--study-small); line-height: 1.4; }
  .bars__row--emphasis { color: var(--color-ink); }
  .bars__label { margin: 0; }
  .bars__plot { display: flex; align-items: center; gap: 10px; margin: 0; }
  /* Scaled to the top of the scale, so a short bar is really short. */
  .bars__bar { display: block; flex: none; width: calc((100% - 4.5rem) * var(--share)); min-width: 2px; height: 10px; border-radius: 0 4px 4px 0; background: #d0d0d3; }
  .bars__row--emphasis .bars__bar { background: var(--color-ink); }
  .bars__value { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bars__note { margin: 14px 0 0; color: var(--study-caption); font-size: .875rem; line-height: 1.55; }
</style>
