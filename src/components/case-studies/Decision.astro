---
import Rich from './Rich.astro';

interface Props {
  number: number;
  /** Says what was done, so the decision can be found by its title. */
  title: string;
  /** A short destination label for the progress navigation. */
  navLabel: string;
  problem: string;
  decision: string;
  why: string;
  /** The option weighed and not chosen, with the reason. */
  instead?: string;
  /** The outcome, with its numbers in **bold**; they are highlighted as it scrolls in. */
  effect?: string;
  /** Where the outcome comes from, set as a note in the margin beside it. */
  source?: string;
  /** side: the screen in the margin beside the story. stack: a wide visual after it. */
  layout?: 'side' | 'stack';
}

const { number, title, navLabel, problem, decision, why, instead, effect, source, layout = 'side' } = Astro.props;
const even = number % 2 === 0;
// The note goes in whichever margin the screen leaves free.
const noteSide = layout === 'side' && !even ? 'right' : layout === 'side' ? 'left' : 'right';
---

<!-- Written as a short story: the problem, what I did, why, the alternative, the outcome. -->
<article class:list={['decision', `decision--${layout}`, even && 'decision--even']} id={`decision-${number}`} data-index-sub data-index-label={`${number}. ${navLabel}`}>
  <div class:list={['decision__story', `decision__story--${noteSide}`]}>
    <h3>{number}. {title}</h3>
    <p>{problem}</p>
    <p>{decision}</p>
    <p>{why}</p>
    {instead && <p>{instead}</p>}
    {effect && (
      <div class:list={['outcome', `outcome--${noteSide}`]}>
        <p class="decision__effect marked" id={`outcome-${number}`} data-arrive><Rich text={effect} /></p>
        {source && <p class="callout" data-note-for={`outcome-${number}`}>{source}</p>}
      </div>
    )}
  </div>
  {Astro.slots.has('default') && <div class="decision__visual"><slot /></div>}
</article>
