---
import Rich from './Rich.astro';

interface Props {
  number: number;
  /** Says what was done, so the decision can be found by its title. */
  title: string;
  /** A short destination label for the progress navigation. */
  navLabel: string;
  problem: string;
  decision: string;
  why: string;
  /** The option weighed and not chosen, with the reason. */
  instead?: string;
  /** The outcome, with its numbers in **bold**; they are highlighted as it scrolls in. */
  effect?: string;
  /** Where the outcome comes from, set as a quiet line under it. */
  source?: string;
}

const { number, title, navLabel, problem, decision, why, instead, effect, source } = Astro.props;
---

<!-- One shape for every decision, read top to bottom: what was wrong, what I did, why, what I
     didn't do; then the screen; then what came of it. The TL;DR keeps the problem, what I did, the
     screen, and the result. -->

<article class="decision" id={`decision-${number}`} data-index-sub data-index-label={`${number}. ${navLabel}`}>
  <h3>{number}. {title}</h3>
  <p class="decision__problem">{problem}</p>
  <p class="decision__did">{decision}</p>
  <p class="decision__why">{why}</p>
  {instead && <p class="decision__instead">{instead}</p>}
  {Astro.slots.has('default') && <div class="decision__visual"><slot /></div>}
  {effect && <p class="decision__effect marked" data-arrive><Rich text={effect} /></p>}
  {source && <p class="decision__source">{source}</p>}
  {Astro.slots.has('evidence') && <div class="decision__evidence"><slot name="evidence" /></div>}
</article>
