---
import { toLocale, translator } from '../../i18n/locales';
import Rich from './Rich.astro';

// The order still follows STAR (problem and goal are the situation and task, research and decisions
// the action), but each heading says plainly what the section holds, so a reader can find it fast.
type Part = 'problem' | 'goal' | 'research' | 'decisions' | 'results' | 'reflection' | 'next';

interface Props {
  part: Part;
  /** Only when the plain name would mislead, such as research that was someone else's. */
  title?: string;
  lead?: string;
}

const { part, title, lead } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
const labels: Record<Part, string> = {
  problem: t('Problem', 'Проблема'),
  goal: t('Goal', 'Цель'),
  research: t('Research', 'Исследование'),
  decisions: t('Decisions', 'Решения'),
  results: t('Results', 'Результаты'),
  reflection: t('Reflection', 'Выводы'),
  next: t('Next steps', 'Что дальше'),
};
const label = labels[part];
---

<section class="study-section" id={part} data-index-section data-index-label={label}>
  <h2 class="study-section__title">{title ?? label}</h2>
  {lead && <p class="study-section__lead"><Rich text={lead} /></p>}
  <slot />
</section>

<style>
  .study-section { padding-block: clamp(48px, 6vw, 80px) 0; }
  .study-section__title { margin-bottom: 16px; }
</style>
