---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** The film's first frame, without the letterbox (scripts/prepare-observatory-footage.mjs). */
  poster: ImageMetadata;
}

const { poster } = Astro.props;
---

<!-- Archive footage of an astronomer at a telescope, shown as it is, behind an iris that opens as
     the page scrolls in, the way old films opened a scene. Decorative: nothing depends on it.
     Without scroll-driven animation or with reduced motion, the iris is simply open. -->
<figure class="archive" aria-hidden="true">
  <div class="archive__iris">
    <Image src={poster} alt="" widths={[poster.width]} sizes="(max-width: 1040px) calc(100vw - 40px), 960px" format="webp" loading="eager" decoding="async" fetchpriority="high" />
  </div>
</figure>

<style>
  .archive {
    max-width: 60rem;
    margin: 0 auto;
  }

  .archive__iris {
    overflow: hidden;
    aspect-ratio: 470 / 320;
    border-radius: 1.25rem;
    background: #0d0d0c;
    clip-path: circle(80% at 42% 45%);
  }

  .archive__iris :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .archive__iris {
        animation: archive-iris linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes archive-iris {
    from { clip-path: circle(10% at 42% 45%); }
    to { clip-path: circle(80% at 42% 45%); }
  }
</style>
