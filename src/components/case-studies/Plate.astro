---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { toLocale, translator } from '../../i18n/locales';

// A screen on a panel, the one way every case study shows its product: a calm panel lightly tinted
// with the study's colour, the screen large and sharp, its name under it inside the panel. What
// changed is ringed on the screen with a number and named by that number. Several screens are one
// panel showing one screen at a time: swipe or scroll sideways, use the arrows, or pick a dot.
// Without JavaScript the screens still scroll sideways, each with its name.

interface Region {
  /** In percent of the whole screen image: left, top, width, height. */
  x: number;
  y: number;
  w: number;
  h: number;
}

interface Note extends Region {
  label: string;
  /** More regions that changed the same way, ringed too; the number sits on the first. */
  also?: Region[];
}

interface Shot {
  src: ImageMetadata;
  alt: string;
  /** The screen's name, shown under it. */
  label?: string;
  /** Show only this part of the screen (percent), such as an app window without its shadow. */
  crop?: Region;
}

interface Props {
  shots: Shot[];
  /** What changed on one screen, ringed and named. */
  notes?: Note[];
  /** Which screen carries the notes: the first by default. */
  notesOn?: number;
  /** Show only this part of the first screen, large, without the phone around it (percent). */
  crop?: Region;
  /** One line about the whole panel, under it. */
  caption?: string;
  /** phone: screens of one set width. desktop: an app window as wide as the panel allows. */
  kind?: 'phone' | 'desktop';
}

const { shots, notes = [], notesOn = 0, crop, caption, kind = 'phone' } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
const candidates = kind === 'desktop' ? [640, 960, 1280, 1600] : [320, 480, 640, 800];
const widthsFor = (src: ImageMetadata) => [...new Set(candidates.filter((width) => width < src.width).concat(Math.min(src.width, candidates.at(-1)!)))];
const round = (value: number) => Math.round(value * 100) / 100;
const cropOf = (index: number) => shots[index]?.crop ?? (index === 0 ? crop : undefined);

// Rings are placed against the screen as shown, so a cropped screen moves them into its frame.
const ringCrop = cropOf(notesOn);
const shown = (region: Region) => (ringCrop
  ? { x: ((region.x - ringCrop.x) / ringCrop.w) * 100, y: ((region.y - ringCrop.y) / ringCrop.h) * 100, w: (region.w / ringCrop.w) * 100, h: (region.h / ringCrop.h) * 100 }
  : region);
const rings = notes.flatMap((note, at) => [note, ...(note.also ?? [])].map((region, index) => ({ ...shown(region), number: index === 0 ? at + 1 : undefined, at })));
const place = (ring: Region & { at: number }) => `--x: ${round(ring.x)}; --y: ${round(ring.y)}; --w: ${round(ring.w)}; --h: ${round(ring.h)}; --i: ${ring.at}`;
const frameOf = (index: number) => {
  const area = cropOf(index);
  const shot = shots[index];
  return area ? `aspect-ratio: ${round(area.w * shot.src.width)} / ${round(area.h * shot.src.height)}` : undefined;
};
const layersOf = (index: number) => {
  const area = cropOf(index);
  return area ? `width: ${round(10000 / area.w)}%; left: ${round((-area.x / area.w) * 100)}%; top: ${round((-area.y / area.h) * 100)}%` : undefined;
};
const sizes = kind === 'desktop' ? '(max-width: 759px) 90vw, 44rem' : '(max-width: 759px) 70vw, 22rem';
const many = shots.length > 1;
const legend = notes.map((note, at) => ({ number: at + 1, label: note.label }));
---

<figure class:list={['plate', `plate--${kind}`, many && 'plate--many', crop && 'plate--crop']} data-plate>
  <div class="plate__panel">
    <div class="plate__track" data-track tabindex={many ? 0 : undefined} role={many ? 'group' : undefined} aria-label={many ? t('Screens, one at a time', 'Экраны по одному') : undefined}>
      {shots.map((shot, index) => (
        <div class="plate__slide" data-slide>
          <div class:list={['plate__screen', cropOf(index) && 'plate__screen--crop']} style={frameOf(index)}>
            <div class="plate__layers" style={layersOf(index)}>
              <Image src={shot.src} alt={shot.alt} widths={widthsFor(shot.src)} sizes={sizes} format="webp" quality={85} loading="lazy" decoding="async" />
            </div>
            {index === notesOn && rings.length > 0 && (
              <ol class="plate__rings" aria-hidden="true">
                {rings.map((ring) => <li style={place(ring)}>{ring.number && <span>{ring.number}</span>}</li>)}
              </ol>
            )}
          </div>
          {(shot.label || (index === notesOn && legend.length > 0)) && (
            <div class="plate__key">
              {shot.label && <p class="plate__label">{shot.label}</p>}
              {index === notesOn && legend.length > 0 && (
                <ol class="plate__names">{legend.map((item) => <li><span class="plate__number" aria-hidden="true">{item.number}</span>{item.label}</li>)}</ol>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
    {many && (
      <div class="plate__controls" hidden>
        <button class="plate__arrow plate__arrow--prev" type="button" data-prev aria-label={t('Previous screen', 'Предыдущий экран')}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button class="plate__arrow plate__arrow--next" type="button" data-next aria-label={t('Next screen', 'Следующий экран')}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9.5 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="plate__dots">
          {shots.map((shot, index) => (
            <button class="plate__dot" type="button" data-dot={index} aria-label={`${t('Screen', 'Экран')} ${index + 1}${shot.label ? `: ${shot.label}` : ''}`} aria-current={index === 0 ? 'true' : undefined}></button>
          ))}
        </div>
      </div>
    )}
  </div>
  {caption && <figcaption class="plate__caption">{caption}</figcaption>}
</figure>

<script>
  // Panels with several screens: arrows and dots move the sideways scroll one screen at a time,
  // and the dots follow wherever a swipe or a trackpad leaves it. Rings draw in once a panel's
  // screens are in view and decoded.
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-plate]').forEach((plate) => {
    const track = plate.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(plate.querySelectorAll<HTMLElement>('[data-slide]'));
    const controls = plate.querySelector<HTMLElement>('.plate__controls');
    if (!track || !controls || slides.length < 2) return;

    const prev = controls.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-next]')!;
    const dots = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    controls.hidden = false;

    const current = () => Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
    const go = (index: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: target * track.clientWidth, behavior: still.matches ? 'auto' : 'smooth' });
    };
    const sync = () => {
      const at = current();
      prev.disabled = at === 0;
      next.disabled = at === slides.length - 1;
      dots.forEach((dot, index) => (index === at ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current')));
      slides.forEach((slide, index) => slide.toggleAttribute('inert', index !== at));
    };

    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); go(current() + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); go(current() - 1); }
    });
    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(sync);
    }, { passive: true });
    new ResizeObserver(sync).observe(track);
    sync();
  });

  const ready = (image: HTMLImageElement) => {
    const loaded = image.complete && image.naturalWidth
      ? Promise.resolve()
      : new Promise<void>((resolve) => {
          image.addEventListener('load', () => resolve(), { once: true });
          image.addEventListener('error', () => resolve(), { once: true });
        });
    return loaded.then(() => image.decode().catch(() => undefined));
  };
  const watch = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      watch.unobserve(entry.target);
      const plate = entry.target as HTMLElement;
      const first = plate.querySelector<HTMLImageElement>('.plate__layers img');
      (first ? ready(first) : Promise.resolve()).then(() => plate.classList.add('is-here'));
    });
  }, { rootMargin: '0px 0px -15% 0px', threshold: 0.25 });
  document.querySelectorAll<HTMLElement>('[data-plate]').forEach((plate) => (still.matches ? plate.classList.add('is-here') : watch.observe(plate)));
</script>

<style>
  .plate {
    --pad: clamp(1.25rem, 3vw, 2.5rem);
    /* One phone width for every study, never taller than the window can show with its name. */
    --phone: min(19rem, (100svh - 19rem) * 0.5);
    margin: 0;
  }

  .plate--crop {
    --phone: min(24rem, (100svh - 17rem) * 0.66);
  }

  /* ---- The panel: calm, lightly tinted with the study's colour ------------------------------ */

  .plate__panel {
    position: relative;
    border-radius: var(--radius-card);
    background: var(--panel, #f0f0ee);
  }

  .plate__track {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .plate__track::-webkit-scrollbar {
    display: none;
  }

  .plate__track:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
    border-radius: var(--radius-card);
  }

  .plate__slide {
    display: flex;
    flex: 0 0 100%;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    padding: var(--pad) var(--pad) calc(var(--pad) * 0.9);
    scroll-snap-align: center;
  }

  /* Room for the dots under the names. */
  .plate--many .plate__slide {
    padding-bottom: calc(var(--pad) + 1.75rem);
  }

  .plate__screen {
    position: relative;
    width: var(--phone);
    max-width: 100%;
  }

  .plate--desktop .plate__screen {
    width: 100%;
  }

  .plate__layers {
    position: relative;
  }

  .plate__layers :global(img) {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    filter: drop-shadow(0 0.75rem 1.25rem rgb(17 17 15 / 0.16));
  }

  .plate--desktop .plate__layers :global(img) {
    border-radius: 0.5rem;
    filter: none;
    box-shadow: 0 0.75rem 1.75rem rgb(17 17 15 / 0.14), 0 0 0 1px rgb(17 17 15 / 0.06);
  }

  /* A crop shows only part of the screen, framed to its own edges. */
  .plate__screen--crop {
    overflow: hidden;
    border-radius: 1.1rem;
    box-shadow: 0 0.75rem 1.75rem rgb(17 17 15 / 0.16);
  }

  .plate--desktop .plate__screen--crop {
    border-radius: 0.6rem;
    box-shadow: 0 0.75rem 1.75rem rgb(17 17 15 / 0.14), 0 0 0 1px rgb(17 17 15 / 0.06);
  }

  .plate__screen--crop .plate__layers {
    position: absolute;
  }

  .plate__screen--crop .plate__layers :global(img) {
    border-radius: 0;
    filter: none;
    box-shadow: none;
  }

  /* ---- Rings: what changed, numbered ---------------------------------------------------------- */

  .plate__rings {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .plate__rings li {
    position: absolute;
    top: calc(var(--y) * 1%);
    left: calc(var(--x) * 1%);
    width: calc(var(--w) * 1%);
    height: calc(var(--h) * 1%);
    border: 2px solid var(--color-ink);
    border-radius: 0.55rem;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 0.9);
    transition: opacity 240ms ease, scale 360ms var(--ease-out);
    transition-delay: calc(200ms + var(--i) * 160ms);
  }

  :global(html.js) .plate:not(.is-here) .plate__rings li {
    opacity: 0;
    scale: 1.06;
  }

  .plate__rings span,
  .plate__number {
    display: inline-grid;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-study-emphasis);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .plate__rings span {
    position: absolute;
    top: 0;
    left: 0;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 0.9);
    translate: -55% -55%;
  }

  /* ---- Inside the panel, under the screen: its name and what changed -------------------------- */

  .plate__key {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    max-width: 30rem;
    text-align: center;
  }

  .plate .plate__label {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: var(--small, 0.9375rem);
    line-height: 1.45;
  }

  .plate__names {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Specific enough to win over the page's running-text style for list items. */
  .plate .plate__names li {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    color: var(--color-copy);
    font-family: var(--font-reading);
    font-size: var(--small, 0.9375rem);
    line-height: 1.45;
    text-align: left;
  }

  .plate .plate__caption {
    max-width: 40rem;
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: var(--small, 0.9375rem);
    line-height: 1.5;
  }

  /* ---- Several screens: arrows at the sides, dots at the bottom ------------------------------ */

  .plate__controls[hidden] {
    display: none;
  }

  .plate__arrow {
    position: absolute;
    top: 50%;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.82);
    box-shadow: 0 1px 2px rgb(17 17 15 / 0.12);
    color: var(--color-ink);
    cursor: pointer;
    translate: 0 -50%;
    transition: opacity 160ms ease, background-color 160ms ease;
  }

  .plate__arrow:hover {
    background: #fff;
  }

  .plate__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .plate__arrow--prev {
    left: 0.75rem;
  }

  .plate__arrow--next {
    right: 0.75rem;
  }

  .plate__dots {
    position: absolute;
    bottom: calc(var(--pad) * 0.6);
    left: 50%;
    display: flex;
    gap: 0.1rem;
    translate: -50% 0;
  }

  .plate__dot {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .plate__dot::before {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-ink);
    content: '';
    opacity: 0.22;
    transition: opacity 160ms ease;
  }

  .plate__dot:hover::before {
    opacity: 0.5;
  }

  .plate__dot[aria-current='true']::before {
    opacity: 0.85;
  }

  .plate :is(.plate__arrow, .plate__dot):focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .plate__rings li {
      transition: none;
    }
  }

  @media (max-width: 759px) {
    .plate {
      --pad: 1.25rem;
      --phone: min(66vw, 16.5rem);
    }

    .plate--crop {
      --phone: min(80vw, 21rem);
    }

    .plate__arrow {
      display: none;
    }

    .plate__rings li {
      border-width: 1.5px;
      border-radius: 0.4rem;
    }

    .plate__rings span {
      width: 1.1rem;
      height: 1.1rem;
      font-size: 0.625rem;
    }
  }
</style>
