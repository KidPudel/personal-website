---
import { toLocale, translator } from '../../i18n/locales';

const t = translator(toLocale(Astro.currentLocale));
---

<!-- Navigation for a case study, built from its sections and decisions. Wide screens get a list beside
     the text; narrower ones get the contents list after the summary and a small pill that leads back
     to it. Without JavaScript the headings still carry the structure. -->
<reading-progress hidden data-back-label={t('Back to contents', 'К содержанию')}>
  <nav class="rail" aria-label={t('Case study sections', 'Разделы кейса')}></nav>
  <a class="pill" href="#contents" hidden></a>
</reading-progress>

<script>
  class ReadingProgress extends HTMLElement {
    private abort?: AbortController;
    private resize?: ResizeObserver;
    private frame = 0;

    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const { signal } = this.abort;
      const main = document.querySelector('main');
      const rail = this.querySelector<HTMLElement>('.rail');
      const pill = this.querySelector<HTMLAnchorElement>('.pill');
      if (!main || !rail || !pill) return;
      const items = Array.from(main.querySelectorAll<HTMLElement>('[data-index-section], [data-index-sub]'));
      if (!items.length) return;
      items.forEach((item, index) => { if (!item.id) item.id = `study-part-${index + 1}`; });
      const heading = (item: HTMLElement) => item.querySelector<HTMLElement>('h2, h3') ?? item;
      const isSub = (item: HTMLElement) => item.hasAttribute('data-index-sub');

      const jump = (item: HTMLElement) => (event: MouseEvent) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const target = heading(item);
        history.replaceState(null, '', `#${item.id}`);
        target.scrollIntoView({ block: 'start', behavior: 'instant' });
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
        schedule();
      };
      const link = (item: HTMLElement) => {
        const anchor = document.createElement('a');
        anchor.href = `#${item.id}`;
        anchor.textContent = item.dataset.indexLabel ?? heading(item).textContent?.trim() ?? '';
        // Navigation links take the hover swipe only, not the faint mark that links in running text carry.
        anchor.className = 'link-mark';
        anchor.addEventListener('click', jump(item), { signal });
        return anchor;
      };

      // The side list: sections, with decisions indented under them.
      const railLinks = items.map((item) => {
        const anchor = link(item);
        anchor.className = isSub(item) ? 'sub' : '';
        return anchor;
      });
      rail.replaceChildren(...railLinks);

      // The contents list after the summary, for screens without room for the side list.
      const contents = main.querySelector<HTMLElement>('[data-study-contents]');
      if (contents) {
        const list = document.createElement('ol');
        let lastSection: HTMLLIElement | undefined;
        let subList: HTMLOListElement | undefined;
        items.filter((item) => item.id !== 'summary').forEach((item) => {
          const entry = document.createElement('li');
          entry.append(link(item));
          if (isSub(item) && lastSection) {
            if (!subList) { subList = document.createElement('ol'); lastSection.append(subList); }
            subList.append(entry);
          } else {
            list.append(entry);
            lastSection = entry;
            subList = undefined;
          }
        });
        contents.querySelector('ol')?.remove();
        contents.append(list);
        contents.hidden = false;
        pill.addEventListener('click', (event) => {
          event.preventDefault();
          contents.scrollIntoView({ block: 'start', behavior: 'instant' });
          contents.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
        }, { signal });
      }

      const update = () => {
        this.frame = 0;
        const line = Math.min(160, innerHeight * 0.25);
        let active = 0;
        items.forEach((item, index) => { if (heading(item).getBoundingClientRect().top <= line) active = index; });
        if (main.getBoundingClientRect().bottom <= innerHeight + 2) active = items.length - 1;
        railLinks.forEach((anchor, index) => {
          if (index === active) anchor.setAttribute('aria-current', 'location');
          else anchor.removeAttribute('aria-current');
        });
        // The pill names where the reader is, and appears once the contents list is out of view.
        const current = items[active];
        const section = isSub(current) ? items.slice(0, active).reverse().find((item) => !isSub(item)) : current;
        const name = [section, isSub(current) ? current : undefined].filter(Boolean).map((item) => item!.dataset.indexLabel).join(' · ');
        pill.textContent = `↑ ${name}`;
        pill.setAttribute('aria-label', `${this.dataset.backLabel ?? 'Back to contents'}. ${name}`);
        pill.hidden = !contents || contents.getBoundingClientRect().bottom > 0 || active === 0;
      };
      const schedule = () => {
        if (!this.frame) this.frame = requestAnimationFrame(update);
      };
      this.hidden = false;
      window.addEventListener('scroll', schedule, { passive: true, signal });
      window.addEventListener('resize', schedule, { passive: true, signal });
      this.resize = new ResizeObserver(schedule);
      this.resize.observe(main);
      update();
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.resize?.disconnect();
      cancelAnimationFrame(this.frame);
    }
  }
  if (!customElements.get('reading-progress')) customElements.define('reading-progress', ReadingProgress);
</script>

<style is:global>
  reading-progress[hidden] { display: none; }
  reading-progress .rail { display: none; }
  /* Wide screens: a quiet list beside the text, the current part in ink. */
  @media (min-width: 1400px) {
    reading-progress .rail { position: fixed; z-index: 10; top: 50%; left: 24px; display: flex; flex-direction: column; gap: 2px; width: calc(var(--page-gutter) - 48px); max-height: 80vh; overflow-y: auto; transform: translateY(-50%); scrollbar-width: none; }
    reading-progress .rail a { padding: 3px 0; color: var(--color-muted); font: 14px/1.35 var(--font-reading); text-decoration: none; transition: color 120ms ease-out; }
    reading-progress .rail a.sub { padding-left: 12px; font-size: 13px; }
    reading-progress .rail a[aria-current] { color: var(--color-ink); }
    reading-progress .pill { display: none; }
  }
  @media (min-width: 1400px) and (hover: hover) { reading-progress .rail a:hover { color: var(--color-ink); } }
  /* Narrower screens: one small pill that names the current part and leads back to the contents. */
  reading-progress .pill { position: fixed; z-index: 10; left: 50%; bottom: 14px; max-width: min(calc(100% - 32px), 420px); padding: 10px 16px; overflow: hidden; border-radius: 999px; background: var(--color-field); box-shadow: 0 0 0 1px rgb(17 17 15 / 10%), 0 8px 24px -12px rgb(17 17 15 / 30%); color: var(--color-ink); font: 14px/1.3 var(--font-reading); text-decoration: none; white-space: nowrap; text-overflow: ellipsis; transform: translateX(-50%); }
  reading-progress .pill[hidden] { display: none; }
  reading-progress a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; border-radius: 4px; }
  @media (prefers-reduced-motion: reduce) { reading-progress .rail a { transition: none; } }
  @media print { reading-progress { display: none; } }
</style>
