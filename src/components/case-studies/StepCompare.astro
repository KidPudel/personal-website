---
import { toLocale, translator } from '../../i18n/locales';

interface Row {
  label: string;
  steps: string[];
  emphasis?: boolean;
}

interface Props {
  title: string;
  rows: Row[];
  note?: string;
}

const { title, rows, note } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const russianSteps = (count: number) => {
  const lastTwo = count % 100;
  const last = count % 10;
  if (last === 1 && lastTwo !== 11) return 'шаг';
  if (last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14)) return 'шага';
  return 'шагов';
};
const countLabel = (count: number) => t(`${count} ${count === 1 ? 'step' : 'steps'}`, `${count} ${russianSteps(count)}`);
const longest = Math.max(...rows.map((row) => row.steps.length));
---

<!-- A walk through the steps: the same distance per step in every row, so fewer steps look shorter. -->
<figure class="steps" style={`--longest: ${longest}`}>
  <figcaption class="steps__title">{title}</figcaption>
  {rows.map((row) => (
    <div class:list={['steps__row', row.emphasis && 'steps__row--emphasis']}>
      <p class="steps__label">{row.label}<span class="sr-only">,</span> <span class="steps__count">{countLabel(row.steps.length)}</span></p>
      <ol class="steps__list">
        {row.steps.map((step) => <li class="steps__step"><span class="steps__name">{step}</span></li>)}
      </ol>
    </div>
  ))}
  {note && <p class="steps__note">{note}</p>}
</figure>

<style>
  .steps {
    display: grid;
    gap: 1.9rem;
    margin-block: 2.5rem;
    container: steps / inline-size;
  }

  .steps__title {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-study-emphasis);
    font-size: var(--text);
    font-weight: 600;
    line-height: 1.4;
    text-wrap: balance;
  }

  .steps__row {
    color: var(--color-muted);
    font-size: var(--small);
    line-height: 1.45;
  }

  .steps__row--emphasis {
    color: var(--color-ink);
  }

  .steps .steps__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.65rem;
    margin: 0 0 1rem;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .steps__count {
    color: var(--color-muted);
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(var(--longest), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A dot for each step, joined to the next by a hairline. */
  .steps__step {
    position: relative;
    min-width: 0;
    color: inherit;
    font-size: var(--small);
    line-height: 1.45;
    padding: 1.35rem 0.75rem 0 0;
  }

  .steps__step::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 0.7rem;
    height: 0.7rem;
    box-sizing: border-box;
    border: 1.5px solid var(--context);
    border-radius: 50%;
    content: '';
  }

  .steps__step:not(:last-child)::after {
    position: absolute;
    top: 0.34rem;
    right: 0.35rem;
    left: 1.05rem;
    height: 1px;
    background: var(--context);
    content: '';
  }

  .steps__row--emphasis .steps__step::before {
    border: 0;
    background: var(--color-ink);
  }

  .steps__row--emphasis .steps__step:not(:last-child)::after {
    background: var(--color-ink);
  }

  .steps__name {
    display: block;
    overflow-wrap: anywhere;
  }

  .steps__note {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--small);
    line-height: 1.55;
  }

  /* On a narrow column the walk turns downward, one step per line. */
  @container steps (max-width: 30rem) {
    .steps__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps__step {
      padding: 0 0 0.85rem 1.6rem;
    }

    .steps__step::before {
      top: 0.38em;
    }

    .steps__step:not(:last-child)::after {
      top: 1.35rem;
      right: auto;
      bottom: 0.2rem;
      left: 0.34rem;
      width: 1px;
      height: auto;
    }
  }
</style>
