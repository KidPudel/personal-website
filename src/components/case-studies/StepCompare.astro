---
import { toLocale, translator } from '../../i18n/locales';

interface Row {
  label: string;
  steps: string[];
  emphasis?: boolean;
}

interface Props {
  title: string;
  rows: Row[];
  note?: string;
}

const { title, rows, note } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const russianSteps = (count: number) => {
  const lastTwo = count % 100;
  const last = count % 10;
  if (last === 1 && lastTwo !== 11) return 'шаг';
  if (last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14)) return 'шага';
  return 'шагов';
};
const countLabel = (count: number) => t(`${count} ${count === 1 ? 'step' : 'steps'}`, `${count} ${russianSteps(count)}`);
---

<!-- Steps as plain words with thin arrows: the "after" row in ink, the "before" row in grey. -->
<figure class="steps">
  <figcaption class="steps__title">{title}</figcaption>
  {rows.map((row) => (
    <div class:list={['steps__row', row.emphasis && 'steps__row--emphasis']}>
      <p class="steps__label">{row.label}, {countLabel(row.steps.length)}</p>
      <ol class="steps__list">
        {row.steps.map((step) => <li class="steps__step">{step}</li>)}
      </ol>
    </div>
  ))}
  {note && <p class="steps__note">{note}</p>}
</figure>

<style>
  .steps { margin: 0; }
  .steps__title { margin: 0 0 16px; color: var(--color-ink); font-size: var(--study-body); font-weight: 700; letter-spacing: -.015em; line-height: 1.35; text-wrap: balance; }
  .steps__row { color: var(--study-caption); font-size: var(--study-small); line-height: 1.5; }
  .steps__row + .steps__row { margin-top: 12px; }
  .steps__row--emphasis { color: var(--color-ink); }
  .steps .steps__label { margin: 0 0 2px; font-size: inherit; line-height: inherit; }
  .steps__list { display: flex; flex-wrap: wrap; gap: 0; margin: 0; padding: 0; list-style: none; }
  .steps__step:not(:last-child)::after { content: '→'; margin-inline: .45em; color: #a8a49c; }
  .steps__note { margin: 14px 0 0; color: var(--study-caption); font-size: .875rem; line-height: 1.55; }
</style>
