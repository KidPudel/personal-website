---
import { toLocale, translator } from '../../i18n/locales';

interface Row {
  label: string;
  value: number;
  total: number;
  emphasis?: boolean;
}

interface Props {
  title: string;
  rows: Row[];
  note?: string;
}

const { title, rows, note } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
---

<!-- One dot per person, in the same quiet style as the bar charts. -->
<figure class="dots">
  <figcaption class="dots__title">{title}</figcaption>
  <dl class="dots__rows">
    {rows.map((row) => (
      <div class:list={['dots__row', row.emphasis && 'dots__row--emphasis']}>
        <dt class="dots__label">{row.label}</dt>
        <dd class="dots__plot">
          <span class="dots__people" aria-hidden="true">
            {Array.from({ length: row.total }, (_, index) => (
              <span class:list={['dots__dot', index < row.value && 'dots__dot--on']}></span>
            ))}
          </span>
          <span class="dots__value">{t(`${row.value} of ${row.total}`, `${row.value} из ${row.total}`)}</span>
        </dd>
      </div>
    ))}
  </dl>
  {note && <p class="dots__note">{note}</p>}
</figure>

<style>
  .dots { margin: 0; }
  .dots__title { margin: 0 0 16px; color: var(--color-ink); font-size: var(--study-body); font-weight: 700; letter-spacing: -.015em; line-height: 1.35; text-wrap: balance; }
  .dots__rows { display: grid; gap: 12px; margin: 0; }
  .dots__row { display: grid; gap: 6px; color: var(--study-caption); font-size: var(--study-small); line-height: 1.4; }
  .dots__row--emphasis { color: var(--color-ink); }
  .dots__label { margin: 0; }
  .dots__plot { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 0; }
  .dots__people { display: flex; flex-wrap: wrap; gap: 5px; }
  .dots__dot { width: 10px; height: 10px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px #d0d0d3; }
  .dots__dot--on { background: #d0d0d3; box-shadow: none; }
  .dots__row--emphasis .dots__dot { box-shadow: inset 0 0 0 1.5px var(--color-ink); }
  .dots__row--emphasis .dots__dot--on { background: var(--color-ink); box-shadow: none; }
  .dots__value { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dots__note { margin: 14px 0 0; color: var(--study-caption); font-size: .875rem; line-height: 1.55; }
</style>
