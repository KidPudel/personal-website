---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  kind?: 'phone' | 'spread' | 'wireframe';
  priority?: boolean;
  sizes?: string;
}
const { src, alt, caption, kind = 'phone', priority = false, sizes } = Astro.props;
const widths = [...new Set([...(kind === 'phone' ? [280, 388] : [540, 800, 1080]).filter(width => width < src.width), src.width])];
const full = await getImage({ src, width: src.width, format: kind === 'wireframe' ? 'png' : 'webp', quality: 90 });
---
<figure style={`--source-width: ${src.width}px`} class:list={['study-image', `study-image--${kind}`]}>
  <a href={full.src} aria-label={`Open image: ${alt}`}>
    <Image src={src} alt={alt} width={src.width} height={src.height} widths={widths}
      sizes={sizes ?? (kind === 'phone' ? '(max-width: 390px) calc(100vw - 80px), 300px' : kind === 'spread' ? '(max-width: 700px) calc(100vw - 40px), (max-width: 1200px) calc((100vw - 108px) / 2), 546px' : `(max-width: ${Math.min(src.width, 1040) + 40}px) calc(100vw - 40px), ${Math.min(src.width, 1040)}px`)}
      format={kind === 'wireframe' ? 'png' : 'webp'} quality={90}
      loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .study-image { margin: 0; min-width: 0; max-width: min(100%, var(--source-width)); }
  a { display: block; border-radius: 6px; }
  img { display: block; width: 100%; height: auto; }
  .study-image--phone { width: min(100%, 300px); margin-inline: auto; }
  .study-image--phone img { border-radius: 25px; box-shadow: 0 0 0 1px rgb(25 20 28 / 8%), 0 18px 40px -20px rgb(25 20 28 / 25%); }
  .study-image--spread img { border-radius: 5px; }
  .study-image--wireframe { width: min(100%, var(--source-width)); margin-inline: auto; }
  .study-image--wireframe img { width: 100%; max-width: var(--source-width); }
  figcaption { margin-top: 18px; color: #605a62; font-size: var(--study-small, 0.9375rem); line-height: 1.6; }
</style>
