---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  title: string;
  description: string;
  small: string;
  large: string;
  poster: ImageMetadata;

}
import { toLocale, translator } from '../../../i18n/locales';

const { id, title, description, small, large, poster } = Astro.props;
const t = translator(toLocale(Astro.currentLocale));
const labels = { play: t('Play', 'Играть'), pause: t('Pause', 'Пауза') };
const cover = await getImage({ src: poster, width: 720, format: 'webp', quality: 85 });
---
<study-film>
<figure class="study-film">
  <video muted loop playsinline preload="none" poster={cover.src} width={720} height={1280}
    aria-label={title} aria-describedby={`${id}-caption`}>
    <source src={small} type="video/mp4" media="(max-resolution: 1.5dppx)" />
    <source src={large} type="video/mp4" />
    <a href={large}><span class="link-mark">{t('Watch', 'Смотреть:')} {title}</span></a>
  </video>
  <figcaption id={`${id}-caption`}>
    <span>{description}</span>
  </figcaption>
  <button type="button" hidden aria-label={`${labels.play}: ${title}`} data-labels={JSON.stringify(labels)}><span class="link-mark">{labels.play}</span></button>
  <noscript><a href={large}><span class="link-mark">{t('Watch', 'Смотреть:')} {title}</span></a></noscript>
</figure>
</study-film>
<script>
  class StudyFilm extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup?.();
      const video = this.querySelector('video')!;
      const button = this.querySelector('button')!;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
      const conserve = connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? '');
      let visible = false;
      let userPaused = false;
      let explicitPlay = false;
      let failed = false;
      const abort = new AbortController();
      const labels = { play: 'Play', pause: 'Pause', ...JSON.parse(button.dataset.labels ?? '{}') };
      const syncLabel = () => {
        const label = video.paused ? labels.play : labels.pause;
        (button.querySelector('.link-mark') ?? button).textContent = label;
        button.setAttribute('aria-label', `${label}: ${video.getAttribute('aria-label')}`);
      };
      const sync = () => {
        if (visible && !document.hidden && !userPaused && !failed && (explicitPlay || (!motion.matches && !conserve))) {
          void video.play().catch(() => { failed = true; syncLabel(); });
        } else video.pause();
      };
      button.hidden = false;
      button.addEventListener('click', () => {
        if (video.paused) { userPaused = false; explicitPlay = true; failed = false; }
        else { userPaused = true; explicitPlay = false; }
        sync();
      }, { signal: abort.signal });
      video.addEventListener('play', syncLabel, { signal: abort.signal });
      video.addEventListener('pause', syncLabel, { signal: abort.signal });
      document.addEventListener('visibilitychange', sync, { signal: abort.signal });
      motion.addEventListener('change', () => { explicitPlay = false; sync(); }, { signal: abort.signal });
      const observer = new IntersectionObserver(entries => {
        visible = entries[0].isIntersecting && entries[0].intersectionRatio >= .35;
        sync();
      }, { threshold: [0, .35] });
      observer.observe(video);
      this.cleanup = () => { observer.disconnect(); abort.abort(); video.pause(); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('study-film')) customElements.define('study-film', StudyFilm);
</script>
<style>
  study-film { display: block; height: 100%; }
  button { grid-column: 1; grid-row: 3; justify-self: start; align-self: start; display: inline-flex; align-items: flex-start; justify-content: flex-start; min-width: 44px; min-height: 44px; padding: 0; margin: 0; border: 0; background: none; color: var(--study-caption); font: inherit; font-size: var(--study-small); line-height: 1.5; cursor: pointer; }
  button[hidden] { display: none; }

  .study-film { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr auto; gap: 8px; height: 100%; margin: 0; min-width: 0; }
  video { grid-column: 1 / -1; display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: contain; border-radius: 6px; background: white;  }
  .study-film figcaption { grid-column: 1; grid-row: 2; min-width: 0; margin: 0; color: var(--study-caption); font-size: var(--study-small, .9375rem); line-height: 1.5; }
  noscript { grid-column: 1; grid-row: 3; }
  a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--study-body, 1.0625rem); color: inherit; text-decoration: none; }
</style>
