---
import { getCollection } from 'astro:content';

import { sitePath } from '../../config/site';
import ArtifactSketch from './ArtifactSketch.astro';
import UnfoldingTrail from './UnfoldingTrail.astro';

const order = [
  'discourses-by-campfire',
  'santa-foundation',
  'snake-raylib',
  'tic-tac-toe-opengl',
];
const entries = (await getCollection('games'))
  .filter((entry) => order.includes(entry.id))
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const [discourses, santa, snake, ticTacToe] = entries;
---

<section
  id="work/games"
  class="games-disclosure"
  aria-labelledby="games-title"
  data-destination-disclosure
  data-destination-id="work/games"
  hidden
>
  <article class="games-unfolding">
    <svg
      class="games-opening__connections"
      viewBox="0 0 1200 760"
      preserveAspectRatio="none"
      aria-hidden="true"
      data-route-connections
    >
      <path class="games-opening__connection games-opening__connection--title" data-connection-to="games-title-piece" data-curve="0.1" pathLength="1" d="M980 390 C810 275 650 220 420 235" />
      <path class="games-opening__connection games-opening__connection--resume" data-connection-to="games-resume" data-curve="0.08" pathLength="1" d="M980 390 C870 330 760 290 650 285" />
      <path class="games-opening__connection games-opening__connection--artifact" data-connection-to="games-first-artifact" data-curve="-0.11" pathLength="1" d="M980 390 C820 430 705 505 565 565" />
    </svg>

    <header class="games-opening">
      <div
        class="games-opening__title games-opening__piece"
        data-connection-target="games-title-piece"
        style="--piece-delay: 80ms; --piece-x: 4rem; --piece-y: 2rem;"
      >
        <p>work / games</p>
        <h1 id="games-title" tabindex="-1" data-destination-title>Games</h1>
      </div>

      <aside
        class="games-opening__resume games-opening__piece"
        data-connection-target="games-resume"
        aria-labelledby="games-resume-label"
        style="--piece-delay: 130ms; --piece-x: 3rem; --piece-y: -1.5rem;"
      >
        <p id="games-resume-label">game résumé</p>
        <div>
          <a href={sitePath('/resume/igor-kupchinenko-game-development-resume.pdf')} download>PDF</a>
          <a href={sitePath('/resume/igor-kupchinenko-game-development-resume.docx')} download>DOCX</a>
        </div>
      </aside>

      <section
        class="games-opening__artifact games-opening__piece"
        data-connection-target="games-first-artifact"
        aria-labelledby="games-discourses-title"
        style="--piece-delay: 160ms; --piece-x: 4rem; --piece-y: -2.5rem;"
      >
        <div class="games-opening__media">
          <ArtifactSketch category="games" slug={discourses.id} />
        </div>
        <div class="games-opening__copy">
          <span aria-hidden="true">01</span>
          <h2 id="games-discourses-title">{discourses.data.title}</h2>
          <aside aria-label="Learned along this artifact">
            <p>Learned along an artifact</p>
            <ul>{discourses.data.learnings.map((learning) => <li>{learning}</li>)}</ul>
          </aside>
          {discourses.data.externalUrl && (
            <a href={discourses.data.externalUrl} rel="noreferrer">
              visit the game <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </section>
    </header>

    <UnfoldingTrail>
      <div class="games-trail">
        <svg class="games-trail__spine" viewBox="0 0 1000 1600" preserveAspectRatio="none" aria-hidden="true">
          <path d="M500 8 C500 150 755 110 758 305 C760 510 247 390 245 615 C242 835 748 760 752 1012 C755 1230 528 1260 500 1592" pathLength="1" />
        </svg>

        <section id="games-santa" class="games-stop games-stop--santa" data-trail-stop aria-labelledby="games-santa-title">
          <div class="games-stop__copy">
            <span class="games-stop__number" aria-hidden="true">02</span>
            <h2 id="games-santa-title">{santa.data.title}</h2>
            <aside aria-label="Learned along this artifact">
              <p>Learned along an artifact</p>
              <ul>{santa.data.learnings.map((learning) => <li>{learning}</li>)}</ul>
            </aside>
            {santa.data.externalUrl && (
              <a class="games-stop__open" href={santa.data.externalUrl} rel="noreferrer">
                visit the game <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
          <div class="games-stop__media">
            <ArtifactSketch category="games" slug={santa.id} />
          </div>
        </section>

        <section id="games-snake" class="games-stop games-stop--snake" data-trail-stop aria-labelledby="games-snake-title">
          <div class="games-stop__media">
            <ArtifactSketch category="games" slug={snake.id} />
          </div>
          <div class="games-stop__copy">
            <span class="games-stop__number" aria-hidden="true">03</span>
            <h2 id="games-snake-title">{snake.data.title}</h2>
            <aside aria-label="Learned along this artifact">
              <p>Learned along an artifact</p>
              <ul>{snake.data.learnings.map((learning) => <li>{learning}</li>)}</ul>
            </aside>
            {snake.data.externalUrl && (
              <a class="games-stop__open" href={snake.data.externalUrl} rel="noreferrer">
                visit the artifact <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </section>

        <section id="games-tic-tac-toe" class="games-stop games-stop--tic-tac-toe" data-trail-stop aria-labelledby="games-tic-tac-toe-title">
          <div class="games-stop__copy">
            <span class="games-stop__number" aria-hidden="true">04</span>
            <h2 id="games-tic-tac-toe-title">{ticTacToe.data.title}</h2>
            <aside aria-label="Learned along this artifact">
              <p>Learned along an artifact</p>
              <ul>{ticTacToe.data.learnings.map((learning) => <li>{learning}</li>)}</ul>
            </aside>
            {ticTacToe.data.externalUrl && (
              <a class="games-stop__open" href={ticTacToe.data.externalUrl} rel="noreferrer">
                visit the artifact <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
          <div class="games-stop__media">
            <ArtifactSketch category="games" slug={ticTacToe.id} />
          </div>
        </section>
      </div>
    </UnfoldingTrail>
  </article>
</section>

<style>
  .games-disclosure {
    position: relative;
    z-index: 2;
    display: none;
    width: 100%;
    min-width: 0;
    color: var(--color-field-ink);
    isolation: isolate;
    pointer-events: none;
  }

  .games-disclosure[hidden] {
    display: none;
  }

  :global(spatial-route-shell:not([data-enhanced]) .games-disclosure:target),
  .games-disclosure:not([hidden]) {
    display: block;
  }

  .games-unfolding {
    --games-accent: #d98b7f;

    position: relative;
    pointer-events: auto;
  }

  .games-opening {
    position: relative;
    display: grid;
    min-height: max(48rem, calc(100vh - (2 * var(--field-gutter))));
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(8, minmax(0, 1fr));
    overflow: clip;
  }

  .games-opening__connections {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    width: 100%;
    height: max(48rem, calc(100vh - (2 * var(--field-gutter))));
    overflow: visible;
    pointer-events: none;
  }

  .games-opening__connection {
    fill: none;
    stroke: color-mix(in srgb, var(--games-accent) 60%, rgba(243, 239, 228, 0.35));
    stroke-dasharray: 0.016 0.024 0.07 0.026;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
    vector-effect: non-scaling-stroke;
  }

  .games-opening__piece {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .games-opening__title {
    display: grid;
    grid-column: 2 / 6;
    grid-row: 1 / 4;
    align-self: center;
    gap: 0.4rem;
    padding: clamp(1rem, 3vw, 3rem);
  }

  .games-opening__title p {
    width: fit-content;
    color: rgba(243, 239, 228, 0.6);
    transform: rotate(-2deg);
  }

  .games-opening__title h1 {
    font-family: var(--font-distinctive);
    font-size: clamp(3.8rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 0.9;
    transform: rotate(-1.7deg);
  }

  .games-opening__title h1:focus {
    outline: none;
  }

  .games-opening__resume {
    display: grid;
    width: min(100%, 17rem);
    grid-column: 7 / 10;
    grid-row: 1 / 3;
    align-self: center;
    gap: 0.7rem;
    padding: 1.1rem 0.5rem 0.5rem 1.1rem;
    border-top: 0.12rem dashed rgba(243, 239, 228, 0.36);
    transform: rotate(1deg);
  }

  .games-opening__resume > p {
    color: var(--games-accent);
    font-family: var(--font-distinctive);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .games-opening__resume > div {
    display: flex;
    gap: 1rem;
  }

  .games-opening__resume a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.25rem;
    text-underline-offset: 0.2em;
  }

  .games-opening__artifact {
    display: grid;
    grid-column: 2 / 11;
    grid-row: 4 / 9;
    grid-template-columns: minmax(18rem, 1.15fr) minmax(16rem, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: 0 clamp(1rem, 3vw, 3rem) clamp(1rem, 3vh, 2.5rem);
  }

  .games-opening__media {
    min-width: 0;
    transform: rotate(-1.3deg);
  }

  .games-opening__copy {
    display: grid;
    gap: 0.8rem;
    min-width: 0;
  }

  .games-opening__copy > span {
    width: fit-content;
    color: rgba(243, 239, 228, 0.45);
    transform: rotate(-7deg);
  }

  .games-opening__copy h2 {
    max-width: 17ch;
    font-family: var(--font-distinctive);
    font-size: clamp(2rem, 3.4vw, 3.3rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .games-opening__copy aside,
  .games-stop__copy aside {
    display: grid;
    gap: 0.5rem;
    max-width: 25rem;
    padding: 0.8rem 0 0 1rem;
    border-left: 0.11rem solid color-mix(in srgb, var(--games-accent) 68%, transparent);
  }

  .games-opening__copy aside > p,
  .games-stop__copy aside > p {
    color: var(--games-accent);
  }

  .games-opening__copy ul,
  .games-stop__copy ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.85rem;
    padding: 0;
    color: rgba(243, 239, 228, 0.72);
    list-style: none;
  }

  .games-opening__copy li::before,
  .games-stop__copy li::before {
    color: var(--games-accent);
    content: '·';
    margin-right: 0.35rem;
  }

  .games-opening__copy > a,
  .games-stop__open {
    display: inline-flex;
    width: fit-content;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-field-ink);
    text-underline-offset: 0.2em;
  }

  .games-trail {
    position: relative;
    display: grid;
    width: min(100%, 76rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(3rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
    margin-inline: auto;
    padding: 1rem clamp(1rem, 4vw, 4rem) 7rem;
  }

  .games-trail__spine {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    transform: none;
  }

  .games-trail__spine path {
    fill: none;
    stroke: color-mix(in srgb, var(--games-accent) 55%, rgba(243, 239, 228, 0.24));
    stroke-dasharray: 9 10 3 8;
    stroke-linecap: round;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .games-stop {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(3rem, 6vw, 5rem) clamp(0.75rem, 2vw, 1.5rem);
    scroll-margin-top: 2rem;
  }

  .games-stop__media {
    order: 1;
  }

  .games-stop__copy {
    order: 2;
  }

  .games-stop__copy {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .games-stop__number {
    width: fit-content;
    color: rgba(243, 239, 228, 0.45);
    transform: rotate(-8deg);
  }

  .games-stop h2 {
    max-width: 18ch;
    font-family: var(--font-distinctive);
    font-size: clamp(2rem, 3.5vw, 3.35rem);
    font-weight: 400;
    line-height: 1.06;
    transform: rotate(-0.8deg);
  }

  .games-stop__media {
    min-width: 0;
    transform-origin: center;
  }

  .games-stop--santa .games-stop__media {
    transform: rotate(1.5deg);
  }

  .games-stop--snake .games-stop__media {
    transform: rotate(-1.2deg);
  }

  .games-stop--tic-tac-toe .games-stop__media {
    transform: rotate(1deg);
  }

  :global(.js) unfolding-trail[data-enhanced] .games-stop__media {
    opacity: 0;
    clip-path: inset(0 0 0 100%);
    translate: 0 1rem;
  }

  :global(.js) unfolding-trail[data-enhanced] .games-stop--snake .games-stop__media {
    clip-path: inset(0 100% 0 0);
  }

  :global(.js) unfolding-trail[data-enhanced] .games-stop[data-revealed] .games-stop__media {
    opacity: 1;
    clip-path: inset(-10% -10% -10% -10%);
    translate: 0 0;
    transition:
      clip-path 560ms steps(7, end),
      opacity 180ms ease,
      translate 480ms cubic-bezier(0.18, 0.78, 0.25, 1);
  }

  :global(spatial-route-shell[data-entering]) .games-opening__piece {
    animation: games-piece-unfolds 540ms cubic-bezier(0.18, 0.78, 0.25, 1)
      var(--piece-delay) both;
  }

  :global(spatial-route-shell[data-entering]) .games-opening__connection {
    animation: games-line-draws 580ms steps(8, end) both;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(spatial-route-shell[data-entering]) .games-opening__connection--resume {
    animation-delay: 90ms;
  }

  :global(spatial-route-shell[data-entering]) .games-opening__connection--artifact {
    animation-delay: 170ms;
  }

  @keyframes games-piece-unfolds {
    from {
      opacity: 0;
      transform: translate(var(--piece-x), var(--piece-y)) rotate(-1deg) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(0) scale(1);
    }
  }

  @keyframes games-line-draws {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 64rem) {
    .games-opening {
      display: flex;
      min-height: calc(100vh - 1.75rem);
      flex-direction: column;
      gap: 3.5rem;
      padding: 7.25rem 1rem 4rem;
    }

    .games-opening__connections {
      display: none;
    }

    .games-opening__title,
    .games-opening__resume,
    .games-opening__artifact {
      width: min(100%, 42rem);
      max-width: 100%;
      align-self: center;
      padding: 0;
    }

    .games-opening__title {
      order: 1;
    }

    .games-opening__resume {
      order: 2;
      align-self: center;
    }

    .games-opening__artifact {
      order: 3;
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
    }

    .games-opening__media {
      width: min(100%, 34rem);
      margin-inline: auto;
    }

    .games-trail {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-inline: clamp(0.4rem, 3vw, 1.5rem);
    }

    .games-trail__spine {
      left: 1.25rem;
      width: 1rem;
      transform: none;
    }

    .games-stop {
      gap: 2.2rem;
      min-height: 0;
      padding: 4.5rem 1rem 3rem 1.5rem;
    }

    .games-stop__media {
      width: min(100%, 34rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 36rem) {
    .games-opening {
      gap: 3rem;
      padding-inline: 0.35rem;
    }

    .games-opening__title h1 {
      font-size: clamp(3.8rem, 22vw, 5.4rem);
    }

    .games-opening__copy h2,
    .games-stop h2 {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) unfolding-trail[data-enhanced] .games-stop__media,
    :global(.js) unfolding-trail[data-enhanced] .games-stop[data-revealed] .games-stop__media,
    :global(spatial-route-shell[data-entering]) .games-opening__piece,
    :global(spatial-route-shell[data-entering]) .games-opening__connection {
      animation-duration: 0.01ms;
      animation-delay: 0ms;
      transition-duration: 0.01ms;
    }
  }
</style>
