<unfolding-trail>
  <slot />
</unfolding-trail>

<script>
  class UnfoldingTrailElement extends HTMLElement {
    private observer?: IntersectionObserver;

    connectedCallback() {
      if (this.hasAttribute('data-enhanced')) return;

      const stops = this.querySelectorAll<HTMLElement>('[data-trail-stop]');
      if (stops.length === 0 || !('IntersectionObserver' in window)) return;

      this.setAttribute('data-enhanced', '');
      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).setAttribute('data-revealed', '');
            this.observer?.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.18 },
      );

      stops.forEach((stop) => this.observer?.observe(stop));
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('unfolding-trail')) {
    customElements.define('unfolding-trail', UnfoldingTrailElement);
  }
</script>

<style>
  unfolding-trail {
    display: block;
  }
</style>
