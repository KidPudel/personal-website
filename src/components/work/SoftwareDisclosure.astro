---
import { getCollection } from 'astro:content';

import { sitePath } from '../../config/site';
import ArtifactSketch from './ArtifactSketch.astro';
import UnfoldingTrail from './UnfoldingTrail.astro';

const order = ['flutter-product', 'chinese-bee', 'receipt-processing'];
const entries = (await getCollection('software'))
  .filter((entry) => order.includes(entry.id))
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const [flutterProduct, chineseBee, receiptProcessing] = entries;
---

<section
  id="work/software"
  class="software-disclosure"
  aria-labelledby="software-title"
  data-destination-disclosure
  data-destination-id="work/software"
  hidden
>
  <div class="software-unfolding">
    <svg
      class="software-opening__connections"
      viewBox="0 0 1200 760"
      preserveAspectRatio="none"
      aria-hidden="true"
      data-route-connections
    >
      <path class="software-opening__connection software-opening__connection--title" data-connection-to="software-title-piece" data-curve="-0.1" pathLength="1" d="M980 250 C840 225 650 210 450 250" />
      <path class="software-opening__connection software-opening__connection--resume" data-connection-to="software-resume" data-curve="0.12" pathLength="1" d="M980 250 C870 335 730 385 590 410" />
      <path class="software-opening__connection software-opening__connection--artifact" data-connection-to="software-first-artifact" data-curve="-0.08" pathLength="1" d="M980 250 C820 470 660 585 455 635" />
    </svg>

    <header class="software-opening">
      <div
        class="software-opening__title software-opening__piece"
        data-connection-target="software-title-piece"
        style="--piece-delay: 80ms; --piece-x: 4rem; --piece-y: 1rem;"
      >
        <p>work / software</p>
        <h1 id="software-title" tabindex="-1" data-destination-title>Software</h1>
        <p>My professional work and what I have learned from it.</p>
      </div>

      <aside
        class="software-opening__resume software-opening__piece"
        data-connection-target="software-resume"
        aria-labelledby="software-resume-label"
        style="--piece-delay: 150ms; --piece-x: 3rem; --piece-y: -2rem;"
      >
        <p id="software-resume-label">résumé</p>
        <div>
          <a href={sitePath('/resume/igor-kupchinenko-resume.pdf')} download>PDF</a>
          <a href={sitePath('/resume/igor-kupchinenko-resume.docx')} download>DOCX</a>
        </div>
      </aside>

      <section
        class="software-opening__artifact software-opening__piece"
        data-connection-target="software-first-artifact"
        aria-labelledby="software-flutter-title"
        style="--piece-delay: 220ms; --piece-x: 2rem; --piece-y: -3rem;"
      >
        <div class="software-opening__media">
          <ArtifactSketch category="software" slug={flutterProduct.id} />
        </div>
        <div class="software-opening__copy">
          <span aria-hidden="true">01</span>
          <h2 id="software-flutter-title">{flutterProduct.data.title}</h2>
          <aside aria-label="Learned along this artifact">
            <p>Learned along an artifact</p>
            <ul>{flutterProduct.data.capabilities.map((learning) => <li>{learning}</li>)}</ul>
          </aside>
        </div>
      </section>
    </header>

    <UnfoldingTrail>
      <div class="software-trail">
        <svg class="software-trail__spine" viewBox="0 0 1000 1600" preserveAspectRatio="none" aria-hidden="true">
          <path d="M500 8 C500 150 250 105 245 305 C240 505 753 380 756 610 C760 822 252 755 248 1010 C246 1230 472 1260 500 1592" pathLength="1" />
        </svg>

        <section id="software-chinese-bee" class="software-stop software-stop--bee" data-trail-stop aria-labelledby="software-bee-title">
          <div class="software-stop__copy">
            <span class="software-stop__number" aria-hidden="true">02</span>
            <h2 id="software-bee-title">{chineseBee.data.title}</h2>
            <aside aria-label="Learned along this artifact">
              <p>Learned along an artifact</p>
              <ul>{chineseBee.data.capabilities.map((learning) => <li>{learning}</li>)}</ul>
            </aside>
          </div>
          <div class="software-stop__media">
            <ArtifactSketch category="software" slug={chineseBee.id} />
          </div>
        </section>

        <section id="software-receipts" class="software-stop software-stop--receipts" data-trail-stop aria-labelledby="software-receipts-title">
          <div class="software-stop__media">
            <ArtifactSketch category="software" slug={receiptProcessing.id} />
          </div>
          <div class="software-stop__copy">
            <span class="software-stop__number" aria-hidden="true">03</span>
            <h2 id="software-receipts-title">{receiptProcessing.data.title}</h2>
            {receiptProcessing.data.result && <p class="software-stop__result">{receiptProcessing.data.result}</p>}
            <aside aria-label="Learned along this artifact">
              <p>Learned along an artifact</p>
              <ul>{receiptProcessing.data.capabilities.map((learning) => <li>{learning}</li>)}</ul>
            </aside>
          </div>
        </section>
      </div>
    </UnfoldingTrail>
  </div>
</section>

<style>
  .software-disclosure {
    position: relative;
    z-index: 2;
    display: none;
    width: 100%;
    min-width: 0;
    color: var(--color-field-ink);
    isolation: isolate;
    pointer-events: none;
  }

  .software-disclosure[hidden] {
    display: none;
  }

  .software-disclosure:target,
  .software-disclosure:not([hidden]) {
    display: block;
  }

  .software-unfolding {
    --software-accent: #86aebd;

    position: relative;
    display: block;
    pointer-events: auto;
  }

  .software-opening {
    position: relative;
    display: grid;
    min-height: max(48rem, calc(100vh - (2 * var(--field-gutter))));
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(8, minmax(0, 1fr));
    overflow: clip;
  }

  .software-opening__connections {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    width: 100%;
    height: max(48rem, calc(100vh - (2 * var(--field-gutter))));
    overflow: visible;
    pointer-events: none;
  }

  .software-opening__connection {
    fill: none;
    stroke: color-mix(in srgb, var(--software-accent) 55%, rgba(243, 239, 228, 0.4));
    stroke-dasharray: 0.018 0.026 0.075 0.026;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
    vector-effect: non-scaling-stroke;
  }

  .software-opening__piece {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .software-opening__title {
    display: grid;
    max-width: 34rem;
    grid-column: 2 / 7;
    grid-row: 1 / 4;
    align-self: center;
    gap: 0.55rem;
    padding-left: clamp(1rem, 3vw, 3rem);
  }

  .software-opening__title > p:first-child {
    width: fit-content;
    color: rgba(243, 239, 228, 0.6);
    transform: rotate(-2deg);
  }

  .software-opening__title h1 {
    font-family: var(--font-distinctive);
    font-size: clamp(3.5rem, 7vw, 6.6rem);
    font-weight: 400;
    line-height: 0.9;
    transform: rotate(-1.5deg);
  }

  .software-opening__title h1:focus {
    outline: none;
  }

  .software-opening__title > p:last-child {
    max-width: 34ch;
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.5;
  }

  .software-opening__resume {
    display: grid;
    width: min(100%, 17rem);
    grid-column: 7 / 10;
    grid-row: 1 / 3;
    align-self: center;
    gap: 0.7rem;
    padding: 1.1rem 0.5rem 0.5rem 1.1rem;
    border-top: 0.12rem dashed rgba(243, 239, 228, 0.36);
    transform: rotate(1deg);
  }

  .software-opening__resume > p {
    color: var(--software-accent);
    font-family: var(--font-distinctive);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .software-opening__resume > div {
    display: flex;
    gap: 1rem;
  }

  .software-opening__resume a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.25rem;
    text-underline-offset: 0.2em;
  }

  .software-opening__artifact {
    display: grid;
    grid-column: 2 / 11;
    grid-row: 4 / 9;
    grid-template-columns: minmax(18rem, 1.15fr) minmax(16rem, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: 0 clamp(1rem, 3vw, 3rem) clamp(1rem, 3vh, 2.5rem);
  }

  .software-opening__media {
    min-width: 0;
    transform: rotate(-1.3deg);
  }

  .software-opening__copy {
    display: grid;
    gap: 0.8rem;
    min-width: 0;
  }

  .software-opening__copy > span {
    width: fit-content;
    color: rgba(243, 239, 228, 0.45);
    transform: rotate(-7deg);
  }

  .software-opening__copy h2 {
    max-width: 17ch;
    font-family: var(--font-distinctive);
    font-size: clamp(2rem, 3.4vw, 3.3rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .software-trail {
    position: relative;
    display: grid;
    width: min(100%, 76rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(3rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
    margin-inline: auto;
    padding: 2rem clamp(1rem, 4vw, 4rem) 7rem;
  }

  .software-trail__spine {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    transform: none;
  }

  .software-trail__spine path {
    fill: none;
    stroke: color-mix(in srgb, var(--software-accent) 54%, rgba(243, 239, 228, 0.24));
    stroke-dasharray: 8 11 2 8;
    stroke-linecap: round;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .software-stop {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(3rem, 6vw, 5rem) clamp(0.75rem, 2vw, 1.5rem);
    scroll-margin-top: 2rem;
  }

  .software-stop__media {
    order: 1;
  }

  .software-stop__copy {
    order: 2;
  }

  .software-stop__copy {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .software-stop__number {
    width: fit-content;
    color: rgba(243, 239, 228, 0.45);
    transform: rotate(-8deg);
  }

  .software-stop h2 {
    max-width: 18ch;
    font-family: var(--font-distinctive);
    font-size: clamp(2rem, 3.5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.06;
    transform: rotate(-0.8deg);
  }

  .software-opening__copy aside,
  .software-stop__copy aside {
    display: grid;
    gap: 0.55rem;
    max-width: 24rem;
    padding: 0.85rem 0 0 1.1rem;
    border-left: 0.11rem solid color-mix(in srgb, var(--software-accent) 68%, transparent);
  }

  .software-opening__copy aside > p,
  .software-stop__copy aside > p {
    color: var(--software-accent);
  }

  .software-opening__copy ul,
  .software-stop__copy ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    padding: 0;
    color: rgba(243, 239, 228, 0.72);
    list-style: none;
  }

  .software-opening__copy li::before,
  .software-stop__copy li::before {
    color: var(--software-accent);
    content: '·';
    margin-right: 0.35rem;
  }

  .software-stop__result {
    max-width: 26ch;
    color: var(--software-accent);
    font-family: var(--font-distinctive);
    font-size: clamp(1.55rem, 2.7vw, 2.4rem);
    line-height: 1.08;
  }

  .software-stop__media {
    position: relative;
    min-width: 0;
    transform-origin: center;
  }

  .software-stop--bee .software-stop__media {
    transform: rotate(1.2deg);
  }

  .software-stop--receipts .software-stop__media {
    transform: rotate(-1deg);
  }

  :global(.js) unfolding-trail[data-enhanced] .software-stop__media {
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    translate: 0 1rem;
  }

  :global(.js) unfolding-trail[data-enhanced] .software-stop[data-revealed] .software-stop__media {
    opacity: 1;
    clip-path: inset(-10% -10% -10% -10%);
    translate: 0 0;
    transition:
      clip-path 560ms steps(7, end),
      opacity 180ms ease,
      translate 480ms cubic-bezier(0.18, 0.78, 0.25, 1);
  }

  :global(spatial-route-shell[data-entering]) .software-opening__piece {
    animation: software-piece-unfolds 520ms cubic-bezier(0.18, 0.78, 0.25, 1)
      var(--piece-delay) both;
  }

  :global(spatial-route-shell[data-entering]) .software-opening__connection {
    animation: software-line-draws 580ms steps(8, end) both;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(spatial-route-shell[data-entering]) .software-opening__connection--resume {
    animation-delay: 100ms;
  }

  :global(spatial-route-shell[data-entering]) .software-opening__connection--artifact {
    animation-delay: 190ms;
  }

  @keyframes software-piece-unfolds {
    from {
      opacity: 0;
      transform: translate(var(--piece-x), var(--piece-y)) rotate(1deg) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(0) scale(1);
    }
  }

  @keyframes software-line-draws {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 64rem) {
    .software-opening {
      display: flex;
      min-height: calc(100vh - 1.75rem);
      flex-direction: column;
      gap: 3rem;
      padding: 7.25rem 1rem 3.5rem;
    }

    .software-opening__connections {
      display: none;
    }

    .software-opening__title,
    .software-opening__resume,
    .software-opening__artifact {
      width: min(100%, 42rem);
      max-width: 100%;
      align-self: center;
      padding-inline: 0;
      margin: 0;
    }

    .software-opening__title {
      order: 1;
    }

    .software-opening__resume {
      order: 2;
      align-self: center;
    }

    .software-opening__artifact {
      order: 3;
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
    }

    .software-opening__media {
      width: min(100%, 34rem);
      margin-inline: auto;
    }

    .software-trail {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-inline: clamp(0.4rem, 3vw, 1.5rem);
    }

    .software-trail__spine {
      left: 1.25rem;
      width: 1rem;
      transform: none;
    }

    .software-stop {
      gap: 2.2rem;
      min-height: 0;
      padding: 4.5rem 1rem 3rem 1.5rem;
    }

    .software-stop__media {
      width: min(100%, 34rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 36rem) {
    .software-opening {
      gap: 2.5rem;
      padding-inline: 0.35rem;
    }

    .software-opening__title h1 {
      font-size: clamp(3.4rem, 20vw, 5.3rem);
    }

    .software-opening__copy h2,
    .software-stop h2 {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) unfolding-trail[data-enhanced] .software-stop__media,
    :global(.js) unfolding-trail[data-enhanced] .software-stop[data-revealed] .software-stop__media,
    :global(spatial-route-shell[data-entering]) .software-opening__piece,
    :global(spatial-route-shell[data-entering]) .software-opening__connection {
      animation-duration: 0.01ms;
      animation-delay: 0ms;
      transition-duration: 0.01ms;
    }
  }
</style>
