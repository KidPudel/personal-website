---
import type { CollectionEntry } from 'astro:content';

import openBox from '../../../assets/art/Doodles-box-opening/box_frame7.png';
import { sitePath } from '../../../config/site';
import WorkMedia from '../../homepage/WorkMedia.astro';

interface Props {
  observatory: CollectionEntry<'software'>;
  foodProduct: CollectionEntry<'software'>;
  chineseBee: CollectionEntry<'software'>;
}

const { observatory, foodProduct, chineseBee } = Astro.props;
const projects = [
  { name: 'Observatory', label: 'macOS product · 2026', href: '/case-studies/observatory/', slug: 'observatory', entry: observatory },
  { name: 'SuperGood', label: 'Food delivery · 2024', href: '/case-studies/supergood/', slug: 'flutter-product', entry: foodProduct },
  { name: 'Two Sticks', label: 'Learning product · 2024', href: '/case-studies/two-sticks/', slug: 'chinese-bee', entry: chineseBee },
];
---

<section class="equal-frames" aria-labelledby="equal-frames-title">
  <header>
    <p>Product design</p>
    <h1 id="equal-frames-title">Selected work</h1>
    <span>Three case studies I can present most clearly.</span>
  </header>

  <img class="equal-frames__box" src={openBox.src} alt="" width="150" height="150" loading="lazy" decoding="async" />

  <div class="equal-frames__grid">
    {projects.map((project) => (
      <article>
        <a class="equal-frames__media" href={sitePath(project.href)} aria-label={`Read the ${project.name} case study`}>
          <WorkMedia slug={project.slug} />
        </a>
        <p>{project.label}</p>
        <h2><a href={sitePath(project.href)}>{project.name}</a></h2>
        <span>{project.entry.data.summary}</span>
        <a class="equal-frames__link" href={sitePath(project.href)}>Case study</a>
      </article>
    ))}
  </div>
</section>

<style>
  .equal-frames {
    width: min(100%, 82rem);
    margin-inline: auto;
    padding: clamp(4rem, 9vw, 7rem) clamp(1.25rem, 4vw, 3.5rem) 8rem;
  }

  header {
    text-align: center;
  }

  header p,
  header span {
    margin: 0;
    color: var(--color-muted);
  }

  header p {
    font-family: var(--font-special);
    font-size: 0.92rem;
  }

  h1 {
    margin: 0.1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.7rem);
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  header span {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.95rem;
  }

  .equal-frames__box {
    display: block;
    width: 7rem;
    height: 7rem;
    margin: 1.5rem auto 1rem;
    object-fit: contain;
  }

  .equal-frames__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: start;
  }

  article {
    min-width: 0;
  }

  .equal-frames__media {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  article > p {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  h2 {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  article > span {
    display: block;
    margin-top: 0.7rem;
    color: var(--color-copy);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .equal-frames__link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-ink);
    font-size: 0.8rem;
    text-decoration-style: dotted;
    text-underline-offset: 0.25rem;
  }

  @media (max-width: 48rem) {
    .equal-frames__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    article {
      width: min(100%, 31rem);
      margin-inline: auto;
    }
  }
</style>
