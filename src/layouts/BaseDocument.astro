---
import '../styles/foundations.css';
import '../styles/composition.css';
import '../styles/motion.css';

import aleoURL from '../assets/fonts/Aleo-Regular.ttf?url';

interface Props {
  title: string;
  description: string;
  pageClass?: string;
  themeColor?: string;
  ogImage?: string;
  robots?: string;
}

const { title, description, pageClass, themeColor = '#F8F8F8', ogImage, robots } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : undefined;
const faviconURL = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang="en" class={pageClass}>
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      if (
        location.hash ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('opening-bypassed');
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content={themeColor} />
    <link rel="preload" href={aleoURL} as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href={faviconURL} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
