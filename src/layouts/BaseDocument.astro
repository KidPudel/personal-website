---
import '../styles/foundations.css';
import '../styles/composition.css';
import '../styles/motion.css';

import aleoURL from '../assets/fonts/Aleo-Regular.ttf?url';

interface Props {
  title: string;
  description: string;
  pageClass?: string;
  themeColor?: string;
  ogImage?: string;
  robots?: string;
  canonicalPath?: string;
}

const { title, description, pageClass, themeColor = '#F8F8F8', ogImage, robots, canonicalPath } = Astro.props;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : undefined;
const faviconURL = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang="en" class={pageClass}>
  <head>
    <script is:inline>
      const skipTargetRequested = location.hash === '#main-content';

      document.documentElement.classList.add('js');
      if (
        location.hash ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('opening-bypassed');
      }

      if (skipTargetRequested) {
        history.replaceState(history.state, '', `${location.pathname}${location.search}`);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content={themeColor} />
    <link rel="preload" href={aleoURL} as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href={faviconURL} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <script is:inline>
      const skipLink = document.querySelector('.skip-link');
      const mainContent = document.getElementById('main-content');

      const focusMainContent = () => {
        if (!mainContent) return;

        const hadTabIndex = mainContent.hasAttribute('tabindex');
        if (!hadTabIndex) mainContent.setAttribute('tabindex', '-1');

        mainContent.focus({ preventScroll: true });
        mainContent.scrollIntoView({ block: 'start' });

        if (!hadTabIndex) {
          mainContent.addEventListener('blur', () => mainContent.removeAttribute('tabindex'), {
            once: true,
          });
        }
      };

      skipLink?.addEventListener('click', (event) => {
        if (!mainContent) return;
        event.preventDefault();
        history.replaceState(history.state, '', `${location.pathname}${location.search}`);
        requestAnimationFrame(focusMainContent);
      });

      if (skipTargetRequested) requestAnimationFrame(focusMainContent);
    </script>
  </body>
</html>
