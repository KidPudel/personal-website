---
import '../styles/foundations.css';
import '../styles/composition.css';
import '../styles/motion.css';

import instrumentSansURL from '../assets/fonts/InstrumentSans-Regular.ttf?url';
import PortfolioHeader from '../components/homepage/PortfolioHeader.astro';
import ReadingProgress from '../components/case-studies/ReadingProgress.astro';
import {
  defaultLocale,
  localeDetails,
  localePath,
  localeStorageKey,
  locales,
  neutralPath,
  toLocale,
  translator,
} from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  pageClass?: string;
  themeColor?: string;
  ogImage?: string;
  robots?: string;
  canonicalPath?: string;
  /** False for documents that exist in one shared version, such as the 404 page. */
  translated?: boolean;
}

const {
  title,
  description,
  pageClass,
  themeColor = '#F8F8F8',
  ogImage,
  robots,
  canonicalPath,
  translated = true,
} = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const pagePath = neutralPath(canonicalPath ?? Astro.url.pathname);
const alternates = translated
  ? locales.map((alternateLocale) => ({
      locale: alternateLocale,
      href: new URL(localePath(pagePath, alternateLocale), Astro.site).href,
    }))
  : [];
// English pages send visitors whose system prefers Russian to the Russian page,
// unless they chose a language with the switcher.
const russianPath = translated && locale === defaultLocale ? localePath(pagePath, 'ru') : undefined;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
// Individual case studies get the section index; the case-studies listing does not.
const showReadingProgress = /\/case-studies\/[^/]+\//.test(Astro.url.pathname);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : undefined;
// The homepage and the case studies open into each other: a work card grows into its study's
// opening, and the study shrinks back into the card on the way home (see the script below).
const isHome = pagePath === '/';
const opensIntoStudy = isHome || showReadingProgress;
// The new page holds its first paint until the element it morphs into has been parsed.
const renderAfter = isHome ? '#side-projects' : '#summary';
const faviconURL = `${import.meta.env.BASE_URL}favicon.svg`;
const appleTouchIconURL = `${import.meta.env.BASE_URL}apple-touch-icon.png`;
---

<!doctype html>
<html lang={locale} class={pageClass} data-base={import.meta.env.BASE_URL}>
  <head>
    {russianPath && (
      <script is:inline define:vars={{ russianPath, localeStorageKey }}>
        let chosenLocale = null;
        try {
          chosenLocale = localStorage.getItem(localeStorageKey);
        } catch {}
        const systemLanguages = navigator.languages?.length ? navigator.languages : [navigator.language ?? ''];
        const systemLocale = systemLanguages
          .map((language) => language.toLowerCase().split('-')[0])
          .find((language) => language === 'ru' || language === 'en');

        if ((chosenLocale ?? systemLocale) === 'ru') {
          try {
            sessionStorage.setItem('locale-redirect', russianPath);
          } catch {}
          location.replace(`${russianPath}${location.search}${location.hash}`);
        }
      </script>
    )}
    <script is:inline>
      const skipTargetRequested = location.hash === '#main-content';
      const navigationType = performance.getEntriesByType('navigation')[0]?.type;
      // A system-language redirect is still the visitor's first arrival.
      const arrivedByLocaleRedirect = (() => {
        try {
          if (sessionStorage.getItem('locale-redirect') !== location.pathname) return false;
          sessionStorage.removeItem('locale-redirect');
          return true;
        } catch {
          return false;
        }
      })();
      const siteBase = document.documentElement.dataset.base ?? '/';
      const arrivedFromSite = (() => {
        try {
          const referrer = new URL(document.referrer);
          return referrer.origin === location.origin && referrer.pathname.startsWith(siteBase);
        } catch {
          return false;
        }
      })();
      const returningWithinSite =
        !arrivedByLocaleRedirect &&
        (navigationType === 'back_forward' || (navigationType !== 'reload' && arrivedFromSite));

      document.documentElement.classList.add('js');
      if (
        location.hash ||
        returningWithinSite ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('greeting-settled');
      }

      if (skipTargetRequested) {
        history.replaceState(history.state, '', `${location.pathname}${location.search}`);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {opensIntoStudy && <link rel="expect" href={renderAfter} blocking="render" />}
    {opensIntoStudy && (
      <script is:inline>
        // A work card and the case study it opens are one object across the two pages: the
        // card's panel and the study's opening carry data-study-transition with the study's slug,
        // and are named only for a navigation between the homepage and that study. If the element
        // is off screen (the reader scrolled deep into a study before going back), it isn't named,
        // and the pages simply crossfade.
        (() => {
          const base = document.documentElement.dataset.base ?? '/';
          const pathOf = (url) => new URL(url, location.href).pathname;
          const isHome = (url) => [base, `${base}ru/`].includes(pathOf(url));
          const studyOf = (url) => pathOf(url).match(/\/case-studies\/([^/]+)\/?$/)?.[1] ?? null;
          const slugFor = (here, there) =>
            isHome(here) ? studyOf(there) : isHome(there) ? studyOf(here) : null;

          const name = (slug, transition) => {
            const element = slug && document.querySelector(`[data-study-transition="${slug}"]`);
            if (!element) return;
            const box = element.getBoundingClientRect();
            if (box.bottom < 0 || box.top > innerHeight) return;
            element.style.viewTransitionName = `study-${slug}`;
            element.style.viewTransitionClass = 'study';
            transition.finished.finally(() => {
              element.style.viewTransitionName = '';
              element.style.viewTransitionClass = '';
            });
          };

          addEventListener('pageswap', (event) => {
            const to = event.activation?.entry?.url;
            if (event.viewTransition && to) name(slugFor(location.href, to), event.viewTransition);
          });
          addEventListener('pagereveal', (event) => {
            const from = window.navigation?.activation?.from?.url;
            if (event.viewTransition && from) name(slugFor(location.href, from), event.viewTransition);
          });
        })();
      </script>
    )}
    {opensIntoStudy && (
      <style is:inline>
        @view-transition {
          navigation: auto;
        }

        /* The page around the work crossfades; the work itself travels. */
        ::view-transition-old(root) {
          animation: 200ms cubic-bezier(0.23, 1, 0.32, 1) both study-page-out;
        }

        ::view-transition-new(root) {
          animation: 360ms cubic-bezier(0.23, 1, 0.32, 1) 120ms both study-page-in;
        }

        ::view-transition-group(*.study) {
          animation-duration: 620ms;
          animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
        }

        /* Both pictures fill the travelling box, so neither stretches as it changes shape. */
        ::view-transition-old(*.study),
        ::view-transition-new(*.study) {
          height: 100%;
          object-fit: cover;
          animation-duration: 620ms;
          animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
        }

        @keyframes study-page-out {
          to { opacity: 0; }
        }

        @keyframes study-page-in {
          from { opacity: 0; }
        }

        @media (prefers-reduced-motion: reduce) {
          ::view-transition-group(*),
          ::view-transition-old(*),
          ::view-transition-new(*) {
            animation-duration: 0s !important;
            animation-delay: 0s !important;
          }

          ::view-transition-old(root) {
            animation: 160ms linear both study-page-out !important;
          }

          ::view-transition-new(root) {
            animation: 160ms linear both study-page-in !important;
          }
        }
      </style>
    )}
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content={themeColor} />
    <link rel="preload" href={instrumentSansURL} as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href={faviconURL} />
    <link rel="apple-touch-icon" href={appleTouchIconURL} />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates.find((alternate) => alternate.locale === defaultLocale)?.href} />
    )}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeDetails[locale].ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t('Skip to main content', 'Перейти к основному содержанию')}</a>
    <PortfolioHeader
      showHome={/\/(case-studies|blog)\//.test(Astro.url.pathname)}
      alternatePath={translated ? pagePath : undefined}
    />
    <slot />
    {showReadingProgress && <ReadingProgress />}
    <script is:inline>
      const skipLink = document.querySelector('.skip-link');
      const mainContent = document.getElementById('main-content');

      const focusMainContent = () => {
        if (!mainContent) return;

        const hadTabIndex = mainContent.hasAttribute('tabindex');
        if (!hadTabIndex) mainContent.setAttribute('tabindex', '-1');

        mainContent.focus({ preventScroll: true });
        mainContent.scrollIntoView({ block: 'start' });

        if (!hadTabIndex) {
          mainContent.addEventListener('blur', () => mainContent.removeAttribute('tabindex'), {
            once: true,
          });
        }
      };

      skipLink?.addEventListener('click', (event) => {
        if (!mainContent) return;
        event.preventDefault();
        history.replaceState(history.state, '', `${location.pathname}${location.search}`);
        requestAnimationFrame(focusMainContent);
      });

      if (skipTargetRequested) requestAnimationFrame(focusMainContent);
    </script>
    <script is:inline>
      const connection = navigator.connection;
      const conserveData = Boolean(
        connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? ''),
      );
      const approachMargin = conserveData ? '25% 0px' : '80% 0px';

      if ('IntersectionObserver' in window) {
        const imageObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const image = entry.target;
              image.loading = 'eager';
              void image.decode().catch(() => undefined);
              observer.unobserve(image);
            });
          },
          { rootMargin: approachMargin },
        );

        document.querySelectorAll('img[loading="lazy"]').forEach((image) => {
          imageObserver.observe(image);
        });

        const videoObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const video = entry.target;
              video.preload = conserveData ? 'metadata' : 'auto';
              video.load();
              observer.unobserve(video);
            });
          },
          { rootMargin: conserveData ? '15% 0px' : '50% 0px' },
        );

        document.querySelectorAll('video[data-deferred-media]').forEach((video) => {
          videoObserver.observe(video);
        });
      }
    </script>
  </body>
</html>
