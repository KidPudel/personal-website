---
import Homepage from '../components/homepage/Homepage.astro';
import homepageShareImage from '../assets/showcase-cards/card2.png';
import { toLocale, translator } from '../i18n/locales';
import BaseDocument from '../layouts/BaseDocument.astro';

const t = translator(toLocale(Astro.currentLocale));
---

<BaseDocument
  title={t('Igor Kupchinenko · Product Designer', 'Игорь Купчиненко · Продуктовый дизайнер')}
  description={t(
    'Product designer Igor Kupchinenko looks for where things don’t fit how people behave, designs interactions from how people’s minds work, and builds what he designs.',
    'Продуктовый дизайнер Игорь Купчиненко ищет места, где устройство вещей расходится с поведением людей, проектирует взаимодействия, отталкиваясь от того, как люди думают, и сам собирает то, что проектирует.',
  )}
  pageClass="composition-document homepage-document"
  themeColor="#F8F8F8"
  ogImage={homepageShareImage.src}
>
  <Homepage />
</BaseDocument>
