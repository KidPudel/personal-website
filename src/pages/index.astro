---
import { getEntry } from 'astro:content';

import Homepage from '../components/homepage/Homepage.astro';
import homepageShareImage from '../assets/software-showcases/observatory/launch-film.png';
import BaseDocument from '../layouts/BaseDocument.astro';

const observatory = await getEntry('software', 'observatory');
const foodProduct = await getEntry('software', 'flutter-product');
const chineseBee = await getEntry('software', 'chinese-bee');

if (!observatory || !foodProduct || !chineseBee) {
  throw new Error('The homepage content entries could not be loaded.');
}
---

<BaseDocument
  title="Igor Kupchinenko · Product Designer"
  description="Product designer Igor Kupchinenko creates interactive products and the systems that make them real."
  pageClass="composition-document homepage-document"
  themeColor="#F8F8F8"
  ogImage={homepageShareImage.src}
>
  <Homepage {observatory} {foodProduct} {chineseBee} />
</BaseDocument>
