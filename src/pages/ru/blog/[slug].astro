---
import OldBlogRedirect from '../../../components/blog/OldBlogRedirect.astro';
import { getWriting } from '../../../lib/writing';

export async function getStaticPaths() {
  const posts = await getWriting('ru');
  return posts.filter((post) => !post.entry.data.externalUrl).map((post) => ({ params: { slug: post.slug } }));
}
---

<OldBlogRedirect locale="ru" slug={Astro.params.slug} />
