---
import SecretBoxSequence from '../components/secret-box/SecretBoxSequence.astro';
import WorldField from '../components/shell/WorldField.astro';
import BaseDocument from '../layouts/BaseDocument.astro';
---

<BaseDocument
  title="Secret box | Igor Kupchinenko"
  description="Open the secret box."
>
  <WorldField doodles={false}>
    <main id="main-content">
      <h1 class="secret-box-title">Secret box</h1>
      <SecretBoxSequence />
    </main>
  </WorldField>
</BaseDocument>

<style>
  .secret-box-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
