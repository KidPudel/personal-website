---
import SecretBoxSequence from '../components/secret-box/SecretBoxSequence.astro';
import WorldField from '../components/shell/WorldField.astro';
import BaseDocument from '../layouts/BaseDocument.astro';
---

<BaseDocument
  title="Secret box | Igor Kupchinenko"
  description="Open the secret box."
  pageClass="secret-box-page"
>
  <WorldField doodles={false}>
    <main id="main-content">
      <h1 class="secret-box-title">Secret box</h1>
      <SecretBoxSequence />
    </main>
  </WorldField>
</BaseDocument>

<style>
  .secret-box-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<style is:global>
  html.secret-box-page {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  html.secret-box-page body {
    height: 100vh;
    min-height: 0;
    overflow: hidden;
    overscroll-behavior: none;
    background: transparent;
  }

  html.secret-box-page .world-field {
    height: 100vh;
    min-height: 0;
  }

  html.secret-box-page .world-field__content,
  html.secret-box-page main {
    height: 100%;
    min-height: 0;
  }

  @supports (height: 100dvh) {
    html.secret-box-page body,
    html.secret-box-page .world-field {
      height: 100dvh;
    }
  }
</style>
