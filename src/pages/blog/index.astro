---
import { getEntry } from 'astro:content';

import PortfolioHeader from '../../components/homepage/PortfolioHeader.astro';
import WritingPreview from '../../components/homepage/WritingPreview.astro';
import BaseDocument from '../../layouts/BaseDocument.astro';

const identityCage = await getEntry('writing', 'identity-cage');

if (!identityCage) {
  throw new Error('The writing page content entries could not be loaded.');
}
---

<BaseDocument
  title="Writing · Igor Kupchinenko"
  description="Writing by Igor Kupchinenko."
  pageClass="composition-document"
  themeColor="#F8F8F8"
>
  <div class="writing-page">
    <PortfolioHeader current="work" />
    <main id="main-content">
      <WritingPreview {identityCage} />
    </main>
  </div>
</BaseDocument>

<style>
  .writing-page {
    min-width: 20rem;
    overflow-x: clip;
    background: var(--color-field);
    color: var(--color-ink);
    font-family: var(--font-reading);
    font-size: clamp(0.95rem, 0.12vw + 0.93rem, 1.02rem);
    line-height: 1.62;
  }
</style>
