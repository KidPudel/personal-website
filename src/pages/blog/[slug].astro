---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import PortfolioHeader from '../../components/homepage/PortfolioHeader.astro';
import { sitePath } from '../../config/site';
import BaseDocument from '../../layouts/BaseDocument.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const publishedAt = entry.data.publishedAt?.toLocaleDateString('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseDocument
  title={`${entry.data.title} | Igor Kupchinenko`}
  description={entry.data.summary}
  pageClass="composition-document"
>
  <div class="article-page">
    <PortfolioHeader current="home" />
    <main id="main-content" class="article-main">
      <article class="writing-article" aria-labelledby="article-title">
        <a class="writing-article__back" href={sitePath('/')}>Back to Igor</a>

        <header>
          {publishedAt && <time datetime={entry.data.publishedAt?.toISOString()}>{publishedAt}</time>}
          <h1 id="article-title">{entry.data.title}</h1>
          <p>{entry.data.summary}</p>
        </header>

        <div class="writing-article__body">
          <Content />
        </div>

        {entry.data.canonicalUrl && (
          <footer>
            <a href={entry.data.canonicalUrl}>Originally published on Medium ↗</a>
          </footer>
        )}
      </article>
    </main>
  </div>
</BaseDocument>

<style>
  .article-page {
    min-width: 20rem;
    background: var(--color-field);
    color: var(--color-ink);
    font-family: var(--font-reading);
  }

  .article-main {
    width: min(100%, 62rem);
    margin-inline: auto;
  }

  .writing-article {
    min-height: 100svh;
    padding: clamp(5.5rem, 10vw, 8rem) clamp(1.25rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
  }

  .writing-article__back {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-muted);
    text-underline-offset: 0.24em;
  }

  .writing-article header {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .writing-article time {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .writing-article h1 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .writing-article header p {
    max-width: 58ch;
    margin: 0;
    color: var(--color-copy);
    font-size: clamp(1.08rem, 1.9vw, 1.28rem);
    line-height: 1.65;
  }

  .writing-article__body {
    max-width: var(--reading-width);
    font-size: clamp(1.05rem, 1.6vw, 1.18rem);
    line-height: 1.78;
  }

  .writing-article__body :global(> * + *) {
    margin-top: 1.35em;
  }

  .writing-article__body :global(h2),
  .writing-article__body :global(h3) {
    margin-top: 2.4em;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.12;
  }

  .writing-article__body :global(h2) {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
  }

  .writing-article__body :global(h3) {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }

  .writing-article__body :global(a),
  .writing-article footer a {
    color: inherit;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 0.24em;
  }

  .writing-article__body :global(blockquote) {
    position: relative;
    margin-block: 2rem;
    padding-left: clamp(1.25rem, 3vw, 2rem);
    color: var(--color-copy);
  }

  .writing-article__body :global(blockquote)::before {
    position: absolute;
    top: 0.1rem;
    bottom: 0.1rem;
    left: 0;
    width: 0.12rem;
    background: rgba(17, 17, 15, 0.42);
    content: '';
  }

  .writing-article__body :global(ul),
  .writing-article__body :global(ol) {
    padding-left: 1.4em;
  }

  .writing-article footer {
    max-width: var(--reading-width);
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: 1.5rem;
  }
</style>
