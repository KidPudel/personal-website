---
import BaseDocument from '../layouts/BaseDocument.astro';
import { sitePath } from '../config/site';
---

<BaseDocument
  title="Page not found | Igor Kupchinenko"
  description="The requested page could not be found. Return to Igor Kupchinenko’s product design work."
  pageClass="composition-document"
  themeColor="#F8F8F8"
  robots="noindex"
  translated={false}
>
  <main id="main-content" class="not-found">
    <p>404</p>
    <h1>This page wandered off.</h1>
    <a href={sitePath('/')}>Back to Igor</a>
    <p class="not-found__translation" lang="ru">Эта страница куда-то ушла.</p>
    <a href={sitePath('/ru/')} lang="ru" hreflang="ru">Вернуться к Игорю</a>
  </main>
</BaseDocument>

<style>
  .not-found {
    display: grid;
    min-height: 100svh;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    padding: clamp(1.5rem, 6vw, 7rem);
    background: var(--color-field);
    color: var(--color-ink);
  }

  .not-found p,
  .not-found h1 {
    margin: 0;
  }

  .not-found p,
  .not-found a {
    font-family: var(--font-reading);
  }

  .not-found h1 {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .not-found .not-found__translation {
    margin-top: 1rem;
    font-size: 1.25rem;
  }

  .not-found a {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-style: var(--link-line-style);
    text-decoration-color: var(--link-line-color);
    text-decoration-thickness: var(--link-line-width);
    text-underline-offset: var(--link-line-offset);
  }

  .not-found a:is(:hover, :focus-visible) {
    text-decoration-color: var(--link-line-color-active);
  }
</style>
