    font-family: 'Capriola';
    src: url('../../../assets/fonts/Capriola-Regular.ttf') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Crimson Text';
    src: url('../../../assets/fonts/CrimsonText-Regular.ttf') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Crimson Text';
    src: url('../../../assets/fonts/CrimsonText-Italic.ttf') format('truetype');
    font-style: italic;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Crimson Text';
    src: url('../../../assets/fonts/CrimsonText-SemiBold.ttf') format('truetype');
    font-style: normal;
    font-weight: 600;
    font-display: swap;
  }

  @font-face {
    font-family: 'Crimson Text';
    src: url('../../../assets/fonts/CrimsonText-Bold.ttf') format('truetype');
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }

  @font-face {
    font-family: 'Averia Serif Libre';
    src: url('../../../assets/fonts/AveriaSerifLibre-Bold.ttf') format('truetype');
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }

  html.supergood-case-study {
    --paper: #fbf6ee;
    --soft-paper: #f3ebe0;
    --ink: #1c1914;
    --muted: #6f675c;
    --line: #d9cfc0;
    --accent: #b4530a;
    --serif: 'Crimson Text', Georgia, serif;
    --display-serif: 'Averia Serif Libre', 'Iowan Old Style', Georgia, serif;
    --sans: 'Capriola', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    --reading-size: clamp(18px, 1.45vw, 20px);
    --reading-line: 1.6;
    color-scheme: light;
    scroll-behavior: smooth;
    background: var(--paper);
  }

  html.supergood-case-study body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.58;
    text-rendering: optimizeLegibility;
  }

  html.supergood-case-study * { box-sizing: border-box; }
  html.supergood-case-study img { display: block; width: 100%; height: auto; }
  html.supergood-case-study ::selection { background: var(--accent); color: var(--paper); }
  html.supergood-case-study a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.22em; }
  html.supergood-case-study a:hover { color: var(--accent); }
  html.supergood-case-study :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  html.supergood-case-study .skip-link { background: var(--ink); color: var(--paper); }

  .topbar,
  main,
  .case-footer {
    width: min(100% - 48px, 1440px);
    margin-inline: auto;
  }

