---
import { Image } from 'astro:assets';

import penCircle from '../../../assets/art/elements/circled.png';
import basket from '../../../assets/case_study_images/supergood/basket.png';
import checkoutHero from '../../../assets/case_study_images/supergood/checkout-hero.png';
import dishSheetDark from '../../../assets/case_study_images/supergood/dish-sheet-dark.png';
import history from '../../../assets/case_study_images/supergood/history.png';
import deliveryMap from '../../../assets/case_study_images/supergood/map.png';
import menuDark from '../../../assets/case_study_images/supergood/menu-dark.png';
import menuLight from '../../../assets/case_study_images/supergood/menu-light.png';
import menuHero from '../../../assets/case_study_images/supergood/menu-light-hero.png';
import dishHero from '../../../assets/case_study_images/supergood/dish-sheet-light-hero.png';
import orderTracking from '../../../assets/case_study_images/supergood/order-tracking.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import Cover from '../../../components/case-studies/Cover.astro';
import Decision from '../../../components/case-studies/Decision.astro';
import Rich from '../../../components/case-studies/Rich.astro';
import Shot from '../../../components/case-studies/Shot.astro';
import StarSummary from '../../../components/case-studies/StarSummary.astro';
import StudyLife from '../../../components/case-studies/StudyLife.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/study.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const phoneSizes = '(max-width: 500px) calc((100vw - 72px) / 3), (max-width: 900px) calc((100vw - 140px) / 3), 236px';
const pairSizes = '(max-width: 860px) calc((100vw - 140px) / 2), 248px';

const methods = [
  t('Review analysis: about 150 App Store and Google Play reviews, sorted by complaint.', 'Анализ отзывов: около 150 отзывов из App Store и Google Play, разложенных по темам жалоб.'),
  t('Contextual inquiry: I watched 10 people order at work, in an office and a call center, and noted where they hesitated.', 'Контекстное исследование: смотрел, как заказывают 10 человек на работе, в офисе и колл-центре, и отмечал, где они сомневаются.'),
  t('Competitive analysis: Кухня на районе for how to present the menu, Самокат and Яндекс Лавка for patterns our customers already knew.', 'Конкурентный анализ: «Кухня на районе» для подачи меню, «Самокат» и «Яндекс Лавка» для паттернов, которые наши клиенты уже знали.'),
  t('Comparative usability testing: the old app against prototypes, then against the built app, with 10 colleagues who didn’t work on it.', 'Сравнительное юзабилити-тестирование: старое приложение против прототипов, а потом против готового, на 10 коллегах, которые над ним не работали.'),
].map((text) => {
  const at = text.indexOf(': ');
  return { name: text.slice(0, at), detail: text.slice(at + 2) };
});
---

<BaseDocument
  title={t('SuperGood case study | Igor Kupchinenko', 'Кейс SuperGood | Игорь Купчиненко')}
  description={t(
    'How I redesigned ordering in SuperGood, a homemade food delivery app, and rebuilt its iOS and Android apps as one Flutter app. Repeating a usual order went from about a minute to about 5 seconds, and the store rating went from 3.1 to 3.7.',
    'Как я переделал заказ в SuperGood, приложении доставки домашней еды, и собрал вместо двух нативных приложений одно на Flutter. Повторить привычный заказ теперь можно примерно за 5 секунд вместо минуты, а рейтинг в магазинах приложений вырос с 3,1 до 3,7.',
  )}
  pageClass="study-document study--supergood"
  ogImage={menuLight.src}
>
  <main id="main-content">
    <Cover
      title="SuperGood"
      pitch={t('Homemade food, without making the order feel like a gamble.', 'Домашняя еда, и заказ больше не похож на лотерею.')}
      facts={[
        t('Product designer and the only mobile engineer at PizzaSushiWok, a small company', 'Продуктовый дизайнер и единственный мобильный разработчик в PizzaSushiWok, небольшой компании'),
        t('11 months, 2024', '11 месяцев, 2024'),
        t('Shipped on iOS and Android, and later closed for financial reasons.', 'Вышло на iOS и Android, позже проект закрыли по финансовым причинам.'),
      ]}
    >
      <div class="cover-phones">
        <Shot src={menuHero} priority="high" sizes={phoneSizes} alt={t('SuperGood menu with a pinned bar showing delivery time, item count, and total.', 'Меню SuperGood с закреплённой панелью: время доставки, количество позиций и сумма.')} />
        <Shot src={dishHero} priority="eager" sizes={phoneSizes} alt={t('Dish card with weight, price, nutrition, ingredients, and an add-to-basket button.', 'Карточка блюда с весом, ценой, КБЖУ, составом и кнопкой «В корзину».')} />
        <Shot src={checkoutHero} priority="eager" sizes={phoneSizes} alt={t('Checkout with address, delivery time, payment, bonuses, and total on one screen.', 'Оформление заказа: адрес, время доставки, оплата, бонусы и итог на одном экране.')} />
      </div>
    </Cover>

    <StarSummary
      situation={t(
        'SuperGood delivered homemade food through two separate apps, one for iOS and one for Android. In reviews, people weren’t sure the food was worth the price, and the app made ordering harder than it needed to be.',
        'SuperGood доставлял домашнюю еду, и у него было два отдельных приложения: для iOS и для Android. В отзывах сомневались, что еда стоит своих денег, а приложение только усложняло заказ.',
      )}
      task={t(
        'Make the everyday order quick and clear, especially the usual weekday lunch, and turn two apps into one. I was the only person working on it.',
        'Сделать повседневный заказ быстрым и понятным, особенно привычный обед в будни, и собрать из двух приложений одно. Работал над этим я один.',
      )}
      action={t(
        'I read about 150 store reviews, ran a contextual inquiry with 10 people ordering at work, and checked my changes in a comparative usability test with 10 colleagues. Then I redesigned the menu, the dish card, and reordering, and built it all in Flutter.',
        'Разобрал около 150 отзывов в магазинах приложений, провёл контекстное исследование с 10 людьми, которые заказывают еду на работе, и проверял изменения сравнительным юзабилити-тестированием на 10 коллегах. Переделал меню, карточку блюда и повтор заказа и собрал всё на Flutter.',
      )}
      result={t(
        'Repeating a usual order went from **about 60 seconds to about 5**. After the release, the store rating went from **3.1 to 3.7**, and **one codebase replaced two**.',
        'Повтор привычного заказа сократился **примерно с 60 секунд до 5**. После релиза рейтинг в магазинах приложений вырос **с 3,1 до 3,7**, а **одна кодовая база заменила две**.',
      )}
      caption={t(
        'The usability test was small and internal, so its numbers show direction rather than proof. The store rating is public.',
        'Юзабилити-тест был маленьким и внутренним, поэтому его цифры показывают направление, но ничего не доказывают. Рейтинг в магазинах публичный.',
      )}
    />

    <StudySection
      part="problem"
      lead={t(
        'People weren’t sure the food was worth it, and the app didn’t help. SuperGood competed with Кухня на районе for everyday meals: lunch at work, or dinner when you don’t feel like cooking. To see why people hesitated, I started with the public reviews.',
        'Люди сомневались, что еда стоит своих денег, а приложение не помогало. SuperGood конкурировал с «Кухней на районе» за повседневные заказы: обед на работе или ужин, когда готовить совсем не хочется. Чтобы понять, почему люди сомневались, я начал с публичных отзывов.',
      )}
    >
      <!-- Ten marks for the reviews, the app's three circled with the pen from the homepage. -->
      <figure class="split" data-arrive>
        <figcaption class="split__title">{t('What public reviews complained about', 'На что жаловались в публичных отзывах')}</figcaption>
        <div class="split__chart">
          <div class="split__marks" aria-hidden="true">
            {Array.from({ length: 7 }, (_, index) => <span class="split__mark" style={`--i: ${index}`}></span>)}
            <span class="split__mine">
              {Array.from({ length: 3 }, () => <span class="split__mark split__mark--mine"></span>)}
              <Image class="split__circle pen-circle" src={penCircle} alt="" widths={[256, 512]} sizes="9rem" loading="lazy" decoding="async" />
            </span>
          </div>
          <dl class="split__legend">
            <div class="split__key split__key--mine"><dt>≈30%</dt><dd>{t('The app. This part was mine.', 'Приложение. Это была моя часть.')}</dd></div>
            <div class="split__key"><dt>≈70%</dt><dd>{t('The food for its price. Kitchens and prices weren’t part of my role.', 'Еда за свои деньги. Кухня и цены не входили в мою зону ответственности.')}</dd></div>
          </dl>
        </div>
        <p class="split__note">{t('A rough split from about 150 App Store and Google Play reviews.', 'Примерное соотношение по 150 отзывам в App Store и Google Play.')}</p>
      </figure>

      <p>{t(
        'Most complaints were about the food for its price, which wasn’t mine to change. The ones about the app came down to three things. You couldn’t see the delivery time or the total while choosing dishes. Categories moved as you scrolled, so it was easy to lose your place. And every weekday lunch meant finding the same dishes again.',
        'Большинство жалоб было на еду за свои деньги, а это я поменять не мог. Претензии к приложению сводились к трём вещам. Пока выбираешь блюда, не видно ни времени доставки, ни итоговой суммы. Категории сдвигаются при прокрутке, и легко потеряться. А каждый будний обед приходится заново искать те же блюда.',
      )}</p>
    </StudySection>

    <StudySection
      part="goal"
      lead={t(
        'I joined as a mobile engineer. Kitchens and prices weren’t mine to change, so I took the part that was: the whole ordering experience, from research to the Flutter rebuild.',
        'Я пришёл мобильным разработчиком. Кухня и цены были не в моей власти, поэтому я взял то, что было: весь процесс заказа, от исследования до пересборки на Flutter.',
      )}
    >
      <p>{t(
        'The goal was to remove the reasons to hesitate before paying, and to make the usual order take seconds. To know if it worked, I’d look at the time, success rate, and ease (SEQ) of repeating an order, at app complaints in reviews, and at the store rating. The limits were clear from the start: no say over the food or prices, and one engineer for two platforms.',
        'Цель была убрать причины сомневаться перед оплатой и сделать так, чтобы привычный заказ занимал секунды. Понять, получилось ли, я собирался по времени, доле успешных попыток и лёгкости (SEQ) повтора заказа, по жалобам на приложение в отзывах и по рейтингу в магазинах. Ограничения были понятны сразу: никакого влияния на еду и цены и один разработчик на две платформы.',
      )}</p>
    </StudySection>

    <StudySection part="research" lead={t('Four kinds of research shaped the redesign:', 'Редизайн вырос из четырёх видов исследования:')}>
      <ul class="methods" role="list">
        {methods.map((method) => (
          <li><span class="methods__name">{method.name}<span class="sr-only">:</span></span> <span class="methods__detail">{method.detail}</span></li>
        ))}
      </ul>

      <p class="statement" data-arrive><Rich text={t(
        'Watching people order made one thing clear: ==weekday orders repeat==. People already knew what they wanted, but the app made them look for it again every time.',
        'Когда я смотрел, как люди заказывают, стало ясно главное: ==будничные заказы повторяются==. Люди уже знали, чего хотят, но приложение каждый раз заставляло искать всё заново.',
      )} /></p>

      <p>{t('I wrote what I heard as three job stories (Jobs to be Done). Each one led to one of the first three decisions:', 'Услышанное я записал в виде трёх job stories (Jobs to be Done). Каждая привела к одному из первых трёх решений:')}</p>
      <ul class="plain-list">
        <li>{t('When it’s lunchtime at work, I want my usual meal again with no effort, so ordering takes seconds.', 'Когда на работе время обеда, я хочу без усилий заказать то же, что обычно, чтобы заказ занимал секунды.')}</li>
        <li>{t('When I’m deciding whether to order, I want to know when the food arrives and what it costs, so nothing surprises me after I pay.', 'Когда я решаю, заказывать ли, я хочу знать, когда привезут и сколько это будет стоить, чтобы после оплаты не было сюрпризов.')}</li>
        <li>{t('When I pick a dish, I want to be sure it’s worth the price, so I don’t feel I overpaid.', 'Когда я выбираю блюдо, я хочу быть уверен, что оно стоит своих денег, чтобы не чувствовать, что переплатил.')}</li>
      </ul>
    </StudySection>

    <StudySection part="decisions">
      <Decision
        number={1}
        title={t('Reorder from order history', 'Повтор заказа из истории')}
        navLabel={t('Reorder from history', 'Повтор из истории')}
        problem={t('Rebuilding a usual lunch meant finding each dish again in a menu that kept moving.', 'Чтобы собрать привычный обед, нужно было заново искать каждое блюдо в меню, которое постоянно сдвигалось.')}
        decision={t('So I turned order history into a way to order. You open a past order and repeat one dish or the whole thing. History is searchable, changed prices are flagged, and sold-out dishes show up grayed out.', 'Поэтому я превратил историю заказов в способ заказать. Открываешь прошлый заказ и повторяешь одно блюдо или весь заказ. По истории есть поиск, изменившиеся цены отмечены, а закончившиеся блюда видны серыми.')}
        why={t('Most weekday orders were repeats, so a past order was already the shortest way to the next one.', 'Большинство будничных заказов были повторами, так что прошлый заказ и так был самым коротким путём к следующему.')}
        instead={t('I also thought about favourites, but they work for one dish, and a usual lunch is a few dishes together.', 'Я думал и про избранное, но оно удобно для одного блюда, а привычный обед обычно из нескольких.')}
        effect={t('Reordering went from **8 steps to 3**, and from **about 60 seconds to about 5**.', 'Повтор заказа сократился **с 8 шагов до 3** и **примерно с 60 секунд до 5**.')}
        source={t('steps counted from the flow, time from the usability test', 'шаги посчитаны по сценарию, время из юзабилити-теста')}
      >
        <Shot src={history} alt={t('Order history with an expanded order, a repeat button for each dish, and an add-whole-order button.', 'История заказов: раскрытый заказ, кнопка «Повторить» у каждого блюда и кнопка «Добавить весь заказ».')} caption={t('Repeat one dish, or bring back the whole order.', 'Повторить одно блюдо или вернуть весь заказ.')} />
      </Decision>

      <Decision
        number={2}
        title={t('A pinned bar with time and total', 'Закреплённая панель со временем и суммой')}
        navLabel={t('Pinned order bar', 'Панель заказа')}
        problem={t('People kept leaving the menu or losing their place, because time and total were hidden and categories moved.', 'Люди то уходили из меню, то терялись в нём: время и сумма были спрятаны, а категории сдвигались.')}
        decision={t('I added a pinned bar with the delivery time, item count, and total, put quantity controls right on the dish, and kept categories in a fixed order.', 'Я добавил закреплённую панель со временем доставки, количеством позиций и суммой, перенёс выбор количества прямо на блюдо и закрепил порядок категорий.')}
        why={t('People checked time and cost before every order, and regulars shop from memory, so the screen had to stay still.', 'Люди проверяли время и стоимость перед каждым заказом, а постоянные клиенты выбирают по памяти, так что экран не должен был прыгать.')}
        instead={t('A basket badge with just a count would have been simpler, but people would still have to open the basket to see time and total.', 'Значок корзины только со счётчиком был бы проще, но за временем и суммой всё равно пришлось бы ходить в корзину.')}
        effect={t('Time and total went from **two taps away to always visible**.', 'Время и сумма теперь **всегда на виду, а не в двух касаниях**.')}
        source={t('counted from the flow', 'посчитано по сценарию')}
      >
        <Shot src={menuDark} alt={t('Dark menu with a fixed category bar and a pinned order bar showing time, items, and total.', 'Тёмное меню со строкой категорий и закреплённой панелью заказа: время, позиции, сумма.')} caption={t('Categories stay in order. Time, items, and total stay pinned.', 'Категории не прыгают. Время, позиции и сумма всегда на виду.')} />
      </Decision>

      <Decision
        number={3}
        title={t('Weight, nutrition, and ingredients on the dish card', 'Вес, КБЖУ и состав в карточке блюда')}
        navLabel={t('Dish card details', 'Карточка блюда')}
        problem={t('A photo didn’t tell people enough to judge whether a dish was worth its price.', 'По одной фотографии было не понять, стоит ли блюдо своих денег.')}
        decision={t('The dish card now shows weight, ingredients, nutrition, and extra cooking time, with the price right next to Add.', 'Теперь в карточке блюда есть вес, состав, КБЖУ и дополнительное время приготовления, а цена стоит прямо рядом с кнопкой «В корзину».')}
        why={t('I couldn’t change the price, but I could show what you get for it before you pay.', 'Цену я поменять не мог, зато мог показать, что ты за неё получаешь, ещё до оплаты.')}
        effect={t('The new dish card **did better than the old one**.', 'Новая карточка блюда **показала себя лучше старой**.')}
        source={t('same usability test', 'тот же юзабилити-тест')}
      >
        <Shot src={dishSheetDark} alt={t('Dark dish card with weight, nutrition, ingredients, price, and the pinned order bar.', 'Тёмная карточка блюда с весом, КБЖУ, составом, ценой и закреплённой панелью заказа.')} caption={t('Everything you need to judge the dish, before it goes in the basket.', 'Всё, чтобы оценить блюдо, ещё до корзины.')} />
      </Decision>

      <Decision
        number={4}
        title={t('Keep the patterns people know', 'Оставить знакомые паттерны')}
        navLabel={t('Familiar patterns', 'Знакомые паттерны')}
        problem={t('A redesign can make loyal customers relearn an app they use every week.', 'После редизайна постоянным клиентам часто приходится заново привыкать к приложению, которым они пользуются каждую неделю.')}
        decision={t('I kept the structure people knew and borrowed patterns from Самокат and Яндекс Лавка, so the look changed but the habits didn’t.', 'Я сохранил привычную структуру и взял паттерны у «Самоката» и «Яндекс Лавки», так что поменялся внешний вид, но не привычки.')}
        why={t('Regulars order every week, and I wanted them to feel the improvement without relearning anything.', 'Постоянные клиенты заказывают каждую неделю, и мне хотелось, чтобы они почувствовали улучшение, не переучиваясь.')}
        effect={t('Later reviews called it **a fresher look with nothing new to learn**.', 'В отзывах потом писали, что **выглядит свежее, а переучиваться не нужно**.')}
        source={t('store reviews', 'отзывы в магазинах приложений')}
      >
        <Shot src={basket} alt={t('Basket with quantity controls, promo code, minimum order warning, payment methods, and total.', 'Корзина с количеством, промокодом, предупреждением о минимальной сумме, способами оплаты и итогом.')} caption={t('Basket patterns customers already knew from grocery apps.', 'Корзина по паттернам, знакомым по приложениям доставки продуктов.')} />
      </Decision>

      <Decision
        number={5}
        layout="stack"
        title={t('One Flutter app for iOS and Android', 'Одно приложение на Flutter для iOS и Android')}
        navLabel={t('One Flutter app', 'Одно приложение')}
        problem={t('With two separate apps, every change had to be built twice and could behave differently on each platform.', 'С двумя отдельными приложениями каждое изменение приходилось делать дважды, и на разных платформах оно могло работать по-разному.')}
        decision={t('I rebuilt both apps in Flutter from one codebase, from the menu and 3DS payment to tracking, loyalty, and light and dark themes on my own design system.', 'Я пересобрал оба приложения на Flutter в одной кодовой базе: от меню и оплаты с 3DS до отслеживания, лояльности и светлой и тёмной тем на моей дизайн-системе.')}
        why={t('As the only engineer, one codebase meant every fix reached iOS and Android on the same day.', 'Я был единственным разработчиком, и с одной кодовой базой каждое исправление попадало на iOS и Android в один день.')}
        instead={t('Keeping both native apps would have meant doing every change twice, by one person.', 'Если оставить два нативных приложения, каждое изменение пришлось бы делать дважды, и всё одному.')}
        effect={t('**Two codebases became one**, built alone in 11 months.', '**Две кодовые базы стали одной**, собранной в одиночку за 11 месяцев.')}
      >
        <div class="pair">
          <Shot src={deliveryMap} sizes={pairSizes} alt={t('Address picker on a map with the delivery zone and a confirmation that the address is inside it.', 'Выбор адреса на карте с зоной доставки и подтверждением, что адрес в неё входит.')} caption={t('Delivery zone check', 'Проверка зоны доставки')} />
          <Shot src={orderTracking} sizes={pairSizes} alt={t('Order tracking with expected time, order stages, a route map, and courier contact.', 'Отслеживание заказа: ожидаемое время, этапы, карта маршрута и связь с курьером.')} caption={t('Order tracking', 'Отслеживание заказа')} />
        </div>
      </Decision>
    </StudySection>

    <StudySection part="results" lead={t('I checked the redesign twice: in the usability test with colleagues, and in the stores after the release.', 'Я проверил редизайн дважды: на юзабилити-тесте с коллегами и в магазинах приложений после релиза.')}>
      <BarCompare
        title={t('Time to repeat a usual order', 'Время на повтор привычного заказа')}
        unit={5}
        unitLabel={t('One mark is 5 seconds.', 'Одна отметка: 5 секунд.')}
        rows={[
          { label: t('Before: find each dish again', 'До: снова искать каждое блюдо'), value: 60, display: t('≈60 s', '≈60 с') },
          { label: t('After: history, add whole order', 'После: история, добавить весь заказ'), value: 5, display: t('≈5 s', '≈5 с'), emphasis: true },
