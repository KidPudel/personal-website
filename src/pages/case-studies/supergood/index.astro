---
import { Image } from 'astro:assets';

import penCircle from '../../../assets/art/elements/circled.png';
import basket from '../../../assets/case_study_images/supergood/basket.png';
import checkoutHero from '../../../assets/case_study_images/supergood/checkout-hero.png';
import dishSheetDark from '../../../assets/case_study_images/supergood/dish-sheet-dark.png';
import history from '../../../assets/case_study_images/supergood/history.png';
import deliveryMap from '../../../assets/case_study_images/supergood/map.png';
import menuDark from '../../../assets/case_study_images/supergood/menu-dark.png';
import menuLight from '../../../assets/case_study_images/supergood/menu-light.png';
import menuHero from '../../../assets/case_study_images/supergood/menu-light-hero.png';
import dishHero from '../../../assets/case_study_images/supergood/dish-sheet-light-hero.png';
import orderTracking from '../../../assets/case_study_images/supergood/order-tracking.png';
import texture from '../../../assets/showcase-cards/card2.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import DecisionBlock from '../../../components/case-studies/DecisionBlock.astro';
import More from '../../../components/case-studies/More.astro';
import Plate from '../../../components/case-studies/Plate.astro';
import Rich from '../../../components/case-studies/Rich.astro';
import Rows from '../../../components/case-studies/Rows.astro';
import FocusCover from '../../../components/case-studies/supergood/FocusCover.astro';
import StudyLife from '../../../components/case-studies/StudyLife.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import { caseStudy } from '../../../content/case-studies';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/plates.css';
import '../../../styles/study-structured.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);

// One set of names, used in the short read, the navigation, and the sections.
const label = {
  problem: t('Problem', 'Проблема'),
  goal: t('Goal', 'Цель'),
  research: t('Research', 'Исследование'),
  decisions: t('Decisions', 'Решения'),
  decision: t('Decision', 'Решение'),
  hypothesis: t('Hypothesis', 'Гипотеза'),
  why: t('Why', 'Почему'),
  notChosen: t('Not chosen', 'Отверг'),
  result: t('Result', 'Результат'),
};
const goal = t(
  'Make the everyday order quick and clear, especially the usual weekday lunch, and turn two apps into one.',
  'Сделать повседневный заказ быстрым и понятным, особенно привычный обед в будни, и собрать из двух приложений одно.',
);

const complaints = [
  t('You couldn’t see the delivery time or the total while choosing dishes.', 'Пока выбираешь блюда, не видно ни времени доставки, ни итоговой суммы.'),
  t('Categories moved as you scrolled, so it was easy to lose your place.', 'Категории сдвигаются при прокрутке, и легко потеряться.'),
  t('Every weekday lunch meant finding the same dishes again.', 'Каждый будний обед приходится заново искать те же блюда.'),
];

const constraints = [
  { name: t('No say over the food or prices.', 'Никакого влияния на еду и цены.'), why: t('Most complaints were about the food for its price, and kitchens and prices weren’t part of my role.', 'Большинство жалоб было на еду за свои деньги, а кухня и цены не входили в мою зону ответственности.') },
  { name: t('One engineer for two platforms.', 'Один разработчик на две платформы.'), why: t('I was the only person working on the app, for 11 months.', 'Над приложением работал только я, 11 месяцев.') },
  { name: t('Regulars order every week.', 'Постоянные клиенты заказывают каждую неделю.'), why: t('A redesign couldn’t make them relearn the app.', 'Редизайн не должен был заставить их заново привыкать к приложению.') },
  { name: t('A small, internal test.', 'Маленький внутренний тест.'), why: t('The usability test used 10 colleagues outside the app team, so its numbers show direction, not proof.', 'В юзабилити-тесте участвовали 10 коллег не из команды приложения, так что его цифры показывают направление, но ничего не доказывают.') },
];

const methods = [
  { label: t('Review analysis', 'Анализ отзывов'), text: t('About 150 App Store and Google Play reviews, sorted by complaint.', 'Около 150 отзывов из App Store и Google Play, разложенных по темам жалоб.') },
  { label: t('Contextual inquiry', 'Контекстное исследование'), text: t('I watched 10 people order at work, in an office and a call center, and noted where they hesitated.', 'Смотрел, как заказывают 10 человек на работе, в офисе и колл-центре, и отмечал, где они сомневаются.') },
  { label: t('Competitive analysis', 'Конкурентный анализ'), text: t('Кухня на районе for how to present the menu, Самокат and Яндекс Лавка for patterns our customers already knew.', '«Кухня на районе» для подачи меню, «Самокат» и «Яндекс Лавка» для паттернов, которые наши клиенты уже знали.') },
  { label: t('Usability testing', 'Юзабилити-тест'), text: t('The old app against prototypes, then against the built app, with 10 colleagues who didn’t work on it.', 'Старое приложение против прототипов, а потом против готового, на 10 коллегах, которые над ним не работали.') },
];

// The study's spine: every finding, where it came from, and what it led to.
const findings = [
  { title: t('Weekday orders repeat.', 'Будничные заказы повторяются.'), detail: t('People already knew what they wanted, but the app made them look for it again every time.', 'Люди уже знали, чего хотят, но приложение каждый раз заставляло искать всё заново.'), who: t('Contextual inquiry, reviews', 'Наблюдение, отзывы'), to: t('Decision 1: reorder', 'Решение 1: повтор'), href: '#decision-1' },
  { title: t('Time and total were hidden.', 'Время и сумма спрятаны.'), detail: complaints[0], who: t('Reviews', 'Отзывы'), to: t('Decision 2: pinned bar', 'Решение 2: панель'), href: '#decision-2' },
  { title: t('The menu moved.', 'Меню прыгает.'), detail: complaints[1], who: t('Reviews', 'Отзывы'), to: t('Decision 2: pinned bar', 'Решение 2: панель'), href: '#decision-2' },
  { title: t('A photo wasn’t enough to judge a dish.', 'По фото не понять, стоит ли блюдо своих денег.'), detail: t('Most complaints were about the food for its price.', 'Большинство жалоб было на еду за свои деньги.'), who: t('Reviews', 'Отзывы'), to: t('Decision 3: dish card', 'Решение 3: карточка блюда'), href: '#decision-3' },
  { title: t('Customers already knew grocery apps.', 'Клиенты уже знали приложения доставки продуктов.'), detail: t('Самокат and Яндекс Лавка had patterns they used every week.', 'У «Самоката» и «Яндекс Лавки» были паттерны, которыми они пользовались каждую неделю.'), who: t('Competitive analysis', 'Конкурентный анализ'), to: t('Decision 4: familiar patterns', 'Решение 4: знакомые паттерны'), href: '#decision-4' },
  { title: t('Two apps, one engineer.', 'Два приложения, один разработчик.'), detail: t('Every change had to be built twice.', 'Каждое изменение приходилось делать дважды.'), who: t('The project itself', 'Сам проект'), to: t('Decision 5: one app', 'Решение 5: одно приложение'), href: '#decision-5' },
];

const reflection = [
  t('Agree with stakeholders on the metric to move before designing anything.', 'До начала дизайна договорился бы со стейкхолдерами, какую метрику двигаем.'),
  t('Bring review counts and test results instead of arguing about taste.', 'Приходил бы с цифрами по отзывам и результатами тестов, а не спорил о вкусах.'),
  t('Rank ideas with the business on an impact and effort matrix, so urgency has to earn its place.', 'Раскладывал бы идеи вместе с бизнесом по матрице «влияние и затраты», чтобы срочность приходилось обосновывать.'),
  t('Measure more: bigger tests, ease ratings for every task, and repeat orders after release.', 'Измерял бы больше: тесты побольше, оценка лёгкости для каждой задачи и повторные заказы после релиза.'),
];
---

<BaseDocument
  title={t('SuperGood case study | Igor Kupchinenko', 'Кейс SuperGood | Игорь Купчиненко')}
  description={t(
    'How I redesigned ordering in SuperGood, a homemade food delivery app, and rebuilt its iOS and Android apps as one Flutter app. Repeating a usual order went from about a minute to about 5 seconds, and the store rating went from 3.1 to 3.7.',
    'Как я переделал заказ в SuperGood, приложении доставки домашней еды, и собрал вместо двух нативных приложений одно на Flutter. Повторить привычный заказ теперь можно примерно за 5 секунд вместо минуты, а рейтинг в магазинах приложений вырос с 3,1 до 3,7.',
  )}
  pageClass="study-plates study-structured study--supergood"
  ogImage={menuLight.src}
>
  <main id="main-content" data-present={localePath('/case-studies/supergood/present/', locale)}>
    <!-- The first screen is the short read: each label leads to its section. -->
    <FocusCover
      title="SuperGood"
      about={caseStudy('supergood').about}
      navLabel="TL;DR"
      ground={texture}
      phones={[
        { src: menuHero, alt: t('SuperGood menu with a pinned bar showing delivery time, item count, and total.', 'Меню SuperGood с закреплённой панелью: время доставки, количество позиций и сумма.') },
        { src: dishHero, alt: t('Dish card with weight, price, nutrition, ingredients, and an add-to-basket button.', 'Карточка блюда с весом, ценой, КБЖУ, составом и кнопкой «В корзину».') },
        { src: checkoutHero, alt: t('Checkout with address, delivery time, payment, bonuses, and total on one screen.', 'Оформление заказа: адрес, время доставки, оплата, бонусы и итог на одном экране.') },
      ]}
    >
      <Rows rows={[
        { label: label.problem, href: '#problem', text: t('People weren’t sure the food was worth the price, and the app made ordering harder: the usual weekday lunch had to be found again every time.', 'Люди сомневались, что еда стоит своих денег, а приложение только усложняло заказ: привычный будний обед приходилось каждый раз искать заново.') },
        { label: label.goal, href: '#goal', text: goal },
        { label: label.research, href: '#research', text: t('About 150 store reviews, 10 people watched ordering at work, and a usability test with 10 colleagues. Weekday orders repeat.', 'Около 150 отзывов, наблюдение за 10 людьми, которые заказывают на работе, и юзабилити-тест с 10 коллегами. Будничные заказы повторяются.') },
        { label: label.decisions, href: '#decisions', text: t('Turn order history into a way to reorder, plus four fixes to the menu, the dish card, and how it was built.', 'Превратить историю заказов в способ повторить заказ, и ещё четыре исправления в меню, карточке блюда и в том, как всё собрано.') },
        { label: label.result, href: '#results', tone: 'result', text: t('Repeating a usual order went from **about 60 seconds to about 5** in the usability test. After the release, the store rating went from **3.1 to 3.7**, and **one codebase replaced two**.', 'На юзабилити-тесте повтор привычного заказа сократился **примерно с 60 секунд до 5**. После релиза рейтинг в магазинах приложений вырос **с 3,1 до 3,7**, а **одна кодовая база заменила две**.') },
      ]} />
    </FocusCover>

    <StudySection part="problem">
      <div class="split">
        <div class="stack">
          <p class="opening">{t(
            'People weren’t sure the food was worth it, and the app didn’t help. SuperGood competed with Кухня на районе for everyday meals: lunch at work, or dinner when you don’t feel like cooking. To see why people hesitated, I started with the public reviews.',
            'Люди сомневались, что еда стоит своих денег, а приложение не помогало. SuperGood конкурировал с «Кухней на районе» за повседневные заказы: обед на работе или ужин, когда готовить совсем не хочется. Чтобы понять, почему люди сомневались, я начал с публичных отзывов.',
          )}</p>
          <Rows rows={[
            { label: t('About the app', 'О приложении'), list: complaints },
            { label: t('Not mine to change', 'Не в моей власти'), text: t('Most complaints were about the food for its price. Kitchens and prices weren’t part of my role.', 'Большинство жалоб было на еду за свои деньги. Кухня и цены не входили в мою зону ответственности.') },
          ]} />
        </div>

        <!-- Ten marks for the reviews, the app's three circled with the pen from the homepage. -->
        <figure class="review-split" data-arrive>
          <figcaption class="review-split__title">{t('What public reviews complained about', 'На что жаловались в публичных отзывах')}</figcaption>
          <div class="review-split__chart">
            <div class="review-split__marks" aria-hidden="true">
              {Array.from({ length: 7 }, (_, index) => <span class="review-split__mark" style={`--i: ${index}`}></span>)}
              <span class="review-split__mine">
                {Array.from({ length: 3 }, () => <span class="review-split__mark review-split__mark--mine"></span>)}
                <Image class="review-split__circle pen-circle" src={penCircle} alt="" widths={[256, 512]} sizes="9rem" loading="lazy" decoding="async" />
              </span>
            </div>
            <dl class="review-split__legend">
              <div class="review-split__key review-split__key--mine"><dt>≈30%</dt><dd>{t('The app. This part was mine.', 'Приложение. Это была моя часть.')}</dd></div>
              <div class="review-split__key"><dt>≈70%</dt><dd>{t('The food for its price.', 'Еда за свои деньги.')}</dd></div>
            </dl>
          </div>
          <p class="review-split__note">{t('A rough split from about 150 App Store and Google Play reviews.', 'Примерное соотношение по 150 отзывам в App Store и Google Play.')}</p>
        </figure>
      </div>
    </StudySection>

    <StudySection part="goal">
      <div class="goal">
        <Rows rows={[
          { label: label.goal, tone: 'key', text: t('Remove the reasons to hesitate before paying, and make the usual order take seconds.', 'Убрать причины сомневаться перед оплатой и сделать так, чтобы привычный заказ занимал секунды.') },
          { label: t('How I’d know', 'Как пойму'), list: [
            t('Time, success rate, and ease (SEQ) of repeating an order', 'Время, доля успешных попыток и лёгкость (SEQ) повтора заказа'),
            t('App complaints in store reviews', 'Жалобы на приложение в отзывах'),
            t('The store rating', 'Рейтинг в магазинах приложений'),
          ] },
          { label: t('My part', 'Моя часть'), text: t('I joined as a mobile engineer and took the part I could change: the whole ordering experience, from research to the Flutter rebuild.', 'Я пришёл мобильным разработчиком и взял то, что мог изменить: весь процесс заказа, от исследования до пересборки на Flutter.') },
        ]} />
      </div>
    </StudySection>

    <StudySection part="constraints">
      <ul class="constraints" role="list">
        {constraints.map((item) => <li><strong>{item.name}</strong> {item.why}</li>)}
      </ul>
    </StudySection>

    <StudySection part="research" lead={t('Four kinds of research shaped the redesign.', 'Редизайн вырос из четырёх видов исследования.')}>
      <div class="methods">
        <Rows rows={methods} />
      </div>

      <p class="statement" data-arrive><Rich text={t(
        'Watching people order made one thing clear: ==weekday orders repeat==.',
        'Когда я смотрел, как люди заказывают, стало ясно главное: ==будничные заказы повторяются==.',
      )} /></p>

      <h3>{t('What I found, and what it led to', 'Что я узнал и к чему это привело')}</h3>
      <div class="spine">
        <table>
          <thead>
            <tr>
              <th scope="col">{t('Finding', 'Что выяснилось')}</th>
              <th scope="col">{t('Where it came from', 'Откуда')}</th>
              <th scope="col">{t('What it led to', 'К чему привело')}</th>
            </tr>
          </thead>
          <tbody>
            {findings.map((row) => (
              <tr>
                <th scope="row"><strong>{row.title}</strong> <span>{row.detail}</span></th>
                <td class="spine__who">{row.who}</td>
                <td class="spine__to"><a href={row.href}><span class="link-mark">{row.to}</span></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="details-group">
        <More summary={t('The three job stories behind decisions 1 to 3', 'Три job stories за решениями 1–3')}>
          <ol class="next-steps">
            <li>{t('When it’s lunchtime at work, I want my usual meal again with no effort, so ordering takes seconds.', 'Когда на работе время обеда, я хочу без усилий заказать то же, что обычно, чтобы заказ занимал секунды.')}</li>
            <li>{t('When I’m deciding whether to order, I want to know when the food arrives and what it costs, so nothing surprises me after I pay.', 'Когда я решаю, заказывать ли, я хочу знать, когда привезут и сколько это будет стоить, чтобы после оплаты не было сюрпризов.')}</li>
            <li>{t('When I pick a dish, I want to be sure it’s worth the price, so I don’t feel I overpaid.', 'Когда я выбираю блюдо, я хочу быть уверен, что оно стоит своих денег, чтобы не чувствовать, что переплатил.')}</li>
          </ol>
        </More>
      </div>
    </StudySection>

    <StudySection
      part="decisions"
      lead={t(
        'Five decisions. The first three answer the job stories; the last two are about not making regulars relearn, and building it alone.',
        'Пять решений. Первые три отвечают на job stories, последние два про то, чтобы постоянным клиентам не пришлось переучиваться, и про то, как собрать всё одному.',
      )}
    >
      <DecisionBlock
        number={1}
        title={t('Reorder from order history', 'Повтор заказа из истории')}
        navLabel={t('Reorder', 'Повтор')}
        rows={[
          { label: label.problem, text: t('Rebuilding a usual lunch meant finding each dish again in a menu that kept moving.', 'Чтобы собрать привычный обед, нужно было заново искать каждое блюдо в меню, которое постоянно сдвигалось.') },
          { label: label.hypothesis, text: t('Most weekday orders were repeats, so if a past order can simply be ordered again, the usual lunch takes seconds instead of a search.', 'Большинство будничных заказов были повторами, поэтому если прошлый заказ можно просто повторить, привычный обед занимает секунды, а не поиски.') },
          { label: label.decision, tone: 'key', text: t('Order history became a way to order: open a past order and repeat one dish or the whole thing. History is searchable, changed prices are flagged, and sold-out dishes show up grayed out.', 'История заказов стала способом заказать: открываете прошлый заказ и повторяете одно блюдо или весь заказ. По истории есть поиск, изменившиеся цены отмечены, а закончившиеся блюда видны серыми.') },
          { label: label.notChosen, text: t('Favourites. They work for one dish, and a usual lunch is a few dishes together.', 'Избранное. Оно удобно для одного блюда, а привычный обед обычно из нескольких.') },
          { label: label.result, tone: 'result', text: t('Reordering went from **8 steps to 3**, and from **about 60 seconds to about 5**.', 'Повтор заказа сократился **с 8 шагов до 3** и **примерно с 60 секунд до 5**.'), source: t('Steps counted from the flow, time from the usability test', 'Шаги посчитаны по сценарию, время из юзабилити-теста') },
        ]}
      >
        <Plate shots={[{ src: history, alt: t('Order history with an expanded order, a repeat button for each dish, and an add-whole-order button.', 'История заказов: раскрытый заказ, кнопка «Повторить» у каждого блюда и кнопка «Добавить весь заказ».') }]} notes={[
          { x: 60.6, y: 43.3, w: 22.6, h: 4.4, label: t('Repeat one dish', 'Повторить одно блюдо'), also: [{ x: 60.6, y: 52.3, w: 22.6, h: 4.4 }] },
          { x: 17.1, y: 72.8, w: 65.8, h: 3.8, label: t('Or bring back the whole order', 'Или вернуть весь заказ') },
        ]} />
      </DecisionBlock>

      <DecisionBlock
        number={2}
        title={t('A pinned bar with time and total', 'Закреплённая панель со временем и суммой')}
        navLabel={t('Pinned bar', 'Панель')}
        rows={[
          { label: label.problem, text: t('People kept leaving the menu or losing their place, because time and total were hidden and categories moved.', 'Люди то уходили из меню, то терялись в нём: время и сумма были спрятаны, а категории сдвигались.') },
          { label: label.hypothesis, text: t('People checked time and cost before every order and shop from memory, so if both stay in view and the menu stays still, they can decide without leaving it.', 'Люди проверяли время и стоимость перед каждым заказом и выбирают по памяти, поэтому если и то и другое на виду, а меню не прыгает, решить можно, не уходя из него.') },
          { label: label.decision, tone: 'key', text: t('A pinned bar with the delivery time, item count, and total, quantity controls right on the dish, and categories in a fixed order.', 'Закреплённая панель со временем доставки, количеством позиций и суммой, выбор количества прямо на блюде и закреплённый порядок категорий.') },
          { label: label.notChosen, text: t('A basket badge with just a count. Simpler, but people would still have to open the basket to see time and total.', 'Значок корзины только со счётчиком. Проще, но за временем и суммой всё равно пришлось бы ходить в корзину.') },
          { label: label.result, tone: 'result', text: t('Time and total went from **two taps away to always visible**.', 'Время и сумма теперь **всегда на виду, а не в двух касаниях**.'), source: t('Counted from the flow', 'Посчитано по сценарию') },
        ]}
      >
        <Plate shots={[{ src: menuDark, alt: t('Dark menu with a fixed category bar and an order bar showing time, items, and total.', 'Тёмное меню со строкой категорий и закреплённой панелью заказа: время, позиции, сумма.') }]} notes={[
          { x: 14, y: 38.8, w: 72.7, h: 3.4, label: t('Categories stay in order', 'Категории не прыгают') },
