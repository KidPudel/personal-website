---
import { Image } from 'astro:assets';

import checkout from '../../../assets/case_study_images/supergood/checkout.png';
import dishSheetDark from '../../../assets/case_study_images/supergood/dish-sheet-dark.png';
import dishSheetLight from '../../../assets/case_study_images/supergood/dish-sheet-light.png';
import history from '../../../assets/case_study_images/supergood/history.png';
import { sitePath } from '../../../config/site';
import BaseDocument from '../../../layouts/BaseDocument.astro';

const heroTitle = 'SuperGood';
---

<BaseDocument
  title="SuperGood case study | Igor Kupchinenko"
  description="How I redesigned SuperGood, a homemade-food delivery product, so the order itself could carry the promise of speed, price, and trust."
  pageClass="supergood-case-study"
  themeColor="#FBF6EE"
  ogImage={dishSheetLight.src}
>
  <nav class="topbar" aria-label="Case study navigation">
    <a href={sitePath('/work/')}>← Work</a>
    <span>SuperGood / Case study</span>
    <span></span>
  </nav>

  <nav class="chapter-index" aria-label="Case study sections">
    <p>Case study</p>
    <ol>
      <li><a href="#context" data-index-link="context"><span>01</span><span class="chapter-index__name">Context</span></a></li>
      <li><a href="#research" data-index-link="research"><span>02</span><span class="chapter-index__name">Evidence</span></a></li>
      <li><a href="#direction" data-index-link="direction"><span>03</span><span class="chapter-index__name">Direction</span></a></li>
      <li><a href="#solution" data-index-link="solution"><span>04</span><span class="chapter-index__name">Product</span></a></li>
      <li><a href="#outcome" data-index-link="outcome"><span>05</span><span class="chapter-index__name">Outcome</span></a></li>
      <li><a href="#reflection" data-index-link="reflection"><span>06</span><span class="chapter-index__name">Reflection</span></a></li>
    </ol>
  </nav>

  <main id="main-content">
    <header class="hero">
      <p class="eyebrow">Product design · <time datetime="2024">2024</time> · Production food-ordering app</p>
      <h1 class="hero-title">{heroTitle}</h1>
      <p class="hero__line">Homemade food, without making the order feel like a gamble.</p>
      <p class="hero__intro">
        SuperGood was PizzaSushiWok’s delivery product for homemade-style food. When I joined, public reviews criticised the app and questioned whether the food justified its price. I was hired as a mobile engineer. I ended up owning the order experience and rebuilt it as one Flutter product.
      </p>

      <dl class="facts">
        <div><dt>Role</dt><dd>Product direction, research, UX/UI, Flutter</dd></div>
        <div><dt>When</dt><dd>2024, at PizzaSushiWok</dd></div>
        <div><dt>Research</dt><dd>Conversations, contextual inquiry, competitive study, task tests, polls</dd></div>
        <div><dt>Outcome</dt><dd>Shipped on Android and iOS. Later closed for financial reasons.</dd></div>
      </dl>

      <figure class="hero-phones">
        <Image
          src={dishSheetLight}
          alt="Working SuperGood dish sheet with photo, price, nutrition, ingredients, and add-to-cart."
          widths={[320, 480, 640]}
          sizes="(max-width: 760px) 42vw, 220px"
          format="webp"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <Image
          src={checkout}
          alt="Working SuperGood checkout with address, delivery time, payment, bonuses, and order button."
          widths={[320, 480, 640]}
          sizes="(max-width: 760px) 42vw, 220px"
          format="webp"
          loading="eager"
          decoding="async"
        />
        <Image
          src={history}
          alt="Working SuperGood order history with expandable cards and repeat-order actions."
          widths={[320, 480, 597]}
          sizes="(max-width: 760px) 42vw, 220px"
          format="webp"
          loading="eager"
          decoding="async"
        />
        <figcaption>Working product. The phones below are from the application I designed and built, not a later restyle.</figcaption>
      </figure>
    </header>

    <section class="chapter" id="context" data-index-section>
      <header class="chapter__label">
        <span>01</span>
        <p>Context</p>
      </header>
      <div class="chapter__body">
        <h2>The app could not improve the food. It could stop making it harder to trust.</h2>
        <div class="prose">
          <p>
            SuperGood competed with Кухня на районе for an everyday job: lunch at work or dinner when cooking was too much. The promise was homemade-style food, delivered quickly, at a price that made sense.
          </p>
          <p>
            The product was already struggling in public. Reviews treated an outdated order and disappointing value as one experience. Kitchens, recipes, pricing, and courier operations were outside my control. Everything between opening the app and receiving the bag was not.
          </p>
        </div>

        <dl class="scope">
          <div>
            <dt>Goal</dt>
            <dd>Make value, time, and total clear before payment, then make a repeat order cheap to start.</dd>
          </div>
          <div>
            <dt>Owned</dt>
            <dd>First run, menu, dish details, quantity, basket, payment, tracking, favourites, history, UX/UI, and Flutter implementation.</dd>
          </div>
          <div>
            <dt>Not owned</dt>
            <dd>Kitchens, recipes, food pricing, and courier operations.</dd>
          </div>
          <div>
            <dt>Constraint</dt>
            <dd>Separate Android and iOS apps, public quality problems, and a mobile-engineering role that expanded into product ownership.</dd>
          </div>
        </dl>

        <blockquote>
          What must a person know before this meal feels worth ordering?
        </blockquote>
      </div>
    </section>

    <section class="chapter" id="research" data-index-section>
      <header class="chapter__label">
        <span>02</span>
        <p>Evidence</p>
      </header>
      <div class="chapter__body">
        <h2>Three failures kept appearing in real orders.</h2>
        <div class="prose">
          <p>
            I used customer conversations, contextual inquiry, competitive study, prototype tasks, comparison tests, and polls. I do not have defensible sample sizes or win rates to publish. What matters here is how repeated observations changed the product.
          </p>
        </div>

        <div class="qa">
          <p class="research-label">Observation → product response</p>
          <dl>
            <div>
              <dt>Value was impossible to inspect</dt>
              <dd>A photograph carried too much of the claim. Dish details gained weight, ingredients, nutrition, extra cooking time, and a clear price beside the add action.</dd>
            </div>
            <div>
              <dt>Time and total disappeared</dt>
              <dd>People checked both before paying. The order bar kept delivery time, count, and total visible while they browsed.</dd>
            </div>
            <div>
              <dt>Known meals still began at the catalogue</dt>
              <dd>Weekday orders often repeated. Favourites and order history became ways back into the basket, not storage screens.</dd>
            </div>
          </dl>
        </div>

        <div class="compare">
          <p class="research-label">Competitive frame</p>
          <article>
            <h3>Кухня на районе</h3>
            <p>Defined the category promise: food from a nearby kitchen, a short wait, and a changing everyday menu.</p>
          </article>
          <article>
            <h3>Самокат</h3>
            <p>Set the interaction expectation: address before browsing, quantity on the item, and a useful cart as soon as the first item is added.</p>
          </article>
        </div>

        <div class="finding">
          <p>The reframing</p>
          <strong>This was not a menu redesign. It was a redesign of the order, including the next one.</strong>
        </div>
      </div>
    </section>

    <section class="chapter chapter--dark" id="direction" data-index-section>
      <header class="chapter__label">
        <span>03</span>
        <p>Direction</p>
      </header>
      <div class="chapter__body">
        <h2>I moved the product’s centre from the catalogue to the order.</h2>
        <ol class="principles">
          <li>
            <span>1</span>
            <div>
              <h3>One product, one behaviour</h3>
              <p>Replace separate Android and iOS applications with one Flutter product so interaction, copy, and quality could be designed once.</p>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <h3>Evidence at the decision</h3>
              <p>Put composition, weight, time, price, and quantity where a person decides whether to add the dish.</p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <h3>Yesterday is an entrance</h3>
              <p>Use favourites and history to start an order. Do not make a repeat customer rebuild a known meal.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="chapter chapter--wide" id="solution" data-index-section>
      <header class="chapter__label">
        <span>04</span>
        <p>Product</p>
      </header>
      <div class="chapter__body">
        <h2>Four shipped screens carry the argument.</h2>
        <p class="wide-copy">
          These are working screens from the product I designed and built. The full scope also included greeting, first run, address, menu navigation, tracking, favourites, promotions, loyalty, themes, and adaptive layouts. I am showing the moments that make the product decision visible.
        </p>
      </div>

      <div class="path-group">
        <ol class="journey-map">
          <li id="dish">
            <p>01 Dish</p>
            <h3>Put proof beside the photograph</h3>
            <p class="journey-map__decision">Weight, ingredients, nutrition, extra cooking time, and price sit with the add action. A photo no longer carries the entire value claim.</p>
            <figure>
              <Image src={dishSheetLight} alt="Working dish sheet with photo, weight, price, nutrition, ingredients, and add to cart." widths={[360, 480, 640]} sizes="(max-width: 760px) 70vw, 220px" format="webp" loading="lazy" decoding="async" />
              <figcaption>Working product</figcaption>
            </figure>
          </li>
          <li id="basket">
            <p>02 Order bar</p>
            <h3>Keep time, count, and total in view</h3>
            <p class="journey-map__decision">Quantity moved onto the item. The persistent bar updates the order without sending the person away from the menu.</p>
            <figure>
              <Image src={dishSheetDark} alt="Working dark dish sheet with a persistent order bar showing delivery time, count, and total." widths={[360, 480, 640]} sizes="(max-width: 760px) 70vw, 220px" format="webp" loading="lazy" decoding="async" />
              <figcaption>Working product</figcaption>
            </figure>
          </li>
          <li id="pay">
            <p>03 Checkout</p>
            <h3>Confirm instead of rediscovering</h3>
            <p class="journey-map__decision">Address, delivery time, payment, bonuses, and total appear together. Each part can be changed locally without losing the order.</p>
            <figure>
              <Image src={checkout} alt="Working checkout with address, delivery time, payment, bonuses, and order button." widths={[360, 480, 640]} sizes="(max-width: 760px) 70vw, 220px" format="webp" loading="lazy" decoding="async" />
              <figcaption>Working product</figcaption>
            </figure>
          </li>
          <li id="history">
            <p>04 History</p>
            <h3>Turn a receipt into the next order</h3>
            <p class="journey-map__decision">Expandable cards expose individual dishes and the whole basket. Repeat actions make a finished or cancelled order useful again.</p>
            <figure>
              <Image src={history} alt="Working order history with expandable cards, repeat buttons, and add whole order." widths={[360, 480, 597]} sizes="(max-width: 760px) 70vw, 220px" format="webp" loading="lazy" decoding="async" />
              <figcaption>Working product</figcaption>
            </figure>
          </li>
        </ol>
      </div>

      <div class="validation-board">
        <article class="validation-case">
          <p><strong>Evidence boundary.</strong> The previous application and early prototypes were not preserved. This case study uses surviving production screens and contemporaneous public feedback. I have not reconstructed a before state from memory.</p>
        </article>
      </div>
    </section>

    <section class="chapter chapter--wide chapter--outcome" id="outcome" data-index-section>
      <header class="chapter__label">
        <span>05</span>
        <p>Outcome</p>
      </header>
      <div class="chapter__body">
        <h2>The redesign shipped. The business still closed the product.</h2>
        <div class="prose">
          <p>
            One Flutter codebase replaced the separate Android and iOS applications. The production scope covered the complete order: menu behaviour, basket, payment and 3DS, maps, courier state, promotions, loyalty, themes, adaptive layouts, and continued usability and reliability fixes.
          </p>
          <p>
            SuperGood later closed because of the company’s financial situation, not because the redesign remained unfinished.
          </p>
        </div>

        <dl class="scope">
          <div>
            <dt>What I can prove</dt>
            <dd>A production Android and iOS product, the working screens above, and the implementation scope I owned.</dd>
          </div>
          <div>
            <dt>What I cannot claim</dt>
            <dd>I do not have permissioned conversion, retention, or repeat-order metrics. I will not substitute “more intuitive” for missing measurement.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="chapter reflection" id="reflection" data-index-section>
      <header class="chapter__label">
        <span>06</span>
        <p>Reflection</p>
      </header>
      <div class="chapter__body">
        <h2>The useful move was not making the menu prettier.</h2>
        <div class="prose">
          <p>
            I changed the unit of the product from a catalogue of dishes to an order a person could judge: what is in it, what it costs, when it arrives, and how to get the same meal again.
          </p>
          <p>
            I owned product direction, research, information architecture, interaction, interface, and the Flutter implementation. Kitchens, recipes, pricing, and delivery operations were not mine.
          </p>
          <p>
            The measurement I would want now is repeat-order completion, followed by whether visible composition and delivery time reduced the “not worth it” complaint.
          </p>
        </div>
      </div>
    </section>

  </main>

  <footer class="case-footer">
    <p>SuperGood<br /><em>Homemade food, without making the order feel like a gamble.</em></p>
    <nav aria-label="SuperGood project links">
      <a href={sitePath('/work/')}>Back to work ↑</a>
      <a href={sitePath('/case-studies/two-sticks/')}>Two Sticks case study →</a>
      <a href={sitePath('/case-studies/observatory/')}>Observatory case study →</a>
    </nav>
  </footer>
</BaseDocument>

<script>
  document.documentElement.classList.add('has-scroll-stories');

  const activateFrame = (story: HTMLElement, index: number) => {
    story.querySelectorAll<HTMLElement>('[data-story-frame]').forEach((frame) => {
      frame.classList.toggle('is-active', Number(frame.dataset.storyFrame) === index);
    });
    story.querySelectorAll<HTMLElement>('[data-story-step]').forEach((step) => {
      step.classList.toggle('is-active', Number(step.dataset.storyStep) === index);
    });
  };

  document.querySelectorAll<HTMLElement>('[data-scroll-story]').forEach((story) => {
    if (story.dataset.storyReady) return;
    story.dataset.storyReady = 'true';

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const step = entry.target as HTMLElement;
        activateFrame(story, Number(step.dataset.storyStep));
      });
    }, { rootMargin: '-40% 0px -44%', threshold: 0 });

    story.querySelectorAll<HTMLElement>('[data-story-step]').forEach((step) => observer.observe(step));
  });

  const indexLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-index-link]'));
  const setCurrentSection = (id: string) => {
    indexLinks.forEach((link) => {
      if (link.dataset.indexLink === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) setCurrentSection(entry.target.id);
    });
  }, { rootMargin: '-44% 0px -48%', threshold: 0 });

  document.querySelectorAll<HTMLElement>('[data-index-section]').forEach((section) => sectionObserver.observe(section));
</script>

<style is:global>
