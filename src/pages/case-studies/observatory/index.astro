---
import { getImage, Image } from 'astro:assets';

import observatoryTitleTexture from '../../../assets/case_study_images/ditchered_observatory_bg.png';
import launchFilmPoster from '../../../assets/software-showcases/observatory/launch-film.png';
import flowConsolidation from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 7.png';
import flowNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 6.png';
import outcomeComparison from '../../../assets/case_study_images/outcome_screenshots/results-comparison.png';
import outcomeMemory from '../../../assets/case_study_images/outcome_screenshots/live-plot.png';
import outcomeNow from '../../../assets/case_study_images/outcome_screenshots/main.png';
import outcomeProcessDetails from '../../../assets/case_study_images/outcome_screenshots/processes-of-app.png';
import outcomeRecording from '../../../assets/case_study_images/outcome_screenshots/testing.png';
import outcomeSavedResults from '../../../assets/case_study_images/outcome_screenshots/tests-results.png';
import outcomeTestSetup from '../../../assets/case_study_images/outcome_screenshots/test-setup.png';
import prototypeHistory from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 5.png';
import prototypeNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 3.png';
import prototypeTest from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 8.png';
import personaIndependentTroubleshooter from '../../../assets/case_study_images/sketches/persona_1_v2.png';
import personaPerformanceVerifier from '../../../assets/case_study_images/sketches/persona_2_v2.png';
import sketchGrouping from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-1 2 1.png';
import sketchLevels from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-2 2 1.png';
import sketchRecording from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-3 2 1.png';
import sketchTestFlow from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-4 2 1.png';
import wireframeHistory from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 5.png';
import wireframeNowCards from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 3.png';
import wireframeNowList from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 9.png';
import wireframeSavedResults from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 11.png';
import wireframeTestComplex from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 8.png';
import wireframeTestSetup from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 10.png';
import { sitePath } from '../../../config/site';
import BaseDocument from '../../../layouts/BaseDocument.astro';

const repositoryURL = 'https://github.com/KidPudel/Observatory';
const releaseURL = 'https://github.com/KidPudel/Observatory/releases/latest';
const launchFilmURL = 'https://www.youtube.com/watch?v=6LWORcxVZmY&t=5s';
const launchFilmEmbedURL = 'https://www.youtube-nocookie.com/embed/6LWORcxVZmY?start=5&autoplay=1';
const heroTitle = 'Observatory';
const optimizedTitleTexture = await getImage({
  src: observatoryTitleTexture,
  width: 1600,
  format: 'webp',
  quality: 80,
});

const sketches = [
  { src: sketchGrouping, alt: 'Early sketch comparing loose processes with processes grouped by application.', caption: 'The first shift: from a loose field of processes to application groups.' },
  { src: sketchLevels, alt: 'Early sketch comparing application-level and process-level resource tables.', caption: 'Application totals first, with process detail one level below.' },
  { src: sketchRecording, alt: 'Early sketch of two applications being observed over the same ten-second period.', caption: 'A shared recording window makes the comparison legible.' },
  { src: sketchTestFlow, alt: 'Early sketch of selecting applications, recording each one, and reviewing the results.', caption: 'The first outline of a controlled test and its result.' },
];
---

<BaseDocument
  title="Observatory case study | Igor Kupchinenko"
  description="How I designed Observatory, a macOS activity monitor that groups related processes, records controlled tests, and keeps results available for comparison."
  pageClass="observatory-case-study"
  ogImage={outcomeNow.src}
>
  <nav class="topbar" aria-label="Case study navigation">
    <a href={sitePath('/#work')}>← My work</a>
    <span>Observatory / Case study</span>
    <a href={repositoryURL}>Source ↗</a>
  </nav>

  <nav class="chapter-index" aria-label="Case study sections">
    <p>Case study</p>
    <ol>
      <li><a href="#problem" data-index-link="problem"><span>01</span><span class="chapter-index__name">Catalyst</span></a></li>
      <li><a href="#research" data-index-link="research"><span>02</span><span class="chapter-index__name">Research</span></a></li>
      <li><a href="#direction" data-index-link="direction"><span>03</span><span class="chapter-index__name">Direction</span></a></li>
      <li><a href="#prototype" data-index-link="prototype"><span>04</span><span class="chapter-index__name">Prototype</span></a></li>
      <li><a href="#validation-intro" data-index-link="validation-intro"><span>05</span><span class="chapter-index__name">Iteration</span></a></li>
      <li><a href="#outcome" data-index-link="outcome"><span>06</span><span class="chapter-index__name">Outcome</span></a></li>
      <li><a href="#reflection" data-index-link="reflection"><span>07</span><span class="chapter-index__name">Reflection</span></a></li>
    </ol>
  </nav>

  <main id="main-content">
    <header class="hero">
      <p class="eyebrow">Product design · <time datetime="2026">2026</time> · Native macOS application</p>
      <h1
        class="hero-title"
        aria-label={heroTitle}
        style={`--hero-title-texture: url('${optimizedTitleTexture.src}')`}
      >
        {heroTitle.split('').map((letter, index) => (
          <span
            class="hero-title__letter"
            aria-hidden="true"
            data-letter={letter}
            style={`--letter-index: ${index}; --texture-position: ${(index / (heroTitle.length - 1)) * 100}%`}
          >
            {letter}
          </span>
        ))}
      </h1>
      <p class="hero__line">Activity Monitor, but more.</p>
      <p class="hero__intro">
        I wanted to make system activity easier to understand without removing the detail that makes it useful.
        Observatory groups related processes into applications, records controlled tests, and keeps the results
        available for comparison.
      </p>

      <dl class="facts">
        <div><dt>My role</dt><dd>Product direction, research, UX/UI, identity, motion</dd></div>
        <div><dt>Research</dt><dd>5 exploratory interviews</dd></div>
        <div><dt>Outcome</dt><dd>Working macOS prototype, release 0.1.1</dd></div>
        <div><dt>Build</dt><dd>AI-directed development from my specifications</dd></div>
      </dl>

      <figure class="hero-introduction">
        <a
          class="hero-introduction__link"
          href={launchFilmURL}
          data-introduction-film
          data-embed-src={launchFilmEmbedURL}
        >
          <span class="hero-introduction__stage">
            <Image
              src={launchFilmPoster}
              alt=""
              widths={[720, 1080, 1280]}
              sizes="(max-width: 760px) 94vw, 820px"
              format="webp"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <span class="hero-introduction__play" aria-hidden="true"></span>
          </span>
          <span class="sr-only">Watch the Observatory product introduction on YouTube</span>
        </a>
        <figcaption><span>Launch film</span> Product introduction</figcaption>
      </figure>
    </header>

    <section class="chapter" id="problem" data-index-section>
      <header class="chapter__label">
        <span>01</span>
        <p>The catalyst</p>
      </header>
      <div class="chapter__body">
        <h2>The numbers were there. The picture was not.</h2>
        <div class="prose">
          <p>
            I started Observatory because the default Activity Monitor kept making me do the interpretation.
            During resource-intensive work, one application could appear as several related processes. I had to
            find them, combine their values in my head, and keep watching so I would not miss a spike.
          </p>
          <p>
            Once the task ended, that evidence was gone. A screenshot could capture a moment, but it could not
            make two runs comparable.
          </p>
        </div>
        <blockquote>
          How can I see what an application did during the work, then return to the same evidence later?
        </blockquote>
      </div>
    </section>

    <section class="chapter" id="research" data-index-section>
      <header class="chapter__label">
        <span>02</span>
        <p>Research</p>
      </header>
      <div class="chapter__body">
        <h2>I looked at how people actually investigate performance.</h2>
        <div class="prose">
          <p>
            I needed insight into the people themselves, not only reactions to an interface. I gathered five people
            for exploratory interviews and asked them to reconstruct real moments when they investigated performance.
          </p>
          <p>
            Five conversations do not prove how common a behavior is. They gave me enough depth to understand the
            shape of the problem, find its language, and see where different needs separated.
          </p>
        </div>

        <div class="research-aims">
          <p class="research-label">What I wanted to understand</p>
          <ul>
            <li>How satisfied people were with the way they checked performance now.</li>
            <li>Where they struggled, and what evidence went missing while they worked.</li>
          </ul>
        </div>

        <div class="interview-structure">
          <div>
            <p class="research-label">Interview structure</p>
            <p>
              I started broad, then followed the person's own experience. This kept the conversation grounded in
              what they had actually done instead of what they imagined they might do.
            </p>
          </div>
          <ol>
            <li><span>01</span><p><strong>Context.</strong> Describe your relationship with computers and technical tools.</p></li>
            <li><span>02</span><p><strong>Current behavior.</strong> Walk me through the last time you checked performance and what you were trying to understand.</p></li>
            <li><span>03</span><p><strong>Limits.</strong> What was frustrating, what did you try next, and what could the live view not tell you?</p></li>
          </ol>
        </div>

        <div class="finding">
          <p>What changed my framing</p>
          <strong>People began with an application or a task, not with an isolated process.</strong>
        </div>

        <div class="persona-intro">
          <p>
            The patterns resolved into two working personas. They are a way to keep two different depths of need in
            the design, not a claim about the size of either audience.
          </p>
        </div>

        <div class="persona-sequence" aria-labelledby="working-personas-heading">
          <p class="research-label" id="working-personas-heading">Working personas</p>

          <article class="persona-profile">
            <div class="persona-profile__identity">
              <p class="persona-profile__number">01 / 02</p>
              <div class="persona-profile__portrait">
                <Image
                  src={personaIndependentTroubleshooter}
                  alt="Hand-drawn portrait of the independent troubleshooter persona wearing glasses and making an OK gesture."
                  widths={[240, 360, 480]}
                  sizes="(max-width: 760px) 50vw, 16rem"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3>Independent troubleshooter</h3>
              <div class="persona-profile__quote">
                <p class="research-label">Representative statement</p>
                <blockquote>“The numbers change so quickly that I’m never sure if I caught the actual problem or just a random spike.”</blockquote>
              </div>
            </div>

            <div class="persona-profile__observations">
              <section>
                <h4>Situation</h4>
                <p class="persona-profile__story">
                  A power user whose work can be resource-intensive. They understand common performance metrics and
                  know how to use Activity Monitor, but related processes and rapidly changing values force them to
                  assemble the picture manually while it keeps moving.
                </p>
              </section>
              <section>
                <h4>Needs</h4>
                <ul>
                  <li>See the whole application before opening process detail.</li>
                  <li>Catch short spikes with enough context to trust them.</li>
                  <li>Return to evidence after the task has ended.</li>
                </ul>
              </section>
              <section>
                <h4>Friction</h4>
                <ul>
                  <li>One application is divided across related processes.</li>
                  <li>Values change faster than they can be interpreted.</li>
                  <li>Screenshots and notes do not make runs comparable.</li>
                </ul>
              </section>
              <section class="persona-profile__response">
                <h4>Design response</h4>
                <p>Show the application as a whole, then let process detail wait until greater confidence is needed.</p>
              </section>
            </div>
          </article>

          <article class="persona-profile">
            <div class="persona-profile__identity">
              <p class="persona-profile__number">02 / 02</p>
              <div class="persona-profile__portrait">
                <Image
                  src={personaPerformanceVerifier}
                  alt="Hand-drawn portrait of the performance verifier persona writing on a clipboard."
                  widths={[240, 360, 480]}
                  sizes="(max-width: 760px) 50vw, 16rem"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3>Performance verifier</h3>
              <div class="persona-profile__quote">
                <p class="research-label">Representative statement</p>
                <blockquote>“Activity Monitor is useful for answering ‘what is happening now while I’m looking at it?’ It is weak at answering ‘what happened during that run?’”</blockquote>
              </div>
            </div>

            <div class="persona-profile__observations">
              <section>
                <h4>Situation</h4>
                <p class="persona-profile__story">
                  A developer who uses Activity Monitor for quick checks and advanced tools for deep profiling. The
                  missing layer sits between those extremes: lightweight evidence that can be recorded repeatedly,
                  trusted, and compared without losing its original context.
                </p>
              </section>
              <section>
                <h4>Needs</h4>
                <ul>
                  <li>Record the same kind of workload more than once.</li>
                  <li>Trust how applications, timing, and measurements are grouped.</li>
                  <li>Compare results without losing the original run.</li>
                </ul>
              </section>
              <section>
                <h4>Friction</h4>
                <ul>
                  <li>Live process data only explains the present moment.</li>
                  <li>Full profiling tools can be excessive for routine checks.</li>
                  <li>Loose screenshots cannot synchronize comparable evidence.</li>
                </ul>
              </section>
              <section class="persona-profile__response">
                <h4>Design response</h4>
                <p>Turn live observation into an intentional recording that can be reopened and compared.</p>
              </section>
            </div>
          </article>
        </div>

        <p class="research-synthesis">
          Both personas needed more than a list of processes. One needed a readable whole picture. The other needed
          evidence that survived the moment. Together, those needs defined the product direction.
        </p>
      </div>
    </section>

    <section class="chapter chapter--dark" id="direction" data-index-section>
      <header class="chapter__label">
        <span>03</span>
        <p>Direction</p>
      </header>
      <div class="chapter__body">
        <h2>The product became three decisions.</h2>
        <ol class="principles">
          <li><span>1</span><div><h3>Applications first</h3><p>Show the total cost of the thing a person recognizes. Keep the underlying processes available, but secondary.</p></div></li>
          <li><span>2</span><div><h3>Record the task</h3><p>Replace continuous watching with a defined observation: selected applications, warm-up, duration, and rounds.</p></div></li>
          <li><span>3</span><div><h3>Keep the evidence</h3><p>Save results locally so a person can inspect them later and compare like with like.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="image-chapter" aria-labelledby="sketches-title">
      <div class="image-chapter__heading">
        <p class="eyebrow">Explore and ideate</p>
        <h2 id="sketches-title">Before screens, I sketched the model.</h2>
        <p>The sketches were deliberately plain. I was deciding what should be grouped, recorded, and compared.</p>
      </div>
      <div class="sketch-grid">
        {sketches.map((sketch, index) => (
          <figure>
            <div class="sketch-surface"><Image src={sketch.src} alt={sketch.alt} widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, 38vw" format="webp" loading="lazy" decoding="async" /></div>
            <figcaption><span>0{index + 1}</span> {sketch.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="chapter chapter--wide" id="prototype" data-index-section>
      <header class="chapter__label">
        <span>04</span>
        <p>Prototype</p>
      </header>
      <div class="chapter__body">
        <h2>The first structure followed three destinations.</h2>
        <p class="wide-copy">
          Now showed current activity. Tests created a repeatable recording. History kept the output. This gave me
          a complete end-to-end path before I spent time on visual detail.
        </p>
      </div>

      <div class="scroll-story" data-scroll-story>
        <div class="scroll-story__stage" aria-live="off">
          <figure data-story-frame="0" class="is-active"><Image src={prototypeNow} alt="Initial low-fidelity Now screen with application cards." widths={[480, 720, 960]} sizes="(max-width: 760px) 94vw, 58vw" format="webp" loading="lazy" decoding="async" /></figure>
          <figure data-story-frame="1"><Image src={prototypeTest} alt="Initial low-fidelity test setup screen." widths={[480, 720, 960]} sizes="(max-width: 760px) 94vw, 58vw" format="webp" loading="lazy" decoding="async" /></figure>
          <figure data-story-frame="2"><Image src={prototypeHistory} alt="Initial low-fidelity History screen with saved recordings." widths={[480, 720, 960]} sizes="(max-width: 760px) 94vw, 58vw" format="webp" loading="lazy" decoding="async" /></figure>
        </div>
        <ol class="scroll-story__steps">
          <li data-story-step="0" class="is-active"><span>04.1</span><h3>Now</h3><p>Grouped application cards made the whole application visible, but not yet easy to scan.</p></li>
          <li data-story-step="1"><span>04.2</span><h3>Tests</h3><p>Choose applications and configure a repeatable run before recording.</p></li>
          <li data-story-step="2"><span>04.3</span><h3>History</h3><p>Reopen recordings and compare them after the live moment has passed.</p></li>
        </ol>
      </div>

      <div class="flow-evidence">
        <figure><Image src={flowNow} alt="Early linear flow for the Now experience." widths={[480, 720, 960]} sizes="(max-width: 760px) 94vw, 46vw" format="webp" loading="lazy" decoding="async" /><figcaption><span>04.4</span> The smallest possible path through the live view.</figcaption></figure>
        <figure><Image src={flowConsolidation} alt="Three prototype flows showing the consolidation of History into Saved Results within Tests." widths={[480, 720, 960]} sizes="(max-width: 760px) 94vw, 46vw" format="webp" loading="lazy" decoding="async" /><figcaption><span>04.5</span> I eventually folded History into Tests as Saved Results. Recording and reviewing were one workflow, not two products.</figcaption></figure>
      </div>
    </section>

    <section class="chapter" id="validation-intro" data-index-section>
      <header class="chapter__label">
        <span>05</span>
        <p>Iteration</p>
      </header>
      <div class="chapter__body">
        <h2>I reduced the interface before refining it.</h2>
        <p class="wide-copy">
          The early cards made each application feel self-contained, but they used too much space and made scanning
          harder. The first test setup also tried to keep configuration, recent tests, and an active round visible at
          once. At wireframe level, I separated those responsibilities and made the hierarchy quieter. These changes
          came from task analysis and design critique, not a formal usability study.
        </p>
      </div>
    </section>

    <section class="validation-board" aria-labelledby="validation-title">
      <header class="validation-board__heading">
        <h2 id="validation-title">what changed</h2>
        <p>Reviewing each flow against its intended task exposed three structural problems.</p>
      </header>

      <article class="validation-case validation-case--cards">
        <p>
          Application grouping as cards made each item visually heavy and left the interaction ambiguous. The grid
          also made a familiar collection harder to scan. Changing cards into a list made the applications more
          recognizable while a live plot kept the full picture visible.
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeNowCards} alt="Wireframe of a card-based live application view." widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, 36vw" format="webp" loading="lazy" decoding="async" /><figcaption>Card grouping</figcaption></figure>
          <span aria-hidden="true">→</span>
          <figure><Image src={wireframeNowList} alt="Wireframe of a simplified list-based live application view." widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, 36vw" format="webp" loading="lazy" decoding="async" /><figcaption>List with live plot</figcaption></figure>
        </div>
      </article>

      <article class="validation-case validation-case--tests">
        <p>
          In the test screen, the user first encountered a choice between manual and automated testing. That created
          friction before they reached what they actually wanted to do. Making application selection the first step
          created a more natural flow without overwhelming a non-technical user.
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeTestComplex} alt="Wireframe combining test setup, recent tests, and an active recording." widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, 36vw" format="webp" loading="lazy" decoding="async" /><figcaption>Everything at once</figcaption></figure>
          <span aria-hidden="true">→</span>
          <figure><Image src={wireframeTestSetup} alt="Wireframe of a simplified controlled test setup." widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, 36vw" format="webp" loading="lazy" decoding="async" /><figcaption>Choose, configure, start</figcaption></figure>
        </div>
      </article>

      <article class="validation-case validation-case--history">
        <p>
          Now, Tests, and History described the implementation structure more than user intent. Moving History into
          Tests as Saved Results reduced the number of destinations and made the relationship logical. A sidebar then
          made it easy to move between the list and a wide result without navigating back and forth.
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeHistory} alt="Wireframe of a separate History destination." widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, 36vw" format="webp" loading="lazy" decoding="async" /><figcaption>History as a destination</figcaption></figure>
          <span aria-hidden="true">→</span>
          <figure><Image src={wireframeSavedResults} alt="Wireframe of Saved Results inside the Tests workflow." widths={[320, 480, 640]} sizes="(max-width: 760px) 92vw, 36vw" format="webp" loading="lazy" decoding="async" /><figcaption>Saved Results inside Tests</figcaption></figure>
        </div>
      </article>
    </section>

    <section class="chapter chapter--wide chapter--outcome" id="outcome" data-index-section>
      <header class="chapter__label">
        <span>06</span>
        <p>Outcome</p>
      </header>
      <div class="chapter__body">
        <h2>A working product, not only a presentation.</h2>
        <div class="prose prose--split">
          <p>
            Observatory 0.1.1 runs on macOS 14 and later. The live view groups related processes, shows a sixty-second
            timeline, and reveals process detail when it is needed. Tests can record one to four applications with an
            optional warm-up and repeated rounds.
          </p>
          <p>
            Results remain on the Mac and can be reopened or compared. It is still an idea showcase more than a
            standalone product, but the core experience is real enough to use, question, and improve.
          </p>
        </div>
      </div>

      <div class="scroll-story scroll-story--outcome" data-scroll-story>
        <div class="scroll-story__stage" aria-live="off">
          <figure data-story-frame="0" class="is-active"><Image src={outcomeNow} alt="Final Observatory Now screen with live application data and a chart." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) 94vw, 920px" format="webp" quality={85} loading="lazy" decoding="async" /></figure>
          <figure data-story-frame="1"><Image src={outcomeProcessDetails} alt="Expanded process details in the final Observatory live view." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) 94vw, 920px" format="webp" quality={85} loading="lazy" decoding="async" /></figure>
          <figure data-story-frame="2"><Image src={outcomeMemory} alt="Final Observatory memory timeline chart." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) 94vw, 920px" format="webp" quality={85} loading="lazy" decoding="async" /></figure>
          <figure data-story-frame="3"><Image src={outcomeTestSetup} alt="Final Observatory controlled test setup screen." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) 94vw, 920px" format="webp" quality={85} loading="lazy" decoding="async" /></figure>
          <figure data-story-frame="4"><Image src={outcomeRecording} alt="Final Observatory guided recording screen." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) 94vw, 920px" format="webp" quality={85} loading="lazy" decoding="async" /></figure>
          <figure data-story-frame="5"><Image src={outcomeSavedResults} alt="Final Observatory Saved Results screen." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) 94vw, 920px" format="webp" quality={85} loading="lazy" decoding="async" /></figure>
