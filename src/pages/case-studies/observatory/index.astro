---
import { Image } from 'astro:assets';

import launchFilmPoster from '../../../assets/software-showcases/observatory/launch-film.png';
import outcomeComparison from '../../../assets/case_study_images/outcome_screenshots/results-comparison.png';
import outcomeNow from '../../../assets/case_study_images/outcome_screenshots/main.png';
import outcomeProcessDetails from '../../../assets/case_study_images/outcome_screenshots/processes-of-app.png';
import outcomeRecording from '../../../assets/case_study_images/outcome_screenshots/testing.png';
import outcomeSavedResults from '../../../assets/case_study_images/outcome_screenshots/tests-results.png';
import outcomeTestSetup from '../../../assets/case_study_images/outcome_screenshots/test-setup.png';
import prototypeHistory from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 5.png';
import prototypeNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 3.png';
import prototypeTest from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 8.png';
import personaIndependentTroubleshooter from '../../../assets/case_study_images/sketches/persona_1_v2.png';
import personaPerformanceVerifier from '../../../assets/case_study_images/sketches/persona_2_v2.png';
import sketchGrouping from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-1 2 1.png';
import sketchLevels from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-2 2 1.png';
import sketchRecording from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-3 2 1.png';
import sketchTestFlow from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-4 2 1.png';
import wireframeHistory from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 5.png';
import wireframeNowCards from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 3.png';
import wireframeNowList from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 9.png';
import wireframeSavedResults from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 11.png';
import wireframeTestComplex from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 8.png';
import wireframeTestSetup from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 10.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import DecisionBlock from '../../../components/case-studies/DecisionBlock.astro';
import More from '../../../components/case-studies/More.astro';
import Plate from '../../../components/case-studies/Plate.astro';
import Rich from '../../../components/case-studies/Rich.astro';
import Rows from '../../../components/case-studies/Rows.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudyLife from '../../../components/case-studies/StudyLife.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import EyepieceCover from '../../../components/case-studies/observatory/EyepieceCover.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import { caseStudy } from '../../../content/case-studies';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/plates.css';
import '../../../styles/study-structured.css';

const repositoryURL = 'https://github.com/KidPudel/Observatory';
const releaseURL = 'https://github.com/KidPudel/Observatory/releases/latest';
const launchFilmURL = 'https://www.youtube.com/watch?v=6LWORcxVZmY&t=5s';
const launchFilmEmbedURL = 'https://www.youtube-nocookie.com/embed/6LWORcxVZmY?start=5&autoplay=1';
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);

// One set of names, used in the short read, the navigation, and the sections.
const label = {
  problem: t('Problem', 'Проблема'),
  goal: t('Goal', 'Цель'),
  research: t('Research', 'Исследование'),
  decisions: t('Decisions', 'Решения'),
  result: t('Result', 'Результат'),
};
const goal = t(
  'Answer “what is this app using?” at a glance, and compare one run with another.',
  'Отвечать на вопрос «что потребляет это приложение?» с одного взгляда и сравнивать прогоны между собой.',
);

const sketches = [
  { src: sketchGrouping, alt: t('Early sketch comparing loose processes with processes grouped by application.', 'Ранний скетч: разрозненные процессы против процессов, сгруппированных по приложениям.'), caption: t('From a loose field of processes to app groups.', 'От россыпи процессов к группам по приложениям.') },
  { src: sketchLevels, alt: t('Early sketch comparing application-level and process-level resource tables.', 'Ранний скетч: таблицы ресурсов на уровне приложения и на уровне процесса.'), caption: t('App totals first, process detail one level below.', 'Сначала итог по приложению, детали процессов уровнем ниже.') },
  { src: sketchRecording, alt: t('Early sketch of two applications being observed over the same ten-second period.', 'Ранний скетч: два приложения под наблюдением в течение одних и тех же десяти секунд.'), caption: t('A shared recording window makes runs comparable.', 'Общее окно записи делает прогоны сравнимыми.') },
  { src: sketchTestFlow, alt: t('Early sketch of selecting applications, recording each one, and reviewing the results.', 'Ранний скетч: выбор приложений, запись каждого и просмотр результатов.'), caption: t('The first outline of a test and its result.', 'Первый набросок теста и его результата.') },
];

// Brave Browser as macOS lists it: the 17 processes behind one row in Observatory.
const braveProcesses = [
  'Brave Browser',
  ...Array<string>(4).fill('Brave Browser Helper'),
  ...Array<string>(12).fill('Brave Browser Helper (Renderer)'),
];

const categories = [
  { name: t('Terminals', 'Терминалы'), apps: ['Ghostty', 'kitty', 'Alacritty'] },
  { name: t('Code editors', 'Редакторы кода'), apps: ['Xcode', 'VS Code'] },
  { name: t('AI apps', 'AI-приложения'), apps: ['ChatGPT', 'Claude'] },
];

const constraints = [
  { name: t('Measured against Activity Monitor.', 'Сравнение с «Мониторингом системы».'), why: t('It’s the tool people already open, so every comparison is with it.', 'Это инструмент, который люди и так открывают, поэтому всё сравнивается с ним.') },
  { name: t('A small group.', 'Небольшая группа.'), why: t('5 interviews and 3 colleagues using it: enough to set a direction, not to speak for every Mac user.', '5 интервью и 3 коллеги, которые им пользуются: этого хватает, чтобы задать направление, но не чтобы говорить за всех пользователей Mac.') },
];

// The study's spine: every finding, where it came from, and what it led to.
const findings = [
  { title: t('People start from an app or a task, never from a process.', 'Люди начинают с приложения или задачи, а не с процесса.'), detail: '', who: t('Interviews', 'Интервью'), to: t('Decision 1: group by app', 'Решение 1: по приложениям'), href: '#decision-1' },
  { title: t('Comparing cards was slow.', 'Сравнивать карточки медленно.'), detail: t('Your eyes jumped between boxes to compare one number.', 'Чтобы сравнить одну цифру, взгляд прыгал между блоками.'), who: t('Prototype walkthrough', 'Проход по прототипу'), to: t('Decision 2: aligned list', 'Решение 2: список'), href: '#decision-2' },
  { title: t('Setup asked the wrong thing first.', 'Настройка спрашивала не то.'), detail: t('It wanted a recording mode before you’d picked an app.', 'Она просила режим записи раньше, чем вы выбрали приложение.'), who: t('Prototype walkthrough', 'Проход по прототипу'), to: t('Decision 3: test setup', 'Решение 3: настройка теста'), href: '#decision-3' },
  { title: t('A test and its result lived apart.', 'Тест и результат жили отдельно.'), detail: t('A test ended in Tests, but its result was in History.', 'Тест заканчивался в «Tests», а результат был в «History».'), who: t('Prototype walkthrough', 'Проход по прототипу'), to: t('Decision 4: saved results', 'Решение 4: результаты'), href: '#decision-4' },
  { title: t('Comparisons need context.', 'Сравнению нужен контекст.'), detail: '', who: t('Interviews', 'Интервью'), to: t('Decision 4: saved results', 'Решение 4: результаты'), href: '#decision-4' },
];
---

<BaseDocument
  title={t('Observatory case study | Igor Kupchinenko', 'Кейс Observatory | Игорь Купчиненко')}
  description={t(
    'How I designed Observatory, a macOS activity monitor that shows each app as one row, records tests, and compares runs. Three colleagues have used it for two months.',
    'Как я проектировал Observatory, монитор активности для macOS: он показывает каждое приложение одной строкой, записывает тесты и сравнивает прогоны. Три коллеги пользуются им уже два месяца.',
  )}
  pageClass="study-plates study-structured study--observatory"
  ogImage={outcomeNow.src}
>
  <main id="main-content" data-present={localePath('/case-studies/observatory/present/', locale)}>
    <!-- The first screen is the short read: each label leads to its section. -->
    <EyepieceCover
      title="Observatory"
      about={caseStudy('observatory').about}
      navLabel="TL;DR"
      view={outcomeNow}
      viewAlt={t('Final Observatory Now screen with live application data and a chart.', 'Финальный экран «Now» в Observatory с живыми данными приложений и графиком.')}
    >
      <Rows rows={[
        { label: label.problem, href: '#problem', text: t('Activity Monitor lists processes, not apps. One browser can take up 17 rows, and nothing is kept once the moment’s gone.', '«Мониторинг системы» показывает процессы, а не приложения. Один браузер может занять 17 строк, и как только момент прошёл, ничего не остаётся.') },
        { label: label.goal, href: '#goal', text: goal },
        { label: label.research, href: '#research', text: t('5 interviews. People started from an app or a task, never from a process.', '5 интервью. Люди начинали с приложения или задачи, а не с процесса.') },
        { label: label.decisions, href: '#decisions', text: t('Show each app as one row, its processes one level down, plus three fixes to comparing and recording runs.', 'Показывать каждое приложение одной строкой, а его процессы уровнем ниже, и ещё три исправления в сравнении и записи прогонов.') },
        { label: label.result, href: '#results', tone: 'result', text: t('Reading one app’s total went from **17 rows to 1**, about 3 seconds instead of 60 by my estimate. **All 3 colleagues** who tried it still use it two months later.', 'Чтобы увидеть итог одного приложения, теперь нужна **1 строка вместо 17**, по моей оценке это примерно 3 секунды вместо 60. **Все 3 коллеги**, которые попробовали Observatory, пользуются им и спустя два месяца.') },
      ]} />
    </EyepieceCover>

    <StudySection part="problem">
      <div class="stack">
        <p class="opening">{t(
          'During heavy work I’d open Activity Monitor to find the app I was using. Its activity was split across lots of processes, so I had to find them, add them up in my head, and keep watching while they changed. And once the task ended, there was nothing to come back to.',
          'Во время тяжёлой работы я открывал «Мониторинг системы», чтобы найти приложение, которым пользуюсь. Его активность была раскидана по множеству процессов: найди их, сложи в уме и следи, пока цифры меняются. А когда задача заканчивалась, вернуться было не к чему.',
        )}</p>

        <!-- The same app in both tools. As it arrives, the 17 rows gather into Observatory's one. -->
        <figure class="process-split gather" data-arrive>
          <div class="process-split__side">
            <p class="process-split__tool">{t('Activity Monitor', 'Мониторинг системы')}</p>
            <ol class="process-split__rows" aria-hidden="true">
              {braveProcesses.map((name) => <li>{name}</li>)}
            </ol>
            <p class="process-split__count">{t('17 rows to find and add up', '17 строк, которые нужно найти и сложить')}</p>
          </div>
          <div class="process-split__side">
            <p class="process-split__tool">Observatory</p>
            <div class="process-split__stack">
              {braveProcesses.map((name, index) => <span class="gather__ghost process-split__ghost" style={`--i: ${index}`} aria-hidden="true">{name}</span>)}
              <div class="process-split__app gather__one" aria-hidden="true">
                <span class="process-split__name">Brave Browser</span>
                <span class="process-split__procs">{t('17 processes', '17 процессов')}</span>
                <strong>1.9 GiB</strong>
              </div>
            </div>
            <p class="process-split__count">{t('1 row, already added up', '1 строка, уже сложено')}</p>
          </div>
          <figcaption class="process-split__caption">{t(
            'The same app in both tools. Process names are as macOS lists them, and the total comes from Observatory’s live view.',
            'Одно и то же приложение в обоих инструментах. Названия процессов такие, как их показывает macOS, итог взят из живого просмотра Observatory.',
          )}</figcaption>
        </figure>

        <Rows rows={[
          { label: t('The job', 'Задача'), tone: 'key', text: t('When I’m doing heavy work, I want to see what an app is using and keep a record, so I can come back to it and compare.', 'Когда я делаю тяжёлую работу, я хочу видеть, что потребляет приложение, и сохранять запись, чтобы вернуться к ней и сравнить.'), source: t('Written as a job story (Jobs to be Done)', 'Записано как job story (Jobs to be Done)') },
        ]} />
      </div>
    </StudySection>

    <StudySection part="goal">
      <div class="goal">
        <Rows rows={[
          { label: label.goal, tone: 'key', text: goal },
          { label: t('How I’d know', 'Как пойму'), list: [
            t('How long it takes to read an app’s total', 'Сколько времени нужно, чтобы увидеть итог по приложению'),
            t('Whether people can compare runs without screenshots', 'Могут ли люди сравнить прогоны без скриншотов'),
            t('Whether anyone keeps using it', 'Продолжают ли им пользоваться'),
          ] },
        ]} />
      </div>
    </StudySection>

    <StudySection part="constraints">
      <ul class="constraints" role="list">
        {constraints.map((item) => <li><strong>{item.name}</strong> {item.why}</li>)}
      </ul>
    </StudySection>

    <StudySection
      part="research"
      lead={t(
        'First I checked it wasn’t just my problem. In customer development interviews framed around Jobs to be Done, five people walked me through the last time they looked into performance: what they wanted to know, where they looked, and what they couldn’t find.',
        'Сначала я проверил, что проблема не только у меня. В CustDev-интервью в логике Jobs to be Done пять человек рассказали, как в последний раз разбирались с производительностью: что хотели узнать, где смотрели и чего не нашли.',
      )}
    >
      <!-- The two kinds of people behind the interviews, drawn by hand. -->
      <div class="personas">
        <figure class="persona">
          <Image src={personaIndependentTroubleshooter} alt={t('Hand-drawn portrait of the independent troubleshooter persona wearing glasses and making an OK gesture.', 'Нарисованный от руки портрет персоны «самостоятельный диагност»: человек в очках показывает жест «ОК».')} widths={[240, 360, 480]} sizes="144px" format="webp" loading="lazy" decoding="async" />
          <figcaption>
            <strong>{t('Independent troubleshooter', 'Самостоятельный диагност')}</strong>
            <span>{t('Checks their own Mac.', 'Проверяет свой Mac.')}</span>
            <span>{t('When I check what my Mac is doing, I want to see the whole app and catch a spike, so I don’t have to piece it together from a changing list.', 'Когда я смотрю, что происходит с Mac, я хочу видеть приложение целиком и замечать пики, чтобы не собирать картину по меняющемуся списку.')}</span>
          </figcaption>
        </figure>
        <figure class="persona">
          <Image src={personaPerformanceVerifier} alt={t('Hand-drawn portrait of the performance verifier persona writing on a clipboard.', 'Нарисованный от руки портрет персоны «проверяющий производительность»: человек делает записи на планшете для бумаг.')} widths={[240, 360, 480]} sizes="144px" format="webp" loading="lazy" decoding="async" />
          <figcaption>
            <strong>{t('Performance verifier', 'Проверяющий производительность')}</strong>
            <span>{t('A developer comparing runs.', 'Разработчик, который сравнивает прогоны.')}</span>
            <span>{t('When I change my app, I want before and after recordings with enough context, so the comparison actually means something.', 'Когда я меняю приложение, я хочу записи до и после с понятным контекстом, чтобы сравнение действительно что-то значило.')}</span>
          </figcaption>
        </figure>
      </div>

      <p class="statement" data-arrive><Rich text={t(
        'Both started from an app or a task, ==never from a process==.',
        'Оба начинали с приложения или задачи, ==а не с процесса==.',
      )} /></p>

      <h3>{t('What I found, and what it led to', 'Что я узнал и к чему это привело')}</h3>
      <div class="spine">
        <table>
          <thead>
            <tr>
              <th scope="col">{t('Finding', 'Что выяснилось')}</th>
              <th scope="col">{t('Where it came from', 'Откуда')}</th>
              <th scope="col">{t('What it led to', 'К чему привело')}</th>
            </tr>
          </thead>
          <tbody>
            {findings.map((row) => (
              <tr>
                <th scope="row"><strong>{row.title}</strong>{row.detail && <> <span>{row.detail}</span></>}</th>
                <td class="spine__who">{row.who}</td>
                <td class="spine__to"><a href={row.href}><span class="link-mark">{row.to}</span></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="details-group">
        <More summary={t('My first four sketches', 'Мои первые четыре скетча')}>
          <div class="sketches">
            {sketches.map((sketch) => (
              <figure class="sketch">
                <Image src={sketch.src} alt={sketch.alt} widths={[320, 480, 640]} sizes="(max-width: 1099px) calc((100vw - 64px) / 2), 15rem" format="webp" loading="lazy" decoding="async" />
                <figcaption>{sketch.caption}</figcaption>
              </figure>
            ))}
          </div>
        </More>
        <More summary={t('The first prototype: Now, Tests, and History', 'Первый прототип: «Now», «Tests» и «History»')}>
          <Plate kind="desktop" shots={[
            { src: prototypeNow, alt: t('Initial low-fidelity Now screen with application cards.', 'Первый черновой экран «Now» с карточками приложений.'), label: t('Now: a quick look', '«Now»: быстрый взгляд') },
            { src: prototypeTest, alt: t('Initial low-fidelity test setup screen.', 'Первый черновой экран настройки теста.'), label: t('Tests: record a run', '«Tests»: записать прогон') },
            { src: prototypeHistory, alt: t('Initial low-fidelity History screen with saved recordings.', 'Первый черновой экран «History» с сохранёнными записями.'), label: t('History: return to results', '«History»: вернуться к результатам') },
          ]} />
        </More>
      </div>
    </StudySection>

    <StudySection
      part="decisions"
      lead={t(
        'Four decisions. The first came from the interviews and sketches, the other three from walking through the first prototype.',
        'Четыре решения. Первое выросло из интервью и скетчей, остальные три из прохода по первому прототипу.',
      )}
    >
      <DecisionBlock
        number={1}
        title={t('Group processes under their app', 'Процессы под своим приложением')}
        navLabel={t('Group by app', 'По приложениям')}
        layout="band"
        why={t('One app showed up as lots of rows, so its real cost was hidden.', 'Одно приложение занимало много строк, и его реальная нагрузка терялась.')}
        what={t('Both jobs started from an app. If each app is one row with its totals, people can answer “what is this app using?” without adding anything up. So each app became one row, with its processes one level below, open only when you need them.', 'Обе задачи начинались с приложения. Если каждое приложение будет одной строкой с итогами, ответить «что потребляет это приложение?» можно, ничего не складывая. Поэтому каждое приложение стало одной строкой, а его процессы лежат уровнем ниже и раскрываются, только когда нужны.')}
        notChosen={t('a flat process list with search, like Activity Monitor. You’d still be adding up rows yourself.', 'плоский список процессов с поиском, как в «Мониторинге системы». Складывать строки всё равно пришлось бы самому.')}
      >
        <Plate kind="desktop" caption={t('Totals first. Processes when you need them.', 'Сначала итоги, процессы по запросу.')} shots={[{ src: outcomeProcessDetails, alt: t('Expanded process details in the final Observatory live view.', 'Раскрытые детали процессов в финальном живом просмотре Observatory.') }]} notes={[
          { x: 1, y: 2, w: 98, h: 12, label: t('One row, with the app’s totals', 'Одна строка с итогами приложения') },
          { x: 1.5, y: 20, w: 97, h: 79, label: t('Its processes, one level below', 'Процессы уровнем ниже') },
        ]} />
      </DecisionBlock>

      <DecisionBlock
        number={2}
        title={t('An aligned list instead of cards', 'Выровненный список вместо карточек')}
        navLabel={t('Aligned list', 'Список')}
        layout="band"
        why={t('Cards grouped the processes, but comparing apps meant your eyes jumping between boxes.', 'Карточки группировали процессы, но чтобы сравнить приложения, взгляд прыгал между блоками.')}
        what={t('In aligned columns, one metric compares down a column in a single glance. So the cards became a compact list, with a live chart below it.', 'В выровненных колонках одну метрику можно сравнить одним взглядом сверху вниз. Поэтому карточки стали компактным списком с живым графиком под ним.')}
      >
        <Plate kind="desktop" together shots={[
          { src: wireframeNowList, alt: t('Wireframe of a simplified list-based live application view.', 'Вайрфрейм упрощённого живого просмотра приложений списком.'), label: t('After: an aligned list with a live chart', 'После: выровненный список с живым графиком') },
          { src: wireframeNowCards, alt: t('Wireframe of a card-based live application view.', 'Вайрфрейм живого просмотра приложений на карточках.'), label: t('Before: a card per app', 'До: карточка на приложение') },
        ]} />
      </DecisionBlock>

      <DecisionBlock
        number={3}
        title={t('Pick apps before the recording mode', 'Сначала приложения, потом режим записи')}
        navLabel={t('Test setup', 'Настройка теста')}
        layout="band"
