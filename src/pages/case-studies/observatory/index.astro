---
import { getImage, Image } from 'astro:assets';

import observatoryTitleTexture from '../../../assets/case_study_images/ditchered_observatory_bg.png';
import launchFilmPoster from '../../../assets/software-showcases/observatory/launch-film.png';
import outcomeComparison from '../../../assets/case_study_images/outcome_screenshots/results-comparison.png';
import outcomeNow from '../../../assets/case_study_images/outcome_screenshots/main.png';
import outcomeProcessDetails from '../../../assets/case_study_images/outcome_screenshots/processes-of-app.png';
import outcomeRecording from '../../../assets/case_study_images/outcome_screenshots/testing.png';
import outcomeSavedResults from '../../../assets/case_study_images/outcome_screenshots/tests-results.png';
import outcomeTestSetup from '../../../assets/case_study_images/outcome_screenshots/test-setup.png';
import prototypeHistory from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 5.png';
import prototypeNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 3.png';
import prototypeTest from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 8.png';
import personaIndependentTroubleshooter from '../../../assets/case_study_images/sketches/persona_1_v2.png';
import personaPerformanceVerifier from '../../../assets/case_study_images/sketches/persona_2_v2.png';
import sketchGrouping from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-1 2 1.png';
import sketchLevels from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-2 2 1.png';
import sketchRecording from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-3 2 1.png';
import sketchTestFlow from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-4 2 1.png';
import wireframeHistory from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 5.png';
import wireframeNowCards from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 3.png';
import wireframeNowList from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 9.png';
import wireframeSavedResults from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 11.png';
import wireframeTestComplex from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 8.png';
import wireframeTestSetup from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 10.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import Cover from '../../../components/case-studies/Cover.astro';
import Decision from '../../../components/case-studies/Decision.astro';
import Rich from '../../../components/case-studies/Rich.astro';
import Shot from '../../../components/case-studies/Shot.astro';
import StarSummary from '../../../components/case-studies/StarSummary.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudyLife from '../../../components/case-studies/StudyLife.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/study.css';

const repositoryURL = 'https://github.com/KidPudel/Observatory';
const releaseURL = 'https://github.com/KidPudel/Observatory/releases/latest';
const launchFilmURL = 'https://www.youtube.com/watch?v=6LWORcxVZmY&t=5s';
const launchFilmEmbedURL = 'https://www.youtube-nocookie.com/embed/6LWORcxVZmY?start=5&autoplay=1';
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const heroTitle = 'Observatory';
const optimizedTitleTexture = await getImage({
  src: observatoryTitleTexture,
  width: 1600,
  format: 'webp',
  quality: 80,
});
const wideSizes = '(max-width: 1100px) calc(100vw - 40px), 940px';
const halfSizes = '(max-width: 760px) calc(100vw - 40px), 460px';
const thirdSizes = '(max-width: 760px) calc(100vw - 40px), 300px';

const sketches = [
  {
    src: sketchGrouping,
    alt: t('Early sketch comparing loose processes with processes grouped by application.', 'Ранний скетч: разрозненные процессы против процессов, сгруппированных по приложениям.'),
    caption: t('From a loose field of processes to app groups.', 'От россыпи процессов к группам по приложениям.'),
  },
  {
    src: sketchLevels,
    alt: t('Early sketch comparing application-level and process-level resource tables.', 'Ранний скетч: таблицы ресурсов на уровне приложения и на уровне процесса.'),
    caption: t('App totals first, process detail one level below.', 'Сначала итог по приложению, детали процессов уровнем ниже.'),
  },
  {
    src: sketchRecording,
    alt: t('Early sketch of two applications being observed over the same ten-second period.', 'Ранний скетч: два приложения под наблюдением в течение одних и тех же десяти секунд.'),
    caption: t('A shared recording window makes runs comparable.', 'Общее окно записи делает прогоны сравнимыми.'),
  },
  {
    src: sketchTestFlow,
    alt: t('Early sketch of selecting applications, recording each one, and reviewing the results.', 'Ранний скетч: выбор приложений, запись каждого и просмотр результатов.'),
    caption: t('The first outline of a test and its result.', 'Первый набросок теста и его результата.'),
  },
];

// Brave Browser as macOS lists it: the 17 processes behind one row in Observatory.
const braveProcesses = [
  'Brave Browser',
  ...Array<string>(4).fill('Brave Browser Helper'),
  ...Array<string>(12).fill('Brave Browser Helper (Renderer)'),
];

const categories = [
  { name: t('Terminals', 'Терминалы'), apps: ['Ghostty', 'kitty', 'Alacritty'] },
  { name: t('Code editors', 'Редакторы кода'), apps: ['Xcode', 'VS Code'] },
  { name: t('AI apps', 'AI-приложения'), apps: ['ChatGPT', 'Claude'] },
];
---

<BaseDocument
  title={t('Observatory case study | Igor Kupchinenko', 'Кейс Observatory | Игорь Купчиненко')}
  description={t(
    'How I designed Observatory, a macOS activity monitor that shows each app as one row, records tests, and compares runs. Three colleagues have used it for two months.',
    'Как я проектировал Observatory, монитор активности для macOS: он показывает каждое приложение одной строкой, записывает тесты и сравнивает прогоны. Три коллеги пользуются им уже два месяца.',
  )}
  pageClass="study-document study--observatory"
  ogImage={outcomeNow.src}
>
  <main id="main-content">
    <Cover
      pitch={t('Activity Monitor, but more.', 'Как «Мониторинг системы», только больше.')}
      facts={[
        t('Product design, research, identity, and the launch film. I wrote the specs and directed AI development', 'Продуктовый дизайн, исследование, айдентика и ролик к запуску. Писал спецификации и руководил разработкой с AI'),
        '2026',
        t('Release 0.1.1 for macOS 14 and later, used by 3 colleagues for about two months.', 'Релиз 0.1.1 для macOS 14 и новее, им около двух месяцев пользуются 3 коллеги.'),
      ]}
    >
      <h1
        slot="title"
        class="cover__title wordmark"
        aria-label={heroTitle}
        style={`--hero-title-texture: url('${optimizedTitleTexture.src}')`}
      >
        {heroTitle.split('').map((letter, index) => (
          <span
            class="wordmark__letter"
            aria-hidden="true"
            data-letter={letter}
            style={`--letter-index: ${index}; --texture-position: ${(index / (heroTitle.length - 1)) * 100}%`}
          >
            {letter}
          </span>
        ))}
      </h1>

      <figure class="film">
        <a
          class="film__link"
          href={launchFilmURL}
          data-introduction-film
          data-embed-src={launchFilmEmbedURL}
          data-embed-title={t('Observatory product introduction', 'Презентация Observatory')}
        >
          <span class="film__stage">
            <Image
              src={launchFilmPoster}
              alt=""
              widths={[720, 1080, 1280]}
              sizes="(max-width: 1100px) calc(100vw - 40px), 1100px"
              format="webp"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <span class="film__play" aria-hidden="true"></span>
          </span>
          <span class="sr-only">{t('Watch the Observatory product introduction on YouTube', 'Смотреть презентацию Observatory на YouTube')}</span>
        </a>
        <figcaption>{t('Product introduction', 'Презентация продукта')}</figcaption>
      </figure>
    </Cover>

    <StarSummary
      situation={t(
        'Activity Monitor lists processes, not apps. One browser can take up 17 rows, and nothing is kept once the moment’s gone.',
        '«Мониторинг системы» показывает процессы, а не приложения. Один браузер может занять 17 строк, и как только момент прошёл, ничего не остаётся.',
      )}
      task={t(
        'Let people see an app as one thing, then record a run and compare it with the next one.',
        'Дать увидеть приложение целиком, а потом записать прогон и сравнить его со следующим.',
      )}
      action={t(
        'I ran 5 customer development interviews framed around Jobs to be Done, to check it wasn’t just my problem. Then I sketched, made a rough prototype, and changed three things after walking through it.',
        'Провёл 5 CustDev-интервью в логике Jobs to be Done, чтобы проверить, что проблема не только у меня. Потом скетчи, черновой прототип и три изменения после разбора сценариев.',
      )}
      result={t(
        'Reading one app’s total went from **17 rows to 1** (Brave Browser), which takes **about 3 seconds instead of 60**. **All 3 colleagues** who tried it still use it two months later.',
        'Чтобы увидеть итог одного приложения, теперь нужна **1 строка вместо 17** (Brave Browser), и это **примерно 3 секунды вместо 60**. **Все 3 коллеги**, которые попробовали Observatory, пользуются им и спустя два месяца.',
      )}
      caption={t(
        'The time estimate comes from walking through both apps, not from a formal study.',
        'Оценка времени получена при проходе по обоим приложениям, а не в формальном исследовании.',
      )}
    />

    <StudySection
      part="problem"
      lead={t(
        'During heavy work I’d open Activity Monitor to find the app I was using. Its activity was split across lots of processes, so I had to find them, add them up in my head, and keep watching while they changed. Not exactly a calm way to check memory. And once the task ended, there was nothing to come back to.',
        'Во время тяжёлой работы я открывал «Мониторинг системы», чтобы найти приложение, которым пользуюсь. Его активность была раскидана по множеству процессов: найди их, сложи в уме и следи, пока цифры меняются. Не самый спокойный способ проверить память. А когда задача заканчивалась, вернуться было не к чему.',
      )}
    >
      <!-- The same app in both tools. As it arrives, the 17 rows gather into Observatory's one. -->
      <figure class="process-split col-wide gather" data-arrive>
        <div class="process-split__side">
          <p class="process-split__tool">{t('Activity Monitor', 'Мониторинг системы')}</p>
          <ol class="process-split__rows" aria-hidden="true">
            {braveProcesses.map((name) => <li>{name}</li>)}
          </ol>
          <p class="process-split__count">{t('17 rows to find and add up', '17 строк, которые нужно найти и сложить')}</p>
        </div>
        <div class="process-split__side">
          <p class="process-split__tool">Observatory</p>
          <div class="process-split__stack">
            {braveProcesses.map((name, index) => <span class="gather__ghost process-split__ghost" style={`--i: ${index}`} aria-hidden="true">{name}</span>)}
            <div class="process-split__app gather__one" aria-hidden="true">
              <span class="process-split__name">Brave Browser</span>
              <span class="process-split__procs">{t('17 processes', '17 процессов')}</span>
              <strong>1.9 GiB</strong>
            </div>
          </div>
          <p class="process-split__count">{t('1 row, already added up', '1 строка, уже сложено')}</p>
        </div>
        <figcaption class="process-split__caption">{t(
          'The same app in both tools. Process names are as macOS lists them, and the total comes from Observatory’s live view.',
          'Одно и то же приложение в обоих инструментах. Названия процессов такие, как их показывает macOS, итог взят из живого просмотра Observatory.',
        )}</figcaption>
      </figure>

      <p>{t('So the job, written as a job story (Jobs to be Done):', 'Если записать это как job story (Jobs to be Done):')}</p>
      <p class="job-story">{t(
        'When I’m doing heavy work, I want to see what an app is using and keep a record, so I can come back to it and compare.',
        'Когда я делаю тяжёлую работу, я хочу видеть, что потребляет приложение, и сохранять запись, чтобы вернуться к ней и сравнить.',
      )}</p>
    </StudySection>

    <StudySection
      part="goal"
      lead={t(
        'It was a personal project, and I measured it against Activity Monitor, since that’s the tool people already open.',
        'Это был личный проект, и я сравнивал его с «Мониторингом системы», ведь его люди и так открывают.',
      )}
    >
      <p>{t(
        'The goal was to answer “what is this app using?” at a glance, and to compare one run with another. To know if it worked, I’d look at how long it takes to read an app’s total, whether people can compare runs without screenshots, and whether anyone keeps using it.',
        'Цель была отвечать на вопрос «что потребляет это приложение?» с одного взгляда и сравнивать прогоны между собой. Понять, получилось ли, я собирался по тому, сколько времени нужно, чтобы увидеть итог по приложению, могут ли люди сравнить прогоны без скриншотов и продолжают ли им пользоваться.',
      )}</p>
    </StudySection>

    <StudySection
      part="research"
      lead={t(
        'First, I checked it wasn’t just my problem. Before building anything, I ran customer development interviews framed around Jobs to be Done. Five people walked me through the last time they looked into performance: what they wanted to know, where they looked, and what they couldn’t find. Their answers showed it was worth building.',
        'Сначала я проверил, что проблема не только у меня. Прежде чем что-то делать, я провёл CustDev-интервью в логике Jobs to be Done. Пять человек рассказали, как в последний раз разбирались с производительностью: что хотели узнать, куда смотрели и чего не смогли найти. По их ответам стало ясно, что это стоит делать.',
      )}
    >
      <div class="personas col-wide">
        <figure class="persona">
          <Image
            src={personaIndependentTroubleshooter}
            alt={t('Hand-drawn portrait of the independent troubleshooter persona wearing glasses and making an OK gesture.', 'Нарисованный от руки портрет персоны «самостоятельный диагност»: человек в очках показывает жест «ОК».')}
            widths={[240, 360, 480]}
            sizes="180px"
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{t('Independent troubleshooter', 'Самостоятельный диагност')}</figcaption>
          <p>{t('Checks their own Mac.', 'Проверяет свой Mac.')}</p>
          <p><strong>{t('Job story.', 'Job story.')}</strong> {t('When I check what my Mac is doing, I want to see the whole app and catch a spike, so I don’t have to piece it together from a changing list.', 'Когда я смотрю, что происходит с Mac, я хочу видеть приложение целиком и замечать пики, чтобы не собирать картину по меняющемуся списку.')}</p>
        </figure>
        <figure class="persona">
          <Image
            src={personaPerformanceVerifier}
            alt={t('Hand-drawn portrait of the performance verifier persona writing on a clipboard.', 'Нарисованный от руки портрет персоны «проверяющий производительность»: человек делает записи на планшете для бумаг.')}
            widths={[240, 360, 480]}
            sizes="180px"
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{t('Performance verifier', 'Проверяющий производительность')}</figcaption>
          <p>{t('A developer comparing runs.', 'Разработчик, который сравнивает прогоны.')}</p>
          <p><strong>{t('Job story.', 'Job story.')}</strong> {t('When I change my app, I want before and after recordings with enough context, so the comparison actually means something.', 'Когда я меняю приложение, я хочу записи до и после с понятным контекстом, чтобы сравнение действительно что-то значило.')}</p>
        </figure>
      </div>

      <p class="statement" data-arrive><Rich text={t(
        'Both started from an app or a task, ==never from a process==. So the interface, and my first sketches, start from the app.',
        'Оба начинали с приложения или задачи, ==а не с процесса==. Поэтому интерфейс, а с ним и мои первые скетчи, начинаются с приложения.',
      )} /></p>

      <div class="sketches col-full">
        {sketches.map((sketch) => (
          <figure class="sketch">
            <Image src={sketch.src} alt={sketch.alt} widths={[320, 480, 640]} sizes="(max-width: 900px) calc((100vw - 64px) / 2), 270px" format="webp" loading="lazy" decoding="async" />
            <figcaption>{sketch.caption}</figcaption>
          </figure>
        ))}
      </div>

      <p>{t('From the sketches I made a first prototype with three places to go: Now, Tests, and History.', 'По скетчам я собрал первый прототип с тремя разделами: «Now», «Tests» и «History».')}</p>
      <div class="prototype-row col-wide">
        <Shot kind="desktop" src={prototypeNow} sizes={thirdSizes} alt={t('Initial low-fidelity Now screen with application cards.', 'Первый черновой экран «Now» с карточками приложений.')} caption={t('Now: a quick look', '«Now»: быстрый взгляд')} />
        <Shot kind="desktop" src={prototypeTest} sizes={thirdSizes} alt={t('Initial low-fidelity test setup screen.', 'Первый черновой экран настройки теста.')} caption={t('Tests: record a run', '«Tests»: записать прогон')} />
        <Shot kind="desktop" src={prototypeHistory} sizes={thirdSizes} alt={t('Initial low-fidelity History screen with saved recordings.', 'Первый черновой экран «History» с сохранёнными записями.')} caption={t('History: return to results', '«History»: вернуться к результатам')} />
      </div>
      <p class="note">{t(
        'Decision 1 came straight from the interviews and sketches. Decisions 2 to 4 came from walking through this prototype, with task walkthroughs and design critique rather than a formal usability study.',
        'Решение 1 выросло прямо из интервью и скетчей. Решения со 2 по 4 появились после прохода по этому прототипу: из разбора сценариев и дизайн-критики, а не из формального юзабилити-исследования.',
      )}</p>
    </StudySection>

    <StudySection part="decisions">
      <Decision
        number={1}
        layout="stack"
        title={t('Group processes under their app', 'Процессы под своим приложением')}
        navLabel={t('Group by app', 'По приложениям')}
        problem={t('One app showed up as lots of rows, so its real cost was hidden.', 'Одно приложение занимало много строк, и его реальная нагрузка терялась.')}
        decision={t('So each app became one row with its totals. Its processes sit one level below and open only when you need them.', 'Поэтому каждое приложение стало одной строкой с итогами. Процессы лежат уровнем ниже и раскрываются, только когда нужно.')}
        why={t('Both jobs started from an app. And things that belong together should look together, which is the Gestalt principle of common region.', 'Обе задачи начинались с приложения. А то, что связано, должно и выглядеть вместе: это гештальт-принцип общей области.')}
        instead={t('A flat process list with search, like Activity Monitor, was the other option, but you’d still be adding up rows yourself.', 'Другим вариантом был плоский список процессов с поиском, как в «Мониторинге системы», но складывать строки всё равно пришлось бы самому.')}
        effect={t('Brave Browser went from **17 rows to 1**.', 'Brave Browser занимает **1 строку вместо 17**.')}
        source={t('measured in the live view', 'измерено в живом просмотре')}
      >
        <Shot kind="desktop" src={outcomeProcessDetails} sizes={wideSizes} alt={t('Expanded process details in the final Observatory live view.', 'Раскрытые детали процессов в финальном живом просмотре Observatory.')} caption={t('Totals first. Processes when you need them.', 'Сначала итоги, процессы по запросу.')} />
      </Decision>

      <Decision
        number={2}
        layout="stack"
        title={t('An aligned list instead of cards', 'Выровненный список вместо карточек')}
        navLabel={t('Aligned list', 'Список')}
        problem={t('Cards grouped the processes, but comparing apps meant your eyes jumping between boxes.', 'Карточки группировали процессы, но чтобы сравнить приложения, взгляд прыгал между блоками.')}
        decision={t('I switched to a compact list with numbers in aligned columns, and a live chart below it.', 'Я перешёл на компактный список с цифрами в выровненных колонках и живым графиком под ним.')}
        why={t('With aligned columns, you can compare one metric down a column in a single glance.', 'В выровненных колонках одну метрику можно сравнить одним взглядом сверху вниз.')}
        instead={t('The card grid from the first prototype kept the groups clear, but comparing was slow.', 'Сетка карточек из первого прототипа хорошо показывала группы, но сравнивать в ней было медленно.')}
      >
        <div class="pair pair--wide">
          <Shot kind="wireframe" src={wireframeNowCards} sizes={halfSizes} alt={t('Wireframe of a card-based live application view.', 'Вайрфрейм живого просмотра приложений на карточках.')} caption={t('Before: a card per app', 'До: карточка на приложение')} />
          <Shot kind="wireframe" src={wireframeNowList} sizes={halfSizes} alt={t('Wireframe of a simplified list-based live application view.', 'Вайрфрейм упрощённого живого просмотра приложений списком.')} caption={t('After: an aligned list with a live chart', 'После: выровненный список с живым графиком')} />
        </div>
      </Decision>

      <Decision
        number={3}
        layout="stack"
        title={t('Pick apps before the recording mode', 'Сначала приложения, потом режим записи')}
        navLabel={t('Test setup', 'Настройка теста')}
        problem={t('Test setup asked for manual or automated mode before you’d even picked an app.', 'Настройка теста спрашивала про ручной или автоматический режим ещё до выбора приложения.')}
        decision={t('Now you pick the apps first, then the recording mode, and setup and the running recording are separate screens.', 'Теперь сначала выбираешь приложения, потом режим записи, а настройка и идущая запись стали отдельными экранами.')}
