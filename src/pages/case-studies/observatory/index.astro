---
import { getImage, Image } from 'astro:assets';

import observatoryTitleTexture from '../../../assets/case_study_images/ditchered_observatory_bg.png';
import launchFilmPoster from '../../../assets/software-showcases/observatory/launch-film.png';
import outcomeComparison from '../../../assets/case_study_images/outcome_screenshots/results-comparison.png';
import outcomeNow from '../../../assets/case_study_images/outcome_screenshots/main.png';
import outcomeProcessDetails from '../../../assets/case_study_images/outcome_screenshots/processes-of-app.png';
import outcomeRecording from '../../../assets/case_study_images/outcome_screenshots/testing.png';
import outcomeSavedResults from '../../../assets/case_study_images/outcome_screenshots/tests-results.png';
import outcomeTestSetup from '../../../assets/case_study_images/outcome_screenshots/test-setup.png';
import prototypeHistory from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 5.png';
import prototypeNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 3.png';
import prototypeTest from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 8.png';
import personaIndependentTroubleshooter from '../../../assets/case_study_images/sketches/persona_1_v2.png';
import personaPerformanceVerifier from '../../../assets/case_study_images/sketches/persona_2_v2.png';
import sketchGrouping from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-1 2 1.png';
import sketchLevels from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-2 2 1.png';
import sketchRecording from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-3 2 1.png';
import sketchTestFlow from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-4 2 1.png';
import wireframeHistory from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 5.png';
import wireframeNowCards from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 3.png';
import wireframeNowList from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 9.png';
import wireframeSavedResults from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 11.png';
import wireframeTestComplex from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 8.png';
import wireframeTestSetup from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 10.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import Decision from '../../../components/case-studies/Decision.astro';
import DotStat from '../../../components/case-studies/DotStat.astro';
import MetricGrid from '../../../components/case-studies/MetricGrid.astro';
import Shot from '../../../components/case-studies/Shot.astro';
import StarSummary from '../../../components/case-studies/StarSummary.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/case-study.css';

const repositoryURL = 'https://github.com/KidPudel/Observatory';
const releaseURL = 'https://github.com/KidPudel/Observatory/releases/latest';
const launchFilmURL = 'https://www.youtube.com/watch?v=6LWORcxVZmY&t=5s';
const launchFilmEmbedURL = 'https://www.youtube-nocookie.com/embed/6LWORcxVZmY?start=5&autoplay=1';
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const heroTitle = 'Observatory';
const optimizedTitleTexture = await getImage({
  src: observatoryTitleTexture,
  width: 1600,
  format: 'webp',
  quality: 80,
});
const halfSizes = '(max-width: 760px) calc(100vw - 40px), 524px';
const thirdSizes = '(max-width: 760px) calc(100vw - 40px), 350px';

const sketches = [
  {
    src: sketchGrouping,
    alt: t('Early sketch comparing loose processes with processes grouped by application.', 'Ранний скетч: разрозненные процессы против процессов, сгруппированных по приложениям.'),
    caption: t('From a loose field of processes to app groups.', 'От россыпи процессов к группам по приложениям.'),
  },
  {
    src: sketchLevels,
    alt: t('Early sketch comparing application-level and process-level resource tables.', 'Ранний скетч: таблицы ресурсов на уровне приложения и на уровне процесса.'),
    caption: t('App totals first, process detail one level below.', 'Сначала итог по приложению, детали процессов уровнем ниже.'),
  },
  {
    src: sketchRecording,
    alt: t('Early sketch of two applications being observed over the same ten-second period.', 'Ранний скетч: два приложения под наблюдением в течение одних и тех же десяти секунд.'),
    caption: t('A shared recording window makes runs comparable.', 'Общее окно записи делает прогоны сравнимыми.'),
  },
  {
    src: sketchTestFlow,
    alt: t('Early sketch of selecting applications, recording each one, and reviewing the results.', 'Ранний скетч: выбор приложений, запись каждого и просмотр результатов.'),
    caption: t('The first outline of a test and its result.', 'Первый набросок теста и его результата.'),
  },
];

// Brave Browser as macOS lists it: the 17 processes behind one row in Observatory.
const braveProcesses = [
  'Brave Browser',
  ...Array<string>(4).fill('Brave Browser Helper'),
  ...Array<string>(12).fill('Brave Browser Helper (Renderer)'),
];

const categories = [
  { name: t('Terminals', 'Терминалы'), apps: ['Ghostty', 'kitty', 'Alacritty'] },
  { name: t('Code editors', 'Редакторы кода'), apps: ['Xcode', 'VS Code'] },
  { name: t('AI apps', 'AI-приложения'), apps: ['ChatGPT', 'Claude'] },
];
---

<BaseDocument
  title={t('Observatory case study | Igor Kupchinenko', 'Кейс Observatory | Игорь Купчиненко')}
  description={t(
    'How I designed Observatory, a macOS activity monitor that shows each app as one row, records tests, and compares runs. Three colleagues have used it for two months.',
    'Как я проектировал Observatory, монитор активности для macOS, который показывает приложение одной строкой, записывает тесты и сравнивает прогоны. Три коллеги пользуются им уже два месяца.',
  )}
  pageClass="observatory-case-study editorial-case-study"
  ogImage={outcomeNow.src}
>
  <main id="main-content">
    <header class="hero">
      <h1
        class="hero-title"
        aria-label={heroTitle}
        style={`--hero-title-texture: url('${optimizedTitleTexture.src}')`}
      >
        {heroTitle.split('').map((letter, index) => (
          <span
            class="hero-title__letter"
            aria-hidden="true"
            data-letter={letter}
            style={`--letter-index: ${index}; --texture-position: ${(index / (heroTitle.length - 1)) * 100}%`}
          >
            {letter}
          </span>
        ))}
      </h1>
      <p class="hero__line">{t('Activity Monitor, but more.', 'Мониторинг системы, но больше.')}</p>

      <dl class="facts">
        <div><dt>{t('My role', 'Моя роль')}</dt><dd>{t('Product design, research, identity, and launch film', 'Продуктовый дизайн, исследование, айдентика и фильм к запуску')}</dd></div>
        <div><dt>{t('Build', 'Разработка')}</dt><dd>{t('AI-directed development from my specifications', 'Разработка с AI по моим спецификациям')}</dd></div>
        <div><dt>{t('Timeline', 'Сроки')}</dt><dd>{t('2026 · macOS 14 and later · release 0.1.1', '2026 · macOS 14 и новее · релиз 0.1.1')}</dd></div>
        <div><dt>{t('Used by', 'Кто пользуется')}</dt><dd>{t('3 colleagues, for about two months', '3 коллеги, около двух месяцев')}</dd></div>
      </dl>

      <figure class="hero-introduction">
        <a
          class="hero-introduction__link"
          href={launchFilmURL}
          data-introduction-film
          data-embed-src={launchFilmEmbedURL}
          data-embed-title={t('Observatory product introduction', 'Презентация Observatory')}
        >
          <span class="hero-introduction__stage">
            <Image
              src={launchFilmPoster}
              alt=""
              widths={[720, 1080, 1280]}
              sizes="(max-width: 760px) calc(100vw - 40px), 780px"
              format="webp"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <span class="hero-introduction__play" aria-hidden="true"></span>
          </span>
          <span class="sr-only">{t('Watch the Observatory product introduction on YouTube', 'Смотреть презентацию Observatory на YouTube')}</span>
        </a>
        <figcaption>{t('Product introduction', 'Презентация продукта')}</figcaption>
      </figure>
    </header>

    <StarSummary
      situation={t(
        'Activity Monitor lists processes, not apps. One browser can be 17 rows, and nothing stays once the moment passes.',
        'Мониторинг системы показывает процессы, а не приложения. Один браузер может занимать 17 строк, и ничего не остаётся, когда момент прошёл.',
      )}
      task={t(
        'Let people read an app as one thing, then record a run and compare it with the next.',
        'Дать людям видеть приложение целиком, а потом записать прогон и сравнить его со следующим.',
      )}
      action={t(
        '5 interviews to check it was worth building, 2 jobs, sketches, and a prototype. Then 3 changes: a list instead of cards, the app before the mode, and results inside Tests.',
        '5 интервью, чтобы проверить, стоит ли это делать, 2 задачи, скетчи и прототип. Затем 3 изменения: список вместо карточек, сначала приложение, потом режим, и результаты внутри «Tests».',
      )}
      result={t(
        'A working macOS app. 3 colleagues have used it for two months to compare versions of an app and whole categories of apps.',
        'Рабочее приложение для macOS. 3 коллеги уже два месяца сравнивают в нём версии приложения и целые категории приложений.',
      )}
    />

    <MetricGrid
      metrics={[
        { value: '17 → 1', label: t('rows to read one app’s total (Brave Browser)', 'строк, чтобы увидеть итог одного приложения (Brave Browser)'), basis: t('Measured in the live view', 'Измерено в живом просмотре') },
        { value: t('≈60 s → ≈3 s', '≈60 с → ≈3 с'), label: t('to answer “how much memory is this app using?”', 'чтобы ответить «сколько памяти ест это приложение?»'), basis: t('Estimate: adding 17 changing values vs reading one', 'Оценка: сложить 17 меняющихся значений или прочитать одно') },
        { value: '3 → 2', label: t('places to go, after folding History into Tests', 'раздела после объединения «History» с «Tests»'), basis: t('Counted from the prototypes', 'Посчитано по прототипам') },
        { value: t('3 of 3', '3 из 3'), label: t('colleagues still using it after two months', 'коллеги пользуются им спустя два месяца'), basis: t('Measured', 'Факт') },
      ]}
      caption={t(
        'Estimates come from walking through both apps, not from a formal study.',
        'Оценки получены при проходе по обоим приложениям, а не в формальном исследовании.',
      )}
    />

    <StudySection
      part="situation"
      title={t('The numbers were there. The picture was not.', 'Цифры были. Картины не было.')}
      lead={t(
        'During heavy work I would open Activity Monitor to find the app I was using. Its activity was split across many processes. I had to find them, add them up in my head, and keep watching while they changed. Once the task ended, there was nothing to return to.',
        'Во время тяжёлой работы я открывал Мониторинг системы, чтобы найти приложение, которым пользуюсь. Его активность была разбита на много процессов. Нужно было найти их, сложить в уме и следить, пока цифры меняются. А когда задача заканчивалась, возвращаться было не к чему.',
      )}
    >
      <figure class="process-split breakout">
        <div class="process-split__side">
          <p class="process-split__tool">{t('Activity Monitor', 'Мониторинг системы')}</p>
          <ol class="process-split__rows" aria-hidden="true">
            {braveProcesses.map((name) => <li>{name}</li>)}
          </ol>
          <p class="process-split__count">{t('17 rows to find and add up', '17 строк, которые нужно найти и сложить')}</p>
        </div>
        <div class="process-split__side process-split__side--after">
          <p class="process-split__tool">Observatory</p>
          <div class="process-split__app" aria-hidden="true">
            <span class="process-split__name">Brave Browser</span>
            <span class="process-split__procs">{t('17 processes', '17 процессов')}</span>
            <strong>1.9 GiB</strong>
          </div>
          <p class="process-split__count">{t('1 row, already added up', '1 строка, уже сложено')}</p>
        </div>
        <figcaption class="process-split__caption">{t(
          'The same app in both tools. Process names as macOS lists them; the total comes from Observatory’s live view.',
          'Одно и то же приложение в обоих инструментах. Названия процессов такие, как их показывает macOS; итог взят из живого просмотра Observatory.',
        )}</figcaption>
      </figure>

      <p class="insight">{t(
        'The job: when I do heavy work, I want to see what an app is using and keep a record, so I can come back to it and compare.',
        'Задача: когда я делаю тяжёлую работу, я хочу видеть, что использует приложение, и сохранять запись, чтобы вернуться к ней и сравнить.',
      )}</p>
    </StudySection>

    <StudySection
      part="task"
      title={t('Read the app. Keep the evidence.', 'Видеть приложение. Сохранять данные.')}
      lead={t(
        'A personal project. I owned the product, research, design, identity, and launch, and directed AI development from my specifications.',
        'Личный проект. Я отвечал за продукт, исследование, дизайн, айдентику и запуск, а разработкой с AI руководил по своим спецификациям.',
      )}
    >
      <dl class="goal breakout">
        <div><dt>{t('Goal', 'Цель')}</dt><dd>{t('Answer “what is this app using?” at a glance, and compare one run with another.', 'Отвечать на вопрос «что использует это приложение?» с одного взгляда и сравнивать один прогон с другим.')}</dd></div>
        <div><dt>{t('How I would know', 'Как понять, что получилось')}</dt><dd>{t('Time to read an app’s total. Whether people can compare runs without screenshots. Whether anyone keeps using it.', 'Время, чтобы увидеть итог по приложению. Могут ли люди сравнить прогоны без скриншотов. Продолжают ли им пользоваться.')}</dd></div>
        <div><dt>{t('Baseline', 'С чем сравниваю')}</dt><dd>{t('macOS Activity Monitor, the tool people already open.', 'Мониторинг системы в macOS, инструмент, который люди уже открывают.')}</dd></div>
      </dl>
    </StudySection>

    <StudySection
      part="action"
      title={t('Five interviews. Two jobs. One starting point.', 'Пять интервью. Две задачи. Одна точка старта.')}
      lead={t(
        'Before building anything, I wanted to know if this was only my problem. I ran customer development interviews in the jobs-to-be-done style: five people walked me through the last time they investigated performance, what they wanted to know, where they looked, and what they could not find. Their answers showed it was worth building.',
        'Прежде чем что-то делать, я хотел понять, только ли у меня эта проблема. Я провёл CustDev-интервью в стиле Jobs to be Done: пять человек рассказали, как в последний раз разбирались с производительностью, что хотели узнать, куда смотрели и чего не смогли найти. Их ответы показали, что это стоит делать.',
      )}
    >
      <div class="research-portraits">
        <figure>
          <Image
            src={personaIndependentTroubleshooter}
            alt={t('Hand-drawn portrait of the independent troubleshooter persona wearing glasses and making an OK gesture.', 'Нарисованный от руки портрет персоны «самостоятельный диагност»: человек в очках показывает жест «ОК».')}
            widths={[240, 360, 480]}
            sizes="180px"
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{t('Independent troubleshooter', 'Самостоятельный диагност')}</figcaption>
          <p>{t('Checks their own Mac.', 'Проверяет свой Mac.')}</p>
          <p><strong>{t('Job:', 'Задача:')}</strong> {t('When I check what my Mac is doing, I want to see the whole app and catch a spike, so I do not piece it together from a changing list.', 'Когда я смотрю, что происходит с Mac, я хочу видеть приложение целиком и ловить пик, чтобы не собирать картину по меняющемуся списку.')}</p>
        </figure>
        <figure>
          <Image
            src={personaPerformanceVerifier}
            alt={t('Hand-drawn portrait of the performance verifier persona writing on a clipboard.', 'Нарисованный от руки портрет персоны «проверяющий производительность»: человек делает записи на планшете для бумаг.')}
            widths={[240, 360, 480]}
            sizes="180px"
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{t('Performance verifier', 'Проверяющий производительность')}</figcaption>
          <p>{t('A developer comparing runs.', 'Разработчик, который сравнивает прогоны.')}</p>
          <p><strong>{t('Job:', 'Задача:')}</strong> {t('When I change my app, I want recordings of before and after with enough context, so the comparison means something.', 'Когда я меняю приложение, я хочу записи до и после с контекстом, чтобы сравнение было осмысленным.')}</p>
        </figure>
      </div>

      <p class="insight">{t(
        'Both started with an app or a task, never with a process. So the interface starts with the app.',
        'Оба начинали с приложения или задачи, а не с процесса. Поэтому интерфейс начинается с приложения.',
      )}</p>

      <div class="sketch-grid">
        {sketches.map((sketch) => (
          <figure>
            <div class="sketch-surface"><Image src={sketch.src} alt={sketch.alt} widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /></div>
            <figcaption>{sketch.caption}</figcaption>
          </figure>
        ))}
      </div>

      <h3 class="prototype-title">{t('The first prototype had three places to go.', 'В первом прототипе было три раздела.')}</h3>
      <div class="prototype-row breakout">
        <Shot kind="desktop" src={prototypeNow} sizes={thirdSizes} alt={t('Initial low-fidelity Now screen with application cards.', 'Первый черновой экран «Now» с карточками приложений.')} caption={t('Now: a quick look', '«Now»: быстрый взгляд')} />
        <Shot kind="desktop" src={prototypeTest} sizes={thirdSizes} alt={t('Initial low-fidelity test setup screen.', 'Первый черновой экран настройки теста.')} caption={t('Tests: record a run', '«Tests»: записать прогон')} />
        <Shot kind="desktop" src={prototypeHistory} sizes={thirdSizes} alt={t('Initial low-fidelity History screen with saved recordings.', 'Первый черновой экран «History» с сохранёнными записями.')} caption={t('History: return to results', '«History»: вернуться к результатам')} />
      </div>
      <p class="note">{t(
        'Walking through this prototype led to the changes below. They came from task walkthroughs and design critique, not a formal usability study.',
        'Проход по этому прототипу привёл к изменениям ниже. Они появились из разбора задач и критики дизайна, а не из формального юзабилити-исследования.',
      )}</p>

      <Decision
        number={1}
        title={t('Group processes under their app.', 'Собрать процессы под их приложением.')}
        problem={t('One app showed up as many rows, so its real cost was hidden.', 'Одно приложение занимало много строк, и его настоящая нагрузка была скрыта.')}
        decision={t('One row per app with totals. Its processes wait one level below, opened only when needed.', 'Одна строка на приложение с итогами. Его процессы ждут уровнем ниже и открываются, только когда нужно.')}
        why={t('Both jobs started from an app. And by the Gestalt principle of common region, things that belong together should look together.', 'Обе задачи начинались с приложения. А по гештальт-принципу общей области то, что связано, должно выглядеть вместе.')}
        instead={t('A flat process list with search, like Activity Monitor. You would still add up the rows yourself.', 'Плоского списка процессов с поиском, как в Мониторинге системы. Складывать строки всё равно пришлось бы самому.')}
        effect={t('Brave Browser: 17 rows → 1', 'Brave Browser: 17 строк → 1')}
        effectLabel={t('Measured', 'Измерено')}
      >
        <Shot kind="desktop" src={outcomeProcessDetails} sizes={halfSizes} alt={t('Expanded process details in the final Observatory live view.', 'Раскрытые детали процессов в финальном живом просмотре Observatory.')} caption={t('Totals first. Processes on demand.', 'Сначала итоги. Процессы по запросу.')} />
      </Decision>

      <Decision
        number={2}
        layout="stack"
        title={t('A list, not cards.', 'Список, а не карточки.')}
        problem={t('Cards grouped the processes, but comparing apps meant eyes jumping between boxes.', 'Карточки группировали процессы, но чтобы сравнить приложения, взгляд прыгал между блоками.')}
        decision={t('A compact list with numbers in aligned columns, and a live chart below.', 'Компактный список с цифрами в выровненных колонках и живой график под ним.')}
        why={t('Aligned columns let you compare one metric down a column in a single glance.', 'Выровненные колонки позволяют сравнить одну метрику одним взглядом сверху вниз.')}
        instead={t('The card grid from the first prototype: clear groups, slow comparison.', 'Сетки карточек из первого прототипа: группы понятны, сравнивать медленно.')}
      >
        <div class="pair pair--stack-mobile">
          <Shot kind="wireframe" src={wireframeNowCards} sizes={halfSizes} alt={t('Wireframe of a card-based live application view.', 'Вайрфрейм живого просмотра приложений на карточках.')} caption={t('Before: a card per app', 'До: карточка на приложение')} />
          <Shot kind="wireframe" src={wireframeNowList} sizes={halfSizes} alt={t('Wireframe of a simplified list-based live application view.', 'Вайрфрейм упрощённого живого просмотра приложений списком.')} caption={t('After: aligned list with a live chart', 'После: выровненный список с живым графиком')} />
        </div>
      </Decision>

      <Decision
        number={3}
        layout="stack"
        title={t('Choose what to observe, then how.', 'Сначала что наблюдать, потом как.')}
