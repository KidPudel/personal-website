<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-introduction-film]').forEach((link) => {
    const embedSrc = link.dataset.embedSrc;
    const stage = link.querySelector('.film__stage');
    if (!embedSrc || !stage) return;

    link.addEventListener('click', (event) => {
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.className = 'film__player';
      frame.src = embedSrc;
      frame.title = link.dataset.embedTitle ?? '';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.setAttribute('allowfullscreen', '');
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      stage.replaceChildren(frame);
      link.replaceWith(stage);
      frame.focus();
    });
  });
</script>

