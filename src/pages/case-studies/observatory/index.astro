---
import { getImage, Image } from 'astro:assets';

import observatoryTitleTexture from '../../../assets/case_study_images/ditchered_observatory_bg.png';
import launchFilmPoster from '../../../assets/software-showcases/observatory/launch-film.png';
import flowConsolidation from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 7.png';
import flowNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 6.png';
import outcomeComparison from '../../../assets/case_study_images/outcome_screenshots/results-comparison.png';
import outcomeMemory from '../../../assets/case_study_images/outcome_screenshots/live-plot.png';
import outcomeNow from '../../../assets/case_study_images/outcome_screenshots/main.png';
import outcomeProcessDetails from '../../../assets/case_study_images/outcome_screenshots/processes-of-app.png';
import outcomeRecording from '../../../assets/case_study_images/outcome_screenshots/testing.png';
import outcomeSavedResults from '../../../assets/case_study_images/outcome_screenshots/tests-results.png';
import outcomeTestSetup from '../../../assets/case_study_images/outcome_screenshots/test-setup.png';
import prototypeHistory from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 5.png';
import prototypeNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 3.png';
import prototypeTest from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 8.png';
import personaIndependentTroubleshooter from '../../../assets/case_study_images/sketches/persona_1_v2.png';
import personaPerformanceVerifier from '../../../assets/case_study_images/sketches/persona_2_v2.png';
import sketchGrouping from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-1 2 1.png';
import sketchLevels from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-2 2 1.png';
import sketchRecording from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-3 2 1.png';
import sketchTestFlow from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-4 2 1.png';
import wireframeHistory from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 5.png';
import wireframeNowCards from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 3.png';
import wireframeNowList from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 9.png';
import wireframeSavedResults from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 11.png';
import wireframeTestComplex from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 8.png';
import wireframeTestSetup from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 10.png';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/case-study.css';

const repositoryURL = 'https://github.com/KidPudel/Observatory';
const releaseURL = 'https://github.com/KidPudel/Observatory/releases/latest';
const launchFilmURL = 'https://www.youtube.com/watch?v=6LWORcxVZmY&t=5s';
const launchFilmEmbedURL = 'https://www.youtube-nocookie.com/embed/6LWORcxVZmY?start=5&autoplay=1';
const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const heroTitle = 'Observatory';
const optimizedTitleTexture = await getImage({
  src: observatoryTitleTexture,
  width: 1600,
  format: 'webp',
  quality: 80,
});

const sketches = [
  {
    src: sketchGrouping,
    alt: t('Early sketch comparing loose processes with processes grouped by application.', 'Ранний скетч: разрозненные процессы против процессов, сгруппированных по приложениям.'),
    caption: t('The first shift: from a loose field of processes to application groups.', 'Первый сдвиг: от россыпи процессов к группам по приложениям.'),
  },
  {
    src: sketchLevels,
    alt: t('Early sketch comparing application-level and process-level resource tables.', 'Ранний скетч: таблицы ресурсов на уровне приложения и на уровне процесса.'),
    caption: t('Application totals first, with process detail one level below.', 'Сначала итог по приложению, детали процессов уровнем ниже.'),
  },
  {
    src: sketchRecording,
    alt: t('Early sketch of two applications being observed over the same ten-second period.', 'Ранний скетч: два приложения под наблюдением в течение одних и тех же десяти секунд.'),
    caption: t('A shared recording window makes the comparison legible.', 'Общее окно записи делает сравнение понятным.'),
  },
  {
    src: sketchTestFlow,
    alt: t('Early sketch of selecting applications, recording each one, and reviewing the results.', 'Ранний скетч: выбор приложений, запись каждого и просмотр результатов.'),
    caption: t('The first outline of a controlled test and its result.', 'Первый набросок контролируемого теста и его результата.'),
  },
];
---

<BaseDocument
  title={t('Observatory case study | Igor Kupchinenko', 'Кейс Observatory | Игорь Купчиненко')}
  description={t(
    'How I designed Observatory, a macOS activity monitor that groups related processes, records controlled tests, and keeps results available for comparison.',
    'Как я проектировал Observatory, монитор активности для macOS, который группирует связанные процессы, записывает контролируемые тесты и сохраняет результаты для сравнения.',
  )}
  pageClass="observatory-case-study editorial-case-study"
  ogImage={outcomeNow.src}
>


  <main id="main-content">
    <header class="hero">

      <h1
        class="hero-title"
        aria-label={heroTitle}
        style={`--hero-title-texture: url('${optimizedTitleTexture.src}')`}
      >
        {heroTitle.split('').map((letter, index) => (
          <span
            class="hero-title__letter"
            aria-hidden="true"
            data-letter={letter}
            style={`--letter-index: ${index}; --texture-position: ${(index / (heroTitle.length - 1)) * 100}%`}
          >
            {letter}
          </span>
        ))}
      </h1>
      <p class="hero__line">{t('Activity Monitor, but more.', 'Мониторинг системы, но больше.')}</p>
      <p class="hero__intro">
        {t(
          'An application could appear as several processes. A spike could disappear before I understood it. I designed Observatory to bring those pieces together and record what happened while I worked.',
          'Одно приложение может выглядеть как несколько процессов. Пик нагрузки может исчезнуть раньше, чем я успею в нём разобраться. Я спроектировал Observatory, чтобы собрать эти части вместе и записывать, что происходило, пока я работал.',
        )}
      </p>

      <dl class="facts">
        <div><dt>{t('My role', 'Моя роль')}</dt><dd>{t('Product direction, research, UX/UI, identity, motion', 'Продуктовое видение, исследование, UX/UI, айдентика, моушн')}</dd></div>
        <div><dt>{t('Research', 'Исследование')}</dt><dd>{t('5 exploratory interviews', '5 исследовательских интервью')}</dd></div>
        <div><dt>{t('Outcome', 'Результат')}</dt><dd>{t('2026 · Working macOS prototype, release 0.1.1', '2026 · Рабочий прототип для macOS, релиз 0.1.1')}</dd></div>
        <div><dt>{t('Build', 'Разработка')}</dt><dd>{t('AI-directed development from my specifications', 'Разработка с AI по моим спецификациям')}</dd></div>
      </dl>

      <figure class="hero-introduction">
        <a
          class="hero-introduction__link"
          href={launchFilmURL}
          data-introduction-film
          data-embed-src={launchFilmEmbedURL}
          data-embed-title={t('Observatory product introduction', 'Презентация Observatory')}
        >
          <span class="hero-introduction__stage">
            <Image
              src={launchFilmPoster}
              alt=""
              widths={[720, 1080, 1280]}
              sizes="(max-width: 760px) calc(100vw - 40px), 780px"
              format="webp"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <span class="hero-introduction__play" aria-hidden="true"></span>
          </span>
          <span class="sr-only">{t('Watch the Observatory product introduction on YouTube', 'Смотреть презентацию Observatory на YouTube')}</span>
        </a>
        <figcaption>{t('Product introduction', 'Презентация продукта')}</figcaption>
      </figure>
    </header>

    <section class="chapter" id="problem" data-index-section>

      <div class="chapter__body">
        <h2>{t('The numbers were there. The picture was not.', 'Цифры были. Картины не было.')}</h2>
        <div class="prose">
          <p>
            {t(
              'I would open Activity Monitor during resource-intensive work and look for the application I was using. Its activity was spread across several processes. I had to find them, add their values in my head, and keep watching. By then, the numbers had changed again.',
              'Во время ресурсоёмкой работы я открывал Мониторинг системы и искал приложение, которым пользовался. Его активность была разбросана по нескольким процессам. Нужно было найти их, сложить значения в уме и продолжать следить. К этому моменту цифры уже снова менялись.',
            )}
          </p>
          <p>
            {t(
              'And once the task ended, there was nothing to return to. A screenshot caught one moment. It could not tell me what happened across the whole run, or how the next run differed.',
              'А когда задача заканчивалась, возвращаться было не к чему. Скриншот ловил один момент. Он не мог рассказать, что происходило за весь прогон и чем от него отличался следующий.',
            )}
          </p>
        </div>
        <blockquote>
          {t(
            'How can I see what an application did during the work, then return to the same evidence later?',
            'Как увидеть, что приложение делало во время работы, и потом вернуться к тем же данным?',
          )}
        </blockquote>
      </div>
    </section>

    <section class="chapter" id="research" data-index-section>

      <div class="chapter__body">
        <h2>{t('People were looking for an application, too.', 'Люди тоже искали приложение.')}</h2>
        <div class="prose">
          <p>{t(
            'I asked five people to walk me through the last time they investigated performance: what they wanted to know, where they looked, and what they could not find. These exploratory conversations suggested two needs to design for.',
            'Я попросил пятерых человек рассказать, как они в последний раз разбирались с производительностью: что хотели узнать, куда смотрели и чего не смогли найти. Эти исследовательские разговоры подсказали две потребности, под которые стоило проектировать.',
          )}</p>
        </div>
        <div class="research-portraits">
          <figure><Image
                  src={personaIndependentTroubleshooter}
                  alt={t('Hand-drawn portrait of the independent troubleshooter persona wearing glasses and making an OK gesture.', 'Нарисованный от руки портрет персоны «самостоятельный диагност»: человек в очках показывает жест «ОК».')}
                  widths={[240, 360, 480]}
                  sizes="180px"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                /><figcaption>{t('Independent troubleshooter', 'Самостоятельный диагност')}</figcaption>
            <p>{t(
              'Someone checking their own Mac needed to see the whole application and catch a spike without piecing together a changing list.',
              'Человеку, который проверяет свой Mac, нужно было видеть приложение целиком и ловить пик, не собирая картину по меняющемуся списку.',
            )}</p>
          </figure>
          <figure><Image
                  src={personaPerformanceVerifier}
                  alt={t('Hand-drawn portrait of the performance verifier persona writing on a clipboard.', 'Нарисованный от руки портрет персоны «проверяющий производительность»: человек делает записи на планшете для бумаг.')}
                  widths={[240, 360, 480]}
                  sizes="180px"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                /><figcaption>{t('Performance verifier', 'Проверяющий производительность')}</figcaption>
            <p>{t(
              'A developer comparing runs needed a recording they could reopen, with enough context to make the comparison useful.',
              'Разработчику, который сравнивает прогоны, нужна была запись, к которой можно вернуться, с контекстом, достаточным для полезного сравнения.',
            )}</p>
          </figure>
        </div>
        <p class="research-synthesis">{t(
          'Both started with an application or a task. That became my starting point for the interface.',
          'Оба начинали с приложения или задачи. С этого я и начал проектировать интерфейс.',
        )}</p>
      </div>
    </section>

    <section class="chapter chapter--dark" id="direction" data-index-section>

      <div class="chapter__body">
        <h2>{t('Start with the app. Keep the detail within reach.', 'Начать с приложения. Держать детали под рукой.')}</h2>
        <div class="prose">
          <p>{t(
            'I grouped related processes under the application they belonged to. You could read its total first, then open the individual processes when you needed to investigate.',
            'Я сгруппировал связанные процессы под приложением, к которому они относятся. Сначала виден общий итог, а отдельные процессы можно открыть, когда нужно разобраться.',
          )}</p>
          <p>{t(
            'For work that needed a closer look, I sketched a recording flow: choose applications, set a shared duration, and keep the results. Watching the numbers would no longer be the only way to catch what happened.',
            'Для работы, которая требовала более пристального взгляда, я набросал сценарий записи: выбрать приложения, задать общую длительность и сохранить результаты. Следить за цифрами больше не было единственным способом поймать, что произошло.',
          )}</p>
        </div>
      </div>
    </section>

    <section class="image-chapter" aria-labelledby="sketches-title">
      <div class="image-chapter__heading">

        <h2 id="sketches-title">{t('What should stay together?', 'Что должно быть вместе?')}</h2>
        <p>{t(
          'I explored application groups, levels of detail, and recordings made over the same time window.',
          'Я исследовал группы приложений, уровни детализации и записи за одно и то же окно времени.',
        )}</p>
      </div>
      <div class="sketch-grid">
        {sketches.map((sketch) => (
          <figure>
            <div class="sketch-surface"><Image src={sketch.src} alt={sketch.alt} widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /></div>
            <figcaption>{sketch.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="chapter chapter--wide" id="prototype" data-index-section>

      <div class="chapter__body">
        <h2>{t('The first version had three places to go.', 'В первой версии было три раздела.')}</h2>
        <p class="wide-copy">
          {t(
            'Now was for a quick look. Tests was for recording. History was for returning to the results. Walking through that first prototype showed where these boundaries helped, and where they got in the way.',
            '«Now» для быстрого взгляда. «Tests» для записи. «History» для возврата к результатам. Проход по первому прототипу показал, где эти границы помогали, а где мешали.',
          )}
        </p>
      </div>

      <div class="study-sequence">
<article class="study-step"><h3>Now</h3><p>{t('Grouped application cards made the whole application visible, but not yet easy to scan.', 'Сгруппированные карточки показывали приложение целиком, но пробегать их глазами было ещё непросто.')}</p><figure><Image src={prototypeNow} alt={t('Initial low-fidelity Now screen with application cards.', 'Первый черновой экран «Now» с карточками приложений.')} widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>Tests</h3><p>{t('Choose applications and configure a repeatable run before recording.', 'Выбрать приложения и настроить повторяемый прогон перед записью.')}</p><figure><Image src={prototypeTest} alt={t('Initial low-fidelity test setup screen.', 'Первый черновой экран настройки теста.')} widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>History</h3><p>{t('Reopen recordings and compare them after the live moment has passed.', 'Открывать записи заново и сравнивать их, когда живой момент уже прошёл.')}</p><figure><Image src={prototypeHistory} alt={t('Initial low-fidelity History screen with saved recordings.', 'Первый черновой экран «History» с сохранёнными записями.')} widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" loading="lazy" decoding="async" /></figure></article>
</div>

      <div class="flow-evidence">
        <figure><Image src={flowNow} alt={t('Early linear flow for the Now experience.', 'Ранний линейный сценарий для «Now».')} widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>{t('The smallest possible path through the live view.', 'Самый короткий путь через живой просмотр.')}</figcaption></figure>
        <figure><Image src={flowConsolidation} alt={t('Three prototype flows showing the consolidation of History into Saved Results within Tests.', 'Три сценария прототипа: «History» объединяется с «Saved Results» внутри «Tests».')} widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>{t('An early exploration of keeping recordings inside Tests.', 'Ранняя попытка хранить записи внутри «Tests».')}</figcaption></figure>
      </div>
    </section>

    <section class="chapter" id="validation-intro" data-index-section>

      <div class="chapter__body">
        <h2>{t('Grouping helped. The cards got in the way.', 'Группировка помогла. Карточки мешали.')}</h2>
        <p class="wide-copy">
          {t(
            'The first prototype brought related processes together, but made each application a large card. I could see the groups. Comparing them still took too much looking around. Reviewing the tasks and critiquing the design led to three changes. These were design iterations, not findings from a formal usability study.',
            'Первый прототип объединял связанные процессы, но превращал каждое приложение в большую карточку. Группы были видны. Сравнивать их всё равно приходилось, долго водя глазами по экрану. Разбор задач и критика дизайна привели к трём изменениям. Это были итерации дизайна, а не выводы формального юзабилити-исследования.',
          )}
        </p>
      </div>
    </section>

    <section class="validation-board" aria-labelledby="validation-title">
      <header class="validation-board__heading">
        <h2 id="validation-title">{t('Less to scan. Fewer places to go.', 'Меньше просматривать. Меньше переходить.')}</h2>
      </header>

      <article class="validation-case validation-case--cards">
        <p>
          {t(
            'I replaced the card grid with a compact list. Applications could sit one below another, with a live plot alongside them. Grouping stayed; the space each group demanded shrank.',
            'Я заменил сетку карточек компактным списком. Приложения идут одно под другим, а рядом живой график. Группировка осталась, но места под каждую группу стало нужно меньше.',
          )}
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeNowCards} alt={t('Wireframe of a card-based live application view.', 'Вайрфрейм живого просмотра приложений на карточках.')} widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>{t('Card grouping', 'Группировка карточками')}</figcaption></figure>

          <figure><Image src={wireframeNowList} alt={t('Wireframe of a simplified list-based live application view.', 'Вайрфрейм упрощённого живого просмотра приложений списком.')} widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>{t('List with live plot', 'Список с живым графиком')}</figcaption></figure>
        </div>
      </article>

      <article class="validation-case validation-case--tests">
        <p>
          {t(
            'The test screen asked people to choose manual or automated testing before choosing an application. I reversed that order: start with what you want to observe, then decide how to record it. I also separated setup from the active recording.',
            'Экран тестов просил выбрать ручное или автоматическое тестирование ещё до выбора приложения. Я поменял порядок: сначала то, за чем хочешь наблюдать, потом способ записи. А ещё отделил настройку от идущей записи.',
          )}
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeTestComplex} alt={t('Wireframe combining test setup, recent tests, and an active recording.', 'Вайрфрейм, где на одном экране настройка теста, недавние тесты и идущая запись.')} widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>{t('Everything at once', 'Всё сразу')}</figcaption></figure>

          <figure><Image src={wireframeTestSetup} alt={t('Wireframe of a simplified controlled test setup.', 'Вайрфрейм упрощённой настройки контролируемого теста.')} widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>{t('Choose, configure, start', 'Выбрать, настроить, запустить')}</figcaption></figure>
        </div>
      </article>

      <article class="validation-case validation-case--history">
        <p>
          {t(
            'A recording ended in Tests, but reopening it meant going to History. I brought the results back into Tests as Saved Results. A sidebar kept the list within reach while a result was open.',
            'Запись заканчивалась в «Tests», а чтобы открыть её снова, нужно было идти в «History». Я вернул результаты в «Tests» в виде «Saved Results». Боковая панель держала список под рукой, пока открыт результат.',
          )}
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeHistory} alt={t('Wireframe of a separate History destination.', 'Вайрфрейм отдельного раздела «History».')} widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>{t('History as a destination', '«History» как отдельный раздел')}</figcaption></figure>

