---
import { getImage, Image } from 'astro:assets';

import observatoryTitleTexture from '../../../assets/case_study_images/ditchered_observatory_bg.png';
import launchFilmPoster from '../../../assets/software-showcases/observatory/launch-film.png';
import flowConsolidation from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 7.png';
import flowNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 6.png';
import outcomeComparison from '../../../assets/case_study_images/outcome_screenshots/results-comparison.png';
import outcomeMemory from '../../../assets/case_study_images/outcome_screenshots/live-plot.png';
import outcomeNow from '../../../assets/case_study_images/outcome_screenshots/main.png';
import outcomeProcessDetails from '../../../assets/case_study_images/outcome_screenshots/processes-of-app.png';
import outcomeRecording from '../../../assets/case_study_images/outcome_screenshots/testing.png';
import outcomeSavedResults from '../../../assets/case_study_images/outcome_screenshots/tests-results.png';
import outcomeTestSetup from '../../../assets/case_study_images/outcome_screenshots/test-setup.png';
import prototypeHistory from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 5.png';
import prototypeNow from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 3.png';
import prototypeTest from '../../../assets/case_study_images/initial_prototype_screenshots_and_flows/image 8.png';
import personaIndependentTroubleshooter from '../../../assets/case_study_images/sketches/persona_1_v2.png';
import personaPerformanceVerifier from '../../../assets/case_study_images/sketches/persona_2_v2.png';
import sketchGrouping from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-1 2 1.png';
import sketchLevels from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-2 2 1.png';
import sketchRecording from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-3 2 1.png';
import sketchTestFlow from '../../../assets/case_study_images/explore_and_ideate_sketches/Untitled_Artwork-4 2 1.png';
import wireframeHistory from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 5.png';
import wireframeNowCards from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 3.png';
import wireframeNowList from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 9.png';
import wireframeSavedResults from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 11.png';
import wireframeTestComplex from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 8.png';
import wireframeTestSetup from '../../../assets/case_study_images/validation_screenshots_of_wireframes/image 10.png';
import { sitePath } from '../../../config/site';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/case-study.css';

const repositoryURL = 'https://github.com/KidPudel/Observatory';
const releaseURL = 'https://github.com/KidPudel/Observatory/releases/latest';
const launchFilmURL = 'https://www.youtube.com/watch?v=6LWORcxVZmY&t=5s';
const launchFilmEmbedURL = 'https://www.youtube-nocookie.com/embed/6LWORcxVZmY?start=5&autoplay=1';
const heroTitle = 'Observatory';
const optimizedTitleTexture = await getImage({
  src: observatoryTitleTexture,
  width: 1600,
  format: 'webp',
  quality: 80,
});

const sketches = [
  { src: sketchGrouping, alt: 'Early sketch comparing loose processes with processes grouped by application.', caption: 'The first shift: from a loose field of processes to application groups.' },
  { src: sketchLevels, alt: 'Early sketch comparing application-level and process-level resource tables.', caption: 'Application totals first, with process detail one level below.' },
  { src: sketchRecording, alt: 'Early sketch of two applications being observed over the same ten-second period.', caption: 'A shared recording window makes the comparison legible.' },
  { src: sketchTestFlow, alt: 'Early sketch of selecting applications, recording each one, and reviewing the results.', caption: 'The first outline of a controlled test and its result.' },
];
---

<BaseDocument
  title="Observatory case study | Igor Kupchinenko"
  description="How I designed Observatory, a macOS activity monitor that groups related processes, records controlled tests, and keeps results available for comparison."
  pageClass="observatory-case-study editorial-case-study"
  ogImage={outcomeNow.src}
>


  <main id="main-content">
    <header class="hero">

      <h1
        class="hero-title"
        aria-label={heroTitle}
        style={`--hero-title-texture: url('${optimizedTitleTexture.src}')`}
      >
        {heroTitle.split('').map((letter, index) => (
          <span
            class="hero-title__letter"
            aria-hidden="true"
            data-letter={letter}
            style={`--letter-index: ${index}; --texture-position: ${(index / (heroTitle.length - 1)) * 100}%`}
          >
            {letter}
          </span>
        ))}
      </h1>
      <p class="hero__line">Activity Monitor, but more.</p>
      <p class="hero__intro">
        An application could appear as several processes. A spike could disappear before I understood it.
        I designed Observatory to bring those pieces together and record what happened while I worked.
      </p>

      <dl class="facts">
        <div><dt>My role</dt><dd>Product direction, research, UX/UI, identity, motion</dd></div>
        <div><dt>Research</dt><dd>5 exploratory interviews</dd></div>
        <div><dt>Outcome</dt><dd>2026 · Working macOS prototype, release 0.1.1</dd></div>
        <div><dt>Build</dt><dd>AI-directed development from my specifications</dd></div>
      </dl>

      <figure class="hero-introduction">
        <a
          class="hero-introduction__link"
          href={launchFilmURL}
          data-introduction-film
          data-embed-src={launchFilmEmbedURL}
        >
          <span class="hero-introduction__stage">
            <Image
              src={launchFilmPoster}
              alt=""
              widths={[720, 1080, 1280]}
              sizes="(max-width: 760px) calc(100vw - 40px), 780px"
              format="webp"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <span class="hero-introduction__play" aria-hidden="true"></span>
          </span>
          <span class="sr-only">Watch the Observatory product introduction on YouTube</span>
        </a>
        <figcaption>Product introduction</figcaption>
      </figure>
    </header>

    <section class="chapter" id="problem" data-index-section>

      <div class="chapter__body">
        <h2>The numbers were there. The picture was not.</h2>
        <div class="prose">
          <p>
            I would open Activity Monitor during resource-intensive work and look for the application I was using.
            Its activity was spread across several processes. I had to find them, add their values in my head,
            and keep watching. By then, the numbers had changed again.
          </p>
          <p>
            And once the task ended, there was nothing to return to. A screenshot caught one moment.
            It could not tell me what happened across the whole run, or how the next run differed.
          </p>
        </div>
        <blockquote>
          How can I see what an application did during the work, then return to the same evidence later?
        </blockquote>
      </div>
    </section>

    <section class="chapter" id="research" data-index-section>

      <div class="chapter__body">
        <h2>People were looking for an application, too.</h2>
        <div class="prose">
          <p>I asked five people to walk me through the last time they investigated performance: what they wanted to know, where they looked, and what they could not find. These exploratory conversations suggested two needs to design for.</p>
        </div>
        <div class="research-portraits">
          <figure><Image
                  src={personaIndependentTroubleshooter}
                  alt="Hand-drawn portrait of the independent troubleshooter persona wearing glasses and making an OK gesture."
                  widths={[240, 360, 480]}
                  sizes="180px"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                /><figcaption>Independent troubleshooter</figcaption>
            <p>Someone checking their own Mac needed to see the whole application and catch a spike without piecing together a changing list.</p>
          </figure>
          <figure><Image
                  src={personaPerformanceVerifier}
                  alt="Hand-drawn portrait of the performance verifier persona writing on a clipboard."
                  widths={[240, 360, 480]}
                  sizes="180px"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                /><figcaption>Performance verifier</figcaption>
            <p>A developer comparing runs needed a recording they could reopen, with enough context to make the comparison useful.</p>
          </figure>
        </div>
        <p class="research-synthesis">Both started with an application or a task. That became my starting point for the interface.</p>
      </div>
    </section>

    <section class="chapter chapter--dark" id="direction" data-index-section>

      <div class="chapter__body">
        <h2>Start with the app. Keep the detail within reach.</h2>
        <div class="prose">
          <p>I grouped related processes under the application they belonged to. You could read its total first, then open the individual processes when you needed to investigate.</p>
          <p>For work that needed a closer look, I sketched a recording flow: choose applications, set a shared duration, and keep the results. Watching the numbers would no longer be the only way to catch what happened.</p>
        </div>
      </div>
    </section>

    <section class="image-chapter" aria-labelledby="sketches-title">
      <div class="image-chapter__heading">

        <h2 id="sketches-title">What should stay together?</h2>
        <p>I explored application groups, levels of detail, and recordings made over the same time window.</p>
      </div>
      <div class="sketch-grid">
        {sketches.map((sketch) => (
          <figure>
            <div class="sketch-surface"><Image src={sketch.src} alt={sketch.alt} widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /></div>
            <figcaption>{sketch.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="chapter chapter--wide" id="prototype" data-index-section>

      <div class="chapter__body">
        <h2>The first version had three places to go.</h2>
        <p class="wide-copy">
          Now was for a quick look. Tests was for recording. History was for returning to the results.
          Walking through that first prototype showed where these boundaries helped, and where they got in the way.
        </p>
      </div>

      <div class="study-sequence">
<article class="study-step"><h3>Now</h3><p>Grouped application cards made the whole application visible, but not yet easy to scan.</p><figure><Image src={prototypeNow} alt="Initial low-fidelity Now screen with application cards." widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>Tests</h3><p>Choose applications and configure a repeatable run before recording.</p><figure><Image src={prototypeTest} alt="Initial low-fidelity test setup screen." widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>History</h3><p>Reopen recordings and compare them after the live moment has passed.</p><figure><Image src={prototypeHistory} alt="Initial low-fidelity History screen with saved recordings." widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" loading="lazy" decoding="async" /></figure></article>
</div>

      <div class="flow-evidence">
        <figure><Image src={flowNow} alt="Early linear flow for the Now experience." widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>The smallest possible path through the live view.</figcaption></figure>
        <figure><Image src={flowConsolidation} alt="Three prototype flows showing the consolidation of History into Saved Results within Tests." widths={[480, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>An early exploration of keeping recordings inside Tests.</figcaption></figure>
      </div>
    </section>

    <section class="chapter" id="validation-intro" data-index-section>

      <div class="chapter__body">
        <h2>Grouping helped. The cards got in the way.</h2>
        <p class="wide-copy">
          The first prototype brought related processes together, but made each application a large card.
          I could see the groups. Comparing them still took too much looking around.
          Reviewing the tasks and critiquing the design led to three changes. These were design iterations, not findings from a formal usability study.
        </p>
      </div>
    </section>

    <section class="validation-board" aria-labelledby="validation-title">
      <header class="validation-board__heading">
        <h2 id="validation-title">Less to scan. Fewer places to go.</h2>
      </header>

      <article class="validation-case validation-case--cards">
        <p>
          I replaced the card grid with a compact list. Applications could sit one below another,
          with a live plot alongside them. Grouping stayed; the space each group demanded shrank.
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeNowCards} alt="Wireframe of a card-based live application view." widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>Card grouping</figcaption></figure>

          <figure><Image src={wireframeNowList} alt="Wireframe of a simplified list-based live application view." widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>List with live plot</figcaption></figure>
        </div>
      </article>

      <article class="validation-case validation-case--tests">
        <p>
          The test screen asked people to choose manual or automated testing before choosing an application.
          I reversed that order: start with what you want to observe, then decide how to record it.
          I also separated setup from the active recording.
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeTestComplex} alt="Wireframe combining test setup, recent tests, and an active recording." widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>Everything at once</figcaption></figure>

          <figure><Image src={wireframeTestSetup} alt="Wireframe of a simplified controlled test setup." widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>Choose, configure, start</figcaption></figure>
        </div>
      </article>

      <article class="validation-case validation-case--history">
        <p>
          A recording ended in Tests, but reopening it meant going to History. I brought the results back into Tests
          as Saved Results. A sidebar kept the list within reach while a result was open.
        </p>
        <div class="validation-pair">
          <figure><Image src={wireframeHistory} alt="Wireframe of a separate History destination." widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>History as a destination</figcaption></figure>

          <figure><Image src={wireframeSavedResults} alt="Wireframe of Saved Results inside the Tests workflow." widths={[320, 480, 640]} sizes="(max-width: 760px) calc(100vw - 40px), 378px" format="webp" loading="lazy" decoding="async" /><figcaption>Saved Results inside Tests</figcaption></figure>
        </div>
      </article>
    </section>

    <section class="chapter chapter--wide chapter--outcome" id="outcome" data-index-section>

      <div class="chapter__body">
        <h2>A quick look, or a recording to come back to.</h2>
        <div class="prose prose--split">
          <p>
            Observatory 0.1.1 runs on macOS 14 and later. For a quick check, the live view keeps sixty seconds of activity
            in sight. For a longer investigation, Tests records one to four applications, with optional warm-up and repeated rounds.
          </p>
          <p>
            Recordings stay on the Mac. You can reopen them and align their timelines for comparison.
            This is a working prototype: the core flow is available to try, with broader testing still ahead.
          </p>
        </div>
      </div>

      <div class="study-sequence">
<article class="study-step"><h3>Read the whole application.</h3><p>A compact application list keeps the live picture scannable.</p><figure><Image src={outcomeNow} alt="Final Observatory Now screen with live application data and a chart." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" quality={85} loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>Open detail only when it matters.</h3><p>Process data is present, but it waits until a row is expanded.</p><figure><Image src={outcomeProcessDetails} alt="Expanded process details in the final Observatory live view." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" quality={85} loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>Keep the frame stable.</h3><p>CPU, memory, energy, and disk share one chart position.</p><figure><Image src={outcomeMemory} alt="Final Observatory memory timeline chart." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" quality={85} loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>Define the observation.</h3><p>Select applications, choose a recording mode, then define the run.</p><figure><Image src={outcomeTestSetup} alt="Final Observatory controlled test setup screen." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" quality={85} loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>Guide one run at a time.</h3><p>Manual mode guides the person through one application at a time.</p><figure><Image src={outcomeRecording} alt="Final Observatory guided recording screen." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" quality={85} loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>Preserve the context.</h3><p>Saved results keep the meaning of each test after it ends.</p><figure><Image src={outcomeSavedResults} alt="Final Observatory Saved Results screen." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" quality={85} loading="lazy" decoding="async" /></figure></article>
<article class="study-step"><h3>Make the same moment comparable.</h3><p>Synchronized timelines align evidence across results.</p><figure><Image src={outcomeComparison} alt="Final Observatory comparison screen showing synchronized metric timelines." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) calc(100vw - 40px), 780px" format="webp" quality={85} loading="lazy" decoding="async" /></figure></article>
</div>
    </section>

    <section class="chapter reflection" id="reflection" data-index-section>

      <div class="chapter__body">
        <h2>The task ends. The evidence stays.</h2>
        <div class="prose">
          <p>
            I started by trying to read a moving list. The project became a way to return to something I had missed:
            an application’s activity during a particular piece of work.
          </p>
          <p>
            Alongside the product design and research, I made the telescope artwork, identity, and launch film.
            I directed AI development of the application from my specifications.
          </p>
          <p>
            Next, I want people who regularly troubleshoot or compare performance to use it on their own tasks.
            Can they identify what happened? Can they tell which recordings are useful to compare?
            Their answers should guide the comparison language and defaults.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="case-footer">
    <nav aria-label="Observatory project links">
      <a href={launchFilmURL}>Launch film ↗</a>
      <a href={releaseURL}>Download 0.1.1 ↗</a>
      <a href={repositoryURL}>Source ↗</a>
      <a href={sitePath('/')}>Home</a>
    </nav>
  </footer>
</BaseDocument>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-introduction-film]').forEach((link) => {
    const embedSrc = link.dataset.embedSrc;
    const stage = link.querySelector('.hero-introduction__stage');
    if (!embedSrc || !stage) return;

    link.addEventListener('click', (event) => {
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.className = 'hero-introduction__player';
      frame.src = embedSrc;
      frame.title = 'Observatory product introduction';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.setAttribute('allowfullscreen', '');
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      stage.replaceChildren(frame);
      link.replaceWith(stage);
      frame.focus();
    });
  });
</script>

<style>
  .hero h1 { margin: 0; text-align: center; font-family: var(--font-display); font-size: clamp(72px, 8vw, 112px); font-weight: 700; font-synthesis: none; letter-spacing: -0.06em; line-height: 0.9; }
  .hero-title { white-space: nowrap; }
  .hero-title__letter { position: relative; display: inline-block; }
  .hero-title__letter::after {
    content: attr(data-letter);
    position: absolute;
    inset: -0.14em -0.05em -0.2em;
    box-sizing: border-box;
    padding: 0.14em 0.05em 0.2em;
    background-image: var(--hero-title-texture);
    background-position: var(--texture-position) 50%;
    background-size: 900% auto;
    background-clip: text;
    color: transparent;
    opacity: 0;
    transform: translateY(0.035em) scale(0.985);
    transform-origin: 50% 70%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-title-texture-flash 820ms cubic-bezier(0.22, 0.75, 0.28, 1) both;
    animation-delay: calc(180ms + var(--letter-index) * 82ms);
    will-change: opacity, transform;
  }

  @keyframes hero-title-texture-flash {
    0%, 16%, 100% { opacity: 0; transform: translateY(0.035em) scale(0.985); }
    38%, 68% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (max-width: 760px) { .hero h1 { font-size: clamp(56px, 15vw, 61px); letter-spacing: -0.055em; } }
  @media (prefers-reduced-motion: reduce) { .hero-title__letter::after { animation: none; } }
</style>
