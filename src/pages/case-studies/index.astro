---
import { Image } from 'astro:assets';

import { caseStudies, caseStudyPath } from '../../content/case-studies';
import { localePath, toLocale, translator } from '../../i18n/locales';
import BaseDocument from '../../layouts/BaseDocument.astro';
import '../../styles/case-study.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
---

<BaseDocument
  title={t('Case studies | Igor Kupchinenko', 'Кейсы | Игорь Купчиненко')}
  description={t(
    'Product design case studies by Igor Kupchinenko: SuperGood, Observatory, Instagram Saves, and Two Sticks.',
    'Кейсы продуктового дизайнера Игоря Купчиненко: SuperGood, Observatory, «Сохранённое» в Instagram и «Две палочки».',
  )}
  pageClass="editorial-case-study"
  ogImage={caseStudies[0].cover.src}
>
  <main id="main-content" class="case-index">
    <h1>{t('Case studies', 'Кейсы')}</h1>

    <ol class="case-index__list">
      {caseStudies.map((study, index) => {
        const firstRow = index < 2;
        return (
          <li class="case-index__item">
            <div class="case-index__frame" aria-hidden="true">
              <Image
                class="case-index__texture"
                src={study.background}
                alt=""
                widths={[480, 720, 1040]}
                sizes="(max-width: 760px) calc(100vw - 40px), 520px"
                format="webp"
                quality={80}
                loading={firstRow ? 'eager' : 'lazy'}
                decoding="async"
              />
              <Image
                class:list={['case-index__cover', `case-index__cover--${study.coverFormat}`]}
                src={study.cover}
                alt=""
                widths={study.coverFormat === 'phone' ? [240, 360, 480] : [480, 720, 960]}
                sizes={study.coverFormat === 'phone'
                  ? '(max-width: 760px) 38vw, 190px'
                  : '(max-width: 760px) calc(86vw - 34px), 450px'}
                format="webp"
                quality={85}
                loading={firstRow ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            </div>
            <div class="case-index__text">
              <h2>
                <a class="case-index__link" href={localePath(caseStudyPath(study.slug), locale)}>
                  {study.name[locale]}
                </a>
              </h2>
              <p class="case-index__pitch">{study.pitch[locale]}</p>
              <p class="case-index__meta">{study.year} · {study.responsibility[locale]}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </main>
</BaseDocument>

<style>
  .case-index {
    width: min(1080px, calc(100% - 48px)) !important;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(5rem, 9vw, 8rem);
  }

  .case-index h1 {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .case-index__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .case-index__item {
    position: relative;
    min-width: 0;
  }

  .case-index__frame {
    position: relative;
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    overflow: hidden;
    border-radius: 18px;
    background: #eceae6;
  }

  .case-index__frame :global(img) {
    max-width: none;
  }

  .case-index__frame :global(.case-index__texture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-index__frame :global(.case-index__cover) {
    position: relative;
    box-shadow: 0 14px 34px rgb(17 17 15 / 0.16);
    transition: transform 260ms var(--ease-out);
  }

  .case-index__frame :global(.case-index__cover--phone) {
    width: auto;
    height: 84%;
    border-radius: 14px;
  }

  .case-index__frame :global(.case-index__cover--desktop) {
    width: 86%;
    height: auto;
    border-radius: 8px;
  }

  .case-index__text {
    padding-top: 1.25rem;
  }

  .case-index h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  /* The title link covers the whole card, so the frame is clickable too. */
  .case-index__link::after {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    content: '';
  }

  .case-index__link:focus-visible {
    outline: none;
  }

  .case-index__link:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .case-index .case-index__pitch {
    margin: 0 0 0.35rem;
    font-size: var(--study-small);
    line-height: 1.5;
  }

  .case-index .case-index__meta {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (hover: hover) and (pointer: fine) {
    .case-index__item:hover :global(.case-index__cover) {
      transform: translateY(-4px);
    }

    .case-index__item:hover .case-index__link {
      text-decoration-color: var(--link-line-color-active);
    }
  }

  @media (max-width: 760px) {
    .case-index {
      width: calc(100% - 40px) !important;
    }

    .case-index__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-index__frame :global(.case-index__cover) {
      transition: none;
    }
  }
</style>
