---
import ShowcaseCards from '../../components/homepage/showcase/ShowcaseCards.astro';
import { caseStudies } from '../../content/case-studies';
import { toLocale, translator } from '../../i18n/locales';
import BaseDocument from '../../layouts/BaseDocument.astro';
import '../../styles/case-study.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
---

<BaseDocument
  title={t('Case studies | Igor Kupchinenko', 'Кейсы | Игорь Купчиненко')}
  description={t(
    'Product design case studies by Igor Kupchinenko: Instagram Saves, SuperGood, Observatory, and Two Sticks.',
    'Кейсы продуктового дизайнера Игоря Купчиненко: «Сохранённое» в Instagram, SuperGood, Observatory и «Две палочки».',
  )}
  pageClass="editorial-case-study"
  ogImage={caseStudies[0].cover.src}
>
  <!-- The same cards as the homepage's work section, so the two read as one. -->
  <main id="main-content" class="case-index">
    <ShowcaseCards page />
  </main>
</BaseDocument>

<style>
  /* The cards set their own frame. */
  .case-index {
    width: 100%;
  }
</style>
