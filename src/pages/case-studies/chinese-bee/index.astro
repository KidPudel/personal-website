---
import dictationStart from '../../../assets/case_study_images/two-sticks/fact.png';
import flashcardScreen from '../../../assets/case_study_images/two-sticks/flash-card.png';
import graphemes from '../../../assets/case_study_images/two-sticks/graphemes.png';
import sheetInChat from '../../../assets/case_study_images/two-sticks/list-to-fill.png';
import notebookFilled from '../../../assets/case_study_images/two-sticks/notebook-filled.png';
import searchResults from '../../../assets/case_study_images/two-sticks/search1.png';
import searchScreen from '../../../assets/case_study_images/two-sticks/search2.png';
import startScreen from '../../../assets/case_study_images/two-sticks/start1.png';
import writeScreen from '../../../assets/case_study_images/two-sticks/write.png';
import Decision from '../../../components/case-studies/Decision.astro';
import MetricGrid from '../../../components/case-studies/MetricGrid.astro';
import Shot from '../../../components/case-studies/Shot.astro';
import StarSummary from '../../../components/case-studies/StarSummary.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/case-study.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const phoneSizes = '(max-width: 760px) calc((100vw - 60px) / 3), 300px';
const pairSizes = '(max-width: 760px) calc((100vw - 56px) / 2), 250px';
---

<BaseDocument
  title={t('Two Sticks case study | Igor Kupchinenko', 'Кейс «Две палочки» | Игорь Купчиненко')}
  description={t(
    'How I turned a university diploma’s research into Two Sticks, a Telegram product for finding Chinese characters, remembering them, and writing them by hand, in one chat instead of three tools.',
    'Как я превратил исследование дипломной работы в «Две палочки», продукт в Telegram, чтобы находить китайские иероглифы, запоминать их и писать от руки, в одном чате вместо трёх инструментов.',
  )}
  pageClass="chinesebee-case-study editorial-case-study"
  ogImage={searchScreen.src}
  canonicalPath={localePath('/case-studies/two-sticks/', locale)}
>
  <main id="main-content">
    <header class="hero">
      <h1 class="hero-title">{t('Two Sticks', 'Две палочки')}</h1>
      <p class="hero__line">{t('Write the character, without leaving the chat.', 'Написать иероглиф, не выходя из чата.')}</p>

      <dl class="facts">
        <div><dt>{t('Role', 'Роль')}</dt><dd>{t('Product direction, UX/UI, bot, API, and handwriting app', 'Продуктовое видение, UX/UI, бот, API и приложение для прописей')}</dd></div>
        <div><dt>{t('Based on', 'Основа')}</dt><dd>{t('Research by an МПГУ diploma team', 'Исследование дипломной команды МПГУ')}</dd></div>
        <div><dt>{t('When', 'Когда')}</dt><dd>2024</dd></div>
        <div><dt>{t('Outcome', 'Результат')}</dt><dd>{t('Working prototype, used by a few students. No longer hosted.', 'Рабочий прототип, им пользовались несколько студентов. Сейчас не размещён.')}</dd></div>
      </dl>

      <div class="phones breakout">
        <Shot src={searchScreen} priority="high" sizes={phoneSizes} alt={t('Two Sticks word search result with character details and a save action.', 'Результат поиска слова в «Двух палочках» с карточкой иероглифа и кнопкой сохранения.')} />
        <Shot src={flashcardScreen} priority="eager" sizes={phoneSizes} alt={t('Two Sticks flashcard practice using the learner’s saved characters.', 'Практика с карточками в «Двух палочках» на сохранённых иероглифах ученика.')} />
        <Shot src={writeScreen} priority="eager" sizes={phoneSizes} alt={t('Two Sticks handwriting Web App with a drawn character and recognition score.', 'Web App для прописей «Две палочки» с нарисованным иероглифом и оценкой распознавания.')} />
      </div>
    </header>

    <StarSummary
      situation={t(
        'Learners can recognise a Chinese character and still fail to write it. Practice was split across a dictionary, flashcards, and paper copybooks.',
        'Ученики узнают китайский иероглиф, но не могут его написать. Практика была разбита между словарём, карточками и бумажными прописями.',
      )}
      task={t(
        'Turn a university diploma’s research into one working product, inside the messenger learners already use.',
        'Превратить исследование дипломной работы в один рабочий продукт внутри мессенджера, которым ученики уже пользуются.',
      )}
      action={t(
        'Chose Telegram over a new app, made every saved word feed every exercise, and built the bot, the API, and the handwriting app.',
        'Выбрал Telegram вместо нового приложения, сделал так, чтобы каждое сохранённое слово шло во все упражнения, и собрал бота, API и приложение для прописей.',
      )}
      result={t(
        'Three tools became one chat. Students liked not switching between apps. What they missed was pronunciation practice.',
        'Три инструмента превратились в один чат. Студентам понравилось не переключаться между приложениями. Не хватало им практики произношения.',
      )}
    />

    <MetricGrid
      metrics={[
        { value: '3 → 1', label: t('tools for one study session: dictionary, flashcards, and copybook', 'инструмента на одно занятие: словарь, карточки и прописи'), basis: t('By design', 'Так устроен продукт') },
        { value: '0', label: t('apps to install. Everything opens in Telegram.', 'приложений для установки. Всё открывается в Telegram.'), basis: t('By design', 'Так устроен продукт') },
        { value: t('15 of 20', '15 из 20'), label: t('open-day visitors were interested in the idea', 'гостей дня открытых дверей заинтересовались идеей'), basis: t('Diploma team’s research', 'Исследование дипломной команды') },
      ]}
      caption={t(
        'No usage analytics were collected. Student feedback came from conversations.',
        'Аналитику использования не собирали. Отзывы студентов получены в разговорах.',
      )}
    />

    <StudySection
      part="situation"
      title={t('You recognise it. Can you write it?', 'Узнаёшь его. А написать сможешь?')}
      lead={t(
        'A dictionary gives you the character, its sound, and its meaning. Writing it from memory takes a different kind of practice, and that practice lived in separate places.',
        'Словарь даёт иероглиф, его звучание и значение. Чтобы написать его по памяти, нужна другая практика, а она жила в разных местах.',
      )}
    >
      <figure class="tools">
        <div class="tools__row">
          <p class="tools__label">{t('Before: 3 tools', 'Раньше: 3 инструмента')}</p>
          <ul class="tools__list" role="list">
            <li>{t('Dictionary', 'Словарь')}</li>
            <li>{t('Flashcard app', 'Приложение с карточками')}</li>
            <li>{t('Paper copybook', 'Бумажные прописи')}</li>
          </ul>
        </div>
        <div class="tools__row tools__row--after">
          <p class="tools__label">{t('Two Sticks: 1 chat', '«Две палочки»: 1 чат')}</p>
          <ul class="tools__list" role="list">
            <li>{t('Search, flashcards, notebook sheets, and handwriting, in Telegram', 'Поиск, карточки, листы-прописи и письмо, всё в Telegram')}</li>
          </ul>
        </div>
      </figure>

      <p class="situation-copy">{t(
        'The starting point was a 2024 МПГУ diploma by Смакова, Шаталова, and Шинкарева. They studied copybooks, memorisation methods, and competing apps and bots, and ran an open-day masterclass where 15 of 20 visitors were interested. That was a signal of interest, not a test of my product. Their research became my brief.',
        'Отправной точкой стал диплом МПГУ 2024 года, который написали Смакова, Шаталова и Шинкарева. Они изучили прописи, методы запоминания, конкурирующие приложения и боты и провели мастер-класс на дне открытых дверей, где идеей заинтересовались 15 из 20 гостей. Это был сигнал интереса, а не проверка моего продукта. Их исследование стало моим брифом.',
      )}</p>
    </StudySection>

    <StudySection
      part="task"
      title={t('One place to find, remember, and write.', 'Одно место, чтобы найти, запомнить и написать.')}
      lead={t(
        'I turned the diploma’s brief into a product and built it: a Telegram bot, a FastAPI backend, a PostgreSQL word database, and a Vue handwriting app.',
        'Я превратил бриф диплома в продукт и собрал его: Telegram-бот, бэкенд на FastAPI, базу слов на PostgreSQL и приложение для прописей на Vue.',
      )}
    >
      <dl class="goal breakout">
        <div><dt>{t('Goal', 'Цель')}</dt><dd>{t('Connect looking up a character with practising it, in one place.', 'Связать поиск иероглифа с практикой в одном месте.')}</dd></div>
        <div><dt>{t('How I would know', 'Как понять, что получилось')}</dt><dd>{t('Share of learners who save 5 words and unlock flashcards. Share who go on to handwriting. Scores on the same character over repeated attempts.', 'Доля учеников, которые сохранили 5 слов и открыли карточки. Доля тех, кто дошёл до прописей. Оценки на одном и том же иероглифе от попытки к попытке.')}</dd></div>
        <div><dt>{t('Constraints', 'Ограничения')}</dt><dd>{t('One developer, a student budget, and a chat interface that cannot draw.', 'Один разработчик, студенческий бюджет и интерфейс чата, в котором нельзя рисовать.')}</dd></div>
      </dl>
    </StudySection>

    <StudySection part="action" title={t('Decisions that turned a brief into a product.', 'Решения, которые превратили бриф в продукт.')}>
      <figure class="position">
        <div class="position__plot" role="img" aria-label={t(
          'Positioning chart. Skritter offers deep writing practice but is a separate app. Telegram bots are easy to start but focus on vocabulary. Two Sticks is easy to start and includes writing practice.',
          'Карта позиционирования. Skritter даёт серьёзную практику письма, но это отдельное приложение. Боты в Telegram легко начать, но они про словарь. «Две палочки» легко начать, и в них есть практика письма.',
        )}>
          <span class="position__axis position__axis--y" aria-hidden="true">{t('↑ More writing practice', '↑ Больше практики письма')}</span>
          <span class="position__axis position__axis--x" aria-hidden="true">{t('Easier to start →', 'Проще начать →')}</span>
          <span class="position__point" style="--x: 14%; --y: 26%" aria-hidden="true">Skritter</span>
          <span class="position__point position__point--end" style="--x: 74%; --y: 74%" aria-hidden="true">{t('Telegram bots', 'Боты в Telegram')}</span>
          <span class="position__point position__point--ours position__point--end" style="--x: 74%; --y: 26%" aria-hidden="true">{t('Two Sticks', 'Две палочки')}</span>
        </div>
        <figcaption class="position__caption">{t(
          'From the diploma team’s competitor review: Skritter for dedicated writing practice in a separate app, Telegram bots for an easy start with mostly vocabulary. Two Sticks aims for both.',
          'По конкурентному анализу дипломной команды: Skritter для отдельной практики письма в своём приложении, боты в Telegram для лёгкого старта, но в основном со словарём. «Две палочки» стремятся к обоим.',
        )}</figcaption>
      </figure>

      <Decision
        number={1}
        title={t('Telegram, not a new app.', 'Telegram, а не новое приложение.')}
        problem={t('Every new app is one more thing to install, open, and remember.', 'Каждое новое приложение это ещё одна установка, ещё одна иконка и ещё одна привычка.')}
        decision={t('A Telegram bot for search, saving, and flashcards, with a Telegram Web App for handwriting.', 'Telegram-бот для поиска, сохранения и карточек и Telegram Web App для прописей.')}
        why={t('Learners were already in Telegram every day. Nothing to install, and practice sits next to their chats.', 'Ученики и так каждый день в Telegram. Ничего не нужно устанавливать, а практика рядом с их чатами.')}
        instead={t('A standalone app. More freedom in the interface, but a harder start: the same trade-off as Skritter.', 'Отдельного приложения. Больше свободы в интерфейсе, но сложнее начать: тот же компромисс, что у Skritter.')}
        effect={t('0 apps to install', '0 приложений для установки')}
        effectLabel={t('By design', 'Так устроено')}
      >
        <Shot src={dictationStart} alt={t('Two Sticks chat where the dictation command offers a button that opens the handwriting practice.', 'Чат «Двух палочек»: команда диктанта предлагает кнопку, которая открывает прописи.')} caption={t('Handwriting opens from the chat as a Web App.', 'Прописи открываются из чата как Web App.')} />
      </Decision>

      <Decision
        number={2}
        title={t('One saved list feeds every exercise.', 'Один список сохранённого для всех упражнений.')}
        problem={t('Learners had to build a separate list for each tool.', 'Ученикам приходилось собирать отдельный список для каждого инструмента.')}
        decision={t('Save sits on the character card, next to pinyin, meaning, and HSK level. Flashcards, notebook sheets, and handwriting all draw from that one list.', 'Кнопка сохранения на карточке иероглифа, рядом с пиньинем, значением и уровнем HSK. Карточки, листы-прописи и письмо берут слова из этого одного списка.')}
        why={t('Every lookup can lead somewhere useful, with no extra setup.', 'Каждый поиск может привести к практике без лишней настройки.')}
      >
        <div class="pair">
          <Shot src={searchResults} sizes={pairSizes} alt={t('Search for a Russian word returning a list of matching Chinese words.', 'Поиск по русскому слову возвращает список подходящих китайских слов.')} caption={t('Search by a Russian word.', 'Поиск по русскому слову.')} />
          <Shot src={searchScreen} sizes={pairSizes} alt={t('Character card with pinyin, meaning, HSK level, and a save button.', 'Карточка иероглифа с пиньинем, значением, уровнем HSK и кнопкой сохранения.')} caption={t('Save it from the card.', 'Сохранить прямо с карточки.')} />
        </div>
      </Decision>

      <Decision
        number={3}
        title={t('Flashcards unlock at five words.', 'Карточки открываются после пяти слов.')}
        problem={t('A multiple-choice card with one or two saved words has no real wrong answers.', 'В карточке с выбором ответа при одном-двух сохранённых словах нет настоящих неправильных вариантов.')}
        decision={t('Flashcards open once five words are saved. Until then, the empty state says how many more to add.', 'Карточки открываются, когда сохранено пять слов. До этого пустое состояние подсказывает, сколько ещё добавить.')}
        why={t('The quiz only works with real alternatives, and the countdown turns the wait into a small goal.', 'Тест работает только с настоящими вариантами, а обратный отсчёт превращает ожидание в маленькую цель.')}
      >
        <Shot src={flashcardScreen} alt={t('Flashcard practice built from the learner’s saved characters.', 'Практика с карточками на сохранённых иероглифах ученика.')} caption={t('Questions come from your own saved words.', 'Вопросы строятся из твоих сохранённых слов.')} />
      </Decision>

      <Decision
        number={4}
        layout="stack"
        title={t('Understand the shape before writing it.', 'Понять форму, прежде чем писать.')}
        problem={t('Copying a character without knowing its parts makes it hard to remember.', 'Если переписывать иероглиф, не зная его частей, его трудно запомнить.')}
        decision={t('One notebook sheet with structure, stroke order, similar characters, a mnemonic, examples, and a writing grid, sent right into the chat.', 'Один лист-пропись со структурой, порядком черт, похожими иероглифами, мнемоникой, примерами и сеткой для письма, прямо в чат.')}
        why={t('Structure and mnemonics were the methods the diploma research pointed to. In the chat, the sheet is always one scroll away.', 'На структуру и мнемонику указывало исследование диплома. В чате лист всегда в одной прокрутке.')}
      >
        <div class="sheet-pair">
          <Shot src={sheetInChat} sizes="(max-width: 760px) min(calc(100vw - 40px), 300px), 300px" alt={t('The saved-words command sending a notebook sheet into the chat.', 'Команда сохранённых слов присылает лист-пропись в чат.')} caption={t('The sheet arrives in the chat.', 'Лист приходит прямо в чат.')} />
          <Shot kind="sheet" src={notebookFilled} sizes="(max-width: 760px) calc(100vw - 40px), 740px" alt={t('Filled notebook sheet for 教 with structure, stroke order, similar characters, mnemonic, and writing grid.', 'Заполненный лист-пропись для 教 со структурой, порядком черт, похожими иероглифами, мнемоникой и сеткой для письма.')} caption={t('Structure, stroke order, look-alikes, a mnemonic, and a grid on one sheet.', 'Структура, порядок черт, похожие иероглифы, мнемоника и сетка на одном листе.')} />
        </div>
      </Decision>

      <Decision
        number={5}
        title={t('Let experienced learners skip the basics.', 'Дать опытным пропустить основы.')}
        problem={t('A primer on how characters work helps beginners and slows everyone else down.', 'Вводный курс о том, как устроены иероглифы, помогает новичкам и тормозит остальных.')}
        decision={t('The bot asks first: “Yes, show me” or “I already know”.', 'Бот сначала спрашивает: «Да, хочу!» или «Уже знаю».')}
        why={t('Respect what people already know. The primer is there, but never in the way.', 'Уважать то, что человек уже знает. Курс есть, но не мешает.')}
      >
        <div class="pair">
          <Shot src={startScreen} sizes={pairSizes} alt={t('Two Sticks introduction asking whether the learner wants to learn how characters are built, with the options “Yes, show me” and “I already know”.', 'Знакомство с «Двумя палочками»: бот спрашивает, хочет ли ученик узнать, как устроены иероглифы, с вариантами «Да, хочу!» и «Уже знаю».')} caption={t('A choice before the primer.', 'Выбор перед курсом.')} />
          <Shot src={graphemes} sizes={pairSizes} alt={t('Primer message explaining graphemes and radicals with an example diagram.', 'Сообщение вводного курса о графемах и ключах с примером-схемой.')} caption={t('The primer, for those who want it.', 'Курс для тех, кому он нужен.')} />
        </div>
      </Decision>

      <Decision
        number={6}
        layout="stack"
        title={t('Ship the core loop first.', 'Сначала выпустить основной цикл.')}
        problem={t('The diploma brief also included live teacher supervision, an HSK statistics dashboard, and audience growth plans.', 'В брифе диплома были ещё живое сопровождение преподавателем, панель статистики HSK и планы по росту аудитории.')}
        decision={t('Shipped the learner’s loop first: find, save, recall, understand, write. Left the rest for later.', 'Сначала выпустил цикл ученика: найти, сохранить, вспомнить, понять, написать. Остальное оставил на потом.')}
        why={t('Teacher tools only matter once learners come back on their own. Prove that first.', 'Инструменты для преподавателя важны, только когда ученики возвращаются сами. Сначала нужно доказать это.')}
      />
    </StudySection>

    <StudySection
      part="result"
      title={t('One chat instead of three tools.', 'Один чат вместо трёх инструментов.')}
      lead={t(
        'A few students at the university used it. They liked having everything in one place: no switching between apps, and less effort just to keep up. What they missed was practising pronunciation.',
        'Им пользовались несколько студентов университета. Им понравилось, что всё в одном месте: не нужно переключаться между приложениями и тратить силы, чтобы не отставать. Не хватало им практики произношения.',
      )}
    >
      <ul class="tiles breakout" role="list">
        <li><strong>{t('Built', 'Собрано')}</strong><p>{t('A Russian-language Telegram bot, a FastAPI backend, a PostgreSQL word database, and a Vue handwriting app.', 'Русскоязычный Telegram-бот, бэкенд на FastAPI, база слов на PostgreSQL и приложение для прописей на Vue.')}</p></li>
        <li><strong>{t('Liked', 'Понравилось')}</strong><p>{t('Everything in one place, with no switching between tools.', 'Всё в одном месте, не нужно переключаться между инструментами.')}</p></li>
        <li><strong>{t('Missed', 'Не хватило')}</strong><p>{t('Practising pronunciation, not just writing.', 'Практики произношения, а не только письма.')}</p></li>
        <li><strong>{t('Honest limits', 'Честные ограничения')}</strong><p>{t('No usage analytics. The score shows how similar a drawing is to the character; it does not check stroke order.', 'Аналитики использования нет. Оценка показывает, насколько рисунок похож на иероглиф; порядок черт она не проверяет.')}</p></li>
      </ul>
      <p class="note result-note">{t(
        'The prototype is no longer hosted because the bot, API, and Web App need paid infrastructure. The public source code documents the working version, under its working name, Chinese Bee.',
        'Прототип больше не размещён, потому что боту, API и Web App нужна платная инфраструктура. Рабочую версию документирует открытый исходный код под рабочим названием Chinese Bee.',
      )}</p>
    </StudySection>

    <StudySection
      part="next"
      title={t('Add the voice.', 'Добавить голос.')}
      lead={t(
        'Students missed pronunciation practice. Telegram already has voice messages, so the next step fits the chat: hear a word, record it, and get feedback on the tones.',
        'Студентам не хватало практики произношения. В Telegram уже есть голосовые сообщения, так что следующий шаг вписывается в чат: послушать слово, записать его и получить отзыв о тонах.',
      )}
    >
      <div class="next-steps">
        <StepCompare
          title={t('Pronunciation drill, proposed', 'Тренировка произношения, предложение')}
          rows={[
