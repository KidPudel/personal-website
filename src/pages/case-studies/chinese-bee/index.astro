---
import { Image } from 'astro:assets';

import penCircle from '../../../assets/art/elements/circled.png';
import dictationStart from '../../../assets/case_study_images/two-sticks/fact.png';
import flashcardScreen from '../../../assets/case_study_images/two-sticks/flash-card.png';
import graphemes from '../../../assets/case_study_images/two-sticks/graphemes.png';
import sheetInChat from '../../../assets/case_study_images/two-sticks/list-to-fill.png';
import notebookFilled from '../../../assets/case_study_images/two-sticks/notebook-filled.png';
import searchResults from '../../../assets/case_study_images/two-sticks/search1.png';
import searchScreen from '../../../assets/case_study_images/two-sticks/search2.png';
import startScreen from '../../../assets/case_study_images/two-sticks/start1.png';
import DecisionBlock from '../../../components/case-studies/DecisionBlock.astro';
import Plate from '../../../components/case-studies/Plate.astro';
import Rich from '../../../components/case-studies/Rich.astro';
import Rows from '../../../components/case-studies/Rows.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudyLife from '../../../components/case-studies/StudyLife.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import CopybookCover from '../../../components/case-studies/two-sticks/CopybookCover.astro';
import { copybookPaper } from '../../../components/case-studies/two-sticks/copybook';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import { caseStudy } from '../../../content/case-studies';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/plates.css';
import '../../../styles/study-structured.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);

// One set of names, used in the short read, the navigation, and the sections.
const label = {
  problem: t('Problem', 'Проблема'),
  goal: t('Goal', 'Цель'),
  research: t('Research', 'Исследование'),
  decisions: t('Decisions', 'Решения'),
  why: t('Why', 'Почему'),
  result: t('Result', 'Результат'),
};
const goal = t('Connect looking up a character with practising it, in one place.', 'Связать поиск иероглифа с практикой в одном месте.');
const tools = [t('Dictionary', 'Словарь'), t('Flashcard app', 'Приложение с карточками'), t('Paper copybook', 'Бумажные прописи')];
// The learner's core loop, drawn as squares of the copybook, the last leading back to the first.
const loop = [t('Find', 'Найти'), t('Save', 'Сохранить'), t('Recall', 'Вспомнить'), t('Understand', 'Понять'), t('Write', 'Написать')];

const constraints = [
  { name: t('One developer.', 'Один разработчик.'), why: t('I built it alone: a Telegram bot, a FastAPI backend, a PostgreSQL word database, and a Vue handwriting app.', 'Я собрал всё один: Telegram-бота, бэкенд на FastAPI, базу слов на PostgreSQL и приложение для прописей на Vue.') },
  { name: t('A student budget.', 'Студенческий бюджет.'), why: t('Hosting the bot, the API, and the Web App costs money.', 'Боту, API и Web App нужна платная инфраструктура.') },
  { name: t('A chat can’t draw.', 'В чате нельзя рисовать.'), why: t('Handwriting needed more than messages.', 'Для прописей сообщений мало.') },
];

// The study's spine: every finding, where it came from, and what it led to.
const findings = [
  { title: t('Writing practice lived in separate apps.', 'Практика письма жила в отдельных приложениях.'), detail: '', who: t('Diploma: competitive analysis', 'Диплом: конкурентный анализ'), to: t('Decision 1: Telegram', 'Решение 1: Telegram'), href: '#decision-1' },
  { title: t('Each tool had its own word list.', 'У каждого инструмента свой список слов.'), detail: t('A dictionary, flashcards, and a copybook didn’t share anything.', 'Словарь, карточки и прописи ничем не делились.'), who: t('The three tools', 'Три инструмента'), to: t('Decision 2: one word list', 'Решение 2: один список'), href: '#decision-2' },
  { title: t('Structure and mnemonics help you remember.', 'Структура и мнемоника помогают запомнить.'), detail: '', who: t('Diploma: memorisation methods', 'Диплом: методы запоминания'), to: t('Decision 4: notebook sheet', 'Решение 4: лист-пропись'), href: '#decision-4' },
  { title: t('The brief also asked for teacher tools.', 'В брифе были и инструменты для преподавателя.'), detail: '', who: t('Diploma brief', 'Бриф из диплома'), to: t('Left out, for now', 'Пока за рамками'), href: '#left-out' },
];
---

<BaseDocument
  title={t('Two Sticks case study | Igor Kupchinenko', 'Кейс «Две палочки» | Игорь Купчиненко')}
  description={t(
    'How I turned a university diploma’s research into Two Sticks, a Telegram product for finding Chinese characters, remembering them, and writing them by hand, in one chat instead of three tools.',
    'Как я превратил исследование из дипломной работы в «Две палочки», продукт в Telegram, где можно найти китайский иероглиф, запомнить его и прописать от руки. Один чат вместо трёх инструментов.',
  )}
  pageClass="study-plates study-structured study--two-sticks"
  ogImage={searchScreen.src}
  canonicalPath={localePath('/case-studies/two-sticks/', locale)}
>
  <main id="main-content" style={`--plate-paper: ${copybookPaper}`} data-present={localePath('/case-studies/two-sticks/present/', locale)}>
    <!-- The first screen is the short read: each label leads to its section. -->
    <CopybookCover
      title={t('Two Sticks', 'Две палочки')}
      about={caseStudy('two-sticks').about}
      navLabel="TL;DR"
    >
      <Rows rows={[
        { label: label.problem, href: '#problem', text: t('Learners can recognise a Chinese character and still not be able to write it, and practice was split between a dictionary, flashcards, and paper copybooks.', 'Ученики узнают иероглиф, но написать его не могут, а практика разбросана между словарём, карточками и бумажными прописями.') },
        { label: label.goal, href: '#goal', text: goal },
        { label: label.research, href: '#research', text: t('A university diploma’s research, not mine: writing practice lived in separate apps, and Telegram bots were mostly about vocabulary.', 'Исследование из дипломной работы, не моё: практика письма жила в отдельных приложениях, а боты в Telegram были в основном про слова.') },
        { label: label.decisions, href: '#decisions', text: t('Build it inside Telegram with one saved word list for every exercise, plus three choices about the practice itself.', 'Собрать всё внутри Telegram с одним списком слов для всех упражнений, и ещё три решения о самой практике.') },
        { label: label.result, href: '#results', tone: 'result', text: t('Three tools became **one chat**, with **nothing to install**. A few students used it; what they missed was pronunciation practice.', 'Три инструмента превратились в **один чат**, где **ничего не нужно устанавливать**. Им пользовались несколько студентов, и не хватало им практики произношения.') },
      ]} />
    </CopybookCover>

    <StudySection part="problem">
      <div class="stack">
        <p class="opening">{t(
          'A dictionary gives you the character, how it sounds, and what it means. Writing it from memory takes a different kind of practice, and that practice lived in separate tools: a flashcard app and a paper copybook.',
          'Словарь даёт иероглиф, его звучание и значение. А чтобы написать его по памяти, нужна другая практика, и она жила в отдельных инструментах: в приложении с карточками и в бумажных прописях.',
        )}</p>
        <Rows rows={[
          { label: t('Where it started', 'Откуда всё началось'), text: t('A 2024 МПГУ diploma by Смакова, Шаталова, and Шинкарева. Their research became my brief.', 'Диплом МПГУ 2024 года, который написали Смакова, Шаталова и Шинкарева. Их исследование стало моим брифом.') },
        ]} />
      </div>
    </StudySection>

    <StudySection part="goal">
      <div class="goal">
        <Rows rows={[
          { label: label.goal, tone: 'key', text: goal },
          { label: t('How I’d know', 'Как пойму'), list: [
            t('The share of learners who save 5 words and unlock flashcards', 'Доля учеников, которые сохранили 5 слов и открыли карточки'),
            t('The share who go on to handwriting', 'Доля тех, кто дошёл до прописей'),
            t('Scores on the same character over repeated attempts', 'Оценки за один и тот же иероглиф от попытки к попытке'),
          ] },
        ]} />
      </div>
    </StudySection>

    <StudySection part="constraints">
      <ul class="constraints" role="list">
        {constraints.map((item) => <li><strong>{item.name}</strong> {item.why}</li>)}
      </ul>
    </StudySection>

    <StudySection
      part="research"
      title={t('Research it started from', 'Исследование, с которого всё началось')}
      lead={t(
        'The diploma team studied copybooks, memorisation methods, and competing apps and bots. At their open-day masterclass, 15 of 20 visitors were interested in the idea: a signal of interest, not a test of my product.',
        'Дипломная команда изучила прописи, методы запоминания, конкурирующие приложения и боты. На их мастер-классе в день открытых дверей идеей заинтересовались 15 из 20 гостей: это сигнал интереса, а не проверка моего продукта.',
      )}
    >
      <div class="split research-map">
        <!-- The positioning map, with the corner Two Sticks aimed for circled in the pen from the homepage. -->
        <figure class="position" data-arrive>
          <div class="position__plot" role="img" aria-label={t(
            'Positioning map. Skritter offers deep writing practice but is a separate app. Telegram bots are easy to start but focus on vocabulary. Two Sticks is easy to start and includes writing practice.',
            'Карта позиционирования. Skritter даёт серьёзную практику письма, но это отдельное приложение. Боты в Telegram легко начать, но они про слова. «Две палочки» легко начать, и в них есть практика письма.',
          )}>
            <span class="position__axis position__axis--y" aria-hidden="true">{t('↑ More writing practice', '↑ Больше практики письма')}</span>
            <span class="position__axis position__axis--x" aria-hidden="true">{t('Easier to start →', 'Проще начать →')}</span>
            <span class="position__point" style="--x: 14%; --y: 26%" aria-hidden="true">Skritter</span>
            <span class="position__point position__point--end" style="--x: 74%; --y: 74%" aria-hidden="true">{t('Telegram bots', 'Боты в Telegram')}</span>
            <span class="position__point position__point--ours position__point--end" style="--x: 74%; --y: 26%" aria-hidden="true">
              {t('Two Sticks', 'Две палочки')}
              <Image class="position__circle pen-circle" src={penCircle} alt="" widths={[256, 512]} sizes="12rem" loading="lazy" decoding="async" />
            </span>
          </div>
          <figcaption>{t(
            'From the diploma team’s competitive analysis: serious writing practice lived in separate apps, and Telegram bots were easy to start but mostly about vocabulary. Two Sticks aimed for the corner between them.',
            'По конкурентному анализу дипломной команды: серьёзная практика письма была только в отдельных приложениях, а боты в Telegram легко начать, но они в основном про слова. «Две палочки» целились в угол между ними.',
          )}</figcaption>
        </figure>
      </div>

      <h3>{t('What it pointed to, and what it led to', 'На что оно указало и к чему это привело')}</h3>
      <div class="spine">
        <table>
          <thead>
            <tr>
              <th scope="col">{t('Finding', 'Что выяснилось')}</th>
              <th scope="col">{t('Where it came from', 'Откуда')}</th>
              <th scope="col">{t('What it led to', 'К чему привело')}</th>
            </tr>
          </thead>
          <tbody>
            {findings.map((row) => (
              <tr>
                <th scope="row"><strong>{row.title}</strong>{row.detail && <> <span>{row.detail}</span></>}</th>
                <td class="spine__who">{row.who}</td>
                <td class="spine__to"><a href={row.href}><span class="link-mark">{row.to}</span></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </StudySection>

    <StudySection
      part="decisions"
      lead={t(
        'Five decisions. The first two set up the product, the other three shape the practice.',
        'Пять решений. Первые два задают продукт, остальные три определяют практику.',
      )}
    >
      <DecisionBlock
        number={1}
        title={t('A Telegram bot instead of a new app', 'Бот в Telegram вместо нового приложения')}
        navLabel="Telegram"
        why={t('Every new app is one more thing to install, open, and remember.', 'Каждое новое приложение нужно установить, открыть и не забыть о нём.')}
        what={t('Learners were already in Telegram every day. If practice lives there, there’s nothing to install and nothing to remember to open. So search, saving, and flashcards are a Telegram bot, and handwriting opens from the chat as a Telegram Web App.', 'Ученики и так каждый день в Telegram. Если практика живёт там, ничего не нужно устанавливать и помнить, что его надо открыть. Поэтому поиск, сохранение и карточки стали Telegram-ботом, а прописи открываются из чата как Telegram Web App.')}
        notChosen={t('a standalone app. More freedom in the interface, but a harder start, the trade-off Skritter makes.', 'отдельное приложение. Больше свободы в интерфейсе, но начать сложнее, тот же компромисс, что у Skritter.')}
      >
        <Plate caption={t('Handwriting opens from the chat as a Web App.', 'Прописи открываются из чата как Web App.')} shots={[
          { src: dictationStart, alt: t('Two Sticks chat where the dictation command offers a button that opens the handwriting practice.', 'Чат «Двух палочек»: команда диктанта предлагает кнопку, которая открывает прописи.') },
        ]} notes={[
          { x: 60, y: 46, w: 30, h: 3.2, label: t('The dictation command', 'Команда диктанта') },
          { x: 9, y: 55.5, w: 48, h: 3.8, label: t('A button opens the handwriting practice', 'Кнопка открывает прописи') },
        ]} />
      </DecisionBlock>

      <DecisionBlock
        number={2}
        title={t('One saved list for every exercise', 'Один список слов для всех упражнений')}
        navLabel={t('One word list', 'Список слов')}
        why={t('Learners had to build a separate word list for each tool.', 'Ученикам приходилось собирать отдельный список слов для каждого инструмента.')}
        what={t('If every saved word feeds every exercise, each lookup can turn into practice with no extra setup. So Save sits on the character card, next to pinyin, meaning, and HSK level, and flashcards, notebook sheets, and handwriting all pull from that one list.', 'Если каждое сохранённое слово попадает во все упражнения, любой поиск может превратиться в практику без лишней настройки. Поэтому кнопка сохранения стоит на карточке иероглифа, рядом с пиньинем, значением и уровнем HSK, а карточки, листы-прописи и письмо берут слова из этого одного списка.')}
      >
        <Plate shots={[
          { src: searchScreen, alt: t('Character card with pinyin, meaning, HSK level, and a save button.', 'Карточка иероглифа с пиньинем, значением, уровнем HSK и кнопкой сохранения.'), label: t('Save it from the card.', 'Сохранить прямо с карточки.'), notes: [
            { x: 6, y: 69, w: 45, h: 12.5, label: t('Pinyin, meaning, and HSK level', 'Пиньинь, значение и уровень HSK') },
            { x: 7, y: 83, w: 23, h: 3.6, label: t('Save, right on the card', 'Сохранить прямо с карточки') },
          ] },
          { src: searchResults, alt: t('Search for a Russian word returning a list of matching Chinese words.', 'Поиск по русскому слову возвращает список подходящих китайских слов.'), label: t('Search by a Russian word.', 'Поиск по русскому слову.') },
        ]} />
      </DecisionBlock>

      <DecisionBlock
        number={3}
        title={t('Flashcards unlock at five words', 'Карточки открываются после пяти слов')}
        navLabel={t('Flashcards', 'Карточки')}
        why={t('A multiple-choice card with only one or two saved words has no real wrong answers.', 'Если сохранено одно-два слова, в карточке с вариантами ответа нет настоящих неправильных вариантов.')}
        what={t('So flashcards open once five words are saved, and until then the empty state says how many more to add, which turns the wait into a small goal.', 'Поэтому карточки открываются, когда сохранено пять слов, а до этого пустое состояние подсказывает, сколько ещё осталось, и ожидание становится маленькой целью.')}
      >
        <Plate caption={t('Questions come from your own saved words.', 'Вопросы строятся из ваших сохранённых слов.')} shots={[
          { src: flashcardScreen, alt: t('Flashcard practice built from the learner’s saved characters.', 'Практика с карточками на сохранённых иероглифах ученика.') },
        ]} notes={[
          { x: 6, y: 51, w: 82, h: 3.6, label: t('A word you saved', 'Слово, которое вы сохранили') },
          { x: 6, y: 55.6, w: 82, h: 26.5, label: t('The other answers: your other saved words', 'Остальные варианты: другие ваши слова') },
        ]} />
      </DecisionBlock>

      <DecisionBlock
        number={4}
        title={t('A notebook sheet for each character', 'Лист-пропись для каждого иероглифа')}
        navLabel={t('Notebook sheet', 'Лист-пропись')}
        layout="band"
        why={t('Copying a character without knowing its parts makes it hard to remember, and the diploma research pointed to structure and mnemonics.', 'Если переписывать иероглиф, не зная его частей, его трудно запомнить, а исследование из диплома указывало на структуру и мнемонику.')}
        what={t('So the bot sends one notebook sheet per character into the chat, with structure, stroke order, similar characters, a mnemonic, examples, and a writing grid, always one scroll away.', 'Поэтому бот присылает в чат лист-пропись для каждого иероглифа: структура, порядок черт, похожие иероглифы, мнемоника, примеры и сетка для письма, и он всегда в одной прокрутке.')}
      >
        <!-- The sheet as it arrives in the chat, and the sheet itself, laid on the copybook. -->
        <div class="sheet-spread">
          <Plate caption={t('The sheet arrives in the chat.', 'Лист приходит прямо в чат.')} shots={[
            { src: sheetInChat, alt: t('The saved-words command sending a notebook sheet into the chat.', 'Команда сохранённых слов присылает лист-пропись в чат.') },
          ]} />
          <figure class="sheet" data-arrive>
            <span class="sheet__paper panel-paper">
              <Image src={notebookFilled} alt={t('Filled notebook sheet for 教 with structure, stroke order, similar characters, mnemonic, and writing grid.', 'Заполненный лист-пропись для 教 со структурой, порядком черт, похожими иероглифами, мнемоникой и сеткой для письма.')} widths={[800, 1200, 1600]} sizes="(max-width: 759px) calc(100vw - 40px), 44rem" format="webp" quality={88} loading="lazy" decoding="async" />
            </span>
            <figcaption>{t('Structure, stroke order, look-alikes, a mnemonic, and a grid on one sheet.', 'Структура, порядок черт, похожие иероглифы, мнемоника и сетка на одном листе.')}</figcaption>
          </figure>
        </div>
      </DecisionBlock>

      <DecisionBlock
        number={5}
        title={t('An optional primer', 'Вводный курс по желанию')}
        navLabel={t('Primer', 'Вводный курс')}
        why={t('A primer on how characters work helps beginners and slows everyone else down.', 'Вводный курс о том, как устроены иероглифы, помогает новичкам и тормозит всех остальных.')}
        what={t('So the bot asks first, “Yes, show me” or “I already know”, and people who know the basics skip it.', 'Поэтому бот сначала спрашивает: «Да, хочу!» или «Уже знаю», и кто знает основы, пропускает курс.')}
      >
        <Plate shots={[
          { src: startScreen, alt: t('Two Sticks introduction asking whether the learner wants to learn how characters are built, with the options “Yes, show me” and “I already know”.', 'Знакомство с «Двумя палочками»: бот спрашивает, хочет ли ученик узнать, как устроены иероглифы, с вариантами «Да, хочу!» и «Уже знаю».'), label: t('A choice before the primer.', 'Выбор перед курсом.'), notes: [
            { x: 4, y: 79.5, w: 62, h: 3.4, label: t('“Yes, show me” or “I already know”', '«Да, хочу!» или «Уже знаю»') },
          ] },
          { src: graphemes, alt: t('Primer message explaining graphemes and radicals with an example diagram.', 'Сообщение вводного курса о графемах и ключах с примером-схемой.'), label: t('The primer, for those who want it.', 'Курс для тех, кому он нужен.') },
        ]} />
      </DecisionBlock>

      <section class="left-out" id="left-out" data-index-sub data-index-label={t('Left out', 'За рамками')}>
        <h3>{t('What I left out, for now', 'Что я пока оставил за рамками')}</h3>
        <div class="split">
          <Rows rows={[
            { label: t('Left out', 'Оставил'), text: t('Live teacher supervision, an HSK statistics dashboard, and audience growth plans, all from the diploma brief.', 'Живое сопровождение преподавателем, панель статистики HSK и планы по росту аудитории, всё из брифа диплома.') },
            { label: t('Shipped first', 'Сначала'), tone: 'key', text: t('The learner’s core loop: find, save, recall, understand, write.', 'Основной цикл ученика: найти, сохранить, вспомнить, понять, написать.') },
            { label: label.why, text: t('Teacher tools only matter once learners come back on their own, so that had to be proven first.', 'Инструменты для преподавателя нужны, только когда ученики возвращаются сами, поэтому сначала нужно было доказать это.') },
          ]} />
          <ol class="loop" role="list" aria-label={t('The core loop', 'Основной цикл')}>
            {loop.map((step, index) => <li style={`--i: ${index}`}><span class="loop__number">{index + 1}</span>{step}</li>)}
          </ol>
        </div>
      </section>
    </StudySection>

    <StudySection part="results">
      <p class="statement" data-arrive><Rich text={t('Three tools became ==one chat==, with nothing to install.', 'Три инструмента превратились в ==один чат==, где ничего не нужно устанавливать.')} /></p>

      <div class="split results">
