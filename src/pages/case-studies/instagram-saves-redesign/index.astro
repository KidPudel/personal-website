  .priority__item p { margin: 0; color: var(--color-copy); font-size: 1rem; line-height: 1.5; }
  .priority__item--first .priority__tag, .priority__item--first p { color: rgb(248 248 248 / 72%); }

  .wireframes { display: grid; gap: 28px; margin-top: 20px; }
