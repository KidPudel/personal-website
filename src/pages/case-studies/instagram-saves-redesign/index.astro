---
import actions from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/action_prompt_for_save.png';
import savedNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/all_saved_new.png';
import savedOld from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/all_saved_old.png';
import annotation from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/annotation.png';
import feed from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/collection_feed.png';
import filter from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/filter.png';
import filterResult from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/filter_result.png';
import saveNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/save_new.png';
import saveOld from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/save_old.png';
import newYork from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/search_new_york.png';
import spider from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/search_spider.png';
import doodlesOne from '../../../assets/case_study_images/instagram-saves-redesign/interview-doodles/interview set 1.png';
import doodlesTwo from '../../../assets/case_study_images/instagram-saves-redesign/interview-doodles/interview set 2.png';
import saveFlow from '../../../assets/case_study_images/instagram-saves-redesign/wireframes/wireframe_flow_save.png';
import managementFlow from '../../../assets/case_study_images/instagram-saves-redesign/wireframes/wireframe_flow_saves_management.png';
import savingFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-540.mp4?url';
import savingFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-720.mp4?url';
import savingFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-poster.png';
import managementFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-540.mp4?url';
import managementFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-720.mp4?url';
import managementFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-poster.png';
import searchFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-540.mp4?url';
import searchFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-720.mp4?url';
import searchFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-poster.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import Decision from '../../../components/case-studies/Decision.astro';
import DotStat from '../../../components/case-studies/DotStat.astro';
import MetricGrid from '../../../components/case-studies/MetricGrid.astro';
import Shot from '../../../components/case-studies/Shot.astro';
import StarSummary from '../../../components/case-studies/StarSummary.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import StudyFilm from '../../../components/case-studies/instagram-saves/StudyFilm.astro';
import StudyImage from '../../../components/case-studies/instagram-saves/StudyImage.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/case-study.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const heroSizes = '(max-width: 760px) calc((100vw - 56px) / 2), 280px';
const pairSizes = '(max-width: 760px) calc((100vw - 56px) / 2), 250px';

const participants = [
  { profile: t('Casual recipe saver', 'Сохраняет рецепты между делом'), need: t('Save without thinking, find by meaning later.', 'Сохранять не задумываясь, находить потом по смыслу.'), finding: true },
  { profile: t('Creator with a reference library', 'Автор контента с библиотекой референсов'), need: t('Keep the reason, not only the post.', 'Хранить причину, а не только пост.'), finding: true },
  { profile: t('Travel planner', 'Планирует путешествия'), need: t('Get the place out of the video.', 'Достать из видео само место.'), finding: false },
  { profile: t('Shares a collection with a partner', 'Ведёт общую коллекцию с партнёром'), need: t('Go from collecting to deciding together.', 'Перейти от собирания к совместному решению.'), finding: false },
  { profile: t('Saving for years', 'Сохраняет годами'), need: t('Stay usable with thousands of saves.', 'Оставаться удобным, когда сохранений тысячи.'), finding: true },
  { profile: t('Heavy Reels viewer who never files', 'Много смотрит рилсы и не сортирует'), need: t('Find from a vague memory, without filing.', 'Находить по смутному воспоминанию, без сортировки.'), finding: true },
  { profile: t('Mostly stopped using Saved', 'Почти перестал пользоваться «Сохранённым»'), need: t('Help letting go, not only keeping.', 'Помогать отпускать, а не только хранить.'), finding: false },
  { profile: t('Overwhelmed by manual search', 'Теряется при ручном поиске'), need: t('Anchors to search by: when it was saved and what the picture shows.', 'Опоры для поиска: когда сохранено и что на картинке.'), finding: true },
  { profile: t('Returns to the same references', 'Возвращается к одним и тем же референсам'), need: t('Keep repeat references close, and a shared folder worth trusting.', 'Держать частые референсы под рукой и доверять общей папке.'), finding: true },
];

const journey = [
  { name: t('Save', 'Сохранить'), does: t('Tap Save and keep scrolling.', 'Нажать «Сохранить» и листать дальше.'), breaks: t('Picking a collection interrupts the scroll, so many saves go unfiled.', 'Выбор коллекции прерывает просмотр, поэтому многие сохранения остаются неразобранными.'), fix: t('Decision 3: suggested collection', 'Решение 3: подсказка коллекции') },
  { name: t('Organise', 'Разобрать'), does: t('Make more collections, or plan a weekly clean-up.', 'Завести больше коллекций или разбирать раз в неделю.'), breaks: t('Too many collections, no clear place for a post. One weekly review lasted two weeks.', 'Коллекций слишком много, непонятно, куда положить пост. Еженедельный разбор продержался две недели.'), fix: t('Decision 3: fewer choices to make', 'Решение 3: меньше выбора') },
  { name: t('Remember', 'Вспомнить'), does: t('Recall what the post showed and roughly when.', 'Вспомнить, что было в посте и примерно когда.'), breaks: t('Memory works by subject and time. Saved works by folder.', 'Память работает по теме и времени. «Сохранённое» по папкам.'), fix: t('Decisions 1 and 2: search and a date range', 'Решения 1 и 2: поиск и диапазон дат') },
  { name: t('Find', 'Найти'), does: t('Scroll the grid, open a post, go back.', 'Листать сетку, открыть пост, вернуться.'), breaks: t('Posts look alike and the place gets lost. After a minute or two, people give up and look for something new.', 'Посты похожи, место в ленте теряется. Через минуту-другую люди сдаются и ищут что-то новое.'), fix: t('Decision 1: search inside Saved', 'Решение 1: поиск в «Сохранённом»') },
  { name: t('Use', 'Использовать'), does: t('Copy it to Notes, Notion, Maps, or a chat to act on it.', 'Перенести в Заметки, Notion, Карты или чат, чтобы что-то сделать.'), breaks: t('The reason and the next step live outside Instagram.', 'Причина и следующий шаг живут вне Instagram.'), fix: t('Decisions 4 and 5: notes, pins, reactions, a collection feed', 'Решения 4 и 5: заметки, закрепление, реакции, лента коллекции') },
];
---

<BaseDocument
  title={t('Instagram Saves, worth coming back to | Igor Kupchinenko', 'Сохранённое в Instagram, к которому хочется вернуться | Игорь Купчиненко')}
  description={t(
    'A redesign concept for Instagram Saves. Nine interviews showed that finding a saved post was the main problem for six people, so search came first, then lighter filing, notes, and pins.',
    'Концепт редизайна «Сохранённого» в Instagram. Девять интервью показали, что для шести человек главная проблема в том, чтобы найти сохранённый пост, поэтому первым стал поиск, а за ним более лёгкая сортировка, заметки и закрепление.',
  )}
  pageClass="instagram-case-study editorial-case-study"
  ogImage={savedNew.src}
>
  <main id="main-content">
    <header class="hero">
      <h1 class="hero-title">{t('Instagram Saves, worth coming back to.', 'Сохранённое в Instagram, к которому хочется вернуться.')}</h1>
      <p class="hero__line">{t('The more you save, the less you can find.', 'Чем больше сохраняешь, тем сложнее найти.')}</p>

      <dl class="facts">
        <div><dt>{t('Role', 'Роль')}</dt><dd>{t('Research, UX/UI, and prototyping', 'Исследование, UX/UI и прототипирование')}</dd></div>
        <div><dt>{t('Type', 'Тип')}</dt><dd>{t('Self-initiated redesign concept, 2026', 'Самостоятельный концепт редизайна, 2026')}</dd></div>
        <div><dt>{t('Research', 'Исследование')}</dt><dd>{t('9 interviews', '9 интервью')}</dd></div>
        <div><dt>{t('Output', 'Итог')}</dt><dd>{t('Interactive mobile prototype', 'Интерактивный мобильный прототип')}</dd></div>
      </dl>

      <div class="hero-screens">
        <Shot kind="screen" src={savedNew} priority="high" sizes={heroSizes} alt={t('Redesigned Saved screen with search, collections, and a grid of saved posts.', 'Экран «Сохранённое» после редизайна: поиск, коллекции и сетка сохранённых публикаций.')} />
        <Shot kind="screen" src={saveNew} priority="eager" sizes={heroSizes} alt={t('Redesigned save sheet with suggested collections.', 'Окно сохранения после редизайна с предложенными коллекциями.')} />
      </div>
    </header>

    <StarSummary
      situation={t(
        'Saving on Instagram takes one tap. Finding that save again means scrolling through all of them.',
        'Сохранить в Instagram можно одним касанием. А чтобы найти сохранённое, приходится листать всё подряд.',
      )}
      task={t(
        'Make saves findable again, without asking people to organise more.',
        'Сделать сохранённое снова находимым и не заставлять людей больше сортировать.',
      )}
      action={t(
        '9 interviews. 6 people named the same problem, so search came first. Then lighter filing, notes, and pins.',
        '9 интервью. 6 человек назвали одну и ту же проблему, поэтому первым стал поиск. Потом более лёгкая сортировка, заметки и закрепление.',
      )}
      result={t(
        'A prototype where a half-remembered post takes one search instead of a long scroll, and a new collection takes one tap instead of typing a name.',
        'Прототип, в котором полузабытый пост находится одним поиском вместо долгого листания, а новая коллекция создаётся одним касанием вместо ввода названия.',
      )}
    />

    <MetricGrid
      metrics={[
        { value: t('6 of 9', '6 из 9'), label: t('named finding a saved post as their main problem', 'назвали поиск сохранённого главной проблемой'), basis: t('Interviews', 'Интервью') },
        { value: t('≈90 s → ≈10 s', '≈90 с → ≈10 с'), label: t('to find a half-remembered post', 'чтобы найти полузабытый пост'), basis: t('Estimate: scrolling 76 saves vs one search', 'Оценка: листать 76 сохранений или один поиск') },
        { value: t('2 taps + a name → 1 tap', '2 касания + название → 1 касание'), label: t('to save into a new collection', 'чтобы сохранить в новую коллекцию'), basis: t('Counted from the designs', 'Посчитано по макетам') },
      ]}
      caption={t(
        'The prototype has not been tested at scale. Estimates come from walking through the flows.',
        'Прототип не тестировали в масштабе. Оценки получены при проходе по сценариям.',
      )}
    />

    <StudySection
      part="situation"
      title={t('You saved it for later. Later has arrived.', 'Ты сохранил это на потом. «Потом» наступило.')}
      lead={t(
        'You remember the reel, more or less. You open Saved and start scrolling. Still scrolling. I kept losing references I had saved on purpose: saving worked, getting back did not.',
        'Ты помнишь тот рилс, более-менее. Открываешь «Сохранённое» и начинаешь листать. Всё ещё листаешь. Я сам постоянно терял референсы, которые сохранял специально: сохранять получалось, а вернуться нет.',
      )}
    >
      <div class="situation-pair breakout">
        <Shot kind="screen" src={savedOld} sizes="(max-width: 760px) min(calc(100vw - 40px), 300px), 300px" alt={t('Current Saved screen with collections and a grid of 76 saved posts, without search.', 'Текущий экран «Сохранённое»: коллекции и сетка из 76 публикаций, без поиска.')} caption={t('Saved today: collections, then one long grid. No search.', '«Сохранённое» сейчас: коллекции, потом одна длинная сетка. Поиска нет.')} />
        <div class="why-card">
          <p class="why-card__label">{t('My hypothesis', 'Моя гипотеза')}</p>
          <h3 class="why-card__title">{t('Why Instagram should care', 'Почему это важно для Instagram')}</h3>
          <p class="why-card__text">{t(
            'A save is a strong signal of intent: someone wanted this again. If Saved works, it gives people one more reason to come back to the app. If it does not, those signals go to waste.',
            'Сохранение сильный сигнал намерения: человек хотел вернуться к этому. Если «Сохранённое» работает, у людей появляется ещё одна причина возвращаться в приложение. Если нет, эти сигналы пропадают зря.',
          )}</p>
        </div>
      </div>
    </StudySection>

    <StudySection
      part="task"
      title={t('Make saves findable, without more filing.', 'Сделать сохранённое находимым без лишней сортировки.')}
      lead={t(
        'A self-initiated concept. I ran the interviews, synthesised them, and designed and prototyped the redesign.',
        'Самостоятельный концепт. Я провёл интервью, свёл выводы, спроектировал редизайн и собрал прототип.',
      )}
    >
      <dl class="goal breakout">
        <div><dt>{t('Goal', 'Цель')}</dt><dd>{t('Get people back to a specific save quickly.', 'Быстро возвращать людей к конкретному сохранённому.')}</dd></div>
        <div><dt>{t('How I would know', 'Как понять, что получилось')}</dt><dd>{t('Share of Saved visits that end in opening a post. Time to find a post. Share of saves filed into a collection.', 'Доля заходов в «Сохранённое», которые заканчиваются открытием поста. Время на поиск поста. Доля сохранений, разложенных по коллекциям.')}</dd></div>
        <div><dt>{t('Guardrail', 'Ограничитель')}</dt><dd>{t('Saving must stay one tap, and total saves should not drop.', 'Сохранение должно остаться одним касанием, а общее число сохранений не должно упасть.')}</dd></div>
      </dl>
    </StudySection>

    <StudySection
      part="action"
      title={t('Nine interviews. One problem kept coming back.', 'Девять интервью. Одна проблема возвращалась снова и снова.')}
      lead={t(
        'I asked nine people the same questions: why they started saving, how they save and find things now, what they tried before, and what they use instead.',
        'Я задал девяти людям одни и те же вопросы: почему они начали сохранять, как сохраняют и ищут сейчас, что пробовали раньше и чем пользуются вместо этого.',
      )}
    >
      <div class="research-board breakout">
        <DotStat
          title={t('Named finding a specific save as their main problem', 'Назвали главной проблемой поиск конкретного сохранённого')}
          rows={[{ label: t('People interviewed', 'Участники интервью'), value: 6, total: 9, emphasis: true }]}
          note={t('By far the most common thread.', 'Самая частая тема, с большим отрывом.')}
        />
        <ul class="tiles research-board__also" role="list">
          <li><strong>{t('Important things leave Instagram', 'Важное уходит из Instagram')}</strong><p>{t('7 of 9 moved anything that mattered into Notes, Notion, Maps, screenshots, or messages.', '7 из 9 переносили всё важное в Заметки, Notion, Карты, скриншоты или сообщения.')}</p></li>
          <li><strong>{t('Filing feels like homework', 'Сортировка как домашнее задание')}</strong><p>{t('5 of 9 tried more collections, and it stopped working: too many, too slow, or no clear place for a post.', '5 из 9 пробовали завести больше коллекций, и это переставало работать: их слишком много, сохранять долго или непонятно, куда положить пост.')}</p></li>
          <li><strong>{t('Why did I save this?', 'Зачем я это сохранил?')}</strong><p>{t('A collection keeps the post, not the reason. A creator pasted links into Notion just to write the reason down.', 'Коллекция хранит пост, но не причину. Автор контента вставлял ссылки в Notion, только чтобы записать зачем.')}</p></li>
          <li><strong>{t('Shared collections give no feedback', 'Общие коллекции молчат')}</strong><p>{t('The 2 people who used them did not trust them: no sign the other person saw a post, and no way to say “let’s do this”.', 'Двое, кто ими пользовался, им не доверяли: не видно, заметил ли пост другой человек, и нельзя сказать «давай сделаем это».')}</p></li>
        </ul>
      </div>

      <h3 class="subtitle">{t('Nine people, nine needs', 'Девять человек, девять потребностей')}</h3>
      <div class="people breakout">
        {[true, false].map((finding) => (
          <section class="people__group">
            <h4 class="people__label">{finding
              ? t('Main problem: finding a save', 'Главная проблема: найти сохранённое')
              : t('Other main problems', 'Другие главные проблемы')}
              <span>{participants.filter((person) => person.finding === finding).length}</span></h4>
            <ul role="list">
              {participants.filter((person) => person.finding === finding).map((person) => (
                <li class="people__row"><strong>{person.profile}</strong><span>{person.need}</span></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="note">{t('Needs are my synthesis of each interview, not quotes.', 'Потребности это мой вывод из каждого интервью, а не цитаты.')}</p>

      <div class="notebooks breakout">
        <StudyImage src={doodlesOne} kind="spread" alt={t("First notebook spread of Igor's interview doodles and handwritten observations about saving and finding posts.", 'Первый разворот блокнота с рисунками Игоря с интервью и рукописными наблюдениями о том, как сохраняют и ищут публикации.')} caption={t('My interview notes, drawn as well as written.', 'Мои заметки с интервью, не только записанные, но и нарисованные.')} />
        <StudyImage src={doodlesTwo} kind="spread" alt={t('Second notebook spread with sketched people and notes about revisiting, organizing, and remembering saves.', 'Второй разворот блокнота с набросками людей и заметками о том, как возвращаются к сохранённому, упорядочивают его и вспоминают.')} caption={t('Nine people set the direction. They do not speak for every Instagram user.', 'Девять человек задали направление. Они не говорят за всех пользователей Instagram.')} />
      </div>

      <h3 class="subtitle">{t('Where the journey breaks', 'Где ломается путь')}</h3>
      <div class="journey breakout">
      <table>
        <thead>
          <tr>
            <th scope="col">{t('Stage', 'Этап')}</th>
            <th scope="col">{t('What people do', 'Что делают люди')}</th>
            <th scope="col">{t('What breaks', 'Что ломается')}</th>
            <th scope="col">{t('What fixes it', 'Что это чинит')}</th>
          </tr>
        </thead>
        <tbody>
          {journey.map((stage, index) => (
            <tr>
              <th scope="row">{index + 1}. {stage.name}</th>
              <td data-label={t('What people do', 'Что делают люди')}>{stage.does}</td>
              <td data-label={t('What breaks', 'Что ломается')}>{stage.breaks}</td>
              <td data-label={t('What fixes it', 'Что это чинит')}>{stage.fix}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <p class="note">{t('A customer journey map built from all nine interviews.', 'Карта пути пользователя, собранная по всем девяти интервью.')}</p>

      <h3 class="subtitle">{t('What to build first', 'Что делать в первую очередь')}</h3>
      <ol class="priority breakout" role="list">
        <li class="priority__item priority__item--first"><span class="priority__tag">{t('First', 'Сначала')}</span><strong>{t('Search and a date filter', 'Поиск и фильтр по дате')}</strong><p>{t('For the 6 of 9 who could not find a save.', 'Для 6 из 9, кто не мог найти сохранённое.')}</p></li>
        <li class="priority__item"><span class="priority__tag">{t('Next', 'Затем')}</span><strong>{t('Collection suggestions', 'Подсказки коллекций')}</strong><p>{t('Filed saves are easier to find later.', 'Разложенное проще найти потом.')}</p></li>
        <li class="priority__item"><span class="priority__tag">{t('Then', 'Потом')}</span><strong>{t('Notes and pins', 'Заметки и закрепление')}</strong><p>{t('Remember why, and find by your own words.', 'Помнить зачем и искать своими словами.')}</p></li>
        <li class="priority__item"><span class="priority__tag">{t('To test', 'Проверить')}</span><strong>{t('Shared reactions and a collection feed', 'Общие реакции и лента из коллекции')}</strong><p>{t('Worth trying, not yet proven.', 'Стоит попробовать, но пока не доказано.')}</p></li>
      </ol>
      <p class="note">{t(
        'Heard, but left for later: pulling places out of travel videos, a plan-and-decide flow for couples, bulk tools and export for years of saves, and help letting go of saves. Each came from one person. Search served six.',
        'Услышал, но отложил: доставать места из видео о путешествиях, сценарий «спланировать и решить» для пар, массовые действия и экспорт для многолетних сохранений и помощь в том, чтобы отпускать сохранённое. Каждое из этого было у одного человека. Поиск нужен шестерым.',
      )}</p>

      <h3 class="subtitle">{t('Wireframes before pixels', 'Вайрфреймы до пикселей')}</h3>
      <div class="wireframes">
        <StudyImage src={saveFlow} kind="wireframe" alt={t('Early three-screen wireframe flow from watching a reel to a save prompt and suggested collections.', 'Ранний вайрфрейм из трёх экранов: от просмотра рилса до предложения сохранить и подсказанных коллекций.')} caption={t('Saving: from a reel to a suggested collection.', 'Сохранение: от рилса до подсказанной коллекции.')} />
        <StudyImage src={managementFlow} kind="wireframe" alt={t('Wireframe sequence exploring saved-content management, collections, and search states.', 'Серия вайрфреймов: управление сохранённым, коллекции и состояния поиска.')} caption={t('Finding: collections, search, and result states.', 'Поиск: коллекции, запрос и состояния результатов.')} />
      </div>

      <Decision
        number={1}
        title={t('Search inside Saved.', 'Поиск прямо в «Сохранённом».')}
        problem={t('People remember what a post showed, not who posted it or where they filed it. “There’s no way to search for ‘pasta with lemon’ inside my saves.”', 'Люди помнят, что было в посте, но не кто его выложил и куда он сохранён. «В сохранённом никак не найти „пасту с лимоном“».')}
        decision={t('Search across titles, your notes, and AI descriptions of each post, right inside Saved.', 'Поиск по названиям, твоим заметкам и AI-описаниям постов прямо в «Сохранённом».')}
        why={t('It works on the saves people already have. One person said they would not use a redesign that made them organise everything by hand. Another wanted to search by what the picture shows, which the descriptions allow.', 'Он работает с тем, что уже сохранено. Один человек сказал, что не станет пользоваться редизайном, если придётся всё раскладывать вручную. Другой участник хотел искать по тому, что изображено, и описания это позволяют.')}
        instead={t('Pushing people to organise better. That is work up front, exactly the work people skip.', 'Попыток заставить людей лучше сортировать. Это работа заранее, ровно та, которую люди пропускают.')}
        effect={t('≈90 s of scrolling → ≈10 s with a search', '≈90 с листания → ≈10 с с поиском')}
        effectLabel={t('Estimate', 'Оценка')}
      >
        <div class="pair">
          <Shot kind="screen" src={spider} sizes={pairSizes} alt={t('Prototype search for spider returning two saved posts.', 'Поиск в прототипе по запросу «spider» находит две сохранённые публикации.')} caption={t('A subject you remember.', 'Тема, которую помнишь.')} />
          <Shot kind="screen" src={newYork} sizes={pairSizes} alt={t('Prototype search for new york returning three saved posts.', 'Поиск в прототипе по запросу «new york» находит три сохранённые публикации.')} caption={t('A place you remember.', 'Место, которое помнишь.')} />
        </div>
        <p class="note visual-note">{t('Designed result states. Whether AI search reliably finds the right save still needs testing on real libraries.', 'Это спроектированные состояния результатов. Сможет ли AI-поиск надёжно находить нужное, ещё предстоит проверить на настоящих коллекциях.')}</p>
      </Decision>

      <Decision
        number={2}
        title={t('Remembering when is enough.', 'Достаточно помнить когда.')}
        problem={t('A long-time saver knew roughly when they saved a post but could not jump to a month or year. Another wanted time as an anchor for searching.', 'Человек, который сохраняет годами, примерно помнил, когда сохранил пост, но не мог перейти к месяцу или году. Другой участник хотел опираться на время при поиске.')}
        decision={t('Oldest-first sorting and a saved-date range next to search. The active range stays visible above the results.', 'Сортировка от старых к новым и диапазон дат сохранения рядом с поиском. Выбранный диапазон остаётся на виду над результатами.')}
        why={t('With years of saves, even a rough time window cuts the pile down.', 'Когда сохранения копятся годами, даже примерный промежуток сильно сокращает кучу.')}
      >
        <div class="pair">
          <Shot kind="screen" src={filter} sizes={pairSizes} alt={t('Saved search filter with latest-first and oldest-first sorting and a saved-date range from August 28, 2025 to August 27, 2026.', 'Фильтр поиска по сохранённому с сортировкой от новых и от старых и диапазоном дат сохранения с 28 августа 2025 по 27 августа 2026 года.')} caption={t('Narrow the time window.', 'Сузить промежуток времени.')} />
          <Shot kind="screen" src={filterResult} sizes={pairSizes} alt={t('Travel search results with the selected date range and latest-first sort shown above the grid.', 'Результаты поиска по коллекции «Travel» с выбранным диапазоном дат и сортировкой от новых над сеткой.')} caption={t('The range stays in view.', 'Диапазон остаётся на виду.')} />
        </div>
      </Decision>

      <Decision
        number={3}
        title={t('Suggest the collection. Keep the choice.', 'Подсказать коллекцию. Оставить выбор.')}
        problem={t('Filing means finding a collection or naming a new one, mid-scroll. “I don’t want to interrupt what I’m doing.” People with many collections found saving itself slow.', 'Сортировка означает найти коллекцию или придумать название новой прямо посреди ленты. «Не хочу прерывать то, чем занят». У тех, у кого много коллекций, медленным стало само сохранение.')}
        decision={t('Two suggestions above the full list: the best-matching collection, and a new one with a name already filled in.', 'Две подсказки над полным списком: самая подходящая коллекция и новая, уже с названием.')}
        why={t('Reduce the decision without taking it away. The full list stays for when a suggestion is wrong.', 'Облегчить решение, не отнимая его. Полный список остаётся на случай, если подсказка ошиблась.')}
        effect={t('New collection: 2 taps and a name → 1 tap', 'Новая коллекция: 2 касания и название → 1 касание')}
        effectLabel={t('Counted from the designs', 'Посчитано по макетам')}
      >
        <div class="pair">
          <Shot kind="screen" src={saveOld} sizes={pairSizes} alt={t('Original save sheet showing the collection list.', 'Исходное окно сохранения со списком коллекций.')} caption={t('Before: find or name it yourself.', 'До: найти или назвать самому.')} />
          <Shot kind="screen" src={saveNew} sizes={pairSizes} alt={t('Redesigned save sheet suggesting an existing collection and a possible new collection.', 'Окно сохранения после редизайна: подсказывает существующую коллекцию и возможную новую.')} caption={t('After: two suggestions on top.', 'После: две подсказки сверху.')} />
        </div>
      </Decision>

      <Decision
        number={4}
        title={t('Remember why you saved it.', 'Помнить, зачем сохранил.')}
        problem={t('A collection says where a post belongs, not why it mattered. One person kept reaching for the same references, and two did not trust shared collections without any feedback.', 'Коллекция говорит, куда относится пост, но не почему он был важен. Один человек снова и снова возвращался к одним и тем же референсам, а двое не доверяли общим коллекциям без обратной связи.')}
        decision={t('Short notes on a save, searchable later. Pins for references you return to often. Reactions for shared collections.', 'Короткие заметки к сохранённому, по которым потом можно искать. Закрепление для частых референсов. Реакции для общих коллекций.')}
        why={t('A note becomes one more way back, in your own words.', 'Заметка становится ещё одним путём обратно, твоими словами.')}
        effect={t('Shared notes need a clear “who can see this” state before testing.', 'Общим заметкам нужно явно показать, кто их видит, до тестирования.')}
        effectLabel={t('Still open', 'Ещё открыто')}
      >
        <div class="pair">
          <Shot kind="screen" src={annotation} sizes={pairSizes} alt={t('Annotation editor with a note about a limited blue palette.', 'Редактор заметки с записью об ограниченной синей палитре.')} caption={t('A note in your own words.', 'Заметка своими словами.')} />
          <Shot kind="screen" src={actions} sizes={pairSizes} alt={t('Saved-post actions for pinning, annotations, and shared reactions.', 'Действия с сохранённой публикацией: закрепить, добавить заметку, поставить общую реакцию.')} caption={t('Pin, note, or react.', 'Закрепить, подписать, отреагировать.')} />
        </div>
      </Decision>

      <Decision
        number={5}
        title={t('Bring a collection into the feed.', 'Вернуть коллекцию в ленту.')}
        problem={t('One person stopped using Saved: it had become a backlog of things never read, made, or bought. Saving had replaced doing.', 'Один человек перестал пользоваться «Сохранённым»: оно превратилось в список непрочитанного, несделанного и некупленного. Сохранение заменило действие.')}
        decision={t('Collections in the feed selector next to Following and Favorites, so a Design collection can become a daily feed.', 'Коллекции в переключателе ленты рядом с «Подписками» и «Избранным», чтобы коллекция «Design» могла стать ежедневной лентой.')}
        why={t('Saves get a place in everyday browsing instead of a folder nobody opens.', 'Сохранённое получает место в повседневном просмотре вместо папки, которую никто не открывает.')}
        effect={t('It might become just more scrolling, and it does not help people let go of saves. Needs testing.', 'Может стать просто ещё одним листанием, и оно не помогает отпускать сохранённое. Нужно проверить.')}
        effectLabel={t('Open question', 'Открытый вопрос')}
      >
        <Shot kind="screen" src={feed} alt={t('Instagram feed menu expanded to show Following, Favorites, and Collections with Design, Travel, Art, and Health choices.', 'Раскрытое меню ленты Instagram: «Following», «Favorites» и «Collections» с вариантами Design, Travel, Art и Health.')} caption={t('A collection in the main feed selector.', 'Коллекция в главном переключателе ленты.')} />
      </Decision>
    </StudySection>

    <StudySection
      part="result"
      title={t('From scrolling to searching.', 'От листания к поиску.')}
      lead={t(
        'When I showed the prototype, people reacted warmly: “this is a massive improvement”, “really convenient”. Those are early reactions, not evidence, so the numbers below are estimates from the flows.',
        'Когда я показывал прототип, люди реагировали тепло: «это огромное улучшение», «очень удобно». Это первые реакции, а не доказательства, поэтому цифры ниже это оценки по сценариям.',
      )}
    >
      <div class="films breakout">
        <StudyFilm id="search-film" title={t('Less scrolling. More finding.', 'Меньше листать. Больше находить.')} description={t('Start with what you remember, then narrow it down.', 'Начни с того, что помнишь, а потом сузь поиск.')}
          small={searchFilmSmall} large={searchFilmLarge} poster={searchFilmPoster} />
        <StudyFilm id="saving-film" title={t('An easier save.', 'Сохранять проще.')} description={t('A familiar tap, with a helpful collection suggestion.', 'Привычное нажатие и полезная подсказка коллекции.')}
          small={savingFilmSmall} large={savingFilmLarge} poster={savingFilmPoster} />
        <StudyFilm id="management-film" title={t('Make saves yours.', 'Сделать сохранённое своим.')} description={t('Add a note, leave a reaction, keep a reference close.', 'Добавь заметку, оставь реакцию, держи референс под рукой.')}
          small={managementFilmSmall} large={managementFilmLarge} poster={managementFilmPoster} />
      </div>

      <div class="charts breakout">
        <BarCompare
          title={t('Time to find a half-remembered post', 'Время, чтобы найти полузабытый пост')}
          rows={[
            { label: t('Today: scroll the grid', 'Сейчас: листать сетку'), value: 90, display: t('≈90 s', '≈90 с') },
            { label: t('Prototype: search', 'Прототип: поиск'), value: 10, display: t('≈10 s', '≈10 с'), emphasis: true },
          ]}
          note={t('Estimate for a library of 76 saves, like the one in the prototype. Larger libraries widen the gap.', 'Оценка для 76 сохранений, как в прототипе. Чем больше сохранений, тем больше разрыв.')}
        />
        <StepCompare
          title={t('Saving into a new collection', 'Сохранить в новую коллекцию')}
          rows={[
            { label: t('Today', 'Сейчас'), steps: [t('Save', 'Сохранить'), t('New collection', 'Новая коллекция'), t('Type a name', 'Ввести название'), t('Done', 'Готово')] },
            { label: t('Prototype', 'Прототип'), steps: [t('Save', 'Сохранить'), t('Suggested collection', 'Подсказанная коллекция')], emphasis: true },
          ]}
          note={t('Counted from the designs.', 'Посчитано по макетам.')}
        />
      </div>

      <h3 class="subtitle">{t('What I would measure at Instagram’s scale', 'Что я бы измерял в масштабе Instagram')}</h3>
      <ul class="tiles breakout" role="list">
        <li><strong>{t('Finding', 'Находимость')}</strong><p>{t('Share of Saved visits that end with a post opened.', 'Доля заходов в «Сохранённое», которые заканчиваются открытием поста.')}</p></li>
        <li><strong>{t('Search', 'Запросы')}</strong><p>{t('Searches that end in an open, and the time it takes.', 'Доля запросов, после которых открыли пост, и сколько на это ушло времени.')}</p></li>
        <li><strong>{t('Filing', 'Сортировка')}</strong><p>{t('Share of saves in a collection, and how often suggestions are accepted.', 'Доля сохранений в коллекциях и как часто принимают подсказки.')}</p></li>
        <li><strong>{t('Guardrail', 'Ограничитель')}</strong><p>{t('Total saves and time to save must not get worse.', 'Общее число сохранений и время на сохранение не должны ухудшиться.')}</p></li>
      </ul>
    </StudySection>

    <StudySection
      part="next"
      title={t('Test it on real, messy libraries.', 'Проверить на настоящих, запущенных сохранениях.')}
      lead={t(
        'The search results in the prototype are designed states. Next: a task test with 5 people on their own saves, comparing today’s Instagram with the prototype and timing how long it takes to find a post they remember.',
        'Результаты поиска в прототипе спроектированы заранее. Дальше: тест с 5 людьми на их собственных сохранениях, чтобы сравнить сегодняшний Instagram с прототипом и засечь, сколько времени уходит на поиск поста, который они помнят.',
      )}
    />
  </main>

  <footer class="case-footer">
    <nav aria-label={t('Instagram Saves project links', 'Ссылки проекта «Сохранённое» в Instagram')}>
      <a href={localePath('/', locale)}><span class="link-line">{t('Home', 'Главная')}</span></a>
      <a href={localePath('/case-studies/', locale)}><span class="link-line">{t('All case studies', 'Все кейсы')}</span></a>
      <a href={localePath('/case-studies/two-sticks/', locale)}><span class="link-line">{t('Two Sticks case study →', 'Кейс «Две палочки» →')}</span></a>
    </nav>
  </footer>
</BaseDocument>

<style>
