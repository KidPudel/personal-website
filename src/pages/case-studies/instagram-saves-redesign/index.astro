---
import { Image } from 'astro:assets';

import penCircle from '../../../assets/art/elements/circled.png';
import actions from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/action_prompt_for_save.png';
import savedNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/all_saved_new.png';
import savedOld from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/all_saved_old.png';
import annotation from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/annotation.png';
import collectionNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/collection_new.png';
import feed from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/collection_feed.png';
import filter from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/filter.png';
import filterResult from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/filter_result.png';
import saveNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/save_new.png';
import saveOld from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/save_old.png';
import newYork from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/search_new_york.png';
import spider from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/search_spider.png';
import doodlesOne from '../../../assets/case_study_images/instagram-saves-redesign/interview-doodles/interview set 1.png';
import doodlesTwo from '../../../assets/case_study_images/instagram-saves-redesign/interview-doodles/interview set 2.png';
import saveFlow from '../../../assets/case_study_images/instagram-saves-redesign/wireframes/wireframe_flow_save.png';
import managementFlow from '../../../assets/case_study_images/instagram-saves-redesign/wireframes/wireframe_flow_saves_management.png';
import savingFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-540.mp4?url';
import savingFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-720.mp4?url';
import savingFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-poster.png';
import managementFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-540.mp4?url';
import managementFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-720.mp4?url';
import managementFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-poster.png';
import searchFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-540.mp4?url';
import searchFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-720.mp4?url';
import searchFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-poster.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import DecisionBlock from '../../../components/case-studies/DecisionBlock.astro';
import More from '../../../components/case-studies/More.astro';
import Plate from '../../../components/case-studies/Plate.astro';
import Rich from '../../../components/case-studies/Rich.astro';
import Rows from '../../../components/case-studies/Rows.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudyLife from '../../../components/case-studies/StudyLife.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import PileCover from '../../../components/case-studies/instagram-saves/PileCover.astro';
import StudyFilm from '../../../components/case-studies/instagram-saves/StudyFilm.astro';
import StudyImage from '../../../components/case-studies/instagram-saves/StudyImage.astro';
import TryPrototype from '../../../components/case-studies/instagram-saves/TryPrototype.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import { caseStudy } from '../../../content/case-studies';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/plates.css';
import '../../../styles/study-structured.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);

// One set of names, used in the short read, the navigation, and the sections.
const label = {
  problem: t('Problem', 'Проблема'),
  goal: t('Goal', 'Цель'),
  research: t('Research', 'Исследование'),
  decisions: t('Decisions', 'Решения'),
  decision: t('Decision', 'Решение'),
  hypothesis: t('Hypothesis', 'Гипотеза'),
  why: t('Why', 'Почему'),
  notChosen: t('Not chosen', 'Отверг'),
  result: t('Result', 'Результат'),
  idea: t('Idea', 'Идея'),
  test: t('What I’d test', 'Что проверить'),
};
const goal = t(
  'Get people back to a specific save quickly, without asking them to organise more.',
  'Быстро возвращать людей к конкретному сохранённому посту и не заставлять их больше сортировать.',
);

const loop = [
  t('Save it for later', 'Сохранить на потом'),
  t('Choosing a collection is hard', 'Выбрать коллекцию сложно'),
  t('Dump it in All', 'Бросить в общую кучу'),
  t('Scroll to find it', 'Листать в поисках'),
  t('Give up', 'Сдаться'),
];

const constraints = [
  { name: t('Saving stays one tap.', 'Сохранение остаётся одним касанием.'), why: t('It’s the part that already works, so nothing I add can slow it down.', 'Это та часть, которая уже работает, поэтому ничто новое не должно её замедлять.') },
  { name: t('No extra organising.', 'Никакой дополнительной сортировки.'), why: t('Filing is the work people skip, so the fix has to work on the saves they already have.', 'Именно сортировку люди и пропускают, поэтому решение должно работать с тем, что уже сохранено.') },
  { name: t('AI search is unverified.', 'AI-поиск не проверен.'), why: t('The prototype’s results are designed states. Whether AI finds the right save on a real library still needs testing.', 'Результаты в прототипе спроектированы заранее. Насколько надёжно AI находит нужное в настоящих сохранениях, ещё предстоит проверить.') },
  { name: t('A prototype built with AI.', 'Прототип, собранный с AI.'), why: t('I designed it in Figma, then built and refined it with Claude Code. The flows work, so they could be timed.', 'Я спроектировал его в Figma, а потом собрал и доработал с Claude Code. Сценарии работают, поэтому их можно было замерить.') },
  { name: t('Nine interviews.', 'Девять интервью.'), why: t('Enough to set a direction, not enough to speak for every Instagram user.', 'Этого хватает, чтобы задать направление, но не чтобы говорить за всех пользователей Instagram.') },
];

// The study's spine: every finding, how many people it came from, and what it led to.
const findings = [
  { title: t('Finding a specific save is the main problem.', 'Главная проблема: найти конкретное сохранённое.'), detail: t('Memory works by subject and time. Saved works by folder.', 'Память работает по теме и времени, а «Сохранённое» по папкам.'), who: t('6 of 9', '6 из 9'), to: t('Decision 1: search', 'Решение 1: поиск'), href: '#decision-1' },
  { title: t('Filing feels like homework.', 'Сортировка как домашняя работа.'), detail: t('People tried more collections, and it stopped working: too many, too slow, or no clear place for a post.', 'Люди пробовали завести больше коллекций, и это переставало работать: их слишком много, это долго или непонятно, куда положить пост.'), who: t('5 of 9', '5 из 9'), to: t('Decision 2: suggestions', 'Решение 2: подсказки'), href: '#decision-2' },
  { title: t('Important things leave Instagram.', 'Важное уходит из Instagram.'), detail: t('Into Notes, Notion, Maps, screenshots, or chats. The reason and the next step live there too.', 'В Заметки, Notion, Карты, скриншоты или чаты. Там же оказываются причина и следующий шаг.'), who: t('7 of 9', '7 из 9'), to: t('Decision 3: notes and pins', 'Решение 3: заметки и закрепление'), href: '#decision-3' },
  { title: t('Shared collections give no feedback.', 'Общие коллекции молчат.'), detail: t('People couldn’t tell if the other person saw a post.', 'Люди не понимали, видел ли пост другой.'), who: t('Both people who used them', 'Оба, кто ими пользовался'), to: t('Bet: reactions', 'Ставка: реакции'), href: '#bets' },
  { title: t('Saved turned into a backlog.', '«Сохранённое» превратилось в склад.'), detail: t('Things never read, made, or bought.', 'Непрочитанное, несделанное и некупленное.'), who: t('1 person', '1 человек'), to: t('Bet: collection feed', 'Ставка: лента коллекции'), href: '#bets' },
  { title: t('Four needs from one person each.', 'Четыре потребности по одному человеку.'), detail: t('Places from travel videos, planning together as a couple, bulk tools and export, and help letting go of saves.', 'Места из видео о путешествиях, совместное планирование для пар, массовые действия с экспортом и помощь в том, чтобы отпускать сохранённое.'), who: t('1 person each', 'По 1 человеку'), to: t('Left out', 'За рамками'), href: '#left-out' },
];

const participants = [
  { profile: t('Casual recipe saver', 'Сохраняет рецепты между делом'), need: t('Save without thinking, find by meaning later.', 'Сохранять не задумываясь, а потом находить по смыслу.'), finding: true },
  { profile: t('Creator with a reference library', 'Автор контента с библиотекой референсов'), need: t('Find references fast, and remember why each was saved.', 'Быстро находить референсы и помнить, зачем каждый сохранён.'), finding: true },
  { profile: t('Saving for years', 'Сохраняет годами'), need: t('Searches by scrolling. 30 saves are okay, 3,000 are not.', 'Ищет листанием. 30 сохранений ещё нормально, 3000 уже нет.'), finding: true },
  { profile: t('Heavy Reels viewer who never files', 'Много смотрит рилсы и ничего не сортирует'), need: t('Find from a vague memory, without filing.', 'Находить по смутному воспоминанию, без сортировки.'), finding: true },
  { profile: t('Overwhelmed by manual search', 'Теряется при ручном поиске'), need: t('Anchors to search by: when it was saved and what the picture shows.', 'Опоры для поиска: когда сохранил и что на картинке.'), finding: true },
  { profile: t('Returns to the same references', 'Возвращается к одним и тем же референсам'), need: t('Reach the same references again and again, with no anchor to find them by.', 'Снова и снова добираться до одних и тех же референсов, а зацепиться не за что.'), finding: true },
  { profile: t('Travel planner', 'Планирует путешествия'), need: t('Get the place out of the video.', 'Достать из видео само место.'), finding: false },
  { profile: t('Shares a collection with a partner', 'Ведёт общую коллекцию с партнёром'), need: t('Go from collecting to deciding together.', 'Перейти от собирательства к совместному решению.'), finding: false },
  { profile: t('Mostly stopped using Saved', 'Почти перестал пользоваться «Сохранённым»'), need: t('Help letting go, not only keeping.', 'Помогать отпускать, а не только хранить.'), finding: false },
];
const findingCount = participants.filter((person) => person.finding).length;

const journey = [
  { name: t('Save', 'Сохранить'), does: t('Tap Save and keep scrolling.', 'Нажать «Сохранить» и листать дальше.'), breaks: t('Picking a collection interrupts the scroll, so a lot of saves never get filed.', 'Выбор коллекции прерывает просмотр, поэтому многое так и остаётся неразобранным.'), fix: t('Decision 2: suggested collection', 'Решение 2: подсказка коллекции'), to: '#decision-2' },
  { name: t('Organise', 'Разобрать'), does: t('Make more collections, or plan a weekly clean-up.', 'Завести больше коллекций или разбирать раз в неделю.'), breaks: t('Too many collections, no clear place for a post. One weekly review lasted two weeks.', 'Коллекций слишком много, непонятно, куда положить пост. Еженедельный разбор продержался две недели.'), fix: t('Decision 2: fewer choices to make', 'Решение 2: меньше выбора'), to: '#decision-2' },
  { name: t('Remember', 'Вспомнить'), does: t('Recall what the post showed and roughly when.', 'Вспомнить, что было в посте и примерно когда.'), breaks: t('Memory works by subject and time. Saved works by folder.', 'Память работает по теме и времени, а «Сохранённое» по папкам.'), fix: t('Decision 1: search and a date range', 'Решение 1: поиск и диапазон дат'), to: '#decision-1' },
  { name: t('Find', 'Найти'), does: t('Scroll the grid, open a post, go back.', 'Листать сетку, открыть пост, вернуться.'), breaks: t('Posts look alike and you lose your place. After a minute or two, people give up and look for something new.', 'Посты похожи друг на друга, и место в ленте теряется. Через минуту-другую люди сдаются и ищут что-то новое.'), fix: t('Decision 1: search inside Saved', 'Решение 1: поиск в «Сохранённом»'), to: '#decision-1' },
  { name: t('Use', 'Использовать'), does: t('Copy it to Notes, Notion, Maps, or a chat to act on it.', 'Перенести в Заметки, Notion, Карты или чат, чтобы что-то с этим сделать.'), breaks: t('The reason and the next step live outside Instagram.', 'Причина и следующий шаг живут за пределами Instagram.'), fix: t('Decision 3: notes and pins', 'Решение 3: заметки и закрепление'), to: '#decision-3' },
];

const nextSteps = [
  t('Test search on real, messy libraries. The prototype’s results are designed states, so this is the biggest unknown.', 'Проверить поиск на настоящих, захламлённых сохранениях. Результаты в прототипе спроектированы заранее, и это главная неизвестная.'),
  t('Repeat the timing with more people, on their own saves, with working search.', 'Повторить замеры с большим числом людей, на их собственных сохранениях и с работающим поиском.'),
  t('Test the two bets, and first add a clear “who can see this” state to shared notes.', 'Проверить две ставки, а перед этим явно показать в общих заметках, кто их видит.'),
  t('At scale, the metrics in Goal would tell if it works.', 'В масштабе понять, работает ли это, помогут метрики из раздела «Цель».'),
];

// The screens crop to what each one is about, at the same scale, so a panel fits beside its words.
const searchCrop = { x: 0, y: 0, w: 100, h: 58 };
const sheetCrop = { x: 0, y: 40, w: 100, h: 60 };
---

<BaseDocument
  title={t('Instagram Saves, worth coming back to | Igor Kupchinenko', '«Сохранённое» в Instagram, к которому хочется возвращаться | Игорь Купчиненко')}
  description={t(
    'A redesign concept for Instagram Saves. In nine interviews, finding a saved post was the main problem for six people, so search came first, then lighter filing, notes, and pins.',
    'Концепт редизайна «Сохранённого» в Instagram. Из девяти человек, с которыми я поговорил, шестеро назвали главной проблемой поиск сохранённого, поэтому первым стал поиск, а за ним более простая сортировка, заметки и закрепление.',
  )}
  pageClass="study-plates study-structured study--instagram"
  ogImage={savedNew.src}
>
  <main id="main-content">
    <!-- The first screen is the short read: each label leads to its section. -->
    <PileCover
      title={t('Instagram Saves, worth coming back to.', '«Сохранённое» в Instagram, к которому хочется возвращаться.')}
      about={caseStudy('instagram-saves-redesign').about}
      navLabel="TL;DR"
    >
      <Rows rows={[
        { label: label.problem, href: '#problem', text: t('The more you save, the less you can find. Saving takes one tap. Getting a save back means scrolling through all of them.', 'Чем больше сохраняешь, тем сложнее найти. Сохранить можно одним касанием, а чтобы вернуться к посту, приходится листать всё подряд.') },
        { label: label.goal, href: '#goal', text: goal },
        { label: label.research, href: '#research', text: t('9 interviews. 6 people named finding a specific save as their main problem.', '9 интервью. Шестеро назвали главной проблемой поиск конкретного сохранённого.') },
        { label: label.decisions, href: '#decisions', text: t('Search inside Saved first, then suggested collections, then notes and pins.', 'Сначала поиск в «Сохранённом», потом подсказки коллекций, потом заметки и закрепление.') },
        { label: label.result, href: '#results', tone: 'result', text: t('Finding a half-remembered post took **about 10 seconds instead of 90** in a timed test with 3 people. AI search itself is still untested on real libraries.', 'В замерах с тремя людьми полузабытый пост находился **примерно за 10 секунд вместо 90**. Сам AI-поиск на настоящих сохранениях ещё не проверен.') },
      ]} />
    </PileCover>

    <StudySection part="problem">
      <div class="split">
        <div class="stack">
          <p class="opening">{t(
            'You saved it for later, and later is here. You remember the reel, more or less. You open Saved and start scrolling. Still scrolling. I kept losing references I’d saved on purpose: saving worked, getting back to them didn’t.',
            'Вы сохранили пост на потом, и вот «потом» наступило. Примерно помните тот рилс, открываете «Сохранённое» и листаете. И листаете дальше. Я и сам постоянно терял референсы, которые сохранял специально: сохранять получалось, а возвращаться к ним нет.',
          )}</p>

          <figure class="loop">
            <figcaption>{t('What keeps happening', 'Что происходит раз за разом')}</figcaption>
            <ol role="list">{loop.map((step) => <li><span>{step}</span></li>)}</ol>
            <p class="note">{t('After a minute or two of scrolling, people give up and look for something new.', 'Через минуту-другую люди сдаются и ищут что-то новое.')}</p>
          </figure>

          <Rows rows={[
            { label: t('How common', 'Насколько часто'), list: [
              t('**6 of 9** named finding a specific save as their main problem.', '**6 из 9** назвали главной проблемой поиск конкретного сохранённого.'),
              t('**7 of 9** moved what mattered into Notes, Notion, Maps, screenshots, or chats.', '**7 из 9** переносили важное в Заметки, Notion, Карты, скриншоты или чаты.'),
              t('One long-time saver put the scale plainly: 30 saves are okay, 3,000 are not.', 'Один человек, который сохраняет годами, сформулировал это так: 30 сохранений ещё нормально, 3000 уже нет.'),
            ] },
            { label: t('Why Instagram should care', 'Зачем это Instagram'), text: t('My assumption: a save is a strong signal of intent, someone wanted to see this again. If Saved works, people get one more reason to come back to the app. If it doesn’t, those signals go to waste.', 'Моё предположение: сохранение говорит о намерении, человек хотел вернуться к этому посту. Если «Сохранённое» работает, у людей появляется ещё одна причина возвращаться в приложение. Если нет, эти сигналы просто пропадают.') },
          ]} />
        </div>

        <Plate caption={t('Saved today: collections, then one long grid. No search.', '«Сохранённое» сейчас: коллекции, а под ними одна длинная сетка. Поиска нет.')} shots={[{ src: savedOld, alt: t('Current Saved screen with collections and a grid of 76 saved posts, without search.', 'Текущий экран «Сохранённое»: коллекции и сетка из 76 публикаций, без поиска.') }]} />
      </div>
    </StudySection>

    <StudySection part="goal">
      <div class="goal">
        <p class="statement" data-arrive><Rich text={t(
          'So the goal wasn’t another way to save. It was ==a way back==.',
          'Так что цель была не в новом способе сохранять, а ==в способе возвращаться==.',
        )} /></p>
        <Rows rows={[
          { label: label.goal, tone: 'key', text: goal },
          { label: t('How I’d know', 'Как пойму'), text: t('At Instagram’s scale:', 'В масштабе Instagram:'), list: [
            t('Saved visits that end with a post opened', 'Заходы в «Сохранённое», которые заканчиваются открытием поста'),
            t('Searches that end in an open, and how long they take', 'Поиски, после которых открыли пост, и время на них'),
            t('Saves filed into a collection, and how often suggestions are accepted', 'Сохранения в коллекциях и то, как часто принимают подсказки'),
          ] },
          { label: 'Guardrail', text: t('Saving has to stay one tap, and total saves shouldn’t drop.', 'Сохранение должно остаться одним касанием, а общее число сохранений не должно упасть.') },
        ]} />
      </div>
    </StudySection>

    <StudySection part="constraints">
      <ul class="constraints" role="list">
        {constraints.map((item) => <li><strong>{item.name}</strong> {item.why}</li>)}
      </ul>
    </StudySection>

    <StudySection
      part="research"
      lead={t(
        'I wanted to know what people struggle with in Saved and what they actually use it for. So I ran nine interviews and asked everyone the same things: why they started saving, how they save and find things step by step, where it hurts, and what they use instead.',
        'Я хотел понять, с чем у людей трудности в «Сохранённом» и для чего они им на самом деле пользуются. Поэтому провёл девять интервью и всем задал одни и те же вопросы: зачем начали сохранять, как шаг за шагом сохраняют и ищут, где больно и чем пользуются вместо этого.',
      )}
    >
      <!-- The 6 of 9 finding, circled with the pen from the homepage. -->
      <p class="headcount" data-arrive>
        <span class="headcount__dots" aria-hidden="true">
          <span class="headcount__finding">
            {participants.filter((person) => person.finding).map((_, index) => <span class="headcount__dot headcount__dot--on" style={`--i: ${index}`}></span>)}
            <Image class="headcount__circle pen-circle" src={penCircle} alt="" widths={[256, 512]} sizes="10rem" loading="lazy" decoding="async" />
          </span>
          {participants.filter((person) => !person.finding).map(() => <span class="headcount__dot"></span>)}
        </span>
        <span><strong>{t(`${findingCount} of ${participants.length}`, `${findingCount} из ${participants.length}`)}</strong> {t('named finding a specific save as their main problem.', 'назвали главной проблемой поиск конкретного сохранённого.')}</span>
      </p>

