      <a href={localePath('/case-studies/', locale)}><span class="link-mark">{t('All case studies', 'Все кейсы')}</span></a>
      <a href={localePath('/case-studies/two-sticks/', locale)}><span class="link-mark">{t('Two Sticks case study →', 'Кейс «Две палочки» →')}</span></a>
