  .why-card__text { margin: 0; font-size: 1.125rem; line-height: 1.6; }

  .research-board { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 16px; align-items: start; margin-top: 8px; }
  .research-board .research-board__also { grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
  .people, .journey { margin-top: 20px; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px rgb(17 17 15 / 7%); }
