  .priority { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-block: 20px 0; padding: 0; list-style: none; }
  .priority__item { padding: 20px; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px rgb(17 17 15 / 7%); }
  .priority__item--first { background: var(--color-ink); color: var(--color-field); box-shadow: none; }
  .priority__tag { display: block; margin-bottom: 10px; color: #656560; font-size: .9375rem; line-height: 1.4; }
