---
import actions from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/action_prompt_for_save.png';
import savedNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/all_saved_new.png';
import savedOld from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/all_saved_old.png';
import annotation from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/annotation.png';
import feed from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/collection_feed.png';
import filter from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/filter.png';
import filterResult from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/filter_result.png';
import saveNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/save_new.png';
import saveOld from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/save_old.png';
import newYork from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/search_new_york.png';
import spider from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/search_spider.png';
import doodlesOne from '../../../assets/case_study_images/instagram-saves-redesign/interview-doodles/interview set 1.png';
import doodlesTwo from '../../../assets/case_study_images/instagram-saves-redesign/interview-doodles/interview set 2.png';
import saveFlow from '../../../assets/case_study_images/instagram-saves-redesign/wireframes/wireframe_flow_save.png';
import managementFlow from '../../../assets/case_study_images/instagram-saves-redesign/wireframes/wireframe_flow_saves_management.png';
import savingFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-540.mp4?url';
import savingFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-720.mp4?url';
import savingFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-poster.png';
import managementFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-540.mp4?url';
import managementFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-720.mp4?url';
import managementFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-poster.png';
import searchFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-540.mp4?url';
import searchFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-720.mp4?url';
import searchFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-poster.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import Decision from '../../../components/case-studies/Decision.astro';
import Rich from '../../../components/case-studies/Rich.astro';
import Shot from '../../../components/case-studies/Shot.astro';
import StarSummary from '../../../components/case-studies/StarSummary.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import StudyFilm from '../../../components/case-studies/instagram-saves/StudyFilm.astro';
import StudyImage from '../../../components/case-studies/instagram-saves/StudyImage.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/case-study.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const heroSizes = '(max-width: 760px) calc((100vw - 56px) / 2), 240px';
const pairSizes = '(max-width: 760px) calc((100vw - 56px) / 2), 250px';

const participants = [
  { profile: t('Casual recipe saver', 'Сохраняет рецепты между делом'), need: t('Save without thinking, find by meaning later.', 'Сохранять не задумываясь, а потом находить по смыслу.'), finding: true },
  { profile: t('Creator with a reference library', 'Автор контента с библиотекой референсов'), need: t('Keep the reason, not only the post.', 'Хранить причину, а не только пост.'), finding: true },
  { profile: t('Saving for years', 'Сохраняет годами'), need: t('Stay usable with thousands of saves.', 'Оставаться удобным, когда сохранений тысячи.'), finding: true },
  { profile: t('Heavy Reels viewer who never files', 'Много смотрит рилсы и ничего не сортирует'), need: t('Find from a vague memory, without filing.', 'Находить по смутному воспоминанию, без сортировки.'), finding: true },
  { profile: t('Overwhelmed by manual search', 'Теряется при ручном поиске'), need: t('Anchors to search by: when it was saved and what the picture shows.', 'Опоры для поиска: когда сохранил и что на картинке.'), finding: true },
  { profile: t('Returns to the same references', 'Возвращается к одним и тем же референсам'), need: t('Keep repeat references close, and a shared folder worth trusting.', 'Держать частые референсы под рукой и доверять общей папке.'), finding: true },
  { profile: t('Travel planner', 'Планирует путешествия'), need: t('Get the place out of the video.', 'Достать из видео само место.'), finding: false },
  { profile: t('Shares a collection with a partner', 'Ведёт общую коллекцию с партнёром'), need: t('Go from collecting to deciding together.', 'Перейти от собирательства к совместному решению.'), finding: false },
  { profile: t('Mostly stopped using Saved', 'Почти перестал пользоваться «Сохранённым»'), need: t('Help letting go, not only keeping.', 'Помогать отпускать, а не только хранить.'), finding: false },
];
const findingCount = participants.filter((person) => person.finding).length;

const journey = [
  { name: t('Save', 'Сохранить'), does: t('Tap Save and keep scrolling.', 'Нажать «Сохранить» и листать дальше.'), breaks: t('Picking a collection interrupts the scroll, so a lot of saves never get filed.', 'Выбор коллекции прерывает просмотр, поэтому многое так и остаётся неразобранным.'), fix: t('Decision 3: suggested collection', 'Решение 3: подсказка коллекции'), to: 3 },
  { name: t('Organise', 'Разобрать'), does: t('Make more collections, or plan a weekly clean-up.', 'Завести больше коллекций или разбирать раз в неделю.'), breaks: t('Too many collections, no clear place for a post. One weekly review lasted two weeks.', 'Коллекций слишком много, непонятно, куда положить пост. Еженедельный разбор продержался две недели.'), fix: t('Decision 3: fewer choices to make', 'Решение 3: меньше выбора'), to: 3 },
  { name: t('Remember', 'Вспомнить'), does: t('Recall what the post showed and roughly when.', 'Вспомнить, что было в посте и примерно когда.'), breaks: t('Memory works by subject and time. Saved works by folder.', 'Память работает по теме и времени, а «Сохранённое» по папкам.'), fix: t('Decisions 1 and 2: search and a date range', 'Решения 1 и 2: поиск и диапазон дат'), to: 1 },
  { name: t('Find', 'Найти'), does: t('Scroll the grid, open a post, go back.', 'Листать сетку, открыть пост, вернуться.'), breaks: t('Posts look alike and you lose your place. After a minute or two, people give up and look for something new.', 'Посты похожи друг на друга, и место в ленте теряется. Через минуту-другую люди сдаются и ищут что-то новое.'), fix: t('Decision 1: search inside Saved', 'Решение 1: поиск в «Сохранённом»'), to: 1 },
  { name: t('Use', 'Использовать'), does: t('Copy it to Notes, Notion, Maps, or a chat to act on it.', 'Перенести в Заметки, Notion, Карты или чат, чтобы что-то с этим сделать.'), breaks: t('The reason and the next step live outside Instagram.', 'Причина и следующий шаг живут за пределами Instagram.'), fix: t('Decisions 4 and 5: notes, pins, reactions, a collection feed', 'Решения 4 и 5: заметки, закрепление, реакции, лента коллекции'), to: 4 },
];
---

<BaseDocument
  title={t('Instagram Saves, worth coming back to | Igor Kupchinenko', '«Сохранённое» в Instagram, к которому хочется возвращаться | Игорь Купчиненко')}
  description={t(
    'A redesign concept for Instagram Saves. In nine interviews, finding a saved post was the main problem for six people, so search came first, then lighter filing, notes, and pins.',
    'Концепт редизайна «Сохранённого» в Instagram. Из девяти человек, с которыми я поговорил, шестеро назвали главной проблемой поиск сохранённого, поэтому первым стал поиск, а за ним более простая сортировка, заметки и закрепление.',
  )}
  pageClass="instagram-case-study editorial-case-study"
  ogImage={savedNew.src}
>
  <main id="main-content">
    <header class="hero">
      <h1 class="hero-title">{t('Instagram Saves, worth coming back to.', '«Сохранённое» в Instagram, к которому хочется возвращаться.')}</h1>
      <p class="hero__line">{t('The more you save, the less you can find.', 'Чем больше сохраняешь, тем сложнее найти.')}</p>

      <p class="facts-line">
        {t('Research, UX/UI, and prototyping · Self-initiated redesign concept, 2026', 'Исследование, UX/UI и прототипирование · Собственный концепт редизайна, 2026')}<br />
        {t('Based on 9 user interviews, with an interactive mobile prototype as the output.', 'По 9 интервью с пользователями, на выходе интерактивный мобильный прототип.')}
      </p>

      <div class="hero-screens">
        <Shot kind="screen" src={savedNew} priority="high" sizes={heroSizes} alt={t('Redesigned Saved screen with search, collections, and a grid of saved posts.', 'Экран «Сохранённое» после редизайна: поиск, коллекции и сетка сохранённых публикаций.')} />
        <Shot kind="screen" src={saveNew} priority="eager" sizes={heroSizes} alt={t('Redesigned save sheet with suggested collections.', 'Окно сохранения после редизайна с предложенными коллекциями.')} />
      </div>
    </header>

    <StarSummary
      situation={t(
        'Saving on Instagram takes one tap. Finding that save again means scrolling through all of them.',
        'Сохранить пост в Instagram можно одним касанием. А чтобы потом его найти, приходится листать всё подряд.',
      )}
      task={t(
        'Make saves easy to find again, without asking people to organise more.',
        'Сделать так, чтобы сохранённое снова легко находилось, и не заставлять людей больше сортировать.',
      )}
      action={t(
        'I ran 9 user interviews and turned them into a customer journey map. 6 of 9 named the same problem, so search came first, then lighter filing, notes, and pins.',
        'Провёл 9 интервью и собрал из них CJM. 6 из 9 назвали одну и ту же проблему, поэтому первым стал поиск, а за ним более простая сортировка, заметки и закрепление.',
      )}
      result={t(
        'An interactive prototype. In its flows, finding a half-remembered post takes **about 10 seconds instead of 90**, and saving into a new collection takes **1 tap instead of 2 and a name**.',
        'Интерактивный прототип. В его сценариях полузабытый пост находится **примерно за 10 секунд вместо 90**, а сохранить в новую коллекцию можно **одним касанием вместо двух и названия**.',
      )}
      caption={t(
        'The prototype hasn’t been tested at scale yet, so both numbers come from walking through the flows.',
        'Прототип ещё не тестировали в масштабе, поэтому обе цифры получены при проходе по сценариям.',
      )}
    />

    <StudySection
      part="problem"
      lead={t(
        'You saved it for later, and later is here. You remember the reel, more or less. You open Saved and start scrolling. Still scrolling. I kept losing references I’d saved on purpose: saving worked, getting back to them didn’t.',
        'Сохранил на потом, и вот «потом» наступило. Ты примерно помнишь тот рилс. Открываешь «Сохранённое» и листаешь. И листаешь дальше. Я и сам постоянно терял референсы, которые сохранял специально: сохранять получалось, а возвращаться к ним нет.',
      )}
    >
      <div class="situation-pair">
        <Shot kind="screen" src={savedOld} sizes="(max-width: 760px) min(calc(100vw - 40px), 260px), 260px" alt={t('Current Saved screen with collections and a grid of 76 saved posts, without search.', 'Текущий экран «Сохранённое»: коллекции и сетка из 76 публикаций, без поиска.')} caption={t('Saved today: collections, then one long grid. No search.', '«Сохранённое» сейчас: коллекции, а под ними одна длинная сетка. Поиска нет.')} />
        <p class="why">{t(
          'My hypothesis is that Instagram should care too. A save is a strong signal of intent: someone wanted to see this again. If Saved works, people get one more reason to come back to the app. If it doesn’t, those signals just go to waste.',
          'Моя гипотеза в том, что Instagram это тоже важно. Сохранение говорит о намерении: человек хотел вернуться к этому посту. Если «Сохранённое» работает, у людей появляется ещё одна причина возвращаться в приложение. Если нет, эти сигналы просто пропадают.',
        )}</p>
      </div>
    </StudySection>

    <StudySection
      part="goal"
      lead={t(
        'So the goal wasn’t another way to save. It was a way back.',
        'Так что цель была не в новом способе сохранять, а в способе возвращаться.',
      )}
    >
      <p>{t(
        'That means getting people back to a specific save quickly. At Instagram’s scale, I’d know it works by the share of Saved visits that end with a post opened, searches that end in an open and how long they take, and the share of saves filed into a collection and how often suggestions are accepted. The guardrail metric: saving has to stay one tap, and total saves shouldn’t drop.',
        'То есть быстро возвращать людей к конкретному сохранённому посту. В масштабе Instagram понять, что это работает, можно по доле заходов в «Сохранённое», которые заканчиваются открытием поста, по доле поисков, после которых открыли пост, и времени на них, а ещё по доле сохранений в коллекциях и тому, как часто принимают подсказки. Guardrail-метрика: сохранение должно остаться одним касанием, а общее число сохранений не должно упасть.',
      )}</p>
    </StudySection>

    <StudySection
      part="research"
      lead={t(
        'I ran nine user interviews and asked everyone the same questions: why they started saving, how they save and find things now, what they’ve tried before, and what they use instead.',
        'Я провёл девять интервью и всем задал одни и те же вопросы: зачем они начали сохранять, как сохраняют и ищут сейчас, что пробовали раньше и чем пользуются вместо этого.',
      )}
    >
      <div class="notebooks">
        <StudyImage src={doodlesOne} kind="spread" sizes="(max-width: 760px) calc((100vw - 56px) / 2), 300px" alt={t("First notebook spread of Igor's interview doodles and handwritten observations about saving and finding posts.", 'Первый разворот блокнота с рисунками Игоря с интервью и рукописными наблюдениями о том, как сохраняют и ищут публикации.')} />
        <StudyImage src={doodlesTwo} kind="spread" sizes="(max-width: 760px) calc((100vw - 56px) / 2), 300px" alt={t('Second notebook spread with sketched people and notes about revisiting, organizing, and remembering saves.', 'Второй разворот блокнота с набросками людей и заметками о том, как возвращаются к сохранённому, упорядочивают его и вспоминают.')} />
      </div>
      <p class="note">{t('My interview notes, drawn as well as written.', 'Мои заметки с интервью: я не только записывал, но и рисовал.')}</p>

      <figure class="people">
        <figcaption class="people__title">
          <span class="people__dots" aria-hidden="true">
            {participants.map((person) => <span class:list={['people__dot', person.finding && 'people__dot--on']}></span>)}
          </span>
          <span><strong>{t(`${findingCount} of ${participants.length}`, `${findingCount} из ${participants.length}`)}</strong> {t('named finding a specific save as their main problem.', 'назвали главной проблемой поиск конкретного сохранённого.')}</span>
        </figcaption>
        {[true, false].map((finding) => (
          <section class="people__group">
            <h4 class="people__label">{finding
              ? t('Main problem: finding a save', 'Главная проблема: найти сохранённое')
              : t('Main problem: something else', 'Главная проблема: что-то другое')}</h4>
            <ul role="list">
              {participants.filter((person) => person.finding === finding).map((person) => (
                <li class="people__row"><strong>{person.profile}</strong><span>{person.need}</span></li>
              ))}
            </ul>
          </section>
        ))}
        <p class="people__note">{t('Each need is my synthesis of that interview, not a quote. Nine people set the direction, but they don’t speak for every Instagram user.', 'Потребности я вывел из каждого интервью сам, это не цитаты. Девять человек задали направление, но не говорят за всех пользователей Instagram.')}</p>
      </figure>

      <h3 class="subtitle">{t('Other findings', 'Что ещё повторялось')}</h3>
      <ul class="plain-list">
        <li><Rich text={t('Important things leave Instagram: **7 of 9** moved what mattered into Notes, Notion, Maps, screenshots, or chats.', 'Важное уходит из Instagram: **7 из 9** переносили важное в Заметки, Notion, Карты, скриншоты или чаты.')} /></li>
        <li><Rich text={t('Filing feels like homework: **5 of 9** tried more collections, and it stopped working because there were too many, it was too slow, or there was no clear place for a post.', 'Сортировка как домашняя работа: **5 из 9** пробовали завести больше коллекций, и это переставало работать, потому что их слишком много, это долго или непонятно, куда положить пост.')} /></li>
        <li><Rich text={t('Shared collections give no feedback: **both people** who used them couldn’t tell if the other person saw a post.', 'Общие коллекции молчат: **оба человека**, которые ими пользовались, не понимали, видел ли пост другой.')} /></li>
      </ul>

      <h3 class="subtitle">{t('Customer journey map', 'Карта пути пользователя (CJM)')}</h3>
      <p>{t('To see where each of these breaks the experience, I put all nine interviews on one customer journey map.', 'Чтобы увидеть, где именно всё ломается, я разложил все девять интервью на одну карту пути пользователя.')}</p>
      <div class="journey">
      <table>
        <thead>
          <tr>
            <th scope="col">{t('Stage', 'Этап')}</th>
            <th scope="col">{t('What people do', 'Что делают люди')}</th>
            <th scope="col">{t('What breaks', 'Что ломается')}</th>
            <th scope="col">{t('What fixes it', 'Что это чинит')}</th>
          </tr>
        </thead>
        <tbody>
          {journey.map((stage, index) => (
            <tr>
              <th scope="row">{index + 1}. {stage.name}</th>
              <td data-label={t('What people do', 'Что делают люди')}>{stage.does}</td>
              <td data-label={t('What breaks', 'Что ломается')}>{stage.breaks}</td>
              <td data-label={t('What fixes it', 'Что это чинит')}><a class="link-mark" href={`#decision-${stage.to}`}>{stage.fix}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>

      <h3 class="subtitle">{t('Priorities', 'Приоритеты')}</h3>
      <p>{t('The map made the order clear. Search went first, because it served six people.', 'Карта расставила приоритеты. Поиск пошёл первым, потому что он нужен шестерым.')}</p>
      <ol class="plain-list">
        <li>{t('Search and a date filter.', 'Поиск и фильтр по дате.')}</li>
        <li>{t('Collection suggestions.', 'Подсказки коллекций.')}</li>
        <li>{t('Notes and pins.', 'Заметки и закрепление.')}</li>
        <li>{t('Then, to test: shared reactions and a collection feed.', 'Потом проверить: общие реакции и ленту из коллекции.')}</li>
      </ol>
      <p class="note">{t(
        'Left for later, since each came from one person: places from travel videos, planning together as a couple, bulk tools and export, and help letting go of saves.',
        'Отложил то, что было нужно одному человеку: места из видео о путешествиях, совместное планирование для пар, массовые действия с экспортом и помощь в том, чтобы отпускать сохранённое.',
      )}</p>

      <h3 class="subtitle">{t('Wireframes', 'Вайрфреймы')}</h3>
      <p>{t('I wireframed the two main flows, saving and finding, before designing the screens.', 'Два главных сценария, сохранение и поиск, я сначала собрал в вайрфреймах и только потом рисовал экраны.')}</p>
      <div class="wireframes">
        <StudyImage src={saveFlow} kind="wireframe" alt={t('Early three-screen wireframe flow from watching a reel to a save prompt and suggested collections.', 'Ранний вайрфрейм из трёх экранов: от просмотра рилса до предложения сохранить и подсказанных коллекций.')} caption={t('Saving: from a reel to a suggested collection.', 'Сохранение: от рилса до подсказанной коллекции.')} />
        <StudyImage src={managementFlow} kind="wireframe" alt={t('Wireframe sequence exploring saved-content management, collections, and search states.', 'Серия вайрфреймов: управление сохранённым, коллекции и состояния поиска.')} caption={t('Finding: collections, search, and result states.', 'Поиск: коллекции, запрос и состояния результатов.')} />
      </div>
    </StudySection>

    <StudySection part="decisions">

      <Decision
        number={1}
        title={t('Search inside Saved', 'Поиск в «Сохранённом»')}
        navLabel={t('Search', 'Поиск')}
        problem={t('People remember what a post showed, not who posted it or where they filed it. “There’s no way to search for ‘pasta with lemon’ inside my saves.”', 'Люди помнят, что было в посте, но не кто его выложил и куда он сохранён. «В сохранённом никак не найти „пасту с лимоном“».')}
        decision={t('So I added search across titles, your notes, and AI descriptions of each post, right inside Saved.', 'Поэтому я добавил поиск по названиям, твоим заметкам и AI-описаниям постов прямо в «Сохранённом».')}
        why={t('It works on saves people already have. One person said they’d skip a redesign that made them organise by hand, and another wanted to search by what the picture shows.', 'Он работает с тем, что уже сохранено. Один человек сказал, что не станет пользоваться редизайном, где всё нужно раскладывать вручную, а другой хотел искать по тому, что на картинке.')}
        instead={t('I could have nudged people to organise better, but that’s work up front, and it’s exactly the work people skip.', 'Можно было подталкивать людей лучше сортировать, но это работа заранее, а именно её люди и пропускают.')}
        effect={t('Finding a half-remembered post takes **about 10 seconds instead of 90** of scrolling.', 'Полузабытый пост находится **примерно за 10 секунд вместо 90** секунд листания.')}
        source={t('estimate for 76 saves', 'оценка для 76 сохранений')}
      >
        <div class="pair">
          <Shot kind="screen" src={spider} sizes={pairSizes} alt={t('Prototype search for spider returning two saved posts.', 'Поиск в прототипе по запросу «spider» находит две сохранённые публикации.')} caption={t('A subject you remember.', 'Тема, которую помнишь.')} />
          <Shot kind="screen" src={newYork} sizes={pairSizes} alt={t('Prototype search for new york returning three saved posts.', 'Поиск в прототипе по запросу «new york» находит три сохранённые публикации.')} caption={t('A place you remember.', 'Место, которое помнишь.')} />
        </div>
        <p class="note visual-note">{t('These are designed result states. Whether AI search reliably finds the right save still needs testing on real libraries.', 'Это спроектированные состояния результатов. Насколько надёжно AI-поиск находит нужное, ещё предстоит проверить на настоящих сохранениях.')}</p>
      </Decision>

      <Decision
        number={2}
        title={t('Sort and filter by save date', 'Сортировка и фильтр по дате')}
        navLabel={t('Date filter', 'Фильтр по дате')}
        problem={t('A long-time saver knew roughly when they’d saved a post but couldn’t jump to a month or year. Another person wanted time as an anchor for searching.', 'Человек, который сохраняет годами, примерно помнил, когда сохранил пост, но не мог перейти к нужному месяцу или году. Другой хотел опираться на время при поиске.')}
        decision={t('I added oldest-first sorting and a saved-date range next to search. The active range stays visible above the results.', 'Я добавил сортировку от старых к новым и диапазон дат сохранения рядом с поиском. Выбранный диапазон остаётся на виду над результатами.')}
        why={t('With years of saves, even a rough time window cuts the pile down a lot.', 'Когда сохранения копятся годами, даже примерный промежуток сильно сужает поиск.')}
      >
        <div class="pair">
          <Shot kind="screen" src={filter} sizes={pairSizes} alt={t('Saved search filter with latest-first and oldest-first sorting and a saved-date range from August 28, 2025 to August 27, 2026.', 'Фильтр поиска по сохранённому с сортировкой от новых и от старых и диапазоном дат сохранения с 28 августа 2025 по 27 августа 2026 года.')} caption={t('Narrow the time window.', 'Сузить промежуток времени.')} />
          <Shot kind="screen" src={filterResult} sizes={pairSizes} alt={t('Travel search results with the selected date range and latest-first sort shown above the grid.', 'Результаты поиска по коллекции «Travel» с выбранным диапазоном дат и сортировкой от новых над сеткой.')} caption={t('The range stays in view.', 'Диапазон остаётся на виду.')} />
        </div>
      </Decision>

      <Decision
        number={3}
        title={t('Suggested collections when saving', 'Подсказки коллекций при сохранении')}
        navLabel={t('Suggestions', 'Подсказки')}
        problem={t('Filing means finding a collection or naming a new one, mid-scroll. “I don’t want to interrupt what I’m doing.”', 'Чтобы разложить пост, нужно найти коллекцию или придумать название новой прямо посреди ленты. «Не хочу отвлекаться от того, что делаю».')}
        decision={t('The save sheet now shows two suggestions above the full list: the best-matching collection, and a new one with a name already filled in.', 'Теперь в окне сохранения над полным списком две подсказки: самая подходящая коллекция и новая, уже с названием.')}
        why={t('This makes the choice easier without taking it away. The full list stays for when a suggestion is wrong.', 'Так выбирать проще, но выбор остаётся за человеком. Полный список на месте, если подсказка ошиблась.')}
        effect={t('Saving into a new collection takes **1 tap instead of 2 and a name**.', 'Сохранить в новую коллекцию можно **одним касанием вместо двух и названия**.')}
        source={t('counted from the designs', 'посчитано по макетам')}
      >
        <div class="pair">
          <Shot kind="screen" src={saveOld} sizes={pairSizes} alt={t('Original save sheet showing the collection list.', 'Исходное окно сохранения со списком коллекций.')} caption={t('Before: find or name it yourself.', 'До: найти или назвать самому.')} />
          <Shot kind="screen" src={saveNew} sizes={pairSizes} alt={t('Redesigned save sheet suggesting an existing collection and a possible new collection.', 'Окно сохранения после редизайна: подсказывает существующую коллекцию и возможную новую.')} caption={t('After: two suggestions on top.', 'После: две подсказки сверху.')} />
        </div>
      </Decision>

      <Decision
        number={4}
        title={t('Notes, pins, and reactions', 'Заметки, закрепление и реакции')}
        navLabel={t('Notes and pins', 'Заметки')}
        problem={t('A collection keeps the post, not the reason: one creator kept Notion just to write reasons down. Another kept going back to the same references, and shared collections gave no feedback.', 'Коллекция хранит пост, но не причину: один автор контента вёл Notion, только чтобы записывать зачем. Другой постоянно возвращался к одним и тем же референсам, а общие коллекции молчали.')}
        decision={t('I added short notes on a save that you can search later, pins for references you go back to often, and reactions for shared collections.', 'Я добавил короткие заметки к сохранённому, по которым потом можно искать, закрепление для частых референсов и реакции в общих коллекциях.')}
        why={t('A note becomes one more way back, in your own words.', 'Заметка становится ещё одним путём назад, твоими словами.')}
        effect={t('Shared notes still need a clear “who can see this” state before testing.', 'Общим заметкам ещё нужно явно показывать, кто их видит, до тестирования.')}
        source={t('still open', 'ещё открыто')}
      >
        <div class="pair">
          <Shot kind="screen" src={annotation} sizes={pairSizes} alt={t('Annotation editor with a note about a limited blue palette.', 'Редактор заметки с записью об ограниченной синей палитре.')} caption={t('A note in your own words.', 'Заметка своими словами.')} />
          <Shot kind="screen" src={actions} sizes={pairSizes} alt={t('Saved-post actions for pinning, annotations, and shared reactions.', 'Действия с сохранённой публикацией: закрепить, добавить заметку, поставить общую реакцию.')} caption={t('Pin, note, or react.', 'Закрепить, подписать, отреагировать.')} />
        </div>
      </Decision>

      <Decision
        number={5}
        title={t('Collections in the feed selector', 'Коллекции в переключателе ленты')}
        navLabel={t('Collection feed', 'Лента коллекции')}
        problem={t('One person stopped using Saved: it had turned into a backlog of things never read, made, or bought. Saving had replaced doing.', 'Один человек перестал пользоваться «Сохранённым»: оно превратилось в склад непрочитанного, несделанного и некупленного. Сохранять стали вместо того, чтобы делать.')}
        decision={t('I put collections in the feed selector next to Following and Favorites, so a Design collection can become a daily feed.', 'Я добавил коллекции в переключатель ленты рядом с «Подписками» и «Избранным», чтобы коллекция «Design» могла стать ежедневной лентой.')}
        why={t('That way saves get a place in everyday browsing, instead of a folder nobody opens.', 'Так сохранённое получает место в обычном просмотре, а не лежит в папке, которую никто не открывает.')}
        effect={t('It might just become more scrolling, and it doesn’t help people let go of saves, so it needs testing.', 'Это может стать просто ещё одним листанием, и отпускать сохранённое оно не помогает, так что это нужно проверить.')}
        source={t('open question', 'открытый вопрос')}
      >
        <Shot kind="screen" src={feed} alt={t('Instagram feed menu expanded to show Following, Favorites, and Collections with Design, Travel, Art, and Health choices.', 'Раскрытое меню ленты Instagram: «Following», «Favorites» и «Collections» с вариантами Design, Travel, Art и Health.')} caption={t('A collection in the main feed selector.', 'Коллекция в главном переключателе ленты.')} />
      </Decision>
    </StudySection>

    <StudySection
      part="results"
      lead={t(
        'When I showed the prototype, people reacted warmly: “this is a massive improvement”, “really convenient”.',
        'Когда я показывал прототип, реакция была тёплой: «это огромное улучшение», «очень удобно».',
      )}
    >
      <div class="films">
        <StudyFilm id="search-film" title={t('Less scrolling, more finding.', 'Меньше листать, больше находить.')} description={t('Start with what you remember, then narrow it down.', 'Начни с того, что помнишь, а потом сузь поиск.')}
          small={searchFilmSmall} large={searchFilmLarge} poster={searchFilmPoster} />
        <StudyFilm id="saving-film" title={t('An easier save.', 'Сохранять проще.')} description={t('The same tap, plus a helpful collection suggestion.', 'То же касание и подсказка коллекции.')}
          small={savingFilmSmall} large={savingFilmLarge} poster={savingFilmPoster} />
        <StudyFilm id="management-film" title={t('Make saves yours.', 'Сделать сохранённое своим.')} description={t('Add a note, leave a reaction, keep a reference close.', 'Добавь заметку, оставь реакцию, держи референс под рукой.')}
          small={managementFilmSmall} large={managementFilmLarge} poster={managementFilmPoster} />
      </div>

      <p>{t('That’s nice to hear, but it’s an early reaction, not evidence. So these numbers are estimates from the flows:', 'Приятно, но это первые впечатления, а не доказательства. Поэтому цифры ниже я оценил по сценариям:')}</p>
      <div class="chart-block">
        <BarCompare
          title={t('Time to find a half-remembered post', 'Время, чтобы найти полузабытый пост')}
          rows={[
            { label: t('Today: scroll the grid', 'Сейчас: листать сетку'), value: 90, display: t('≈90 s', '≈90 с') },
            { label: t('Prototype: search', 'Прототип: поиск'), value: 10, display: t('≈10 s', '≈10 с'), emphasis: true },
          ]}
          note={t('Estimate for a library of 76 saves, like the one in the prototype. Bigger libraries make the gap wider.', 'Оценка для 76 сохранений, как в прототипе. Чем больше сохранений, тем больше разница.')}
        />
      </div>
      <div class="chart-block">
        <StepCompare
          title={t('Saving into a new collection', 'Сохранить в новую коллекцию')}
          rows={[
            { label: t('Today', 'Сейчас'), steps: [t('Save', 'Сохранить'), t('New collection', 'Новая коллекция'), t('Type a name', 'Ввести название'), t('Done', 'Готово')] },
            { label: t('Prototype', 'Прототип'), steps: [t('Save', 'Сохранить'), t('Suggested collection', 'Подсказанная коллекция')], emphasis: true },
          ]}
          note={t('Counted from the designs.', 'Посчитано по макетам.')}
        />
      </div>

    </StudySection>

    <StudySection
      part="next"
      lead={t(
        'I’d test it on real, messy libraries. The search results in the prototype are designed states. Next, I’d run a task-based usability test with 5 people on their own saves, timing how long it takes to find a post they remember in today’s Instagram and in the prototype. At scale, the success metrics above would tell if it works.',
        'Я бы проверил это на настоящих, захламлённых сохранениях. Результаты поиска в прототипе спроектированы заранее. Следующий шаг: юзабилити-тест на задачах с 5 людьми на их собственных сохранениях, чтобы засечь, сколько уходит на поиск запомнившегося поста в сегодняшнем Instagram и в прототипе. В масштабе понять, работает ли это, помогут метрики успеха выше.',
      )}
    />
  </main>

  <footer class="case-footer">
    <nav aria-label={t('Instagram Saves project links', 'Ссылки проекта «Сохранённое» в Instagram')}>
