---
import actions from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/action_prompt_for_save.png';
import savedNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/all_saved_new.png';
import savedOld from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/all_saved_old.png';
import annotation from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/annotation.png';
import feed from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/collection_feed.png';
import filter from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/filter.png';
import filterResult from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/filter_result.png';
import saveNew from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/save_new.png';
import saveOld from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/save_old.png';
import newYork from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/search_new_york.png';
import spider from '../../../assets/case_study_images/instagram-saves-redesign/screenshots/search_spider.png';
import doodlesOne from '../../../assets/case_study_images/instagram-saves-redesign/interview-doodles/interview set 1.png';
import doodlesTwo from '../../../assets/case_study_images/instagram-saves-redesign/interview-doodles/interview set 2.png';
import saveFlow from '../../../assets/case_study_images/instagram-saves-redesign/wireframes/wireframe_flow_save.png';
import managementFlow from '../../../assets/case_study_images/instagram-saves-redesign/wireframes/wireframe_flow_saves_management.png';
import savingFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-540.mp4?url';
import savingFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-720.mp4?url';
import savingFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/01-easier-save-poster.png';
import managementFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-540.mp4?url';
import managementFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-720.mp4?url';
import managementFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/02-flexible-management-poster.png';
import searchFilmSmall from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-540.mp4?url';
import searchFilmLarge from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-720.mp4?url';
import searchFilmPoster from '../../../assets/case_study_images/instagram-saves-redesign/showcase-videos/web/03-search-and-filter-poster.png';
import BarCompare from '../../../components/case-studies/BarCompare.astro';
import Decision from '../../../components/case-studies/Decision.astro';
import DotStat from '../../../components/case-studies/DotStat.astro';
import MetricGrid from '../../../components/case-studies/MetricGrid.astro';
import Shot from '../../../components/case-studies/Shot.astro';
import StarSummary from '../../../components/case-studies/StarSummary.astro';
import StepCompare from '../../../components/case-studies/StepCompare.astro';
import StudySection from '../../../components/case-studies/StudySection.astro';
import StudyFilm from '../../../components/case-studies/instagram-saves/StudyFilm.astro';
import StudyImage from '../../../components/case-studies/instagram-saves/StudyImage.astro';
import { localePath, toLocale, translator } from '../../../i18n/locales';
import BaseDocument from '../../../layouts/BaseDocument.astro';
import '../../../styles/case-study.css';

const locale = toLocale(Astro.currentLocale);
const t = translator(locale);
const heroSizes = '(max-width: 760px) calc((100vw - 56px) / 2), 280px';
const pairSizes = '(max-width: 760px) calc((100vw - 56px) / 2), 250px';
---

<BaseDocument
  title={t('Instagram Saves, worth coming back to | Igor Kupchinenko', 'Сохранённое в Instagram, к которому хочется вернуться | Игорь Купчиненко')}
  description={t(
    'A redesign concept for Instagram Saves. Eight interviews showed that finding a saved post was the main problem for six people, so search came first, then lighter filing, notes, and pins.',
    'Концепт редизайна «Сохранённого» в Instagram. Восемь интервью показали, что для шести человек главная проблема в том, чтобы найти сохранённый пост, поэтому первым стал поиск, а за ним более лёгкая сортировка, заметки и закрепление.',
  )}
  pageClass="instagram-case-study editorial-case-study"
  ogImage={savedNew.src}
>
  <main id="main-content">
    <header class="hero">
      <h1 class="hero-title">{t('Instagram Saves, worth coming back to.', 'Сохранённое в Instagram, к которому хочется вернуться.')}</h1>
      <p class="hero__line">{t('The more you save, the less you can find.', 'Чем больше сохраняешь, тем сложнее найти.')}</p>

      <dl class="facts">
        <div><dt>{t('Role', 'Роль')}</dt><dd>{t('Research, UX/UI, and prototyping', 'Исследование, UX/UI и прототипирование')}</dd></div>
        <div><dt>{t('Type', 'Тип')}</dt><dd>{t('Self-initiated redesign concept, 2026', 'Самостоятельный концепт редизайна, 2026')}</dd></div>
        <div><dt>{t('Research', 'Исследование')}</dt><dd>{t('8 interviews', '8 интервью')}</dd></div>
        <div><dt>{t('Output', 'Итог')}</dt><dd>{t('Interactive mobile prototype', 'Интерактивный мобильный прототип')}</dd></div>
      </dl>

      <div class="hero-screens">
        <Shot kind="screen" src={savedNew} priority="high" sizes={heroSizes} alt={t('Redesigned Saved screen with search, collections, and a grid of saved posts.', 'Экран «Сохранённое» после редизайна: поиск, коллекции и сетка сохранённых публикаций.')} />
        <Shot kind="screen" src={saveNew} priority="eager" sizes={heroSizes} alt={t('Redesigned save sheet with suggested collections.', 'Окно сохранения после редизайна с предложенными коллекциями.')} />
      </div>
    </header>

    <StarSummary
      situation={t(
        'Saving on Instagram takes one tap. Finding that save again means scrolling through all of them.',
        'Сохранить в Instagram можно одним касанием. А чтобы найти сохранённое, приходится листать всё подряд.',
      )}
      task={t(
        'Make saves findable again, without asking people to organise more.',
        'Сделать сохранённое снова находимым и не заставлять людей больше сортировать.',
      )}
      action={t(
        '8 interviews. 6 people named the same problem, so search came first. Then lighter filing, notes, and pins.',
        '8 интервью. 6 человек назвали одну и ту же проблему, поэтому первым стал поиск. Потом более лёгкая сортировка, заметки и закрепление.',
      )}
      result={t(
        'A prototype where a half-remembered post takes one search instead of a long scroll, and a new collection takes one tap instead of typing a name.',
        'Прототип, в котором полузабытый пост находится одним поиском вместо долгого листания, а новая коллекция создаётся одним касанием вместо ввода названия.',
      )}
    />

    <MetricGrid
      metrics={[
        { value: t('6 of 8', '6 из 8'), label: t('named finding a saved post as their main problem', 'назвали поиск сохранённого главной проблемой'), basis: t('Interviews', 'Интервью') },
        { value: t('≈90 s → ≈10 s', '≈90 с → ≈10 с'), label: t('to find a half-remembered post', 'чтобы найти полузабытый пост'), basis: t('Estimate: scrolling 76 saves vs one search', 'Оценка: листать 76 сохранений или один поиск') },
        { value: t('2 taps + a name → 1 tap', '2 касания + название → 1 касание'), label: t('to save into a new collection', 'чтобы сохранить в новую коллекцию'), basis: t('Counted from the designs', 'Посчитано по макетам') },
      ]}
      caption={t(
        'The prototype has not been tested at scale. Estimates come from walking through the flows.',
        'Прототип не тестировали в масштабе. Оценки получены при проходе по сценариям.',
      )}
    />

    <StudySection
      part="situation"
      title={t('You saved it for later. Later has arrived.', 'Ты сохранил это на потом. «Потом» наступило.')}
      lead={t(
        'You remember the reel, more or less. You open Saved and start scrolling. Still scrolling. I kept losing references I had saved on purpose: saving worked, getting back did not.',
        'Ты помнишь тот рилс, более-менее. Открываешь «Сохранённое» и начинаешь листать. Всё ещё листаешь. Я сам постоянно терял референсы, которые сохранял специально: сохранять получалось, а вернуться нет.',
      )}
    >
      <div class="situation-pair breakout">
        <Shot kind="screen" src={savedOld} sizes="(max-width: 760px) min(calc(100vw - 40px), 300px), 300px" alt={t('Current Saved screen with collections and a grid of 76 saved posts, without search.', 'Текущий экран «Сохранённое»: коллекции и сетка из 76 публикаций, без поиска.')} caption={t('Saved today: collections, then one long grid. No search.', '«Сохранённое» сейчас: коллекции, потом одна длинная сетка. Поиска нет.')} />
        <div class="why-card">
          <p class="why-card__label">{t('My hypothesis', 'Моя гипотеза')}</p>
          <h3 class="why-card__title">{t('Why Instagram should care', 'Почему это важно для Instagram')}</h3>
          <p class="why-card__text">{t(
            'A save is a strong signal of intent: someone wanted this again. If Saved works, it gives people one more reason to come back to the app. If it does not, those signals go to waste.',
            'Сохранение сильный сигнал намерения: человек хотел вернуться к этому. Если «Сохранённое» работает, у людей появляется ещё одна причина возвращаться в приложение. Если нет, эти сигналы пропадают зря.',
          )}</p>
        </div>
      </div>
    </StudySection>

    <StudySection
      part="task"
      title={t('Make saves findable, without more filing.', 'Сделать сохранённое находимым без лишней сортировки.')}
      lead={t(
        'A self-initiated concept. I ran the interviews, synthesised them, and designed and prototyped the redesign.',
        'Самостоятельный концепт. Я провёл интервью, свёл выводы, спроектировал редизайн и собрал прототип.',
      )}
    >
      <dl class="goal breakout">
        <div><dt>{t('Goal', 'Цель')}</dt><dd>{t('Get people back to a specific save quickly.', 'Быстро возвращать людей к конкретному сохранённому.')}</dd></div>
        <div><dt>{t('How I would know', 'Как понять, что получилось')}</dt><dd>{t('Share of Saved visits that end in opening a post. Time to find a post. Share of saves filed into a collection.', 'Доля заходов в «Сохранённое», которые заканчиваются открытием поста. Время на поиск поста. Доля сохранений, разложенных по коллекциям.')}</dd></div>
        <div><dt>{t('Guardrail', 'Ограничитель')}</dt><dd>{t('Saving must stay one tap, and total saves should not drop.', 'Сохранение должно остаться одним касанием, а общее число сохранений не должно упасть.')}</dd></div>
      </dl>
    </StudySection>

    <StudySection part="action" title={t('Eight interviews. One problem kept coming back.', 'Восемь интервью. Одна проблема возвращалась снова и снова.')}>
      <div class="research-board breakout">
        <DotStat
          title={t('Named finding a specific save as their main problem', 'Назвали главной проблемой поиск конкретного сохранённого')}
          rows={[{ label: t('People interviewed', 'Участники интервью'), value: 6, total: 8, emphasis: true }]}
          note={t('By far the most common thread.', 'Самая частая тема, с большим отрывом.')}
        />
        <ul class="tiles research-board__also" role="list">
          <li><strong>{t('Filing takes effort', 'Сортировка требует сил')}</strong><p>{t('So everything lands in All Saves.', 'Поэтому всё оказывается во «Всех сохранённых».')}</p></li>
          <li><strong>{t('Why did I save this?', 'Зачем я это сохранил?')}</strong><p>{t('A collection says where, not why.', 'Коллекция говорит где, но не зачем.')}</p></li>
          <li><strong>{t('Shared collections lose the talk', 'Общие коллекции теряют разговор')}</strong><p>{t('A couple kept posts together, but the conversation stayed in DMs.', 'Пара собирала посты вместе, а обсуждение оставалось в переписке.')}</p></li>
          <li><strong>{t('Saving replaced doing', 'Сохранение заменило действие')}</strong><p>{t('One person stopped saving: collecting had become a substitute for acting.', 'Один человек перестал сохранять: собирать стало заменой тому, чтобы делать.')}</p></li>
        </ul>
      </div>

      <div class="notebooks breakout">
        <StudyImage src={doodlesOne} kind="spread" alt={t("First notebook spread of Igor's interview doodles and handwritten observations about saving and finding posts.", 'Первый разворот блокнота с рисунками Игоря с интервью и рукописными наблюдениями о том, как сохраняют и ищут публикации.')} caption={t('My interview notes, drawn as well as written.', 'Мои заметки с интервью, не только записанные, но и нарисованные.')} />
        <StudyImage src={doodlesTwo} kind="spread" alt={t('Second notebook spread with sketched people and notes about revisiting, organizing, and remembering saves.', 'Второй разворот блокнота с набросками людей и заметками о том, как возвращаются к сохранённому, упорядочивают его и вспоминают.')} caption={t('Eight people set the direction. They do not speak for every Instagram user.', 'Восемь человек задали направление. Они не говорят за всех пользователей Instagram.')} />
      </div>

      <h3 class="subtitle">{t('What to build first', 'Что делать в первую очередь')}</h3>
      <ol class="priority breakout" role="list">
        <li class="priority__item priority__item--first"><span class="priority__tag">{t('First', 'Сначала')}</span><strong>{t('Search and a date filter', 'Поиск и фильтр по дате')}</strong><p>{t('For the 6 of 8 who could not find a save.', 'Для 6 из 8, кто не мог найти сохранённое.')}</p></li>
        <li class="priority__item"><span class="priority__tag">{t('Next', 'Затем')}</span><strong>{t('Collection suggestions', 'Подсказки коллекций')}</strong><p>{t('Filed saves are easier to find later.', 'Разложенное проще найти потом.')}</p></li>
        <li class="priority__item"><span class="priority__tag">{t('Then', 'Потом')}</span><strong>{t('Notes and pins', 'Заметки и закрепление')}</strong><p>{t('Remember why, and find by your own words.', 'Помнить зачем и искать своими словами.')}</p></li>
        <li class="priority__item"><span class="priority__tag">{t('To test', 'Проверить')}</span><strong>{t('Shared reactions and a collection feed', 'Общие реакции и лента из коллекции')}</strong><p>{t('Worth trying, not yet proven.', 'Стоит попробовать, но пока не доказано.')}</p></li>
      </ol>

      <h3 class="subtitle">{t('Wireframes before pixels', 'Вайрфреймы до пикселей')}</h3>
      <div class="wireframes">
        <StudyImage src={saveFlow} kind="wireframe" alt={t('Early three-screen wireframe flow from watching a reel to a save prompt and suggested collections.', 'Ранний вайрфрейм из трёх экранов: от просмотра рилса до предложения сохранить и подсказанных коллекций.')} caption={t('Saving: from a reel to a suggested collection.', 'Сохранение: от рилса до подсказанной коллекции.')} />
        <StudyImage src={managementFlow} kind="wireframe" alt={t('Wireframe sequence exploring saved-content management, collections, and search states.', 'Серия вайрфреймов: управление сохранённым, коллекции и состояния поиска.')} caption={t('Finding: collections, search, and result states.', 'Поиск: коллекции, запрос и состояния результатов.')} />
      </div>

      <Decision
        number={1}
        title={t('Search inside Saved.', 'Поиск прямо в «Сохранённом».')}
        problem={t('People remember a subject, a place, or a note. Not a folder.', 'Люди помнят тему, место или заметку. Но не папку.')}
        decision={t('Search across titles, your notes, and AI descriptions of each post, right inside Saved.', 'Поиск по названиям, твоим заметкам и AI-описаниям постов прямо в «Сохранённом».')}
        why={t('It works on the saves people already have. Nobody has to file anything first.', 'Он работает с тем, что уже сохранено. Никому не нужно сначала всё раскладывать.')}
        instead={t('Pushing people to organise better. That is work up front, exactly the work people skip.', 'Попыток заставить людей лучше сортировать. Это работа заранее, ровно та, которую люди пропускают.')}
        effect={t('≈90 s of scrolling → ≈10 s with a search', '≈90 с листания → ≈10 с с поиском')}
        effectLabel={t('Estimate', 'Оценка')}
      >
        <div class="pair">
          <Shot kind="screen" src={spider} sizes={pairSizes} alt={t('Prototype search for spider returning two saved posts.', 'Поиск в прототипе по запросу «spider» находит две сохранённые публикации.')} caption={t('A subject you remember.', 'Тема, которую помнишь.')} />
          <Shot kind="screen" src={newYork} sizes={pairSizes} alt={t('Prototype search for new york returning three saved posts.', 'Поиск в прототипе по запросу «new york» находит три сохранённые публикации.')} caption={t('A place you remember.', 'Место, которое помнишь.')} />
        </div>
        <p class="note visual-note">{t('Designed result states. Whether AI search reliably finds the right save still needs testing on real libraries.', 'Это спроектированные состояния результатов. Сможет ли AI-поиск надёжно находить нужное, ещё предстоит проверить на настоящих коллекциях.')}</p>
      </Decision>

      <Decision
        number={2}
        title={t('Remembering when is enough.', 'Достаточно помнить когда.')}
        problem={t('Sometimes people only remember roughly when they saved something.', 'Иногда человек помнит только, примерно когда он что-то сохранил.')}
        decision={t('Oldest-first sorting and a saved-date range next to search. The active range stays visible above the results.', 'Сортировка от старых к новым и диапазон дат сохранения рядом с поиском. Выбранный диапазон остаётся на виду над результатами.')}
        why={t('With years of saves, even a rough time window cuts the pile down.', 'Когда сохранения копятся годами, даже примерный промежуток сильно сокращает кучу.')}
      >
        <div class="pair">
          <Shot kind="screen" src={filter} sizes={pairSizes} alt={t('Saved search filter with latest-first and oldest-first sorting and a saved-date range from August 28, 2025 to August 27, 2026.', 'Фильтр поиска по сохранённому с сортировкой от новых и от старых и диапазоном дат сохранения с 28 августа 2025 по 27 августа 2026 года.')} caption={t('Narrow the time window.', 'Сузить промежуток времени.')} />
          <Shot kind="screen" src={filterResult} sizes={pairSizes} alt={t('Travel search results with the selected date range and latest-first sort shown above the grid.', 'Результаты поиска по коллекции «Travel» с выбранным диапазоном дат и сортировкой от новых над сеткой.')} caption={t('The range stays in view.', 'Диапазон остаётся на виду.')} />
        </div>
      </Decision>

      <Decision
        number={3}
        title={t('Suggest the collection. Keep the choice.', 'Подсказать коллекцию. Оставить выбор.')}
        problem={t('Filing means finding a collection or naming a new one, mid-scroll. So people skip it.', 'Сортировка означает найти коллекцию или придумать название новой прямо посреди ленты. Поэтому её пропускают.')}
        decision={t('Two suggestions above the full list: the best-matching collection, and a new one with a name already filled in.', 'Две подсказки над полным списком: самая подходящая коллекция и новая, уже с названием.')}
        why={t('Reduce the decision without taking it away. The full list stays for when a suggestion is wrong.', 'Облегчить решение, не отнимая его. Полный список остаётся на случай, если подсказка ошиблась.')}
        effect={t('New collection: 2 taps and a name → 1 tap', 'Новая коллекция: 2 касания и название → 1 касание')}
        effectLabel={t('Counted from the designs', 'Посчитано по макетам')}
      >
        <div class="pair">
          <Shot kind="screen" src={saveOld} sizes={pairSizes} alt={t('Original save sheet showing the collection list.', 'Исходное окно сохранения со списком коллекций.')} caption={t('Before: find or name it yourself.', 'До: найти или назвать самому.')} />
          <Shot kind="screen" src={saveNew} sizes={pairSizes} alt={t('Redesigned save sheet suggesting an existing collection and a possible new collection.', 'Окно сохранения после редизайна: подсказывает существующую коллекцию и возможную новую.')} caption={t('After: two suggestions on top.', 'После: две подсказки сверху.')} />
        </div>
      </Decision>

      <Decision
        number={4}
        title={t('Remember why you saved it.', 'Помнить, зачем сохранил.')}
        problem={t('A collection says where a post belongs, not why it mattered.', 'Коллекция говорит, куда относится пост, но не почему он был важен.')}
        decision={t('Short notes on a save, searchable later. Pins for references you return to often. Reactions for shared collections.', 'Короткие заметки к сохранённому, по которым потом можно искать. Закрепление для частых референсов. Реакции для общих коллекций.')}
        why={t('A note becomes one more way back, in your own words.', 'Заметка становится ещё одним путём обратно, твоими словами.')}
        effect={t('Shared notes need a clear “who can see this” state before testing.', 'Общим заметкам нужно явно показать, кто их видит, до тестирования.')}
        effectLabel={t('Still open', 'Ещё открыто')}
      >
        <div class="pair">
          <Shot kind="screen" src={annotation} sizes={pairSizes} alt={t('Annotation editor with a note about a limited blue palette.', 'Редактор заметки с записью об ограниченной синей палитре.')} caption={t('A note in your own words.', 'Заметка своими словами.')} />
