<style>
  .hero-screens { display: flex; justify-content: flex-start; align-items: flex-start; gap: clamp(16px, 4vw, 48px); margin-top: 32px; }
  .hero-screens > :global(*) { width: min(240px, calc((100% - 16px) / 2)); margin-inline: 0; }
  .hero-screens > :global(* + *) { margin-top: 40px; }

  .situation-pair { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: clamp(24px, 5vw, 56px); align-items: center; margin-top: 28px; }
  .why { max-width: var(--study-measure); margin: 0; }

  /* Who said what: the 6 of 9 finding and the nine people behind it, in one block. */
  .people { margin: 28px 0 0; }
  .people__title { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin: 0 0 8px; color: var(--color-ink); font-size: var(--study-body); line-height: 1.5; }
  .people__dots { display: flex; gap: 6px; }
  .people__dot { width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--color-ink); }
  .people__dot--on { background: var(--color-ink); box-shadow: none; }
  .people__group { padding-top: 14px; }
  .people__label { margin: 0 0 4px; color: var(--study-caption); font-size: var(--study-small); font-weight: 400; line-height: 1.4; }
  .people ul { margin: 0; padding: 0; list-style: none; }
  .people__row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 2px 24px; padding: 10px 0; border-top: 1px solid var(--study-rule); font-size: 1rem; line-height: 1.5; }
  .people__row span { color: var(--color-copy); }
  .people__note { margin: 12px 0 0; color: var(--study-caption); font-size: var(--study-small); }

  .journey { margin-top: 20px; }
  .journey table { width: 100%; border-collapse: collapse; font-size: 1rem; line-height: 1.5; text-align: left; }
  .journey th, .journey td { padding: 14px 20px 14px 0; vertical-align: top; }
  .journey thead th { color: var(--study-caption); font-size: .9375rem; font-weight: 400; }
  .journey tbody tr { border-top: 1px solid var(--study-rule); }
  .journey tbody th { white-space: nowrap; }
  .journey td { color: var(--color-copy); }
  .journey td:last-child { color: var(--color-ink); font-weight: 600; }

  .notebooks { display: grid; grid-template-columns: repeat(2, minmax(0, 300px)); gap: 16px; margin-top: 24px; }
  .notebooks + .note + .people { margin-top: 36px; }


  .wireframes { display: grid; gap: 28px; margin-top: 20px; }
  .wireframes > :global(*) { margin-inline: 0; }
  .visual-note { margin: 18px 0 0; }

  .films { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 3vw, 32px); margin-top: 28px; }

  /* The journey table needs a wide column; narrower, each stage becomes a short labelled block. */
  @container study (max-width: 759px) {
    .people__row { grid-template-columns: minmax(0, 1fr); }
    .journey thead { display: none; }
    .journey table, .journey tbody, .journey tr, .journey th, .journey td { display: block; }
    .journey tbody tr { padding: 16px 0; }
    .journey th, .journey td { padding: 0; }
    .journey td { margin-top: 8px; }
    .journey td::before { content: attr(data-label); display: block; color: var(--study-caption); font-size: .875rem; font-weight: 400; }
  }
  @media (max-width: 760px) {
    .hero-screens > :global(* + *) { margin-top: 28px; }
  }
  @container study (max-width: 599px) {
    .situation-pair { grid-template-columns: minmax(0, 1fr); }
    .situation-pair > :global(figure) { width: min(100%, 260px); margin-inline: 0; }
    .films { grid-template-columns: minmax(0, 1fr); justify-items: start; }
    .films > :global(*) { width: min(100%, 320px); }
  }
</style>
