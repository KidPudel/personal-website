  .people__group + .people__group { border-top: 1px solid rgb(17 17 15 / 10%); }
  .people__label { display: flex; gap: 10px; align-items: baseline; margin: 0; padding: 18px 20px 6px; color: #656560; font-size: .9375rem; font-weight: 400; line-height: 1.4; }
  .people__label span { color: var(--color-ink); font-weight: 700; }
  .people ul { margin: 0; padding: 0 0 8px; list-style: none; }
  .people__row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 4px 24px; padding: 10px 20px; font-size: 1rem; line-height: 1.5; }
