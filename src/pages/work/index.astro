---
import { getEntry } from 'astro:content';

import WorkPortfolio from '../../components/homepage/WorkPortfolio.astro';
import shareImage from '../../assets/software-showcases/observatory/launch-film.png';
import BaseDocument from '../../layouts/BaseDocument.astro';

const [
  observatory,
  foodProduct,
  chineseBee,
  receiptProcessing,
  orderingPlatform,
  discourses,
  santa,
  snake,
  ticTacToe,
  cardStudy,
] = await Promise.all([
  getEntry('software', 'observatory'),
  getEntry('software', 'flutter-product'),
  getEntry('software', 'chinese-bee'),
  getEntry('software', 'receipt-processing'),
  getEntry('software', 'ordering-platform'),
  getEntry('games', 'discourses-by-campfire'),
  getEntry('games', 'santa-foundation'),
  getEntry('games', 'snake-raylib'),
  getEntry('games', 'tic-tac-toe-opengl'),
  getEntry('games', 'card-system-study'),
]);

if (
  !observatory || !foodProduct || !chineseBee || !receiptProcessing || !orderingPlatform ||
  !discourses || !santa || !snake || !ticTacToe || !cardStudy
) {
  throw new Error('The work page content entries could not be loaded.');
}
---

<BaseDocument
  title="Work · Igor Kupchinenko"
  description="Product design, interactive systems, and game work by Igor Kupchinenko."
  pageClass="composition-document"
  themeColor="#F8F8F8"
  ogImage={shareImage.src}
>
  <WorkPortfolio
    {observatory}
    {foodProduct}
    {chineseBee}
    {receiptProcessing}
    {orderingPlatform}
    {discourses}
    {santa}
    {snake}
    {ticTacToe}
    {cardStudy}
  />
</BaseDocument>
